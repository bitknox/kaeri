<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: the ground colour from the first frame, the splash screen
         too, so a launch never flashes white. -->
    <style name="Theme.Kaeri" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The window on a panel the last run found to be e-ink, chosen before the first frame. From
         Android 13 it is the splash screen's theme too: plain paper with no icon, as the icon's
         dark art would be a large dark area on the panel. -->
    <style name="Theme.Kaeri.Paper">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <!-- The system's splash screen draws the launch here: nothing to add. -->
    <style name="Theme.Kaeri.Launch" />
</resources>
