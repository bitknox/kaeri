+/* Kaeri: compressed audio packets of the selected audio stream are copied as they enter the
+ * demuxer cache (so at readahead speed, ahead of playback), decoded on a thread of the tap's
+ * own, and handed over as 16-bit mono samples at 11025 Hz with their playback-timeline
+ * timestamps. count == 0 marks a break: the next samples don't follow on (seek, gap, dropped
+ * packets, track switch, end of a window, end of the file); pts is then where the run ended.
+ * `tag` is the value of the demuxer-audio-tap-tag option when that file's demuxer opened.
+ * Called on the tap's own thread with no mpv lock held; it must return quickly. */
+typedef void (*mpv_audio_tap_fn)(void *ctx, int64_t tag, double pts, const int16_t *samples, int count);
+/* Set (or with cb NULL, clear) the tap's callback for this mpv core. Returns an mpv error code.
+ * When it returns, the previous callback is not running and won't be called again, so it must
+ * not be called from the callback itself. */
+MPV_EXPORT int mpv_set_audio_tap(mpv_handle *ctx, mpv_audio_tap_fn cb, void *cb_ctx);
+
