[Desktop Entry]
Type=Application
Name=Kaeri
GenericName=Anime Player
Comment=Browse, track and watch anime
Exec=kaeri-desktop %u
Icon=app.kaeri.desktop
Categories=AudioVideo;Video;Player;GTK;
Keywords=anime;anilist;mpv;
