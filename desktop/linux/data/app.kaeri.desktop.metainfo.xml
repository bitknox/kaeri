<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.kaeri.desktop</id>
  <name>Kaeri</name>
  <summary>Browse, track and watch anime</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="app.kaeri">
    <name>The Kaeri authors</name>
  </developer>
  <description>
    <p>
      Kaeri is a player for anime. It finds shows through AniList, keeps your watch history and
      list in step with the trackers you use, and plays episodes in a built-in mpv player with
      subtitles, skip buttons for openings and endings, and optional upscaling.
    </p>
    <p>
      Kaeri doesn't host any shows. You add your own sources, and every episode is fetched
      from the source you pick.
    </p>
  </description>
  <launchable type="desktop-id">app.kaeri.desktop.desktop</launchable>
  <url type="homepage">https://github.com/bitknox/kaeri</url>
  <url type="bugtracker">https://github.com/bitknox/kaeri/issues</url>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Player</category>
  </categories>
  <keywords>
    <keyword>anime</keyword>
    <keyword>anilist</keyword>
    <keyword>mpv</keyword>
  </keywords>
  <provides>
    <binary>kaeri-desktop</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>gamepad</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-11-01"/>
  </releases>
</component>
