<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives the testing build of the Windows app as a person would: the real pointer and keys,
       through UI Automation, then reads what the app's probe (Kaeri.Windows/Probe.cs) recorded
       to say how smooth each step was. See Program.cs. Not part of the app or its tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- FlaUI asks for 5.0.2, which has a known vulnerability. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>
