<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kaeri.Windows.Pages.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:k="using:Kaeri.Windows"
    xmlns:local="using:Kaeri.Windows.Pages"
    Background="{ThemeResource GroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" k:SmoothWheel.On="True">
    <!-- The server's name comes with its row, so the whole page waits for it. -->
    <local:StateHost x:Name="State" Padding="36,20,36,32" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel x:Name="Stack" Spacing="12" />
    </local:StateHost>
  </ScrollViewer>
</Page>
