<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kaeri.Windows.Pages.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kaeri.Windows.Pages"
    xmlns:s="using:Kaeri.App"
    Background="{ThemeResource GroundBrush}">
  <Grid x:Name="Shell" SizeChanged="OnShellSized">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
  <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" SizeChanged="OnSizeChanged">
    <local:StateHost x:Name="State">
    <Grid x:Name="Body">
      <!-- The banner across the content, up to 360 high, the ground over its lower part. -->
      <Grid x:Name="Banner" VerticalAlignment="Top" Height="300">
        <Grid x:Name="Art">
          <Image x:Name="BannerImage" Stretch="UniformToFill" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          <Rectangle x:Name="Scrim">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00161A2E" Offset="0.25" />
                <GradientStop Color="#D9161A2E" Offset="0.75" />
                <GradientStop Color="#FF161A2E" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Grid>
      </Grid>
      <Grid x:Name="Columns" Padding="36,200,36,24" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SideColumn" Width="260" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="Main" Spacing="20">
          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="CoverFrame" Width="120" Height="180" CornerRadius="8" VerticalAlignment="Bottom">
              <Image x:Name="CoverImage" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
              <TextBlock x:Name="ShowTitle" Style="{StaticResource ShowTitleLargeStyle}" />
              <TextBlock x:Name="Secondary" Style="{StaticResource HazeBodyStyle}" />
              <TextBlock x:Name="Meta" Style="{StaticResource HazeCaptionStyle}" />
              <local:OfflineLine />
              <Grid ColumnSpacing="8" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryActionStyle}" Click="OnPrimary" />
                <!-- Play on TV: the episode the primary action plays, on a TV with kaeri. -->
                <Button x:Name="TvAction" Grid.Column="1" HorizontalAlignment="Left" Height="40" Width="40" Padding="0" Visibility="Collapsed" Click="OnPlayOnTv"
                        ToolTipService.ToolTip="{x:Bind s:T.TitlePlayOnTvTooltip}" AutomationProperties.Name="{x:Bind s:T.TvPlayOn}">
                  <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                </Button>
                <DropDownButton x:Name="StatusButton" Grid.Column="2" Height="40" AutomationProperties.Name="{x:Bind s:T.TitleListStatus}">
                  <DropDownButton.Flyout>
                    <MenuFlyout x:Name="StatusMenu" Placement="BottomEdgeAlignedLeft" />
                  </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="MoreButton" Grid.Column="3" Height="40" Width="40" Padding="0" ToolTipService.ToolTip="{x:Bind s:T.ActionMore}" AutomationProperties.Name="{x:Bind s:T.ActionMore}">
                  <FontIcon Glyph="&#xE712;" />
                  <Button.Flyout>
                    <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedLeft">
                      <MenuFlyoutItem Text="{x:Bind s:T.TitleShowSettingsMenu}" Click="OnShowSettings" KeyboardAcceleratorTextOverride="Ctrl+I">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="DownloadItem" Text="{x:Bind s:T.TitleDownloadMenu}" Click="OnDownloadRange">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="PartyItem" Text="{x:Bind s:T.PartyOpen}" Click="OnWatchParty">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE716;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="SourceItem" Click="OnPickSource">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="FixMatchItem" Text="{x:Bind s:T.MatchFix}" Click="OnFixMatch">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem Text="{x:Bind s:T.EpisodeMarkPreviousWatched}" Click="OnMarkPrevious">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="TrailerItem" Text="{x:Bind s:T.TitlePlayTrailer}" Click="OnTrailer">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Text="{x:Bind s:T.TitleOpenAnilist}" Click="OnOpenAnilist">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBlock x:Name="WaitingLine" Style="{StaticResource HazeBodyStyle}" Visibility="Collapsed" />
              <!-- Services that have the title: Also on, or Listed on with a way to choose yours. -->
              <StackPanel x:Name="AvailLine" Orientation="Horizontal" Spacing="2" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
          </Grid>

          <StackPanel>
            <TextBlock x:Name="Synopsis" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords" MaxLines="8"
                       TextTrimming="WordEllipsis" MaxWidth="720" HorizontalAlignment="Left"
                       IsTextTrimmedChanged="OnSynopsisTrimmed" />
            <HyperlinkButton x:Name="SynopsisMore" Padding="0,4" Visibility="Collapsed" Click="OnSynopsisMore"
                             Content="{x:Bind s:T.ActionMore}" />
            <!-- The demo's credit block, wherever the work shows as a title. -->
            <ContentControl x:Name="DemoCredit" HorizontalContentAlignment="Left" Visibility="Collapsed" />
          </StackPanel>

          <StackPanel Spacing="4">
            <!-- The season picker and the dub line sit beside the heading, so their arriving moves nothing. -->
            <Grid ColumnSpacing="16" MinHeight="36">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind s:T.TitleEpisodes}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
              <ComboBox x:Name="SeasonPicker" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" Visibility="Collapsed"
                        AutomationProperties.Name="{x:Bind s:T.FilterSeason}" SelectionChanged="OnSeasonPicked" />
              <!-- A show of over 100 episodes lists them in ranges of 100, beside the season picker. -->
              <DropDownButton x:Name="RangePicker" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed"
                              AutomationProperties.Name="{x:Bind s:T.EpisodeRangeLabel}">
                <DropDownButton.Flyout>
                  <MenuFlyout x:Name="RangeMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
              </DropDownButton>
              <!-- How far the dub goes. Faded in when the engine says. -->
              <TextBlock x:Name="DubLine" Style="{StaticResource HazeCaptionStyle}" Grid.Column="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Margin="0,4,0,0" Opacity="0">
                <TextBlock.OpacityTransition>
                  <ScalarTransition Duration="0:0:0.2" />
                </TextBlock.OpacityTransition>
              </TextBlock>
            </Grid>
            <TextBlock x:Name="EpisodesNote" Style="{StaticResource HazeCaptionStyle}" Visibility="Collapsed" />
            <ListView x:Name="EpisodeList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEpisodeClick"
                      ContainerContentChanging="OnEpisodeContainer"
                      Margin="-12,4,0,0" AutomationProperties.Name="{x:Bind s:T.TitleEpisodes}">
              <ListView.Resources>
                <DataTemplate x:Key="NoteTemplate" x:DataType="local:NoteItem">
                  <Grid MinHeight="44" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- The eye on the line where spoiler protection starts. -->
                    <FontIcon Glyph="&#xED1A;" FontSize="14" Foreground="{ThemeResource HazeBrush}" VerticalAlignment="Center"
                              Visibility="{x:Bind LineShown}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Line, Mode=OneWay}" Style="{StaticResource HazeCaptionStyle}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Visibility="{x:Bind LineShown}" />
                    <HyperlinkButton Grid.Column="2" Content="{x:Bind Action, Mode=OneWay}" Click="OnNote" Tag="{x:Bind}"
                                     VerticalAlignment="Center" Padding="8,4" />
                  </Grid>
                </DataTemplate>
                <DataTemplate x:Key="EpisodeTemplate" x:DataType="local:EpisodeItem">
                  <Grid Height="{x:Bind RowHeight, Mode=OneWay}" Padding="{x:Bind RowPad, Mode=OneWay}" Margin="0,2" ColumnSpacing="14"
                        Background="{x:Bind TargetFill, Mode=OneWay}" CornerRadius="6"
                        AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind HelpText, Mode=OneWay}"
                        Opacity="{x:Bind Dim}" ToolTipService.ToolTip="{x:Bind Tip, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ContextFlyout>
                      <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind s:T.EpisodeSynopsisShow}" Click="OnEpisodeReveal" Tag="{x:Bind}" Visibility="{x:Bind HeldShown, Mode=OneWay}" />
                        <MenuFlyoutItem Text="{x:Bind s:T.ActionPlay}" Click="OnEpisodePlay" Tag="{x:Bind}" IsEnabled="{x:Bind Playable}" />
                        <MenuFlyoutItem Text="{x:Bind s:T.EpisodePlayFromBeginning}" Click="OnEpisodeFromStart" Tag="{x:Bind}" Visibility="{x:Bind PartWay}" />
                        <MenuFlyoutItem Text="{x:Bind s:T.TvPlayOn}" Click="OnEpisodeOnTv" Tag="{x:Bind}" Visibility="{x:Bind OnTv}" IsEnabled="{x:Bind Playable}" />
                        <MenuFlyoutItem Text="{x:Bind WatchedAction}" Click="OnEpisodeWatched" Tag="{x:Bind}" />
                        <MenuFlyoutItem Text="{x:Bind s:T.DiscussionOpen}" Click="OnEpisodeDiscussion" Tag="{x:Bind}" Visibility="{x:Bind DiscussionShown, Mode=OneWay}" />
                        <MenuFlyoutItem Text="{x:Bind s:T.TitleEpisodeDownload}" Click="OnEpisodeDownload" Tag="{x:Bind}" IsEnabled="{x:Bind CanDownload, Mode=OneWay}" />
                      </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid Width="{x:Bind StillWidth, Mode=OneWay}" Height="{x:Bind StillHeight, Mode=OneWay}" Grid.RowSpan="{x:Bind StillRowSpan, Mode=OneWay}"
                          VerticalAlignment="Top" CornerRadius="6" Background="{ThemeResource RaisedBrush}">
                      <Image Source="{x:Bind Still, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                      <!-- A still the viewer has not asked to see, blurred; a reveal clears it. -->
                      <Border Background="{ThemeResource SpoilerBrush}" Opacity="{x:Bind BlurOpacity, Mode=OneWay}" IsHitTestVisible="False">
                        <Border.OpacityTransition>
                          <ScalarTransition Duration="0:0:0.3" />
                        </Border.OpacityTransition>
                        <!-- The eye on the blurred still, which fades with it. -->
                        <FontIcon Glyph="&#xED1A;" FontSize="22" Foreground="{ThemeResource SilkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                      </Border>
                      <!-- The resume track along the still's bottom edge, as on Continue cards. -->
                      <ProgressBar Value="{x:Bind Watched}" Maximum="1" VerticalAlignment="Bottom" Margin="6,0,6,6" MinHeight="3" Height="3"
                                   CornerRadius="2" Foreground="{ThemeResource SilkBrush}" Background="#B310131F"
                                   Visibility="{x:Bind PartWay}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="{x:Bind HeadAlign, Mode=OneWay}" Margin="{x:Bind HeadMargin, Mode=OneWay}" Spacing="4">
                      <!-- Narrow, the title stands alone on up to two lines and the number moves to the facts ("E8"). -->
                      <TextBlock Text="{x:Bind RowHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                 TextWrapping="{x:Bind HeadingWrap, Mode=OneWay}" MaxLines="{x:Bind HeadingLines, Mode=OneWay}" />
                      <TextBlock Text="{x:Bind RowFacts, Mode=OneWay}" Style="{StaticResource HazeCaptionStyle}" />
                      <!-- The quiet row under a watched episode whose discussion the engine found. -->
                      <HyperlinkButton Content="{x:Bind DiscussionLine, Mode=OneWay}" Visibility="{x:Bind DiscussionShown, Mode=OneWay}"
                                       Click="OnEpisodeDiscussion" Tag="{x:Bind}" Padding="0,3" MinHeight="24" FontSize="12"
                                       Foreground="{ThemeResource HazeBrush}" ToolTipService.ToolTip="{x:Bind s:T.DiscussionOpen}">
                        <HyperlinkButton.Resources>
                          <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#E4E0D6" />
                          <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#E4E0D6" />
                        </HyperlinkButton.Resources>
                      </HyperlinkButton>
                    </StackPanel>
                    <!-- The synopsis: three lines of body text, beside the still or under it. Read by Narrator through the row's help text. -->
                    <TextBlock Grid.Row="1" Grid.Column="{x:Bind SynopsisColumn, Mode=OneWay}" Grid.ColumnSpan="{x:Bind SynopsisColumnSpan, Mode=OneWay}"
                               Text="{x:Bind Description, Mode=OneWay}" Opacity="{x:Bind TextOpacity, Mode=OneWay}"
                               Visibility="{x:Bind TextVisible, Mode=OneWay}" Margin="0,6,0,0" FontSize="14" LineHeight="20"
                               TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxLines="3" VerticalAlignment="Top"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw">
                      <TextBlock.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.2" />
                      </TextBlock.OpacityTransition>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                    <!-- The episode's download: Download on hover or focus, then how far, then a check.
                         The cell keeps its width in every state, so the row never moves. -->
                    <Button Width="36" Height="36" Padding="0" Style="{StaticResource SubtleButtonStyle}"
                            Opacity="{x:Bind DownloadOpacity, Mode=OneWay}" IsEnabled="{x:Bind Playable}"
                            Click="OnDownloadCell" Tag="{x:Bind}" GotFocus="OnDownloadCellFocus"
                            ToolTipService.ToolTip="{x:Bind DownloadSay, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind DownloadSay, Mode=OneWay}">
                      <Grid>
                        <FontIcon Glyph="{x:Bind DownloadGlyph, Mode=OneWay}" FontSize="16"
                                  Foreground="{x:Bind DownloadTint, Mode=OneWay}" Visibility="{x:Bind GlyphShown, Mode=OneWay}" />
                        <ProgressRing Width="20" Height="20" Visibility="{x:Bind RingShown, Mode=OneWay}"
                                      IsIndeterminate="{x:Bind RingWaiting, Mode=OneWay}" IsActive="{x:Bind RingActive, Mode=OneWay}"
                                      Value="{x:Bind RingValue, Mode=OneWay}" Maximum="100" />
                      </Grid>
                    </Button>
                    <!-- Watched is a state: a neutral check box, not an amber toggle. -->
                    <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind Completed}"
                              Click="OnWatchedToggle" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind s:T.EpisodeWatched}"
                              AutomationProperties.Name="{x:Bind s:T.EpisodeWatched}" VerticalAlignment="Center">
                      <!-- On the control itself: the app's theme overrides do not reach a template's check box. -->
                      <CheckBox.Resources>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#E4E0D6" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E4E0D6" Opacity="0.9" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#9298B5" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#E4E0D6" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#E4E0D6" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#9298B5" />
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#161A2E" />
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#161A2E" />
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#161A2E" />
                      </CheckBox.Resources>
                    </CheckBox>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
                <local:EpisodeTemplates x:Key="Templates" Episode="{StaticResource EpisodeTemplate}" Note="{StaticResource NoteTemplate}" />
              </ListView.Resources>
            </ListView>
          </StackPanel>
          <StackPanel x:Name="DetailsBelow" Spacing="16" />
        </StackPanel>
        <StackPanel x:Name="Side" Grid.Column="1" Spacing="16" Margin="0,190,0,0" />
      </Grid>
    </Grid>
    </local:StateHost>
  </ScrollViewer>
  <!-- Another: a title Surprise me opened swaps for the next pick. It stands where Surprise me
       stands on Search and Library, at the end of the page's heading row, so the swap leaves it still. -->
  <Button x:Name="AnotherAction" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,36,0" MinHeight="32"
          Visibility="Collapsed" Click="OnAnother"
          ToolTipService.ToolTip="{x:Bind s:T.SurpriseAnotherHint}" AutomationProperties.Name="{x:Bind s:T.SurpriseAnother}"
          AutomationProperties.HelpText="{x:Bind s:T.SurpriseAnotherHint}">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ContentPresenter x:Name="AnotherGlyph" Width="16" Height="16" VerticalAlignment="Center" />
      <TextBlock Text="{x:Bind s:T.SurpriseAnother}" />
    </StackPanel>
  </Button>
  <!-- Digits typed on the episodes: a small capsule at the top right that says what Go to episode will take. -->
  <Border x:Name="TypedCapsule" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,36,0"
          Padding="16,6" CornerRadius="999" Background="{ThemeResource RaisedBrush}" BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="1"
          IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite">
    <TextBlock x:Name="TypedText" Style="{StaticResource BodyTextBlockStyle}" />
  </Border>
  <!-- A range switch: the page as it stood, fading away over the new rows. -->
  <Image x:Name="RangeGhost" Visibility="Collapsed" IsHitTestVisible="False" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
         AutomationProperties.AccessibilityView="Raw" />
  </Grid>
</Page>
