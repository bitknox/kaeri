<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kaeri.Windows.Pages.LicensedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kaeri.Windows.Pages"
    Background="{ThemeResource GroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="36,20,36,32" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <!-- The title is known at once; what the engine sends waits under it. -->
      <StackPanel x:Name="Head" Spacing="12" />
      <local:StateHost x:Name="State">
        <StackPanel x:Name="Stack" Spacing="12" />
      </local:StateHost>
    </StackPanel>
  </ScrollViewer>
</Page>
