<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kaeri.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kaeri.Windows.Pages"
    xmlns:app="using:Kaeri.App"
    Background="{ThemeResource GroundBrush}">
  <Grid Padding="36,20,36,0" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{x:Bind app:T.SettingsTitle}" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
      <!-- Narrow: where you are, as Windows Settings says it, with the panes one step back. -->
      <BreadcrumbBar x:Name="Crumbs" Visibility="Collapsed" ItemClicked="OnCrumb" Margin="0,4,0,0" />
    </StackPanel>
    <!-- As Windows 11 Settings: the panes down the start, the pane's cards beside them; below
         about 760 the panes and the pane take turns. -->
    <Grid x:Name="Columns" Grid.Row="1" ColumnSpacing="24" SizeChanged="OnColumnsSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PaneColumn" Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListView x:Name="Panes" SelectionMode="Single" SelectionChanged="OnPaneChanged" ItemClick="OnPaneClicked" IsItemClickEnabled="True"
                Margin="-12,0,0,0" AutomationProperties.Name="{x:Bind app:T.SettingsPanesLabel}" />
      <ScrollViewer x:Name="CardScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <!-- One width for every pane, up to 760, so the cards never change width between panes or
             as what they say changes. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="760" />
          </Grid.ColumnDefinitions>
          <local:StateHost x:Name="State" Padding="0,0,12,24">
            <StackPanel x:Name="Cards" Spacing="4" />
          </local:StateHost>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
