<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kaeri.Windows.CoverGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kaeri.Windows"
    xmlns:app="using:Kaeri.App">
  <!-- A poster grid: covers 150 wide at 2:3, as many columns as fit with 16 between, the title in
       Zen Kaku 15 and one caption line in haze under each. The title keeps two lines
       whether it needs them or not, so every cell is one height and none is cut. -->
  <ItemsView x:Name="Items" SelectionMode="None" IsItemInvokedEnabled="True" ItemInvoked="OnInvoked"
             TabFocusNavigation="Once">
    <ItemsView.Layout>
      <UniformGridLayout MinItemWidth="150" MinColumnSpacing="16" MinRowSpacing="20" ItemsJustification="Start" />
    </ItemsView.Layout>
    <ItemsView.ItemTemplate>
      <DataTemplate x:DataType="local:CoverItem">
        <!-- The words are bound one way: a newer record of the same title changes them in the
             cell that stands, so nothing is made again. The menu is made as it opens. -->
        <ItemContainer AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" CornerRadius="8" Tag="{x:Bind Id}" Loaded="OnCoverLoaded">
          <StackPanel Width="150" Spacing="2" Padding="0,0,0,6">
            <Grid Tag="cover" Width="150" Height="225" CornerRadius="8" Background="{x:Bind Placeholder}" Margin="0,0,0,6">
              <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource ShowTitleStyle}" MaxLines="2" TextWrapping="WrapWholeWords"
                       LineHeight="20" LineStackingStrategy="BlockLineHeight" Height="40" />
            <TextBlock Text="{x:Bind Count, Mode=OneWay}" Visibility="{x:Bind CountShown, Mode=OneWay}" Style="{StaticResource HazeCaptionStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Caption, Mode=OneWay}" Style="{StaticResource HazeCaptionStyle}" />
          </StackPanel>
        </ItemContainer>
      </DataTemplate>
    </ItemsView.ItemTemplate>
  </ItemsView>
</UserControl>
