settings-summary-chapters-on = Yeni bölümler açık
settings-summary-chapters-off = Yeni bölümler kapalı
settings-summary-book-folders = { $n ->
    [one] 1 klasör
   *[other] { $n } klasör
 }
settings-summary-book-servers = { $n ->
    [one] 1 sunucu
   *[other] { $n } sunucu
 }
settings-summary-book-plugins = { $n ->
    [one] 1 { -plugin }
   *[other] { $n } { -plugin }
 }
settings-book-sources = Kitap { -source-pl }ı
book-matches-line = { $n ->
    [one] { -app-name }, { $matched } seriyi ayrıntılarına göre eşleştirdi. Şu seriye bir bakmak gerekiyor.
   *[other] { -app-name }, { $matched } seriyi ayrıntılarına göre eşleştirdi. Şu { $n } seriye bir bakmak gerekiyor.
 }
book-folder-failed = Bu klasör eklenemedi. Başka bir klasör deneyin.
book-server-note-device = { -app-name } okuma ilerlemenizi bu sunucuya geri gönderir. Parola bu { -device }da kalır.
