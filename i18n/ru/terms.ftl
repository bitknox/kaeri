# The product name. It is never translated.
-app-name = Kaeri

# A site or feed Kaeri reads episodes from. Never "provider".
-source = источник
-source-cap = Источник
-source-pl = источники
-source-cap-pl = Источники

# A WebAssembly add-on that supplies a source.
-plugin = плагин
-plugin-cap = Плагин
-plugin-pl = плагины
-plugin-cap-pl = Плагины

# The invite-based list plugins are installed from.
-plugin-store = магазин плагинов
-plugin-store-cap = Магазин плагинов
-plugin-store-pl = магазины плагинов
-plugin-store-cap-pl = Магазины плагинов

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = магазин
-store-cap = Магазин

# Shows you have saved, with status.
-library = библиотека
-library-cap = Библиотека

# AniList, Kitsu and similar accounts Kaeri updates.
-tracker = трекер
-tracker-cap = Трекер
-tracker-pl = трекеры
-tracker-cap-pl = Трекеры

# Watching in sync with other people. Never "watch together".
-watch-party = совместный просмотр
-watch-party-cap = Совместный просмотр
-watch-party-pl = совместные просмотры
-watch-party-cap-pl = Совместные просмотры

# The name of the place that starts and joins watch parties.
-watch-together-cap = Смотреть вместе

# Where releases are looked up.
# One downloadable file in a torrent index. Not a place episodes come from.
-release = релиз
-release-cap = Релиз
-release-pl = релизы
-release-cap-pl = Релизы

# One release that holds many episodes.
-batch = пакет
-batch-cap = Пакет

# A phone, tablet, TV or computer running Kaeri.
-device = устройство
-device-cap = Устройство
-device-pl = устройства
-device-cap-pl = Устройства

# The button that resumes the show.
-continue = продолжить просмотр
-continue-cap = Продолжить просмотр

# The button that resumes a book, manga or webtoon: reading's own form of { -continue }. English says continue for both; a language whose { -continue } means "continue watching" says "keep reading" here.
-continue-reading = читать дальше
-continue-reading-cap = Читать дальше

# The button that goes on to the next step of a flow, such as setup. Not the button that resumes a
# show; that is { -continue }.
-proceed = продолжить
-proceed-cap = Продолжить

# The episode that plays after this one.
-up-next = далее
-up-next-cap = Далее

# The audio setting's two values.
-subbed = с субтитрами
-subbed-cap = С субтитрами
-dubbed = с дубляжом
-dubbed-cap = С дубляжом
