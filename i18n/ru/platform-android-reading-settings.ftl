settings-summary-chapters-on = Новые главы включены
settings-summary-chapters-off = Новые главы выключены
settings-summary-book-folders = { $n ->
    [one] { $n } папка
    [few] { $n } папки
    [many] { $n } папок
   *[other] { $n } папки
 }
settings-summary-book-servers = { $n ->
    [one] { $n } сервер
    [few] { $n } сервера
    [many] { $n } серверов
   *[other] { $n } сервера
 }
settings-summary-book-plugins = { $n ->
    [one] { $n } { -plugin }
    [few] { -plugin-cap-pl }: { $n }
    [many] { -plugin-cap-pl }: { $n }
   *[other] { -plugin-cap-pl }: { $n }
 }
settings-book-sources = { -source-cap-pl } книг
book-matches-line = { $n ->
    [one] { -app-name } сопоставил по данным: { $matched }. { $n } серию нужно проверить.
    [few] { -app-name } сопоставил по данным: { $matched }. { $n } серии нужно проверить.
    [many] { -app-name } сопоставил по данным: { $matched }. { $n } серий нужно проверить.
   *[other] { -app-name } сопоставил по данным: { $matched }. { $n } серии нужно проверить.
 }
book-folder-failed = Не удалось добавить эту папку. Попробуйте другую.
book-server-note-device = { -app-name } отправляет ваш прогресс чтения обратно на этот сервер. Пароль хранит только это { -device }.
