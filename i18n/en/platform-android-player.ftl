## Android: the player's starting screen.

# Details row on the starting screen once the title has been looked up.
# @only android
# @max 40
android-start-title-looked-up = Looked up the title

# Spoken once by the screen reader when a start has gone on for a while. It names the button that appears.
# @only android
# @max 80
android-start-still-starting = Still starting. Choose { -source } is available.
