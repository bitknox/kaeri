## First launch: the welcome pages. Plugin risk copy is plugin-risk-warning in ui-sources.
## Signing in on the welcome page uses accounts-welcome-detail and accounts-sign-in-to in ui-tracking.

# Title of the welcome window.
onboarding-welcome = Welcome

# Title of the first page.
onboarding-welcome-to = Welcome to { -app-name }

# Line under the title.
onboarding-tagline = Keep track of anime and play it from your own { -source-pl }.

# Button that goes to the next page.
# @max 24
onboarding-continue = { -proceed-cap }

# Button that skips a page.
# @max 24
onboarding-skip = Skip

# Button that skips a page for now.
# @max 24
onboarding-skip-for-now = Skip for now

# Button that declines the sign-in page for now.
# @max 24
onboarding-not-now = Not now

# Heading of the page about sources.
onboarding-sources-title = { -source-cap-pl }

# Line under it.
onboarding-sources-detail = Join a { -plugin-store } with an invite from its owner.

# Button that joins a store from the welcome page.
# @max 24
onboarding-join = Join

# Hint inside the invite field on the welcome page.
onboarding-invite-hint = Invite link

# Heading of the page about where episodes come from.
onboarding-where-title = Where episodes come from

# Line under it on a computer.
onboarding-where-hosts = { -app-name } plays what you already have: files on this { -device }, your Jellyfin server, and { -plugin-pl } from stores you join.

# Heading of the group that adds the viewer's own media.
onboarding-own-heading = Have your own media?

# Heading of the group that joins a store with an invite.
onboarding-invite-heading = Have an invite link?

# Second line of that page. Explains that plugins come from plugin stores and that a store is joined with an invite link.
onboarding-where-stores = { -plugin-cap-pl } come from { -plugin-store-pl }. Each one is signed and gives every { -device } its own token, which is why you join with an invite link from its owner.

# Heading above the Play the demo button on the welcome page.
onboarding-demo-heading = Try it now

# Line under that heading. Names the demo work and its licence.
onboarding-demo-detail = The demo plays こうしす！, a series its makers share under CC BY 4.0, from Wikimedia Commons.

# Button on the welcome page that plays the demo at once.
# @max 24
onboarding-play-demo = Play the demo

# TV only. Button that shows a code to scan with a phone to send an invite link.
onboarding-invite-scan = Scan with your phone

# TV only. Button that opens a field to type an invite link.
onboarding-invite-type = Type the link


# Text of the last welcome page, where the device cannot read folders.
onboarding-where-hosts-mobile = { -app-name } plays what you already have: your Jellyfin server, and { -plugin-pl } from { -plugin-store-pl } you join.
