## First run's join page on Android phones, tablets and TVs: the words the paired view needs
## beyond the ones every platform shares.

# Join page, paired view: the line under "Kaeri is for" when the other device's answer is Watch.
# @only android
# @arg device: text
join-medium-line-watch = Watching, as on { $device }

# Join page, paired view: the line under "Kaeri is for" when the other device's answer is Both.
# @only android
# @arg device: text
join-medium-line-both = Watching and reading, as on { $device }

# Join page, paired view: where this device keeps a book server's key, filling $store in "kept in { $store }".
# @only android
join-key-store = Android’s keystore
