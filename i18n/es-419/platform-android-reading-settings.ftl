settings-summary-chapters-on = Capítulos nuevos activados
settings-summary-chapters-off = Capítulos nuevos desactivados
settings-summary-book-folders = { $n ->
    [one] 1 carpeta
    [many] { $n } carpetas
   *[other] { $n } carpetas
 }
settings-summary-book-servers = { $n ->
    [one] 1 servidor
    [many] { $n } servidores
   *[other] { $n } servidores
 }
settings-summary-book-plugins = { $n ->
    [one] 1 { -plugin }
    [many] { $n } { -plugin-pl }
   *[other] { $n } { -plugin-pl }
 }
settings-book-sources = { -source-cap-pl } de libros
book-matches-line = { $n ->
    [one] { -app-name } identificó { $matched } por sus detalles. Esta necesita revisión.
    [many] { -app-name } identificó { $matched } por sus detalles. Estas { $n } necesitan revisión.
   *[other] { -app-name } identificó { $matched } por sus detalles. Estas { $n } necesitan revisión.
 }
book-folder-failed = No se pudo agregar esa carpeta. Prueba con otra.
book-server-note-device = { -app-name } envía tu progreso de lectura a este servidor. La contraseña se queda en este { -device }.
