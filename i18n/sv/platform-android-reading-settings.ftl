settings-summary-chapters-on = Nya kapitel på
settings-summary-chapters-off = Nya kapitel av
settings-summary-book-folders = { $n ->
    [one] 1 mapp
   *[other] { $n } mappar
 }
settings-summary-book-servers = { $n ->
    [one] 1 server
   *[other] { $n } servrar
 }
settings-summary-book-plugins = { $n ->
    [one] 1 { -plugin }
   *[other] { $n } { -plugin-pl }
 }
settings-book-sources = { -source-cap-pl } för böcker
book-matches-line = { $n ->
    [one] { -app-name } matchade { $matched } utifrån deras detaljer. Den här behöver granskas.
   *[other] { -app-name } matchade { $matched } utifrån deras detaljer. De här { $n } behöver granskas.
 }
book-folder-failed = Mappen kunde inte läggas till. Prova en annan.
book-server-note-device = { -app-name } skickar tillbaka ditt läsförlopp till servern. Lösenordet stannar på den här { -device }en.
