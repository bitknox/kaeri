settings-summary-chapters-on = Nowe rozdziały włączone
settings-summary-chapters-off = Nowe rozdziały wyłączone
settings-summary-book-folders = { $n ->
    [one] 1 folder
    [few] { $n } foldery
    [many] { $n } folderów
   *[other] { $n } folderu
 }
settings-summary-book-servers = { $n ->
    [one] 1 serwer
    [few] { $n } serwery
    [many] { $n } serwerów
   *[other] { $n } serwera
 }
settings-summary-book-plugins = { $n ->
    [one] 1 { -plugin }
    [few] { $n } { -plugin-pl }
    [many] { -plugin-cap-pl }: { $n }
   *[other] { -plugin-cap-pl }: { $n }
 }
settings-book-sources = { -source-cap-pl } książek
book-matches-line = { $n ->
    [one] Dopasowane przez { -app-name } na podstawie danych: { $matched }. Ta jedna wymaga sprawdzenia.
    [few] Dopasowane przez { -app-name } na podstawie danych: { $matched }. Te { $n } wymagają sprawdzenia.
    [many] Dopasowane przez { -app-name } na podstawie danych: { $matched }. Tych { $n } wymaga sprawdzenia.
   *[other] Dopasowane przez { -app-name } na podstawie danych: { $matched }. Te { $n } wymagają sprawdzenia.
 }
book-folder-failed = Nie udało się dodać tego folderu. Spróbuj innego.
book-server-note-device = { -app-name } odsyła postęp czytania na ten serwer. Hasło przechowuje wyłącznie to { -device }.
