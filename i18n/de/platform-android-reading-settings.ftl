settings-summary-chapters-on = Neue Kapitel an
settings-summary-chapters-off = Neue Kapitel aus
settings-summary-book-folders = { $n ->
    [one] 1 Ordner
   *[other] { $n } Ordner
 }
settings-summary-book-servers = { $n ->
    [one] 1 Server
   *[other] { $n } Server
 }
settings-summary-book-plugins = { $n ->
    [one] 1 { -plugin }
   *[other] { $n } { -plugin-pl }
 }
settings-book-sources = { -source-cap-pl } für Bücher
book-matches-line = { $n ->
    [one] { -app-name } hat { $matched } anhand ihrer Details zugeordnet. Diese eine muss noch geprüft werden.
   *[other] { -app-name } hat { $matched } anhand ihrer Details zugeordnet. Diese { $n } müssen noch geprüft werden.
 }
book-folder-failed = Dieser Ordner ließ sich nicht hinzufügen. Versuche einen anderen.
book-server-note-device = { -app-name } sendet deinen Lesefortschritt zurück an diesen Server. Das Passwort bleibt auf diesem { -device }.
