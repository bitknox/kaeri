settings-summary-chapters-on = Nuovi capitoli attivi
settings-summary-chapters-off = Nuovi capitoli disattivati
settings-summary-book-folders = { $n ->
    [one] 1 cartella
    [many] { $n } cartelle
   *[other] { $n } cartelle
 }
settings-summary-book-servers = { $n ->
    [one] 1 server
    [many] { $n } server
   *[other] { $n } server
 }
settings-summary-book-plugins = { $n ->
    [one] 1 { -plugin }
    [many] { $n } { -plugin-pl }
   *[other] { $n } { -plugin-pl }
 }
settings-book-sources = { -source-cap-pl } di libri
book-matches-line = { $n ->
    [one] { -app-name } ne ha abbinate { $matched } in base ai dettagli. Questa va controllata.
    [many] { -app-name } ne ha abbinate { $matched } in base ai dettagli. Queste { $n } vanno controllate.
   *[other] { -app-name } ne ha abbinate { $matched } in base ai dettagli. Queste { $n } vanno controllate.
 }
book-folder-failed = Impossibile aggiungere quella cartella. Provane un'altra.
book-server-note-device = { -app-name } invia i tuoi progressi di lettura a questo server. La password resta su questo { -device }.
