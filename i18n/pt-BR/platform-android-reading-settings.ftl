settings-summary-chapters-on = Capítulos novos ativados
settings-summary-chapters-off = Capítulos novos desativados
settings-summary-book-folders = { $n ->
    [one] { $n } pasta
    [many] { $n } pastas
   *[other] { $n } pastas
 }
settings-summary-book-servers = { $n ->
    [one] { $n } servidor
    [many] { $n } servidores
   *[other] { $n } servidores
 }
settings-summary-book-plugins = { $n ->
    [one] { $n } { -plugin }
    [many] { $n } { -plugin-pl }
   *[other] { $n } { -plugin-pl }
 }
settings-book-sources = { -source-cap-pl } de livros
book-matches-line = { $n ->
    [one] O { -app-name } identificou { $matched } pelos dados. Falta conferir { $n }.
    [many] O { -app-name } identificou { $matched } pelos dados. Estas { $n } precisam ser conferidas.
   *[other] O { -app-name } identificou { $matched } pelos dados. Estas { $n } precisam ser conferidas.
 }
book-folder-failed = Não foi possível adicionar essa pasta. Tente outra.
book-server-note-device = O { -app-name } envia seu progresso de leitura de volta a este servidor. A senha fica neste { -device }.
