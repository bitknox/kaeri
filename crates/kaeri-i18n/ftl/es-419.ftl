# Under a suggestion that airs later today when no episode number is known: the time it airs.
up-next-airs-at = Se emite a las { $time }

# Accessible name of a progress bar on a row that has no better name, such as a download's.
progress-name = Progreso

# What a screen reader says for a progress bar's value.
progress-percent = { $percent } por ciento

# Accessible name of a grid of show covers.
poster-grid-name = Títulos

# Line under the title of the last welcome page: what the app plays, without a promise of its own.
onboarding-where-hosts-linux = Kaeri reproduce lo que ya tienes: archivos de este dispositivo, tu servidor Jellyfin y complementos de las tiendas de complementos a las que te unes.

# Words before the link on the empty Sources page.
sources-empty-or = O

# A folder's line once it is read.
library-row-summary-linux =
    { $episodes ->
        [one] 1 episodio de { $series } series
        [many] { $episodes } episodios de { $series } series
       *[other] { $episodes } episodios de { $series } series
    }

# A folder page's line when changes are noticed as they happen.
library-page-watching-linux = Se vigilan los cambios

# A folder page's line when changes are found only when the app starts or is asked.
library-page-no-watch-linux = Se revisa si hay cambios al iniciar Kaeri

# Heading over the matched series.
library-matched-linux = Con coincidencia

# Row line for a series in Needs a look: the title found, if any.
library-best-guess-linux = Mejor opción: { $title }

# Line on a result in the match picker whose episode count does not fit the folder's files.
library-fix-count-mismatch-linux =
    { $episodes ->
        [one] Tiene 1 episodio, esta carpeta tiene { $files }
        [many] Tiene { $episodes } episodios, esta carpeta tiene { $files }
       *[other] Tiene { $episodes } episodios, esta carpeta tiene { $files }
    }

# Header title on a terminal too narrow for the rail: the product name, then the section on screen.
chrome-header-section = Kaeri · { $section }

# Header chip while the metadata sources are degraded. The mark is a status glyph. Shown beside the { -source } chips, which are short.
chrome-meta-chip = Metadatos { $mark }

# Activity row: how many more running jobs there are than fit. It follows the last job shown.
chrome-activity-more = +{ $count }

# Activity row: a running job that is held up (a rate-limit pause), with the wait counting down. The note says what it waits on; the countdown is a clock such as 0:12.
chrome-job-held = { $note }, { $countdown }

# Heading of an overlay that lists the lines of a long table: which lines are in view.
overlays-window-position = { $from }–{ $to } de { $total }

# Heading of the help overlay when its table does not fit on one page.
overlays-help-page = Página { $page } de { $pages }

# The log overlay, when nothing has been logged this session.
overlays-logs-empty = Nada registrado todavía

# Prompt hint under the manual search heading. The footer names its keys.
overlays-hint-manual-query = Escribe lo que quieres buscar, o déjalo vacío para la coincidencia automática.

# Prompt hint for the first step of signing in to Kitsu.
overlays-hint-kitsu-username = Correo o nombre de usuario.

# Prompt hint for the second step of signing in to Kitsu. The password is shown as dots.
overlays-hint-kitsu-password = Tu contraseña se cambia por un token y no se guarda.

# Prompt hint for the download range. The examples are episode numbers and stay as written.
overlays-hint-download-range = 4 para un episodio, 1-12 para un rango, 7- para todo desde ahí.

# Prompt hint for editing a setting: its label on the Settings screen. The footer names the keys.
overlays-hint-edit-setting = Escribe un valor nuevo para { $setting }.

# Prompt hint for joining a { -plugin-store }.
overlays-hint-join-store = Pega la invitación o el enlace de la tienda que te compartieron.

# Prompt hint for naming the person an invite link is for.
overlays-hint-invite-name = Su nombre, tal como lo mostrará la lista de miembros.

# Overlay heading after the title: the plugin's version and the { -plugin-store } it comes from. The plugin's name leads the heading.
overlays-heading-plugin = { $name } { $version } · de { $store }

# Overlay heading, after the title "Invite link": whom the link is for.
overlays-heading-invite-for = Para { $name }

# Title of the invite link overlay when the link is not for a named person.
overlays-title-link-device = Enlazar otro dispositivo

# Overlay heading, after the title of the store's link: which { -plugin-store } it opens.
overlays-heading-open-link-of = { $store }

# Overlay heading, after the title of the publish list: where the plugin goes.
overlays-heading-publish-to = A { $store }

# Overlay heading, after the title "Which one": the title being matched.
overlays-heading-disambiguate = Coincidencia para { $name }

# Overlay heading, after the title "Watch order": the title the order is built around.
overlays-heading-watch-order = Alrededor de { $name }

# Overlay heading, after the title "Recommended": the title the list came from.
overlays-heading-recommendations = Porque te gustó { $name }

# Overlay heading, after the title of the release list.
overlays-heading-release = Las otras fuentes completan lo que falta.

# Overlay heading, after the title of the { -source } list: the choice is kept for this title.
overlays-heading-source = { $name }

# Overlay heading, after the title of the releases list: the episode it is for.
overlays-heading-releases = Episodio { $episode }. Enter reproduce tu elección.

# Same, when no episode is known.
overlays-heading-releases-bare = Enter reproduce tu elección.

# Toast: a download that is finished cannot be cancelled, only deleted. The key is the delete key.
toast-download-done = Ya descargado. Presiona { $delete } para borrarlo y su archivo.

# Toast: a command needs a title and none is selected.
toast-nothing-selected = No hay nada seleccionado. Elige un título primero.

# Toast: the download-range key was pressed away from the episode table.
toast-ranges-elsewhere = Los rangos se ponen en cola desde la tabla de episodios.

# Toast: the filter key was pressed on a screen without filters.
toast-filters-elsewhere = Los filtros están en la búsqueda y en la tabla de episodios.

# Toast: a watched-mark key was pressed away from the episode table.
toast-watched-elsewhere = Las marcas de visto están en la tabla de episodios.

# Toast: Back was pressed at the top of a section. The key is the quit key.
toast-at-top = Ya estás arriba. Presiona { $quit } para salir.

# Toast: an action was run that does nothing on this screen. The action is its label, such as "Mark all previous watched"; the place says where it works, such as "in the episode table".
toast-works-elsewhere = { $action } funciona { $place }.

# Toast: the bug report is being opened.
toast-bug-report-opening = Abriendo un reporte de error en tu navegador. El enlace está en el registro.

# Log line holding the whole bug report link, for a terminal that cannot open it.
tui-log-bug-report-link = Reporte de error: { $url }

# Toast: a key binding in the config file was refused. The problem says which and why.
toast-keybinding-not-applied = Atajo de teclado no aplicado: { $problem }. Revisa la sección de teclas del archivo de configuración.

# Standing notice: the config file did not load. The problem is the parser's own text.
tui-config-problem = { $file }: { $what }. Se usan los valores predeterminados hasta que se corrija.

# Same, when the problem is on a known line.
tui-config-problem-at-line = { $file }, línea { $line }: { $what }. Se usan los valores predeterminados hasta que se corrija.

# Log line for the same problem. The path is the whole path of the config file.
tui-config-problem-logged = { $path }: { $problem }. Se usan los valores predeterminados.

# The status line at the foot of the screen when nothing is being said: the source in use, the audio and the quality.
chrome-status-state = { $source } · { $audio } · { $quality }p

# Heading of the title page when no title is highlighted.
title-heading = Título

# Under the heading of the title page and the episode table when no title is highlighted.
title-nothing-selected-note = Nada seleccionado

# Toast when a title action is asked for and no title is highlighted.
title-nothing-selected = No hay nada seleccionado. Selecciona un título y vuelve a intentarlo.

# Toast when something that needs a title's full page is asked from a list.
title-trailer-off-page = Abre la página del título para encontrar su tráiler.

# Toast when something that needs a title's full page is asked from a list.
title-recommendations-off-page = Abre la página del título para ver sus recomendaciones.

# Toast when something that needs a title's full page is asked from a list.
title-seasons-off-page = Abre la página del título para ver sus temporadas relacionadas.

# Toast when a title has no trailer on record.
title-no-trailer = No hay ningún tráiler registrado para este título.

# Toast when a title has no recommendations.
title-no-recommendations = No hay recomendaciones para este título.

# Toast when a title has no connected seasons.
title-no-seasons = No hay temporadas relacionadas para este título.

# Toast when the { -source } picker is asked for from a list.
title-pin-off-page = Abre la página del título para elegir una fuente.

# Toast when the { -source } picker is asked for and no { -source } is registered. They register a moment after launch.
title-no-sources-yet = Las fuentes todavía se están cargando. Inténtalo de nuevo en un momento.

# Toast when a list status or rating is asked for and no { -tracker } is signed in. The command is typed as it is.
title-status-needs-tracker = Tu estado en la lista se guarda en un servicio de seguimiento, y no hay ninguno con sesión iniciada. Usa :accounts para iniciar sesión en uno.

# Toast when a rating is asked for and no { -tracker } is signed in. The command is typed as it is.
title-rating-needs-tracker = Las calificaciones se guardan en un servicio de seguimiento, y no hay ninguno con sesión iniciada. Usa :accounts para iniciar sesión en uno.

# Toast after a list status is picked. The status is one of the status names; the trackers are a comma separated list.
title-status-set = Estado cambiado a { $status }. En cola para { $trackers }.

# Toast after a rating is picked.
title-rated = Calificado con { $score }/10. En cola para { $trackers }.

# List status in the status picker and in the toast after picking one.
title-status-watching = Viendo

# List status in the status picker and in the toast after picking one.
title-status-planning = Por ver

# List status in the status picker and in the toast after picking one.
title-status-completed = Completado

# List status in the status picker and in the toast after picking one.
title-status-paused = En pausa

# List status in the status picker and in the toast after picking one.
title-status-dropped = Abandonado

# Beside the Completed status in the status picker, when the title has progress: what choosing it does.
