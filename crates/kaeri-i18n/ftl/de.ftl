# Line over the code to type.
tv-or-enter-code = Oder gib diesen Code ein

# Line naming this TV on that screen.
tv-this-tv = Dieser Fernseher: { $name }, { $address }

# Line: how often the code changes.
tv-code-changes = Der Code ändert sich alle 5 Minuten.

# Title of the question on the TV when a phone asks to pair.
tv-pair-request = Mit { $name } koppeln?

# Line under it.
tv-pair-request-detail = Gib diesen Code auf dem Telefon ein.

# Line on the TV after a phone paired. The name is a phone name.
tv-phone-paired = { $name } ist gekoppelt

# Title of the confirmation on the TV that removes a phone.
tv-remove-phone-title = { $name } entfernen?

# Line under it.
tv-remove-phone-detail = Es funktioniert dann nicht mehr als Fernbedienung für diesen Fernseher. Es kann mit einem neuen Code erneut gekoppelt werden.

# Heading of the settings group on the TV that lists the remotes.
tv-remotes = Fernbedienungen

# Row title of the button that pairs another TV once one is paired.
tv-another = Anderer Fernseher

# Under a TV in the list: its version does not match.
tv-row-needs-update = Braucht dieselbe Version von Kaeri wie dein Gerät

# Title of the remote's volume row.
tv-volume = Lautstärke des Fernsehers

# Heading of the Play on TV group that lists TVs with Chromecast built in, below the TVs that run the app. A product name: keep it as it is.
tv-cast-group = Chromecast

# Line under the empty state of Play on TV when no TV was found: casting looks for these too.
tv-cast-none-found = Fernseher mit eingebautem Chromecast erscheinen hier auch.

# Status line of the casting card while a cast takes a while to start: the line, then the seconds since the TV was picked.
tv-cast-counting = { $line } · { $seconds } s

# Status line of the casting card when the cast didn't start. The reason shows under the episode.
tv-cast-couldnt-start = Start auf { $name } nicht möglich

# Status line of the casting card after the TV stopped answering.
tv-cast-stopped = Übertragung beendet

# Button on the casting card: stop casting and play the episode on this device, from where the TV was.
tv-cast-play-here = Hier abspielen

# Button on the casting card: stop casting. The TV goes back to what it showed.
tv-cast-stop = Übertragung beenden

# Button on the casting card's TV volume row: silence the TV.
tv-cast-mute = Stummschalten

# The same button while the TV is silenced.
tv-cast-unmute = Ton einschalten

# Under the TV volume row on the casting card, for a TV whose volume is set with its own remote.
tv-cast-volume-on-tv = Am Fernseher eingestellt

# Line over the next episode on the casting card while its count runs. At 0 the TV plays it.
tv-cast-up-next-in = Als Nächstes · startet in { $seconds } s

# Line under the paired TVs.
tv-forget-note = Wenn du hier einen Fernseher vergisst, vergisst er auch dieses Gerät.

# Heading of the update row in settings and about.
updates-title = Updates

# Line while the app checks.
updates-checking = Suche nach einer neueren Version…

# Line when the app is current.
updates-up-to-date = Auf dem neuesten Stand

# Line when there is no connection to check.
updates-checks-online = Prüft, sobald du wieder online bist

# Line before the first check.
updates-not-checked = Noch nicht geprüft

# Line when the check failed. The reason starts with a capital.
updates-check-failed = Prüfung fehlgeschlagen: { $reason }

# Line when the check failed on the phone. The reason is already a sentence.
updates-not-checked-because = Nicht geprüft. { $reason }

# Line describing the schedule.
updates-schedule = Einmal am Tag. Nichts wird heruntergeladen, bevor du ein Update wählst.

# Line when the package manager updates the app.
updates-managed = Updates kommen von deiner Paketverwaltung.

# Line when Flatpak updates the app.
updates-flatpak = Flatpak hält Kaeri auf dem neuesten Stand.

# Line when a version is out.
updates-version-out = Version { $version } ist da

# Line when a version is out and the software centre installs it.
updates-version-out-software = Version { $version } ist da. Die Softwareverwaltung installiert sie.

# Line when a version is out and its page has the installer.
updates-version-out-page = Version { $version } ist da. Ihre Seite enthält das Installationsprogramm.

# Line when a version is out and its page has the AppImage.
updates-version-out-appimage = Version { $version } ist da. Ihre Seite enthält das AppImage.

# Title of the offer card.
updates-available = Kaeri { $version } ist verfügbar

# Banner on the TV pointing to the update.
updates-available-tv = Update verfügbar: Kaeri { $version }. Einstellungen › Über

# Button that starts the update.
updates-update-to = Auf { $version } aktualisieren

# Line on the TV: the version now installed.
updates-this-has = Dieser Fernseher hat { $version }

# Line when the notes are on the release page.
updates-notes-on-page = Die Hinweise zu dieser Version stehen auf ihrer Seite.

# Line when this build cannot update itself.
updates-no-self-update = Diese Version aktualisiert sich nicht selbst. Installiere die neue Version von ihrer Seite.

# Line on the TV: Android asks first.
updates-android-asks = Nichts wird installiert, bevor Android dich um Bestätigung bittet.

# Line on the phone: the release page opens.
updates-opens-page = Öffnet die Seite dieser Version

# Line while downloading, with the version.
updates-downloading = Lädt Version { $version } herunter

# Line while downloading, with progress. Sizes are already formatted.
updates-downloading-size = Lädt Version { $version } herunter · { $done } von { $total }

# Line while downloading, with a percentage.
updates-downloading-percent = Lädt { $percent } herunter

# Line while downloading, with a percentage and sizes.
updates-downloading-full = Lädt herunter · { $percent } · { $done } von { $total }

# Line while the download is about to start.
updates-starting-download = Download startet

# Line while the download is checked.
updates-checking-download = Download der Version { $version } wird geprüft…

# Short line while the download is checked.
updates-checking-download-short = Download wird geprüft

# Line when the download is ready.
updates-ready = Version { $version } ist bereit zur Installation

# Line while installing.
updates-installing = Version { $version } wird installiert…

# Line after Android is asked to install.
updates-confirm-on-android = Android fragt, ob das Update installiert werden soll. Bestätige auf seinem Bildschirm. Deine Anmeldungen, Listen und Einstellungen bleiben erhalten.

# Line after the update: when it opens.
updates-updated-tv = Auf { $version } aktualisiert. Es öffnet sich beim nächsten Start von Kaeri.

# Notice after restarting into the new version.
updates-updated = Auf Version { $version } aktualisiert

# Short line after the update on a phone.
updates-opens-next-time = Die neue Version öffnet sich beim nächsten Mal

# Line when the update stopped.
updates-stopped = Das Update auf Version { $version } wurde gestoppt. { $reason }

# Notice when the new version did not install.
updates-did-not-install = Version { $version } wurde nicht installiert. Versuch es erneut unter Über.

# Button that opens About.
updates-open-about = Über öffnen

# Line on Linux when the file is saved to the downloads folder.
updates-saved = Version { $version } in den Downloads gespeichert

# Line on Linux telling what to replace.
updates-saved-replace = Version { $version } in den Downloads gespeichert. Ersetze die alte Datei { $file } durch sie, um zu aktualisieren.

# Line on Linux telling what to replace, file unknown.
updates-saved-replace-plain = Version { $version } in den Downloads gespeichert. Ersetze die alte Datei durch sie, um zu aktualisieren.

# The server refused. The code is a number.
updates-why-server = Der Download wurde abgebrochen: Der Server hat ihn abgelehnt ({ $code }). Versuch es später noch einmal.

# The connection broke.
updates-why-connection = Der Download wurde abgebrochen: Die Verbindung ist verloren gegangen. Versuch es noch einmal.

# The file could not be saved. The reason is a sentence fragment.
updates-why-save = Der Download konnte nicht gespeichert werden: { $reason }

# The file has the wrong size. Sizes are already formatted.
updates-why-size = Die Datei ist { $got } groß, nicht { $expected }, wie für diese Version angegeben.

# The file does not match its checksum.
updates-why-checksum = Der Download stimmt nicht mit der Prüfsumme überein, die für diese Version angegeben ist.

# Android: the file does not match its checksum, and nothing was installed.
updates-why-checksum-android = Der Download stimmt nicht mit der Prüfsumme überein, die für diese Version angegeben ist. Deshalb wurde er nicht installiert.

# Android: not an app.
updates-why-not-app = Der Download ist keine Android-App und wurde deshalb nicht installiert.

# Android: another app.
updates-why-other-app = Der Download ist eine andere App und wurde deshalb nicht installiert.

# Android: not signed with the right key.
updates-why-unsigned = Der Download ist nicht mit dem Schlüssel von Kaeri signiert und wurde deshalb nicht installiert.

# Android: not newer.
updates-why-not-newer = Der Download ist nicht neuer als diese Version und wurde deshalb nicht installiert.

# Android: no space.
updates-why-space = Nicht genug freier Speicher für das Update. Gib etwas frei und versuch es erneut.

# Android: install failed.
updates-why-install = Das Update konnte nicht installiert werden. Versuch es erneut.

# Android: the download did not work.
updates-why-download = Das Update konnte nicht heruntergeladen werden. Prüfe die Verbindung und versuch es erneut.

# Android: the download did not start.
updates-why-start = Der Download konnte nicht gestartet werden. Versuch es erneut.

# Android: the system stopped the download.
updates-why-system = Android hat den Download gestoppt

# The installer would not start. The reason is a sentence fragment.
updates-why-installer = Das Installationsprogramm konnte nicht starten: { $reason }

# Title of the step.
updates-allow-title = Kaeri erlauben, sein Update zu installieren

# Name of the Android setting.
updates-unknown-apps = Unbekannte Apps installieren

# Step one.
updates-allow-step-1 = Wähle „Einstellungen öffnen“. Android zeigt die Apps, die andere Apps installieren dürfen.

# Step two.
updates-allow-step-2 = Schalte Kaeri ein.

# Step three.
updates-allow-step-3 = Drück auf Zurück. Das Update wird heruntergeladen, und Android bittet dich, es zu bestätigen.

# Line while waiting for the switch. The path is the Android settings path.
updates-allow-waiting = Warte auf den Schalter. Wenn sich Androids Seite nicht öffnet, findest du ihn unter { $path }.

# Line the first time. The path is the Android settings path.
updates-allow-once = Android fragt das nur einmal. Wenn sich die Seite nicht öffnet, findest du den Schalter unter { $path }.

# Switch in the Updates section of Settings. Off by default.
updates-beta = Beta-Updates

# Line under the switch.
updates-beta-detail = Jede neue Version bekommen, sobald sie gebaut ist. Ohne das kommen Updates einmal pro Woche.

# Status line on a beta build when beta updates are off: no stable version is newer yet.
updates-stable-behind = Du hast { $version }, eine Beta. Updates gibt es wieder, sobald eine neuere stabile Version erscheint.

# The version in About when the running build is a beta.
updates-version-beta = { $version } Beta

