# The line over Search's results opened by View all on a Finished row: the format and the order. The count follows it: "Finished light novels, most popular · 1,920 series from AniList".
read-view-all-finished-novels = Fertig erschienene Light Novels, am beliebtesten

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Du bist { $store } als { $member } beigetreten.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Du bist { $store } ohne Namen beigetreten.

# Toast after leaving a plugin store.
store-left = Du hast { $store } verlassen. Die Plugins bleiben installiert.

# Toast after a plugin is deleted from this device.
plugin-removed = { $plugin } entfernt.

# Toast after a store owner removes a member.
store-member-removed = Entfernt. Ihre Geräte funktionieren mit diesem Plugin-Store nicht mehr.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Einladung abgebrochen. Der Link funktioniert nicht mehr.

# Toast after cancelling an invite that people joined with.
store-invite-cancelled-kept =
    { $count ->
        [one] Einladung zurückgezogen. Die Person, die beigetreten ist, bleibt Mitglied.
       *[other] Einladung zurückgezogen. Die { $count } Personen, die beigetreten sind, bleiben Mitglieder.
    }

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Jede Person mit dem Link des Plugin-Stores kann jetzt beitreten. Kopiere ihn von der Mitgliederseite.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Ab jetzt können nur eingeladene Personen beitreten.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
        [one] Ab jetzt können nur eingeladene Personen beitreten. Das Gerät, das über den Link beigetreten ist, funktioniert weiter, bis du es entfernst.
       *[other] Ab jetzt können nur eingeladene Personen beitreten. Die { $devices } Geräte, die über den Link beigetreten sind, funktionieren weiter, bis du sie entfernst.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Dieses Gerät funktioniert nicht mehr mit diesem Plugin-Store.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Alle Geräte entfernt, die über den Link beigetreten sind.

# Toast after a plugin is published to a store.
plugin-published = { $plugin } { $version } veröffentlicht.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } wird nicht mehr angeboten.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Die Admin-Seite wurde im Browser geöffnet. Der Link funktioniert einmal und 10 Minuten lang.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Der Browser ließ sich nicht öffnen ({ $reason }). Auf dem Rechner des Plugin-Stores führe „kaeri store admin“ aus, um einen Link auszugeben.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = { $plugin } { $version } installiert, aber Plugins sind in der Reihenfolge der Quellen ausgeschaltet, deshalb wird es nicht verwendet.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = { $plugin } installiert, aber { $id } ist der Name einer eingebauten Quelle, deshalb wurde es nicht geladen.

# Toast after a plugin is installed and ready to use.
plugin-installed = { $plugin } { $version } installiert.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = { $plugin } ist installiert, konnte aber nicht geladen werden. { $reason }

# Toast after a plugin is installed but was built for an older plugin interface, so it was not loaded.
plugin-installed-outdated = { $plugin } wurde installiert, ist aber für eine ältere Version von Kaeri gebaut und muss aktualisiert werden. Frag den Autor nach einem neuen Build.

# Note on the sources screen when plugins were skipped because they were built for an older plugin interface.
plugins-outdated =
    { $count ->
        [one] Ein Plugin wurde für eine ältere Version von Kaeri gebaut und muss aktualisiert werden: { $names }.
       *[other] { $count } Plugins wurden für eine ältere Version von Kaeri gebaut und müssen aktualisiert werden: { $names }.
    }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Plugin-Update bereit: { $names }.
       *[other] Plugin-Updates bereit: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Plugins konnten nicht geladen werden. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Für { $store } ist auf diesem Gerät kein Token gespeichert. Tritt mit einer neuen Einladung erneut bei.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Du bist diesem Plugin-Store nicht mehr beigetreten.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = Der Schlüssel dieses Plugin-Stores auf diesem Gerät ist beschädigt. Verlasse den Plugin-Store und tritt mit einer neuen Einladung erneut bei.

# Error: a store rejected this device's token.
store-device-refused = { $store } akzeptiert dieses Gerät nicht mehr. Tritt mit einer neuen Einladung erneut bei.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = { $store } konnte nicht erreicht werden. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = Du bist { $store } unter { $current } beigetreten, aber der Link zeigt auf { $target }. Wenn der Plugin-Store umgezogen ist, verlasse ihn zuerst und tritt erneut bei.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Du bist { $store } als { $member } beigetreten. Mit diesem Link würdest du ohne deinen Namen erneut beitreten. Deshalb wurde nichts geändert.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } ist nicht der Plugin-Store, den die Einladung nennt ({ $reason }). Du bist nicht beigetreten.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Das Token für diesen Plugin-Store konnte nicht gespeichert werden. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Diese Einladung wurde schon benutzt, abgebrochen oder ist abgelaufen. Frag nach einer neuen.

# Error: the invite was used as many times as it allows.
store-invite-used-up = Diese Einladung ist aufgebraucht. Frag { $owners } nach einer neuen.

# Error: the invite's end date passed.
store-invite-ended = Diese Einladung ist { $when } abgelaufen. Frag { $owners } nach einer neuen.

# Error: an owner cancelled the invite.
store-invite-was-cancelled = Diese Einladung wurde zurückgezogen. Frag { $owners } nach einer neuen.

# Line under any of these when the store has a contact.
store-invite-contact = Kontakt: { $contact }

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Dieser Link lässt niemanden mehr beitreten. Frag den Besitzer des Plugin-Stores nach einem neuen Link oder einer Einladung.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } ist der Name einer eingebauten Quelle, deshalb kann es kein Plugin sein.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } bietet { $plugin } nicht mehr an.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } hat { $plugin } geändert, seit es angezeigt wurde. Schau es dir vor der Installation noch einmal an.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } ist über { $store } installiert, und dieser hält es aktuell.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } erklärt bereits { $plugin }. Entferne zuerst diese Datei, sonst laufen zwei Kopien.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = { $plugin } konnte nicht installiert werden. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = { $plugin } konnte nicht veröffentlicht werden. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } ist nicht mehr im Plugin-Ordner.

# Error: a book source cannot be published to a store whose server is too old to list book sources.
store-takes-no-books = { $store } listet noch keine Buch-Quellen. Der Eigentümer kann den Plugin-Store aktualisieren, um sie hinzuzufügen.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Dieses Gerät ist mit seinem Link bei { $store } beigetreten. Füge auf dem anderen Gerät denselben Link ein.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = Der Plugin-Store hat einen Link geschickt, der sich nicht lesen lässt. Frag den Besitzer, den Plugin-Store zu prüfen. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = Der Plugin-Store hat einen Link mit einem anderen Schlüssel erstellt. Prüfe die Adresse, mit der er gestartet wurde.

# Error: the store's server has no admin page.
store-admin-missing = { $store } hat keine Admin-Seite. Der Server ist vielleicht älter.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } hat einen Admin-Link für eine andere Adresse geschickt.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = Der Server von { $store } ist älter und kann niemanden per Link beitreten lassen. Aktualisiere ihn zuerst.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = { $name } ist ausgeschaltet. Kaeri überspringt es bei der Suche nach Episoden.

# Toast after a source (plugin) is switched on.
source-switched-on = { $name } ist eingeschaltet.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } ist nicht geladen. Prüfe, ob es unter den Quellen installiert ist.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = Dieser Titel verwendet jetzt { $name }.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Diese Auswahl konnte nicht gespeichert werden. { $reason }

# Note on the sources screen: the proxy for torrent traffic failed its check, so torrents wait.
torrent-proxy-waiting = Die Proxy-Prüfung ist fehlgeschlagen. Torrents starten, sobald sie besteht.

# Note on the sources screen: the proxy for torrent traffic hasn't been checked yet.
torrent-proxy-unchecked = Torrents starten, sobald die Proxy-Prüfung besteht.

# Error: the link or file given to open is not a magnet link, an info hash or a torrent file.
torrent-link-unusable = Das ist kein Magnet-Link und keine Torrent-Datei.

# Error: a link the viewer opened can't play or download while torrent playback is off.
torrent-link-playback-off = Schalte die Torrent-Wiedergabe in den Einstellungen ein, um eigene Links abzuspielen.

# Error: the search for what a link the viewer opened is didn't work. The reason comes from the catalogue.
opened-search-failed = Die Suche nach diesem Titel hat nicht geklappt. { $reason }

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = Kaeri wurde geschlossen, bevor die Torrents starteten.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Die Torrent-Sitzung konnte nicht gestartet werden. { $reason }

# Toast when the proxy setting can't be used. The reason comes from the proxy setting.
torrent-proxy-unusable = Die Proxy-Einstellung kann nicht verwendet werden. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on and a proxy set.
sources-reloaded-torrents-checking = Quellen neu geladen. Torrents starten, sobald die Proxy-Prüfung besteht.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrents sind aus. Die Sitzung wurde beendet.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Wartet auf das Anfragelimit von AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Wartet { $wait } wegen des Anfragelimits von AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList antwortet nicht. Vorerst werden Daten von einem anderen Dienst angezeigt.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Kein Metadaten-Dienst hat geantwortet. Gezeigt wird, was zuletzt zwischengespeichert wurde.

# Toast when AniList answers again.
notice-anilist-back = AniList ist wieder da.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Watchpartys sind in dieser App nicht eingebaut.

# Notice after the demo is removed. It offers Undo for 8 seconds.
sources-demo-removed = Demo entfernt

# Notice after the first plugin from a store installs while the demo is on. It offers Remove demo for 8 seconds.
stores-ready-demo-stays = { $store } ist bereit. Die Demo bleibt am Ende von „Deine Quellen“.

# The page the browser shows after signing in to a cloud drive on a computer (Windows, Linux or the terminal), once Kaeri has caught the sign-in. The person goes back to the app by themselves.
cloud-loopback-done = Du kannst diesen Tab schließen und zu Kaeri zurückkehren.

# The error line under Sync on a device that another of the person's devices removed from sync. Joining again, with a code or the recovery key, or setting sync up again adds it as a new device.
sync-device-removed = Dieses Gerät wurde auf einem anderen Gerät aus der Synchronisierung entfernt. Tritt erneut bei, um es zu synchronisieren.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Bei { $tracker } angemeldet.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Bei { $tracker } angemeldet. Das Token liegt im Schlüsselbund des Systems.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Bei { $tracker } angemeldet. Es ist kein Schlüsselbund verfügbar, deshalb liegt das Token in einer privaten Datei auf diesem Gerät.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Bei { $tracker } angemeldet, aber das Token wurde nicht gespeichert. Beim nächsten Mal musst du dich erneut anmelden. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Das Anmelde-Token konnte nicht gespeichert werden. Melde dich erneut an. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Anmeldung bei { $tracker } fehlgeschlagen. Versuche es noch einmal. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = Die Anmeldung bei { $tracker } wurde beendet, bevor sie fertig war. Versuche es noch einmal. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Kein Token von { $tracker } erhalten. Melde dich erneut an. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Für die Anmeldung konnte kein Browser geöffnet werden. Prüfe, ob einer installiert ist, und versuche es erneut. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Eine Anmeldeantwort von { $tracker } ist angekommen, aber keine Anmeldung hat darauf gewartet. Starte die Anmeldung erneut.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = Die Anmeldeantwort von { $tracker } passt nicht zur Anfrage. Starte die Anmeldung erneut.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = Die Anmeldung bei { $tracker } kam ohne Token zurück. Versuche es noch einmal.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Die Anmeldung bei MyAnimeList konnte nicht abgeschlossen werden: Dieser Build hat dafür keinen Client.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Die Anmeldung bei Kitsu erfolgt über den Bildschirm Konten.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Die Anmeldung bei { $tracker } wird noch nicht unterstützt.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Die Anmeldung bei { $tracker } braucht eine Weiterleitung aus dem Browser, die diese App nicht annehmen kann.

# Toast when AniList is set to a sign-in method only the Kaeri app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Diese AniList-Anmeldemethode funktioniert nur in der App Kaeri. Um hier anzumelden, setze { $setting } in der Konfigurationsdatei auf „loopback“.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList braucht eine Client-ID und ein Geheimnis. Setze { $client } und { $secret } in der Konfigurationsdatei und melde dich dann erneut an. Um die Anmeldeadresse zu erhalten, führe kaeri --login-url aus.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Einen Code einzufügen ist hier nicht möglich. Beende das Programm und starte Kaeri stattdessen mit --login.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList braucht eine Client-ID. Registriere auf myanimelist.net/apiconfig eine App vom Typ „other“ und setze dann { $setting } in der Konfigurationsdatei.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = Warte darauf, dass { $tracker } zurückleitet…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList hat kein Refresh-Token ausgegeben. In etwa einem Monat musst du dich erneut anmelden.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Setze zuerst { $setting } in der Konfigurationsdatei.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Bei { $tracker } abgemeldet.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Bei { $tracker } abgemeldet. Eine wartende Änderung wird für die nächste Anmeldung aufbewahrt.
       *[other] Bei { $tracker } abgemeldet. { $count } wartende Änderungen werden für die nächste Anmeldung aufbewahrt.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Abmeldung bei { $tracker } fehlgeschlagen. Versuche es noch einmal. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Diese Einstellung konnte nicht gespeichert werden. { $cause }

# Toast when the proxy for torrent traffic was saved.
notice-proxy-saved = Der Torrent-Verkehr läuft jetzt über den Proxy.

# Toast when the proxy for torrent traffic was turned off.
notice-proxy-removed = Torrents verbinden sich jetzt direkt, ohne Proxy.

# Toast when the proxy could not be checked. The cause says why.
notice-proxy-not-checked = Der Proxy konnte nicht geprüft werden. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Das Passwort des Proxys konnte nicht gespeichert werden. Gib es erneut ein, um das Speichern zu versuchen. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Diese Einstellung konnte nicht gespeichert werden. { $value } ist kein gültiger Wert für { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Die Einstellungen dieser Serie konnten nicht zurückgesetzt werden. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Diese Untertitelauswahl konnte nicht gespeichert werden. Die Serie hat diese Untertitel bisher nicht verwendet.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Zuordnungsdaten aktualisiert.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Die Zuordnungsdaten ({ $datasets }) konnten nicht aktualisiert werden. Neuer Versuch in { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, Folge { $episode }, ist erschienen, während du weg warst.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
        [one] Eine neue Folge einer Serie, die du schaust, ist erschienen. Sie steht im Kalender.
       *[other] { $count } neue Folgen von Serien, die du schaust, sind erschienen. Sie stehen im Kalender.
    }

