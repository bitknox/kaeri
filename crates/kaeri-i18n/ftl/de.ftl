# Note under the rich presence row.
settings-note-presence-rich = Fügt das Cover, eine Fortschrittsleiste und einen AniList-Link hinzu, solange der Titel angezeigt wird.

# Note under the torrent playback row.
settings-note-torrents = Standardmäßig aus. Gilt sofort.

# Note under the torrent proxy row. config.toml is a file name and is not translated.
settings-note-torrent-proxy = Optional. Bearbeite config.toml, um den Torrent-Verkehr über einen SOCKS5-Proxy zu leiten.

# Note under the seed after watching row.
settings-note-seed-ratio = Hält gesehene Episoden im Seeding, solange Kaeri geöffnet ist.

# Note under the seed for at most row.
settings-note-seed-hours = Die längste Zeit, die eine Episode im Seeding bleibt, unabhängig vom Verhältnis.

# Note under the upload limit row.
settings-note-upload-limit = Begrenzt den gesamten Torrent-Upload, damit das Seeding die Wiedergabe nie verlangsamt.

# Note under the token storage row. The option is a command-line flag and is not translated.
settings-note-token-storage = Verwende --token-to-file, um einen bestehenden Token zu verschieben.

# AniList's name, in the line that says it is still being asked.
