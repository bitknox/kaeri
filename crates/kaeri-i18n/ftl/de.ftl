tv-show-remote = Fernbedienung für { $name } anzeigen

# Status on the remote: playing on a TV.
tv-status-playing = Wird auf { $name } abgespielt

# Status on the remote: connecting.
tv-status-connecting = Verbindung zu { $name } wird aufgebaut

# Status on the remote: connection lost, trying again.
tv-status-reconnecting = Verbindung zu { $name } wird wiederhergestellt

# Status on the remote: connected.
tv-status-connected = Verbunden

# Label of the search field on the remote.
tv-search-on-tv = Auf dem Fernseher suchen

# Hint inside the search field on the remote.
tv-type-search = Suche eingeben

# Name of a track that has no name.
tv-track-n = Spur { $id }

# Title of the screen on the TV that waits for a phone.
tv-pair-phone = Telefon koppeln

# Line on that screen.
