stores-column-store = Store

# Column heading over how many plugins each store offers. Ten cells wide.
stores-column-plugins = Plugins

# Column heading over whether this person owns the store or is a member. Ten cells wide.
stores-column-you = Du

# Column heading over each store's condition: up to date, offline, access removed. Takes the rest of the row.
stores-column-state = Status

# Shown under the column headings when no { -plugin-store } has been joined.
stores-none-joined = Noch keinem Plugin-Store beigetreten

# Role in a store, in the list of stores and on the members screen. Ten cells wide.
stores-role-owner = Besitzer

# Role in a store, in the list of stores and on the members screen. Ten cells wide.
stores-role-member = Mitglied

# Row under the list of stores that opens the prompt for joining another.
stores-join-row = + Einem Store beitreten

# State of a store whose owner removed this device. Column of about 30 cells.
stores-state-revoked = Zugriff entzogen

# State of a store that could not be reached. The symbol before it is drawn by the program.
stores-state-offline = Offline

# State of a store with nothing to update. The symbol before it is drawn by the program.
stores-state-up-to-date = Aktuell

# State of a store that has newer versions of installed plugins.
stores-state-updates =
    { $count ->
        [one] { $count } Update
       *[other] { $count } Updates
    }

# Footer of the list of stores when the focused store has removed this device's access.
stores-footer-revoked = Dieser Store nimmt dieses Gerät nicht mehr an. Der Besitzer kann eine neue Einladung schicken.

# Footer of the list of stores when the focused store cannot be reached. The reason comes from the network.
stores-footer-offline = { $url } ({ $reason })

# Part of a store's footer line: the store's key fingerprint, as groups of hexadecimal digits.
stores-key = Schlüssel { $fingerprint }

# Part of a store's footer line when this device joined with the store's link, which keeps no name.
stores-joined-without-name = Ohne Namen beigetreten

# Part of a store's footer line: the name this device joined under.
stores-joined-as = Beigetreten als { $name }

# Footer of the list of stores when the focused row is the one that joins another store.
stores-footer-join = Einladung oder Link eines Stores einfügen, den du bekommen hast

# Tag at the top right of a store's page when this person owns it. Up to seven cells wide.
stores-owner-tag = Eigner

# Part of a store's note line when anyone with its link can join.
stores-anyone-can-join = Jeder mit dem Link kann beitreten

# Note under a store's name when it cannot be reached and its last list is shown. The reason comes from the network.
stores-note-offline = Offline, zeigt die letzte Liste ({ $reason })

# Note under a store's name when it removed this device's access.
stores-note-revoked = Dieser Store nimmt dieses Gerät nicht mehr an. Was er installiert hat, funktioniert weiter.

# Column heading of a store's page over the plugin names.
stores-column-plugin = Plugin

# Column heading of a store's page over the plugin versions. Fourteen cells wide.
stores-column-version = Version

# Shown on a store's page when it offers nothing and this person owns it, who can publish from the rows below.
stores-empty-owner = Noch nichts veröffentlicht. Veröffentliche unten ein Plugin.

# Shown on a store's page when it offers nothing and this person is a member.
stores-empty-member = Noch nichts veröffentlicht

# Row on a store's page: makes a one-time link that joins another computer of this person's.
stores-line-link-device = Weiteres Gerät verknüpfen

# Row on a store's page: makes an invite for someone new. Owners only.
stores-line-invite = Jemanden einladen

# Row on a store's page: opens the members screen. Owners only.
stores-line-members = Mitglieder

# Row on a store's page: switches between invite-only and open to anyone with the link. Owners only.
stores-line-who-can-join = Wer beitreten kann

# Row on a store's page: offers a plugin from the plugin directory. Owners only.
stores-line-publish = Ein Plugin veröffentlichen

# Row on a store's page: opens the store's admin page in a browser. Owners only.
stores-line-admin = Admin-Seite öffnen

# Row on a store's page: leaves the store.
stores-line-leave = Diesen Store verlassen

# What a plugin is, in a store's page, when it is not installed. Column of about 20 cells.
stores-plugin-not-installed = Nicht installiert

# What a plugin is, in a store's page, when it is installed. The symbol before it is drawn by the program.
stores-plugin-installed = Installiert

# What a plugin is, in a store's page, when a newer version is offered. Column of about 20 cells.
stores-plugin-update-from = Update von { $from }

# What a plugin is, in a store's page, when the same file was put in the plugin directory by hand.
stores-plugin-added-by-hand = Von Hand hinzugefügt

# What a plugin is, in a store's page, when another store installed it.
stores-plugin-from-another-store = Von einem anderen Store

# Footer of a store's page on a plugin whose update asks to contact more hosts than before.
stores-footer-update-hosts = Das Update möchte zusätzlich { $hosts } kontaktieren

# Footer of a store's page on a plugin: the hosts it may contact, as a list.
stores-footer-may-contact = Darf { $hosts } kontaktieren

# Footer of a store's page on the row that makes a link for another of this person's computers.
stores-footer-link-device = Ein einmaliger Link, der ein weiteres deiner Geräte als du beitreten lässt

# Footer of a store's page on the row that makes an invite.
stores-footer-invite = Ein einmaliger Link für jemanden Neuen

# Footer of a store's page on the row that opens the members screen.
stores-footer-members = Sehen, wer beigetreten ist, und jemandem den Zugriff entziehen

# Footer of a store's page on the row that changes who can join, while the store is open to anyone with its link. Enter is the key on this screen.
stores-footer-close-join = ↵ Nur Eingeladene beitreten lassen und den Link stoppen

# Footer of a store's page on the row that changes who can join, while the store is invite-only. Enter is the key on this screen.
stores-footer-open-join = ↵ Jeder mit dem Link des Stores darf ohne Namen beitreten

# Footer of a store's page on the row that publishes a plugin.
stores-footer-publish = Ein Plugin aus dem Verzeichnis dieses Rechners anbieten

# Footer of a store's page on the row that opens the admin page.
stores-footer-admin = Mitglieder, Einladungen und Plugins im Browser verwalten

# Footer of a store's page on the row that leaves the store.
stores-footer-leave = Plugins, die von hier installiert wurden, bleiben auf diesem Gerät und aktualisieren sich nicht mehr

# Value beside the "who can join" row while anyone with the store's link can join. Takes the rest of the row.
stores-who-open = Jeder mit dem Link

# Value beside the "who can join" row while only invited people can join. Takes the rest of the row.
stores-who-invite-only = Nur Eingeladene

# Label before the number of plugins a store offers, in the join confirmation. Padded to line up with the other labels there.
stores-label-offers = Angebote

# The number of plugins a store offers, after the label "Offers".
stores-offers-count =
    { $count ->
        [one] { $count } Plugin
       *[other] { $count } Plugins
    }

# A plugin the store offers, in the join confirmation. The hosts are what the plugin may contact.
stores-offered-plugin = { $name } { $version }  darf { $hosts } kontaktieren

# Added after an offered plugin that is already installed here.
stores-offered-installed = Installiert

# Added after an offered plugin when an older version is installed here.
stores-offered-installed-version = { $from } installiert

# Added after an offered plugin when the same file was put in the plugin directory by hand.
stores-offered-added-by-hand = Von Hand hinzugefügt

# Added after an offered plugin that another store installed here.
stores-offered-from-other = Von { $other }

# Last line of the plugins a store offers, when only the first few are listed.
stores-offered-more = und { $count } weitere

# What a plugin may contact when it has no hosts. It follows "may contact" in a sentence, so it is lower case.
stores-hosts-none = nichts

# Shown on the members screen while the members load.
stores-loading = Wird geladen…

# After a member's name, when that member is this person.
stores-member-you = { $name } (du)

# Column heading of the members screen over names.
stores-column-name = Name

# Column heading of the members screen over the role. Ten cells wide.
stores-column-role = Rolle

# Column heading of the members screen over how many devices each member has. Ten cells wide.
stores-column-devices = Geräte

# Column heading of the members screen over when each member was last seen. Takes the rest of the row.
stores-column-last-seen = Zuletzt gesehen

# Title of the members screen.
stores-members-heading = Mitglieder · { $name }

# Name of a store on the members screen when it is not known.
stores-unnamed = Plugin-Store

# Heading over invites that have not been used.
stores-invites-heading = Noch nicht genutzte Einladungen

# An invite on the members screen that makes a link for another of the person's own computers.
stores-invite-another-device = { $name }, ein weiteres Gerät

# When a member was last seen, when never. Column value.
stores-seen-never = Nie

# How long ago a member was last seen, under 1 hour. Column value.
stores-ago-just-now = Gerade eben

# How long ago a member was last seen, 1 to 24 hours. Column value.
stores-ago-today = Heute

# How long ago a member was last seen, 1 day. Column value.
stores-ago-yesterday = Gestern

# How long ago a member was last seen, 2 days or more. Column value.
stores-ago-days =
    { $days ->
        [one] Vor { $days } Tag
       *[other] Vor { $days } Tagen
    }

# After "Joined" or "Seen" on a row, under 1 hour. Lower case: it follows a word.
stores-ago-inline-just-now = gerade eben

# After "Joined" or "Seen" on a row, 1 to 24 hours. Lower case: it follows a word.
stores-ago-inline-today = heute

# After "Joined" or "Seen" on a row, 1 day. Lower case: it follows a word.
stores-ago-inline-yesterday = gestern

# After "Joined" or "Seen" on a row, 2 days or more. Lower case: it follows a word.
stores-ago-inline-days =
    { $days ->
        [one] vor { $days } Tag
       *[other] vor { $days } Tagen
    }

# When an invite stops working, already past. Column value.
stores-expired = Abgelaufen

# When an invite stops working, within a day. Column value.
stores-expires-today = Läuft heute ab

# When an invite stops working, in a day. Column value.
stores-expires-tomorrow = Läuft morgen ab

# When an invite stops working, in 2 days or more. Column value.
stores-expires-days =
    { $days ->
        [one] Läuft in { $days } Tag ab
       *[other] Läuft in { $days } Tagen ab
    }

# Heading over the store's link and the devices that joined with it, while anyone with the link can join.
stores-open-heading = Jeder mit dem Link kann beitreten · { $joined } damit beigetreten

# Heading over the devices that joined with the store's link, after it was closed.
stores-closed-heading = Mit dem Link beigetreten, bevor er geschlossen wurde · { $joined }

# How many devices joined with the store's link, inside the headings over them.
stores-joined-devices =
    { $count ->
        [one] { $count } Gerät
       *[other] { $count } Geräte
    }

# Row on the members screen that shows the store's open link.
stores-open-link-row = Der Link des Stores

# Note beside the row of the store's link.
stores-open-link-note = Anzeigen und kopieren

# Row of one device that joined with the store's link. The time reads like "just now" or "3 days ago".
stores-anonymous-joined = Beigetreten { $when }

# Note beside a device that joined with the store's link: when it was last seen.
stores-anonymous-seen = Gesehen { $when }

# Note beside a device that joined with the store's link and was never seen again.
stores-anonymous-never-seen = Noch nicht gesehen

# Row on the members screen that removes the single device that joined with the store's link, or all of them.
stores-remove-devices =
    { $count ->
        [one] Entfernen
       *[other] Alle { $count } entfernen
    }

# Footer of the members screen on this person's own row.
stores-footer-you = Du bist der Besitzer. Ein Store behält immer seinen Besitzer.

# Footer of the members screen on another member's row. Enter is the key on this screen.
stores-footer-remove-member = ↵ Zugriff entziehen

# Footer of the members screen on an invite not used yet.
stores-footer-cancel-invite = ↵ Diese Einladung abbrechen

# Footer of the members screen on the store's link row.
stores-footer-show-link = ↵ Link anzeigen, zum Kopieren und Teilen

# Footer of the members screen on a device that joined with the store's link.
stores-footer-remove-anonymous = ↵ Dieses Gerät entfernen, erkennbar nur an der Beitrittszeit

# Footer of the members screen on the row that removes every device that joined with the link.
stores-footer-remove-all-anonymous = ↵ Jedes Gerät entfernen, das mit dem Link beigetreten ist

# Line in the store's link overlay, once the link was copied.
stores-link-copied = Kopiert, sofern das Terminal es erlaubt. Sonst wähle den Link aus, um ihn zu kopieren.

# Line in a link overlay before the link was copied, or when the terminal cannot copy.
stores-link-select = Zum Kopieren auswählen.

# Line in the store's link overlay.
stores-open-link-warning = Jeder mit ihm kann ohne Namen beliebig oft beitreten.

# Line in the store's link overlay.
stores-open-link-lasts = Er funktioniert, bis der Store wieder nur Einladungen annimmt.

# Line in an invite link overlay: the link works once, and when it stops working. The expiry reads like "Expires today".
stores-invite-works-once = Funktioniert einmal. { $expiry }.

# Line in an invite link overlay.
stores-invite-preview-safe = Wer ihn im Browser öffnet, sieht, wie man beitritt. Die Einladung wird dabei nicht verbraucht.

# Question in the heading of the confirmation to join a store.
stores-confirm-join = { $name } beitreten?

# Question in the heading of the confirmation to leave a store.
stores-confirm-leave = { $name } verlassen?

# Question in the heading of the confirmation to remove a member.
stores-confirm-remove-member = { $name } entfernen?

# Question in the heading of the confirmation to cancel an invite.
stores-confirm-cancel-invite = Einladung für { $name } abbrechen?

# Question in the heading of the confirmation to stop offering a plugin in a store.
stores-confirm-unpublish = { $name } nicht mehr anbieten?

# Question in the heading of the confirmation to let anyone with the store's link join.
stores-confirm-open = Jeder mit dem Link { $name } beitreten lassen?

# Question in the heading of the confirmation to let only invited people join.
stores-confirm-close = Nur eingeladene Personen { $name } beitreten lassen?

# Question in the heading of the confirmation to remove one device that joined with the store's link.
stores-confirm-remove-device = Dieses Gerät entfernen?

# Question in the heading of the confirmation to remove devices that joined with the store's link.
stores-confirm-remove-devices =
    { $count ->
        [one] Das Gerät entfernen, das mit dem Link beigetreten ist?
       *[other] Alle { $count } Geräte entfernen, die mit dem Link beigetreten sind?
    }

# Heading of a store confirmation when nothing is being confirmed.
stores-confirm-fallback = Bestätigen

# Label before the store's address in the join confirmation. Padded to line up with the other labels there.
stores-label-address = Adresse

# Label before the store's key fingerprint in the join confirmation.
stores-label-key = Schlüssel

# Label before the people who run the store in the join confirmation.
stores-label-run-by = Betrieben von

# Label before this device's name in the join confirmation.
stores-label-device = Gerät

# The store's key fingerprint, in the join confirmation of an open link, with a note that it matches the link.
stores-key-matches-link = { $fingerprint }  (passt zum Link)

# The store's key fingerprint, in the join confirmation of an invite, with a note that it matches the invite.
stores-key-matches-invite = { $fingerprint }  (passt zur Einladung)

# Line of the join confirmation when the store is open to anyone with its link.
stores-join-open = Jeder mit dem Link kann beitreten.

# Line of the join confirmation when it is an open link, which keeps no name.
stores-join-anonymous = Du trittst ohne Namen bei. Jedes andere Gerät kann mit demselben Link beitreten.

# Line of the join confirmation when this device has already joined.
stores-join-already = Bereits beigetreten. Erneut beitreten gibt diesem Gerät ein neues Token.

# Note under the device name field in the join confirmation.
stores-join-device-note = Der Besitzer des Stores sieht diesen Namen. Tippen, um ihn zu ändern.

# Lines of the leave confirmation.
stores-leave-plugins = Plugins, die von hier installiert wurden, bleiben auf diesem Gerät und aktualisieren sich nicht mehr.

# Lines of the leave confirmation.
stores-leave-revoked = Der Zugriff für dieses Gerät auf den Store ist entzogen.

# Line of the remove member confirmation.
stores-remove-member-devices =
    { $count ->
        [one] Ihr Gerät funktioniert mit diesem Store sofort nicht mehr.
       *[other] Ihre { $count } Geräte funktionieren mit diesem Store sofort nicht mehr.
    }

# Line of the remove member confirmation.
stores-remove-member-plugins = Plugins, die sie bereits installiert haben, bleiben auf ihren Geräten.

# Line of the cancel invite confirmation.
stores-cancel-invite-link = Der Link funktioniert nicht mehr.

# Line of the stop offering confirmation.
stores-unpublish-members = Mitglieder, die es installiert haben, behalten es, und es aktualisiert sich nicht mehr.

# Line of the confirmation to let anyone with the store's link join.
stores-open-anyone = Jeder mit dem Link des Stores kann ohne Namen beitreten.

# Line of the confirmation to let anyone with the store's link join.
stores-open-link-new = Der Link ist jedes Mal neu, damit ein früherer ungültig bleibt.

# Line of the confirmation to let anyone with the store's link join.
stores-open-members-see = Mitglieder sehen, dass der Store offen ist.

# Line of the confirmation to let only invited people join.
stores-close-link = Der Link funktioniert nicht mehr, und niemand Neues tritt ohne Einladung bei.

# Line of the confirmation to let only invited people join.
stores-close-devices = Geräte, die damit beigetreten sind, funktionieren weiter, bis du sie unter Mitglieder entfernst.

# Line of the confirmation to remove one device that joined with the store's link.
stores-anonymous-one-stops = Es funktioniert danach nicht mehr mit diesem Store.

# Line of the confirmation to remove all devices that joined with the store's link.
stores-anonymous-all-stop = Sie funktionieren danach nicht mehr mit diesem Store.

# Line of the confirmation to remove devices that joined with the store's link.
stores-anonymous-plugins = Plugins, die bereits installiert sind, bleiben, wo sie sind.

# Line of the confirmation to remove devices that joined with the store's link.
stores-anonymous-still-joins = Solange der Store offen ist, lässt der Link weiterhin jeden beitreten.

# Line of the plugin overlay: the hosts the plugin may contact.
stores-plugin-may-contact = Darf { $hosts } kontaktieren

# Line of the plugin overlay: what a plugin can never do.
stores-plugin-cannot = Es kann keine Dateien lesen, keine Verbindungen öffnen und deine Umgebung nicht sehen.

# Line of the plugin overlay when an update adds hosts to what the plugin may contact.
stores-plugin-update-adds = Das Update erlaubt zusätzlich den Kontakt zu { $hosts }.

# Line of the plugin overlay when a file of the same name is already in the plugin directory. The id is the file name without ".wasm".
stores-plugin-added-by-hand-note = { $id }.wasm liegt schon im Verzeichnis, von Hand hinzugefügt.

# Line of the plugin overlay when another store installed the plugin.
stores-plugin-other-store-note = Von einem anderen Store installiert, der es aktuell hält.

# Choice in the plugin overlay: install the plugin.
stores-choice-install = Installieren

# Choice in the plugin overlay: install the newer version.
stores-choice-update = Auf { $version } aktualisieren

# Choice in the plugin overlay: overwrite the file that was added by hand.
stores-choice-replace = Die von Hand hinzugefügte Kopie ersetzen

# Choice in the plugin overlay: delete the plugin from this machine.
stores-choice-remove = Von diesem Gerät entfernen

# Choice in the plugin overlay: owners stop offering the plugin in the store.
stores-choice-unpublish = In diesem Store nicht mehr anbieten

# Choice in the plugin overlay: close without doing anything.
stores-choice-cancel = Abbrechen

# Tag beside a local plugin in the publish picker when it was never published to the store. Column of about 12 cells.
stores-publish-new = Neu

# Tag beside a local plugin in the publish picker when the store has this version.
stores-publish-published = Veröffentlicht

# Tag beside a local plugin in the publish picker when publishing replaces another version.
stores-publish-replaces = Ersetzt { $version }

# Toast when a pasted invite checked out but the person is no longer on the store list.
stores-toast-invite-checked = Die Einladung ist gültig, aber etwas anderes ist offen. Zum Beitreten erneut einfügen.

# Toast when there is no plugin in the plugin directory to publish.
stores-toast-nothing-to-publish = Im Verzeichnis liegt kein Plugin, das sich veröffentlichen ließe. Mit „{ $command }“ siehst du, wo es liegt.

# Toast when the person tries to remove themselves from a store's members.
stores-toast-that-is-you = Das bist du. Ein Store behält immer seinen Besitzer.

# The word for this kind of { -device } inside sentences such as "Turn off sync on this computer". Lower case.
sync-tui-kind = Computer

# A row under Your { -device-pl }: pair by typing the code another { -device } shows.
sync-tui-enter-code = Code eingeben

# The Cloud folder row while sync uses no cloud folder.
sync-tui-no-cloud = Kein Cloud-Ordner

# Beside a { -device } in Your { -device-pl } that has not synced with this one yet.
sync-tui-device-never = Noch nicht abgeglichen

# Beside a profile: the one in use now. Column value.
sync-tui-profile-in-use = In Benutzung

# The wait while the browser shows a cloud service's sign-in page. The service is a name such as Dropbox.
sync-tui-browser-line = Dein Browser hat die Seite von { $service } geöffnet. Erlaube dort den Zugriff, den Rest erledigt Kaeri von selbst.

# Under Open the page again: the page's address follows on the next line, for a browser that did not open.
sync-tui-browser-address = Oder öffne diese Adresse selbst:

# Title of the waiting dialog while a cloud sign-in runs in the browser.
sync-tui-signing-in = Anmeldung läuft

# Title of the field for a WebDAV server's address.
sync-tui-webdav-address = WebDAV-Adresse

# Under the WebDAV address field.
sync-tui-webdav-address-note = Die Adresse des Ordners auf deinem Server, beginnend mit https://.

# Title of the field for a folder's path on this computer.
sync-tui-folder-path = Ordner

# Under the folder path field.
sync-tui-folder-path-note = Der vollständige Pfad eines Ordners, den eine andere App aktuell hält, etwa ein synchronisiertes Laufwerk.

# Title of the field for the user name a WebDAV or Nextcloud server signs in with.
sync-tui-user = Benutzername

# Under the user name field, for Nextcloud's app password.
sync-tui-nextcloud-user-note = Der Name, mit dem du dich bei Nextcloud anmeldest.

# Title of the field for a WebDAV password. It is drawn as dots.
sync-tui-password = Passwort

# Title of the field for a Nextcloud app password. It is drawn as dots.
sync-tui-app-password = App-Passwort

# Label before the six-digit pairing code this { -device } shows.
sync-tui-code = Code

# Label before this { -device }'s network address and port, which the other { -device } enters with the code.
sync-tui-address = Adresse

# While this { -device } is getting a pairing code ready to show.
sync-tui-pair-making = Code wird erstellt

# Title of the field for the other { -device }'s address, the second step of entering a code.
sync-tui-pair-address = Adresse des anderen Gerät

# Under the address field when entering a pairing code.
sync-tui-pair-address-note = Die Adresse, die das andere Gerät unter seinem Code zeigt, zum Beispiel 192.168.1.20:47811.

# While this { -device } pairs with the one whose code was entered.
sync-tui-pairing = Wird gekoppelt

# After a recovery key is shown: where to see it again in the terminal.
sync-tui-rkey-again = Du kannst ihn in den Einstellungen unter Geräte wieder ansehen.

# A choice when adding a profile: add it as a kids profile.
sync-tui-add-kids = Als Kinderprofil hinzufügen

# Said when the terminal closes to start again on another profile, and printed when it cannot start again by itself.
sync-tui-profile-restart = Starte Kaeri neu, um das Profil von { $name } zu verwenden.

# A sync problem: the folder holds nothing to join.
sync-tui-err-no-group = Dieser Ordner enthält keinen Verlauf zum Beitreten. Wähle einen anderen Ordner.

# A sync problem: a cloud service that this build can't sign in to. The service is a name such as Dropbox.
sync-tui-err-unavailable = { $service } ist auf diesem Gerät nicht verfügbar.

# Status line hint: Enter removes the highlighted { -device } from sync, after a question.
sync-tui-hint-remove = Entfernen

# Status line hint: Enter shows the recovery key.
sync-tui-hint-show = Anzeigen

# Status line hint: Enter turns sync off on this { -device }, after a question.
sync-tui-hint-turn-off = Ausschalten

# Status line hint: a key that copies the recovery key.
sync-tui-hint-copy = Kopieren

# In place of a QR code when the window is too short to draw it whole.
sync-tui-qr-no-room = Mach das Fenster höher, um den QR-Code zu sehen.

# What the terminal says beside a notice that has something to do about it. The key is the one bound to stopping playback, as the key map draws it.
hint-stop-playback = Drücke { $key }, um die Wiedergabe zu stoppen.

# What the terminal says beside a notice about a { -plugin } update: where to go.
hint-open-stores = Gehe zu Quellen und drücke Enter, um die Plugin-Stores zu öffnen.

