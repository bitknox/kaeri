# Note under the trailers row. The terminal never plays trailers by itself; the setting is shared with the apps.
settings-note-trailers = Die Desktop-Apps spielen Trailer stumm in Vorschauen beim Darüberfahren ab. Das Terminal behält die Einstellung und spielt keine ab.

# Note under the subtitles row.
settings-note-subtitles = Drücke Enter, um einen Sprachcode einzugeben. Es gibt zu viele Werte zum Durchschalten.

# Note under the opening and ending marks row.
settings-note-mark-chapters = Fügt Kapitelmarken zur Zeitleiste hinzu, wenn der Stream keine hat.

# Note under the skip button row.
settings-note-skip-button = Zeigt eine Schaltfläche über Intro und Abspann, wenn das Überspringen nicht automatisch ist.

# Note under the fullscreen row. "f" is mpv's own key and is not translated.
settings-note-fullscreen = mpv öffnet sich im Vollbild. Seine eigene Taste f verlässt das Vollbild weiterhin.

# Note under the upscaling row.
settings-note-upscaling = Passt sich dem Video und deiner Grafikkarte an. Gilt ab der nächsten Episode.

# Note under the player interface row.
settings-note-player-ui = Zeigt Vorschaubilder, Menüs und die Überspringen-Schaltfläche im Kaeri-Look.

# Note under the night mode row.
settings-note-night-mode = Gleicht leise Dialoge und laute Musik aus.

# Note under the download folder row.
settings-note-download-dir = Drücke Enter, um einen Pfad einzugeben. Gilt für den nächsten Download.

# Note under the merge subtitles row.
settings-note-merge-subtitles = Gilt für den nächsten Download, der fertig wird.

# Note under the keep seeding row.
settings-note-keep-seeding = Standardmäßig aus, um Upload zu sparen. Schalte es ein, um dem Schwarm etwas zurückzugeben.

# Note under the after each download row.
settings-note-download-hook = Drücke Enter, um einen Befehl einzugeben. Er läuft nach jedem fertigen Download.

# Note under the Syncplay row. The key is the one that plays a single episode in a { -watch-party }.
settings-note-syncplay = Drücke { $key }, um eine Episode im unten eingestellten Raum abzuspielen. Solange sie an ist, läuft jede Wiedergabe dort.

# Note under the Syncplay server row.
settings-note-syncplay-server = Drücke Enter, um host:port einzugeben. Es gibt keinen Server, bis du einen wählst.

# Note under the Syncplay room row.
settings-note-syncplay-room = Drücke Enter, um einen Raum einzugeben, den dir jemand gegeben hat. Leer lassen startet einen Raum, den niemand erraten kann.

# Note under the check for updates row.
settings-note-update-check = Eine zwischengespeicherte Anfrage pro Tag, beim Start.

# Note under the Discord presence row once a client ID is set.
settings-note-presence = Gilt ab der nächsten Episode.

# Note under the Discord presence row when no client ID is set. The address is a web address.
settings-note-presence-needs-client = Leg zuerst eine Client-ID fest. Dafür registrierst du eine App unter discord.com/developers.

# Note under the presence title row. The quoted text is what Discord shows.
