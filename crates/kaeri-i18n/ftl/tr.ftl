# Accessible name of a card or row in Continue: the title, then what is said under it.
continue-row-spoken = { $title }, { $detail }

# Accessible name of the pane beside Continue's queue that previews the selected title.
continue-preview = Önizleme

# Under a suggestion that airs later today when no episode number is known: the time it airs.
up-next-airs-at = { $time } yayımlanacak

# Accessible name of a progress bar on a row that has no better name, such as a download's.
progress-name = İlerleme

# What a screen reader says for a progress bar's value.
progress-percent = yüzde { $percent }

# Accessible name of a grid of show covers.
poster-grid-name = Başlıklar

# Line under the title of the last welcome page: what the app plays, without a promise of its own.
onboarding-where-hosts-linux = Kaeri, zaten sahip olduklarınızı oynatır: bu cihaz üzerindeki dosyalar, Jellyfin sunucunuz ve katıldığınız eklenti mağazaları gelen eklentiler.

# Words before the link on the empty Sources page.
sources-empty-or = Ya da

# A folder's line once it is read.
library-row-summary-linux =
    { $episodes ->
        [one] { $series } dizinin 1 bölümü
       *[other] { $series } dizinin { $episodes } bölümü
    }

# A folder page's line when changes are noticed as they happen.
library-page-watching-linux = Değişiklikler izleniyor

# A folder page's line when changes are found only when the app starts or is asked.
library-page-no-watch-linux = Kaeri açılırken yeniden bakılır

# Heading over the matched series.
library-matched-linux = Eşleşenler

# Row line for a series in Needs a look: the title found, if any.
library-best-guess-linux = En iyi tahmin: { $title }

# Line on a result in the match picker whose episode count does not fit the folder's files.
library-fix-count-mismatch-linux =
    { $episodes ->
        [one] 1 bölümü var, bu klasörde { $files } dosya var
       *[other] { $episodes } bölümü var, bu klasörde { $files } dosya var
    }

# Header title on a terminal too narrow for the rail: the product name, then the section on screen.
chrome-header-section = Kaeri · { $section }

# Header chip while the metadata sources are degraded. The mark is a status glyph. Shown beside the { -source } chips, which are short.
chrome-meta-chip = Üst veri { $mark }

# Activity row: how many more running jobs there are than fit. It follows the last job shown.
chrome-activity-more = +{ $count }

# Activity row: a running job that is held up (a rate-limit pause), with the wait counting down. The note says what it waits on; the countdown is a clock such as 0:12.
chrome-job-held = { $note }, { $countdown }

# Heading of an overlay that lists the lines of a long table: which lines are in view.
overlays-window-position = { $from }–{ $to } / { $total }

# Heading of the help overlay when its table does not fit on one page.
overlays-help-page = Sayfa { $page } / { $pages }

# The log overlay, when nothing has been logged this session.
overlays-logs-empty = Henüz kayıt yok

# Prompt hint under the manual search heading. The footer names its keys.
overlays-hint-manual-query = Aramak istediğinizi yazın ya da otomatik eşleşme için boş bırakın.

# Prompt hint for the first step of signing in to Kitsu.
overlays-hint-kitsu-username = E-posta ya da kullanıcı adı.

# Prompt hint for the second step of signing in to Kitsu. The password is shown as dots.
overlays-hint-kitsu-password = Parolanız bir belirteçle değiştirilir ve saklanmaz.

# Prompt hint for the download range. The examples are episode numbers and stay as written.
overlays-hint-download-range = Bir bölüm için 4, bir aralık için 1-12, oradan itibaren hepsi için 7-.

# Prompt hint for editing a setting: its label on the Settings screen. The footer names the keys.
overlays-hint-edit-setting = { $setting } için yeni bir değer yazın.

# Prompt hint for joining a { -plugin-store }.
overlays-hint-join-store = Size verilen davet ya da mağaza bağlantısını yapıştırın.

# Prompt hint for naming the person an invite link is for.
overlays-hint-invite-name = Kişinin adı, üyeler listesinde göründüğü gibi.

# Overlay heading after the title: the plugin's version and the { -plugin-store } it comes from. The plugin's name leads the heading.
overlays-heading-plugin = { $name }   { $version }  ·  Eklenti mağazası: { $store }

# Overlay heading, after the title "Invite link": whom the link is for.
overlays-heading-invite-for = { $name } için

# Title of the invite link overlay when the link is not for a named person.
overlays-title-link-device = Başka bir cihaz bağla

# Overlay heading, after the title of the store's link: which { -plugin-store } it opens.
overlays-heading-open-link-of = { $store }

# Overlay heading, after the title of the publish list: where the plugin goes.
overlays-heading-publish-to = { $store } için

# Overlay heading, after the title "Which one": the title being matched.
overlays-heading-disambiguate = { $name } için eşleşme

# Overlay heading, after the title "Watch order": the title the order is built around.
overlays-heading-watch-order = { $name } çevresinde

# Overlay heading, after the title "Recommended": the title the list came from.
overlays-heading-recommendations = { $name } beğendiğiniz için

# Overlay heading, after the title of the release list.
overlays-heading-release = Diğer kaynaklar eksikleri tamamlar.

# Overlay heading, after the title of the { -source } list: the choice is kept for this title.
overlays-heading-source = { $name }

# Overlay heading, after the title of the releases list: the episode it is for.
overlays-heading-releases = Bölüm { $episode }. Enter seçiminizi oynatır.

# Same, when no episode is known.
overlays-heading-releases-bare = Enter seçiminizi oynatır.

# Toast: a download that is finished cannot be cancelled, only deleted. The key is the delete key.
toast-download-done = Zaten indirildi. Bunu ve dosyasını silmek için { $delete } tuşuna basın.

# Toast: a command needs a title and none is selected.
toast-nothing-selected = Hiçbir şey seçili değil. Önce bir başlık seçin.

# Toast: the download-range key was pressed away from the episode table.
toast-ranges-elsewhere = Aralıklar bölüm tablosundan kuyruğa alınır.

# Toast: the filter key was pressed on a screen without filters.
toast-filters-elsewhere = Filtreler arama ve bölüm tablosunda bulunur.

# Toast: a watched-mark key was pressed away from the episode table.
toast-watched-elsewhere = İzlendi işaretleri bölüm tablosunda bulunur.

# Toast: Back was pressed at the top of a section. The key is the quit key.
toast-at-top = En üsttesiniz. Çıkmak için { $quit } tuşuna basın.

# Toast: an action was run that does nothing on this screen. The action is its label, such as "Mark all previous watched"; the place says where it works, such as "in the episode table".
toast-works-elsewhere = { $action } yalnızca şu yerde çalışır: { $place }.

# Toast: the bug report is being opened.
toast-bug-report-opening = Hata raporu tarayıcınızda açılıyor. Bağlantı günlükte.

# Log line holding the whole bug report link, for a terminal that cannot open it.
tui-log-bug-report-link = Hata raporu: { $url }

# Toast: a key binding in the config file was refused. The problem says which and why.
toast-keybinding-not-applied = Tuş atama uygulanmadı: { $problem }. Yapılandırma dosyasındaki tuşlar bölümünü denetleyin.

# Standing notice: the config file did not load. The problem is the parser's own text.
tui-config-problem = { $file }: { $what }. Düzeltilene kadar varsayılanlar kullanılıyor.

# Same, when the problem is on a known line.
tui-config-problem-at-line = { $file }, { $line }. satır: { $what }. Düzeltilene kadar varsayılanlar kullanılıyor.

# Log line for the same problem. The path is the whole path of the config file.
tui-config-problem-logged = { $path }: { $problem }. Varsayılanlar kullanılıyor.

# The status line at the foot of the screen when nothing is being said: the source in use, the audio and the quality.
chrome-status-state = { $source } · { $audio } · { $quality }p

# Heading of the title page when no title is highlighted.
title-heading = Başlık

# Under the heading of the title page and the episode table when no title is highlighted.
title-nothing-selected-note = Hiçbir şey seçili değil

# Toast when a title action is asked for and no title is highlighted.
title-nothing-selected = Hiçbir şey seçili değil. Bir başlığı vurgulayıp yeniden deneyin.

# Toast when something that needs a title's full page is asked from a list.
title-trailer-off-page = Fragmanı bulmak için başlığın sayfasını açın.

# Toast when something that needs a title's full page is asked from a list.
title-recommendations-off-page = Önerileri görmek için başlığın sayfasını açın.

# Toast when something that needs a title's full page is asked from a list.
title-seasons-off-page = Bağlantılı sezonları görmek için başlığın sayfasını açın.

# Toast when a title has no trailer on record.
title-no-trailer = Bu başlık için kayıtlı bir fragman yok.

# Toast when a title has no recommendations.
title-no-recommendations = Bu başlık için bilinen bir öneri yok.

# Toast when a title has no connected seasons.
title-no-seasons = Bu başlık için bilinen bağlantılı sezon yok.

# Toast when the { -source } picker is asked for from a list.
title-pin-off-page = Bir kaynak seçmek için başlığın sayfasını açın.

# Toast when the { -source } picker is asked for and no { -source } is registered. They register a moment after launch.
title-no-sources-yet = Henüz kayıtlı kaynaklar yok. Birazdan yeniden deneyin.

# Toast when a list status or rating is asked for and no { -tracker } is signed in. The command is typed as it is.
title-status-needs-tracker = Liste durumunuz bir takip hizmeti üzerinde tutulur, ama hiçbirinde oturum açık değil. Oturum açmak için :accounts yazın.

# Toast when a rating is asked for and no { -tracker } is signed in. The command is typed as it is.
title-rating-needs-tracker = Puanlar bir takip hizmeti üzerinde tutulur, ama hiçbirinde oturum açık değil. Oturum açmak için :accounts yazın.

# Toast after a list status is picked. The status is one of the status names; the trackers are a comma separated list.
title-status-set = Durum { $status } olarak ayarlandı. { $trackers } için sıraya alındı.

# Toast after a rating is picked.
title-rated = { $score }/10 puan verildi. { $trackers } için sıraya alındı.

# List status in the status picker and in the toast after picking one.
title-status-watching = İzleniyor

# List status in the status picker and in the toast after picking one.
title-status-planning = Planlanıyor

# List status in the status picker and in the toast after picking one.
title-status-completed = Tamamlandı

# List status in the status picker and in the toast after picking one.
title-status-paused = Duraklatıldı

# List status in the status picker and in the toast after picking one.
title-status-dropped = Bırakıldı

# Beside the Completed status in the status picker, when the title has progress: what choosing it does.
title-status-completed-hint = İlerlemeyi son bölüme ayarlar

# A rating in the rating picker, beside the number 10.
title-rating-10 = Başyapıt

# A rating in the rating picker, beside the number 9.
title-rating-9 = Harika

# A rating in the rating picker, beside the number 8.
title-rating-8 = Çok iyi

# A rating in the rating picker, beside the number 7.
title-rating-7 = İyi

# A rating in the rating picker, beside the number 6.
title-rating-6 = Fena değil

# A rating in the rating picker, beside the number 5.
title-rating-5 = Orta

# A rating in the rating picker, beside the number 4.
title-rating-4 = Zayıf

# A rating in the rating picker, beside the number 3.
title-rating-3 = Kötü

# A rating in the rating picker, beside the number 2.
title-rating-2 = Berbat

# A rating in the rating picker, beside the number 1.
title-rating-1 = Korkunç

# Place of a title in the watch order: the nth season of its franchise. Sits in a narrow column.
title-season = Sezon { $number }

# Place of a title in the watch order: it comes before this one.
title-relation-prequel = Önceki

# Place of a title in the watch order: it is the story this one comes from.
title-relation-parent = Ana eser

# Place of a title in the watch order: it comes after this one.
title-relation-sequel = Devam

# First choice in the { -source } picker: let Kaeri pick.
title-source-automatic = Otomatik (en iyi kullanılabilir kaynak)

# Beside a { -source } in the picker when it is failing and so not used.
title-source-failing = Hata veriyor

# First choice in the { -release } picker: the { -source } decides.
title-release-first = kaynak sıraya koyduğu ilk sürüm

# The services a title is available on, under its metadata. The list is already joined.
title-available-on = Şu hizmetlerde var: { $services }

# Beside the progress meter on the title page: the episode that follows what has been watched.
title-up-next = Sıradaki: { $next }. bölüm

# Beside the progress meter when the watched count is against the episodes that have aired so far.
title-progress-aired = { $done } / { $aired } yayımlandı

# Beside the progress meter when there is nothing to count against.
title-progress-watched = { $done } izlendi

# Heading of the episode table when the title is not known.
episodes-heading = Bölümler

# Column heading over the episode titles.
episodes-column-title = Başlık

# Column heading over the running time of each episode.
episodes-column-run = Süre

# Column heading over how much of each episode is watched.
episodes-column-watched = İzlendi

# Beside a finished episode, in the last column.
episodes-done = Bitti

# In the last column for an episode that is not out yet. The span is short, such as 2d 3h.
episodes-airs-in = { $span } sonra

# Episode kind in the last column: the story episodes.
episodes-kind-canon = Ana hikâye

# Episode kind in the last column: part story, part filler.
episodes-kind-mixed = Karışık

# Episode kind in the last column: filler, which can be skipped.
episodes-kind-filler = Dolgu

# Episode kind in the last column: made for the anime and not in the book it comes from.
episodes-kind-anime-canon = Anime özgü

# The episode filter shown when nothing is filtered, and named at the top right of the table.
episodes-filter-all = Tüm bölümler

# The episode filter that hides the episodes already watched.
episodes-filter-unwatched = İzlenmemiş

# The episode filter that hides filler.
episodes-filter-no-filler = Dolgu yok

# Toast after the filter changes.
episodes-showing-all = Tüm bölümler gösteriliyor.

# Toast after the filter changes.
episodes-showing-unwatched = İzlenmemiş bölümler gösteriliyor.

# Toast after the filter changes.
episodes-showing-no-filler = Dolgu olmayan bölümler gösteriliyor.

# Top right of the episode table: how far the dub goes, for a dub that stops short of what has aired.
episodes-dub-through = Dublajlı: { $through }. bölüme kadar

# Top right of the episode table: the dub has every episode.
episodes-dub-complete = Dublajlı

# Heading of the empty episode table when the filter hides every episode.
episodes-empty-filtered = Filtreye uyan yok

# Under the heading when the filter hides every episode. The key is the filter key.
episodes-empty-filtered-hint = Filtre tüm bölümleri gizliyor. Değiştirmek için { $key } tuşuna basın.

# Heading of the empty episode table when no { -source } is ready.
episodes-empty-no-source = Henüz bölüm yok

# Under the heading when no { -source } is ready. The key opens the { -source-pl } screen.
episodes-empty-no-source-hint = AniList bu başlık için henüz bölüm listelemiyor ve hazır bir kaynak yok. Kaynaklar ekranını açmak için { $key } tuşuna basın.

# Heading of the empty episode table when the title has not aired yet.
episodes-empty-unaired = Henüz yayımlanan bölüm yok

# Under the heading when the title has not aired yet. The span is short, such as 2d 3h.
episodes-empty-unaired-hint = { $episode }. bölüm { $span } sonra yayımlanır.

# Heading of the empty episode table when a { -source } matched the title and listed nothing.
episodes-empty-none-listed = Bölüm listelenmedi

# Under the heading when a { -source } listed no episodes. The keys search by hand and pick another { -source }.
episodes-empty-none-listed-hint = Bu başlık için kaynak hiç bölüm listelemedi. Doğru eşleşmeyi aramak için { $search }, başka bir kaynak seçmek için { $pick } tuşuna basın.

# Toast when an episode has no { -release } to pick from.
episodes-no-releases = Bu bölüm için seçilecek sürümler yok.

# Toast when a download is asked for from a table listed from AniList alone. The key opens the { -source-pl } screen.
episodes-add-source-to-download = İndirmeden önce bir kaynak ekleyin. Kaynaklar ekranını açmak için { $key } tuşuna basın.

# Toast when marking the episodes before the highlighted one and the table is empty.
episodes-mark-none-listed = İşaretlenecek bölüm listelenmedi.

# Toast when marking the episodes before the first one.
episodes-mark-nothing-before = İlk bölümden önce bir şey yok.

# Toast when every episode before the highlighted one is already watched.
episodes-mark-already-watched = { $episode }. bölümden önceki her bölüm zaten izlendi.

# Toast after the episodes before the highlighted one are marked watched.
episodes-marked-watched =
    { $count ->
        [one] { $count } bölüm izlendi olarak işaretlendi.
       *[other] { $count } bölüm izlendi olarak işaretlendi.
    }

# Toast when the range typed for a download is not understood. The examples are typed as they are.
episodes-range-invalid = Bu aralık okunamadı. Tek bir bölüm (4), bir aralık (1-12) ya da bir bölümden itibaren hepsi (7-) yazın.

# Toast when no episode falls in the range typed for a download.
episodes-range-empty = Bu aralıkta bölüm yok. Başka bir aralık deneyin.

# Toast after a range is queued for download.
episodes-queueing =
    { $count ->
        [one] { $count } bölüm indirme için sıraya alınıyor.
       *[other] { $count } bölüm indirme için sıraya alınıyor.
    }

# Toast when a match is fixed from a list.
episodes-match-off-page = Eşleşmesini düzeltmek için başlığın sayfasını açın.

# Toast when a match is fixed and no title is highlighted.
episodes-match-nothing = Yeniden eşleştirmek için hiçbir şey seçili değil.

# Toast after a match is picked. The title is the candidate's own.
episodes-matched = Eşleşme: { $title }.

# After a { -release } in the picker: it holds both the subbed and the dubbed audio.
episodes-release-dual = Altyazılı ve dublajlı

# After a { -release } in the picker: it is dubbed.
episodes-release-dub = Dublajlı

# After a { -release } in the picker: it is the one Kaeri would play on its own.
episodes-release-current-pick = Şu anki seçim

