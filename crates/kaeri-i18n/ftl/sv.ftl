playback-mark-keys-end = ↵ markera slut   ←→ 1 s   esc tillbaka

playback-mark-keys-review = ↵ spara   tab start eller slut   ←→ 1 s   esc tillbaka

# Key help entry.
keys-action-mark-skips = Markera hopptider

# Note on the transition when finding a stream takes more than a moment. The time is how long it has taken so far.
