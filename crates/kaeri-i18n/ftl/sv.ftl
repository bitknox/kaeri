reading-usually-thursdays = Oftast på torsdagar

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-fridays = Oftast på fredagar

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-saturdays = Oftast på lördagar

# Under a cover or on a series page: when new chapters usually come out.
