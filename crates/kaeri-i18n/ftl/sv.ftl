# Shortcut: undo a skip the player made by itself.
shortcuts-undo-skip = Ångra ett automatiskt hopp

# Shortcut: change the playback speed.
shortcuts-speed = Snabbare eller långsammare

# Shortcut: answer the card that shows in the corner of the player.
shortcuts-answer-card = Svara på kortet i hörnet

# Shortcut: Escape closes the topmost thing in the player, one step at a time.
shortcuts-escape = Stäng kort, minispelaren, helskärmen och sedan spelaren

# Response of the close question: stop what runs and close.
close-stop-and-close = Stoppa och stäng

# Body of the close question when episodes download.
close-body-downloading =
    { $count ->
        [one] Ett avsnitt laddas ner eller väntar. Ska det fortsätta när fönstret stängs, eller stoppas?
       *[other] { $count } avsnitt laddas ner eller väntar. Ska de fortsätta när fönstret stängs, eller stoppas?
    }

# Body of the close question when episodes seed.
close-body-seeding =
    { $count ->
        [one] Ett avsnitt seedas. Ska det fortsätta när fönstret stängs, eller stoppas?
       *[other] { $count } avsnitt seedas. Ska de fortsätta när fönstret stängs, eller stoppas?
    }

# Body of the close question when some episodes download and others seed.
close-body-both = Avsnitt: { $downloading } laddas ner eller väntar och { $seeding } seedas. Ska de fortsätta när fönstret stängs, eller stoppas?

# Status in the sidebar and on the remote: the TV was not found again.
tv-status-not-found = { $name } hittades inte

# Title of the dialog that wants a code to be typed: no name known yet.
tv-connecting-title = Ansluter till tv:n

# Heading of a problem when the pairing code ran out.
tv-code-expired = Koden har gått ut

# Under a TV in the list: what choosing it does, for a screen reader.
tv-row-pairs-with = Parkopplar med den här tv:n

# Under a TV in the list: paired, but not seen on the network.
tv-row-away = Parkopplad, inte sedd på det här nätverket

# Under a TV in the list: found, not paired yet.
tv-row-new = Inte parkopplad än

# What a screen reader hears when a heading and its problem show together.
tv-problem-announce = { $heading }. { $problem }

# What a screen reader hears when no TV was found, then what to check.
tv-none-found-announce = Ingen tv hittades. { $detail }

# Line on the picker while the episode to play is known: the show, then the episode.
tv-title-episode = { $title }, avsnitt { $episode }

# Line under the show on the remote and the picker: which episode.
tv-episode = Avsnitt { $episode }

# Line on the remote under the show: the episode, then its title.
tv-episode-titled = Avsnitt { $episode } · { $title }

# Settings line of a paired TV: paired on a date, reached in the last minute.
tv-paired-seen-now = { $paired } · sedd just nu

# Accessible name of a track menu: the row, then the track chosen.
tv-track-choice = { $row }, { $track }

# The name this computer goes by in lists of a person's devices, such as a plugin store's.
shell-device-label = Linux-dator

# Under a Chromecast TV in Play on TV: this computer sends the TV the episode while it plays.
tv-cast-through-computer = Spelas via den här datorn

# The reason the system gives for keeping the computer from sleeping while it sends a TV with Chromecast built in the episode. Other apps and the desktop may show it.
tv-cast-inhibit-reason = Skickar ett avsnitt till en TV

# The heading over the TVs running Kaeri in Play on TV, once TVs with Chromecast built in are listed below them.
tv-network-group = På det här nätverket

# The sidebar place that lists your own sources, under the Sources heading.
linux-sidebar-your-sources = Dina källor

# Count of devices on a member's row in the members dialog, and after "Owner ·".
stores-device-count =
    { $count ->
        [one] { $count } enhet
       *[other] { $count } enheter
    }

# Accessible name of an owner's dialog: what the dialog does, then the plugin store it is for.
stores-dialog-title = { $title }, { $store }

# Title of the status page in an owner's dialog when the plugin store could not be reached. The reason is not shown here.
stores-owner-unreachable = Det gick inte att nå tilläggsbutik

# Title of the status page in an owner's dialog when the plugin store did not answer in time.
stores-owner-no-answer = tilläggsbutik svarade inte

# Line under it.
stores-owner-no-answer-detail = Den kanske är upptagen, eller så är datorn den körs på avstängd.

# Title of the status page in an owner's dialog when this device is offline.
stores-owner-needs-connection = tilläggsbutik behöver en anslutning

# Line under it.
stores-owner-needs-connection-detail = Försök igen när den här enheten är online igen.

# Red line in the invite dialog when this device is offline and a link cannot be made.
stores-owner-link-offline = Det går inte att skapa en länk medan den här enheten är offline.

# Line over a new invite link made for a named person. The time is the one the link stops working.
stores-send-link-until = Skicka länken. Den fungerar en gång, till { $until }.

# Row title in who-can-join: switching on lets anyone with the link join. Shown while it is on.
stores-open-on-detail = De går med utan namn. Stänger du av det upphör länken. Slår du på det igen skapas en ny.

# Row subtitle in who-can-join while it is off.
stores-open-off-detail = Bara personer du bjuder in kan gå med. Slår du på det kan alla med länken gå med, utan namn.

# Line on the summary row of devices that joined with the link, when joining is on.
stores-open-no-names = Inga namn sparas.

# Line on the summary row of devices that joined with the link, when joining is off.
stores-open-keep-working = De fortsätter fungera tills du tar bort dem.

# Line under a device that joined with the link: when the store last saw it.
stores-device-seen = Sedd { $when }

# Line under a device that joined with the link and has not been seen since.
stores-device-never-seen = Inte sedd sedan anslutningen

# Short title of the publish dialog, over the plugin store's name.
stores-publish-short = Publicera ett tillägg

# Line in the publish dialog when this device has no plugin to offer. Follows stores-publish-none.
stores-publish-none-hint = Ett tillägg du bygger eller installerar visas här.

# Line under a plugin in the publish dialog that the store does not have yet.
stores-not-published = Inte i tilläggsbutik än

# Line under a plugin in the publish dialog that the store has in another version.
stores-store-offers = Tilläggsbutiken har { $version }

# Line under a plugin in the publish dialog whose version the store already has.
stores-published-current = Uppdaterad i tilläggsbutik

# Word at the end of that row.
stores-published-state = Publicerad

# Accessible name of a row's Publish button.
stores-publish-label = Publicera { $name } { $version }

# Footnote on the recovery key dialog; the lock is the account password, asked through polkit.
rkey-lock-linux = Du kan se den igen i Inställningar, Enheter, när du har angett ditt kontolösenord.

# Reason polkit shows when it asks for the account password before the recovery key.
rkey-lock-reason = Visa återställningsnyckeln för Kaeri

# Accessible name of the sidebar account row when it opens the profile popover.
profiles-popover-name = Profiler

# Button that makes the first profile when none exists; the Profiles pane’s add row.
profiles-add-row-action = Lägg till

# Name of the folder picker dialog for a cloud folder on this computer.
cloud-folder-chooser = Välj en mapp

# Button that saves the recovery key to a file.
rkey-save-as-file = Spara som fil

# Button that closes the dialog that shows a device paired.
pair-done-action = Klar

# Under a release in the source picker: how many people share it right now.
source-picker-seeders-linux =
    { $count ->
        [one] En seeder
       *[other] { $count } seeders
    }

# Tooltip on the header bar button that shows the sidebar while the window is narrow.
sidebar-show = Visa sidofältet

# Faint line over the calendar's placeholders while it loads.
activity-calendar = Läser in kalendern

# Faint line over a title page's episode placeholders while they load.
activity-episodes = Läser in avsnitt

# Faint line over the Sources page while the sources are checked.
activity-sources = Kontrollerar källor

# Faint line over the Downloads page while it loads.
activity-downloads = Läser in hämtningar

# Faint line over Search's placeholders while it lists titles with no query typed.
activity-browse = Läser in titlar

# A transfer rate: a size already worded, per second.
size-per-second = { $size }/s

# A wait that is over.
time-now = Nu

# How long ago, when it was inside the last minute.
time-just-now = Just nu

# A length of time said for a screen reader, in hours.
spoken-hours =
    { $count ->
        [one] { $count } timme
       *[other] { $count } timmar
    }

# A length of time said for a screen reader, in minutes.
spoken-minutes =
    { $count ->
        [one] { $count } minut
       *[other] { $count } minuter
    }

# A length of time said for a screen reader, in seconds.
spoken-seconds =
    { $count ->
        [one] { $count } sekund
       *[other] { $count } sekunder
    }

