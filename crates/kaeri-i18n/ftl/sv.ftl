# Under a cover or on a series page: when new chapters usually come out.
reading-usually-mondays = Oftast på måndagar

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-tuesdays = Oftast på tisdagar

# Under a cover or on a series page: when new chapters usually come out.
