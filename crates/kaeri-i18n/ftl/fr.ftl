# A choice of reading Search's Started filter: series that started at any time.
read-search-started-any = Toutes les dates

# A choice of reading Search's Started filter: series that started in the last 12 months.
read-search-started-year = 12 derniers mois

# A choice of reading Search's Started filter: series that started in the last 3 years.
read-search-started-3-years = 3 dernières années

# Under a source's hit in Search: the chapters it holds, from the first.
read-hit-chapters = Chapitres 1 à { $last }

# Under a source's hit in Search: a web novel's episodes it holds, from the first.
read-hit-episodes = Épisodes 1 à { $last }

# Under a source's hit in Search: a light novel's parts it holds.
read-hit-parts =
    { $count ->
        [one] 1 partie
        [many] { $count } de parties
       *[other] { $count } parties
    }

# Under a source's hit in Search: the book files it holds.
read-hit-files =
    { $count ->
        [one] 1 fichier
        [many] { $count } de fichiers
       *[other] { $count } fichiers
    }

# Under a source's hit in Search: the book files it holds, all in one format ("CBZ").
read-hit-files-format =
    { $count ->
        [one] 1 fichier · { $format }
        [many] { $count } de fichiers · { $format }
       *[other] { $count } fichiers · { $format }
    }

# The name of the folders on this device, which read as one source: a Search group's heading, the source a series reads from, "In Folders" on a search result. It stands alone, with no word for its kind beside it.
read-source-folders = Dossiers

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since January".
reading-since-january = depuis janvier

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since February".
reading-since-february = depuis février

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since March".
reading-since-march = depuis mars

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since April".
reading-since-april = depuis avril

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since May".
reading-since-may = depuis mai

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since June".
reading-since-june = depuis juin

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since July".
reading-since-july = depuis juillet

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since August".
reading-since-august = depuis août

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since September".
reading-since-september = depuis septembre

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since October".
reading-since-october = depuis octobre

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since November".
reading-since-november = depuis novembre

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since December".
reading-since-december = depuis décembre

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Vous avez rejoint { $store } en tant que { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Vous avez rejoint { $store } sans nom.

# Toast after leaving a plugin store.
store-left = Vous avez quitté { $store }. Ses plugins restent installés.

# Toast after a plugin is deleted from this device.
plugin-removed = { $plugin } supprimé.

# Toast after a store owner removes a member.
store-member-removed = Membre retiré. Ses appareils ne fonctionnent plus avec cette boutique de plugins.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Invitation annulée. Le lien ne fonctionne plus.

# Toast after cancelling an invite that people joined with.
store-invite-cancelled-kept =
    { $count ->
        [one] Invitation annulée. La personne qui l’a utilisée reste membre.
        [many] Invitation annulée. Les { $count } personnes qui l’ont utilisée restent membres.
       *[other] Invitation annulée. Les { $count } personnes qui l’ont utilisée restent membres.
    }

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Toute personne disposant du lien de la boutique de plugins peut désormais la rejoindre. Copiez-le depuis l’écran des membres.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Seules les personnes que vous invitez peuvent désormais rejoindre.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
        [one] Seules les personnes que vous invitez peuvent désormais rejoindre. L’appareil qui a rejoint avec le lien reste actif jusqu’à ce que vous le retiriez.
        [many] Seules les personnes que vous invitez peuvent désormais rejoindre. Les { $devices } appareils qui ont rejoint avec le lien restent actifs jusqu’à ce que vous les retiriez.
       *[other] Seules les personnes que vous invitez peuvent désormais rejoindre. Les { $devices } appareils qui ont rejoint avec le lien restent actifs jusqu’à ce que vous les retiriez.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Cet appareil ne fonctionne plus avec cette boutique de plugins.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Tous les appareils ayant rejoint avec le lien ont été retirés.

# Toast after a plugin is published to a store.
plugin-published = { $plugin } { $version } publié.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } n’est plus proposé.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Page d’administration ouverte dans votre navigateur. Le lien ne fonctionne qu’une fois, pendant 10 minutes.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Impossible d’ouvrir un navigateur ({ $reason }). Sur la machine de la boutique de plugins, lancez « kaeri store admin » pour afficher un lien.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = { $plugin } { $version } installé, mais les plugins sont désactivés dans l’ordre des sources, il n’est donc pas utilisé.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = { $plugin } installé, mais { $id } est le nom d’une source intégrée, il n’a donc pas été chargé.

# Toast after a plugin is installed and ready to use.
plugin-installed = { $plugin } { $version } installé.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = { $plugin } installé, mais il n’a pas pu se charger. { $reason }

# Toast after a plugin is installed but was built for an older plugin interface, so it was not loaded.
plugin-installed-outdated = { $plugin } est installé, mais il a été conçu pour une version plus ancienne de Kaeri et doit être mis à jour. Demandez une nouvelle version à son auteur.

# Note on the sources screen when plugins were skipped because they were built for an older plugin interface.
plugins-outdated =
    { $count ->
        [one] Un plugin a été conçu pour une version plus ancienne de Kaeri et doit être mis à jour : { $names }.
        [many] { $count } plugins ont été conçus pour une version plus ancienne de Kaeri et doivent être mis à jour : { $names }.
       *[other] { $count } plugins ont été conçus pour une version plus ancienne de Kaeri et doivent être mis à jour : { $names }.
    }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Mise à jour prête : { $names }.
        [many] Mises à jour prêtes : { $names }.
       *[other] Mises à jour prêtes : { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Impossible de charger les plugins. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Il n’y a pas de jeton pour { $store } sur cet appareil. Rejoignez { $store } avec une nouvelle invitation.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Vous n’avez plus rejoint cette boutique de plugins.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = La clé de cette boutique de plugins sur cet appareil est endommagée. Quittez la boutique de plugins et rejoignez-la avec une nouvelle invitation.

# Error: a store rejected this device's token.
store-device-refused = { $store } n’accepte plus cet appareil. Rejoignez { $store } avec une nouvelle invitation.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Impossible de joindre { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = Vous avez rejoint { $store } à l’adresse { $current }, mais ce lien pointe vers { $target }. Si la boutique de plugins a changé d’adresse, quittez-la d’abord, puis rejoignez-la.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Vous avez rejoint { $store } en tant que { $member }. Ce lien vous ferait rejoindre sans votre nom : rien n’a été modifié.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } n’est pas la boutique de plugins de l’invitation ({ $reason }). Rien n’a été rejoint.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Impossible d’enregistrer le jeton de cette boutique de plugins. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Cette invitation a déjà été utilisée, a été annulée ou a expiré. Demandez-en une nouvelle.

# Error: the invite was used as many times as it allows.
store-invite-used-up = Cette invitation a été utilisée au maximum. Demandez-en une nouvelle à { $owners }.

# Error: the invite's end date passed.
store-invite-ended = Cette invitation a pris fin { $when }. Demandez-en une nouvelle à { $owners }.

# Error: an owner cancelled the invite.
store-invite-was-cancelled = Cette invitation a été annulée. Demandez-en une nouvelle à { $owners }.

# Line under any of these when the store has a contact.
store-invite-contact = Contact : { $contact }

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Ce lien ne permet plus à personne de rejoindre. Demandez au propriétaire de la boutique de plugins un nouveau lien ou une invitation.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } est le nom d’une source intégrée, il ne peut pas être un plugin.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } ne propose plus { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } a modifié { $plugin } depuis qu’il a été affiché. Consultez-le de nouveau avant de l’installer.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } est installé depuis { $store }, qui le tient à jour.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } déclare déjà { $plugin }. Supprimez d’abord ce fichier, sinon deux copies s’exécuteraient.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Impossible d’installer { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Impossible de publier { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } n’est plus dans le dossier du plugin.

# Error: a book source cannot be published to a store whose server is too old to list book sources.
store-takes-no-books = { $store } ne liste pas encore les sources de livres. Son propriétaire peut mettre à jour la boutique de plugins pour les ajouter.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Cet appareil a rejoint { $store } avec son lien. Collez le même lien sur l’autre appareil.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = La boutique de plugins a envoyé un lien qui ne fonctionne pas. Demandez à son propriétaire de vérifier la boutique de plugins. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = La boutique de plugins a créé un lien avec une autre clé. Vérifiez l’adresse utilisée pour la lancer.

# Error: the store's server has no admin page.
store-admin-missing = { $store } n’a pas de page d’administration. Son serveur est peut-être plus ancien.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } a envoyé un lien d’administration vers une autre adresse.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = Le serveur de { $store } est plus ancien et ne permet pas de rejoindre avec un lien. Mettez-le d’abord à jour.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = Désactivé : { $name }. Kaeri l’ignore lors de la recherche d’épisodes.

# Toast after a source (plugin) is switched on.
source-switched-on = Activé : { $name }.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } n’est pas chargé. Vérifiez qu’il est installé sous les sources.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = Ce titre utilise maintenant { $name }.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Impossible d’enregistrer ce choix. { $reason }

# Note on the sources screen: the proxy for torrent traffic failed its check, so torrents wait.
torrent-proxy-waiting = La vérification du proxy a échoué. Les torrents démarrent dès qu’elle réussit.

# Note on the sources screen: the proxy for torrent traffic hasn't been checked yet.
torrent-proxy-unchecked = Les torrents démarrent dès que la vérification du proxy réussit.

# Error: the link or file given to open is not a magnet link, an info hash or a torrent file.
torrent-link-unusable = Ce n’est ni un lien magnet ni un fichier torrent.

# Error: a link the viewer opened can't play or download while torrent playback is off.
torrent-link-playback-off = Activez la lecture de torrents dans les paramètres pour lire vos propres liens.

# Error: the search for what a link the viewer opened is didn't work. The reason comes from the catalogue.
opened-search-failed = Impossible de chercher ce titre. { $reason }

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = Kaeri s’est fermé avant le démarrage des torrents.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Impossible de démarrer la session torrent. { $reason }

# Toast when the proxy setting can't be used. The reason comes from the proxy setting.
torrent-proxy-unusable = Le réglage du proxy est inutilisable. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on and a proxy set.
sources-reloaded-torrents-checking = Sources rechargées. Les torrents démarrent dès que la vérification du proxy réussit.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrents désactivés. La session a été arrêtée.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = En attente de la limite de requêtes d’AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Attente de { $wait } à cause de la limite d’AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList ne répond pas. Affichage des données d’un autre service pour l’instant.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Aucun service de métadonnées n’a répondu. Affichage des dernières données en cache.

# Toast when AniList answers again.
notice-anilist-back = AniList est de nouveau disponible.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Visionnages en groupe ne sont pas inclus dans cette application.

# Notice after the demo is removed. It offers Undo for 8 seconds.
sources-demo-removed = Démo retirée

# Notice after the first plugin from a store installs while the demo is on. It offers Remove demo for 8 seconds.
stores-ready-demo-stays = { $store } est prête. La démo reste en dernier dans Vos sources.

# The page the browser shows after signing in to a cloud drive on a computer (Windows, Linux or the terminal), once Kaeri has caught the sign-in. The person goes back to the app by themselves.
cloud-loopback-done = Vous pouvez fermer cet onglet et revenir à Kaeri.

# The error line under Sync on a device that another of the person's devices removed from sync. Joining again, with a code or the recovery key, or setting sync up again adds it as a new device.
sync-device-removed = Cet appareil a été retiré de la synchronisation sur un autre appareil. Rejoignez-la de nouveau pour le synchroniser.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Connecté à { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Connecté à { $tracker }. Le jeton est enregistré dans le trousseau du système.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Connecté à { $tracker }. Aucun trousseau n'est disponible, donc le jeton est dans un fichier privé sur cet appareil.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Connecté à { $tracker }, mais le jeton n'a pas été enregistré. Il faudra vous reconnecter la prochaine fois. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Impossible d'enregistrer le jeton de connexion. Essayez de vous reconnecter. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Impossible de vous connecter à { $tracker }. Réessayez. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = La connexion à { $tracker } s'est arrêtée avant la fin. Réessayez. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Impossible d'obtenir un jeton de { $tracker }. Essayez de vous reconnecter. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Impossible d'ouvrir un navigateur pour la connexion. Vérifiez qu'un navigateur est installé, puis réessayez. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Une réponse de connexion de { $tracker } est arrivée, mais aucune connexion ne l'attendait. Recommencez la connexion.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = La réponse de connexion de { $tracker } ne correspond pas à la demande. Recommencez la connexion.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = La connexion à { $tracker } est revenue sans jeton. Réessayez.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Impossible de finir la connexion à MyAnimeList : cette version n'a pas de client pour elle.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Kitsu se connecte depuis l'écran Comptes.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = La connexion à { $tracker } n'est pas encore prise en charge.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = La connexion à { $tracker } demande une redirection par le navigateur, que cette application ne peut pas recevoir.

# Toast when AniList is set to a sign-in method only the Kaeri app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Cette méthode de connexion AniList ne fonctionne que dans l'application Kaeri. Pour vous connecter ici, mettez { $setting } à « loopback » dans le fichier de configuration.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList a besoin d'un identifiant et d'un secret de client. Renseignez { $client } et { $secret } dans le fichier de configuration, puis reconnectez-vous. Pour obtenir l'adresse de connexion, lancez kaeri --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Coller un code n'est pas possible ici. Quittez et lancez kaeri --login à la place.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList a besoin d'un identifiant de client. Enregistrez une application de type « other » sur myanimelist.net/apiconfig, puis réglez { $setting } dans le fichier de configuration.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = En attente du retour de { $tracker }…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList n'a pas fourni de jeton de renouvellement. Vous devrez vous reconnecter dans un mois environ.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Réglez d'abord { $setting } dans le fichier de configuration.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Déconnecté de { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Déconnecté de { $tracker }. Une modification en attente est conservée pour la prochaine connexion.
        [many] Déconnecté de { $tracker }. { $count } modifications en attente sont conservées pour la prochaine connexion.
       *[other] Déconnecté de { $tracker }. { $count } modifications en attente sont conservées pour la prochaine connexion.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Impossible de vous déconnecter de { $tracker }. Réessayez. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Impossible d'enregistrer ce réglage. { $cause }

# Toast when the proxy for torrent traffic was saved.
notice-proxy-saved = Le trafic des torrents passe désormais par le proxy.

# Toast when the proxy for torrent traffic was turned off.
notice-proxy-removed = Les torrents se connectent désormais directement, sans proxy.

# Toast when the proxy could not be checked. The cause says why.
notice-proxy-not-checked = Impossible de vérifier le proxy. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Impossible de conserver le mot de passe du proxy. Saisissez-le à nouveau pour essayer de l'enregistrer. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Impossible d'enregistrer ce réglage. { $value } n'est pas une valeur valide pour { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Impossible de réinitialiser les réglages de cette série. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Impossible d'enregistrer ce choix de sous-titres. Cette série n'a pas utilisé ces sous-titres auparavant.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Données de correspondance actualisées.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Impossible d'actualiser les données de correspondance ({ $datasets }). Nouvelle tentative dans { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, épisode { $episode }, a été diffusé pendant votre absence.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
        [one] Un nouvel épisode d'une série que vous suivez a été diffusé. Le calendrier l'affiche.
        [many] { $count } nouveaux épisodes de séries que vous suivez ont été diffusés. Le calendrier les affiche.
       *[other] { $count } nouveaux épisodes de séries que vous suivez ont été diffusés. Le calendrier les affiche.
    }

# Toast when a new release of Kaeri is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = La version { $tag } est disponible. Lancez kaeri --update pour l'installer.

# The reason a proxy was refused: it has no host or no port.
