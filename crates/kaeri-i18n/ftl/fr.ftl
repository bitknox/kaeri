# Line on Linux telling what to replace.
updates-saved-replace = Version { $version } enregistrée dans Téléchargements. Remplacez l’ancien fichier, { $file }, par celui-ci pour mettre à jour.

# Line on Linux telling what to replace, file unknown.
updates-saved-replace-plain = Version { $version } enregistrée dans Téléchargements. Remplacez l’ancien fichier par celui-ci pour mettre à jour.

# The server refused. The code is a number.
updates-why-server = Le téléchargement s’est arrêté : le serveur l’a refusé ({ $code }). Réessayez plus tard.

# The connection broke.
updates-why-connection = Le téléchargement s’est arrêté : la connexion a été perdue. Réessayez.

# The file could not be saved. The reason is a sentence fragment.
updates-why-save = Le téléchargement n’a pas pu être enregistré : { $reason }

# The file has the wrong size. Sizes are already formatted.
updates-why-size = Le téléchargement fait { $got }, et non les { $expected } annoncés pour cette version.

# The file does not match its checksum.
updates-why-checksum = Le téléchargement ne correspond pas à la somme de contrôle annoncée pour cette version.

# Android: the file does not match its checksum, and nothing was installed.
updates-why-checksum-android = Le téléchargement ne correspond pas à la somme de contrôle annoncée pour cette version. Il n’a donc pas été installé.

# Android: not an app.
updates-why-not-app = Le téléchargement n’est pas une application Android. Il n’a donc pas été installé.

# Android: another app.
updates-why-other-app = Le téléchargement est une autre application. Il n’a donc pas été installé.

# Android: not signed with the right key.
updates-why-unsigned = Le téléchargement n’est pas signé avec la clé de Kaeri. Il n’a donc pas été installé.

# Android: not newer.
updates-why-not-newer = Le téléchargement n’est pas plus récent que cette version. Il n’a donc pas été installé.

# Android: no space.
updates-why-space = Espace libre insuffisant pour la mise à jour. Libérez de l’espace et réessayez.

# Android: install failed.
updates-why-install = Impossible d’installer la mise à jour. Réessayez.

# Android: the download did not work.
updates-why-download = Impossible de télécharger la mise à jour. Vérifiez la connexion et réessayez.

# Android: the download did not start.
updates-why-start = Impossible de lancer le téléchargement. Réessayez.

# Android: the system stopped the download.
updates-why-system = Android a arrêté le téléchargement

# The installer would not start. The reason is a sentence fragment.
updates-why-installer = L’installeur n’a pas pu démarrer : { $reason }

# Title of the step.
updates-allow-title = Autoriser Kaeri à installer sa mise à jour

# Name of the Android setting.
updates-unknown-apps = Installer des applications inconnues

# Step one.
updates-allow-step-1 = Choisissez Ouvrir les réglages. Android affiche les applications autorisées à en installer d’autres.

# Step two.
updates-allow-step-2 = Activez Kaeri.

# Step three.
updates-allow-step-3 = Appuyez sur Retour. La mise à jour se télécharge, et Android vous demande de la confirmer.

# Line while waiting for the switch. The path is the Android settings path.
updates-allow-waiting = En attente de l’interrupteur. Si la page d’Android ne s’est pas ouverte, cherchez-la sous { $path }.

# Line the first time. The path is the Android settings path.
updates-allow-once = Android ne demande cela qu’une fois. Si sa page ne s’ouvre pas, l’interrupteur se trouve sous { $path }.

# Switch in the Updates section of Settings. Off by default.
updates-beta = Mises à jour bêta

# Line under the switch.
updates-beta-detail = Recevez chaque nouvelle version dès sa création. Sans cela, les mises à jour arrivent une fois par semaine.

# Status line on a beta build when beta updates are off: no stable version is newer yet.
updates-stable-behind = Vous avez la version { $version }, une bêta. Les mises à jour reprennent quand une version stable plus récente sort.

# The version in About when the running build is a beta.
updates-version-beta = { $version } bêta

