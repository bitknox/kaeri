# A reason on its own, as a toast or a failed play's explanation. The reason is one of the engine's own reasons, so it is translated.
notice-reason = { $reason }

# Reason: no source is set up, so nothing can be played or downloaded. Shown in a toast.
cause-no-sources = Aucune sources n'est configurée. Ajoutez-en une dans l'écran Sources.

# Reason: the play waited two minutes for a connection and the device stayed offline. Shown in a toast and on the failure screen.
cause-no-connection = Pas de connexion. Réessayez une fois de nouveau en ligne.

# A play's explanation: the episode's broadcast is still ahead. The "when" says today, tomorrow or a date.
notice-not-aired = L'épisode { $episode } est diffusé { $when }.

# A play's explanation: the episode is after the next one to air. The "when" says when that one airs.
notice-not-aired-yet = L'épisode { $episode } n'est pas encore diffusé. L'épisode { $next } est diffusé { $when }.

# Part of an air time: the broadcast is later today. The time is the viewer's local time.
cause-airs-today = aujourd'hui à { $time }

# Part of an air time: the broadcast is tomorrow. The time is the viewer's local time.
cause-airs-tomorrow = demain à { $time }

# Part of an air time: the broadcast is within the next week.
cause-airs-in-days =
    { $days ->
        [one] dans un jour à { $time }
        [many] dans { $days } jours à { $time }
       *[other] dans { $days } jours à { $time }
    }

# Part of an air time: the broadcast is more than a week away. The date is year-month-day.
cause-airs-on-date = le { $date } à { $time }

# Reason: the source answered but gave nothing to play.
cause-no-playable-stream = La source a répondu, mais sans rien à lire. Essayez une autre source.

# Reason: no source could be matched to the title. The detail is what each source said.
cause-title-no-match = Impossible de faire correspondre ce titre : { $detail }

# Reason: the source the person picked is no longer installed or enabled.
cause-source-gone = La source { $source } n'est plus disponible. Choisissez-en une autre.

# Reason: the release the person picked would not start. The detail comes from the source.
cause-release-failed = Impossible de lancer cette release : { $detail }

# Reason: a play waited too long for its sources to give it a stream, and gave up.
cause-sources-timed-out = Les sources ont mis trop de temps à répondre. Réessayez, ou choisissez une autre source.

# Reason: every source matched the title but none has the episode. The detail is what each said.
cause-no-source-has-episode = Aucune source n'a l'épisode { $episode } : { $detail }

# Reason: the source streams episodes but only torrents can be downloaded.
cause-source-cannot-download = Cette source permet de regarder des épisodes, mais pas de les télécharger.

# Reason: the title was never listed by a source, so it can't be downloaded.
cause-no-source-could-list-show = Aucune source n'a pu répertorier cette série, elle ne peut donc pas être téléchargée.

# Part of a finished download's toast: subtitle files were merged into the video.
cause-subtitles-merged =
    { $tracks ->
        [one] Une piste de sous-titres a été intégrée.
        [many] { $tracks } pistes de sous-titres ont été intégrées.
       *[other] { $tracks } pistes de sous-titres ont été intégrées.
    }

# Part of a finished download's toast: merging failed, so the subtitles stay as files beside it.
cause-subtitles-left-apart = Les sous-titres restent dans des fichiers séparés. { $reason }

# Part of a download toast: how many episodes of the range were in the queue already.
cause-already-in-downloads =
    { $count ->
        [one] Un épisode est déjà dans les téléchargements.
        [many] { $count } épisodes sont déjà dans les téléchargements.
       *[other] { $count } épisodes sont déjà dans les téléchargements.
    }

