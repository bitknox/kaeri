# Part of the { -plugin-store } summary: how many { -plugin } updates are waiting.
sources-stores-updates =
    { $count ->
        [one] { $count } aggiornamento
        [many] { $count } aggiornamenti
       *[other] { $count } aggiornamenti
    }

# Part of the { -plugin-store } summary: how many { -plugin-store-pl } have stopped accepting this device.
sources-stores-removed =
    { $count ->
        [one] { $count } negozio di plugin non accetta più questo dispositivo
        [many] { $count } negozi di plugin non accettano più questo dispositivo
       *[other] { $count } negozi di plugin non accettano più questo dispositivo
    }

