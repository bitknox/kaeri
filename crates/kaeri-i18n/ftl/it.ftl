# Preview note beside the accounts settings.
settings-accounts-note = Kaeri funziona senza account. La cronologia resta su questo computer quando esci.

# Preview note beside the Discord settings when presence is on.
settings-presence-note-on = Il tuo profilo Discord mostra cosa guardi mentre un episodio è in riproduzione.

# Preview note beside the Discord settings when presence is off.
settings-presence-note-off = Disattivata. Se attiva, il tuo profilo Discord mostra cosa guardi mentre un episodio è in riproduzione.

# Preview note beside the advanced settings.
settings-advanced-note = Un'opzione qui può annullare un'impostazione di riproduzione, come l'upscaling o la modalità notturna. La maggior parte delle persone non ne ha mai bisogno.

# Button that opens the page of the new version of the app.
