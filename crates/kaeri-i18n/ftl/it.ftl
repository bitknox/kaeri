# Filter row label in the search filters overlay.
lists-filter-year = Anno

# Filter row label in the search filters overlay.
lists-filter-season = Stagione

# Filter row label in the search filters overlay.
lists-filter-format = Formato

# Filter row label in the search filters overlay.
