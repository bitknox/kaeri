# Line on Linux when the file is saved to the downloads folder.
updates-saved = Wersja { $version } zapisana w folderze Pobrane

# Line on Linux telling what to replace.
updates-saved-replace = Wersja { $version } zapisana w folderze Pobrane. Aby zaktualizować, zastąp nią stary plik: { $file }.

# Line on Linux telling what to replace, file unknown.
updates-saved-replace-plain = Wersja { $version } zapisana w folderze Pobrane. Aby zaktualizować, zastąp nią stary plik.

# The server refused. The code is a number.
updates-why-server = Pobieranie przerwane: serwer je odrzucił ({ $code }). Spróbuj później.

# The connection broke.
updates-why-connection = Pobieranie przerwane: połączenie zostało utracone. Spróbuj ponownie.

# The file could not be saved. The reason is a sentence fragment.
updates-why-save = Nie udało się zapisać pliku: { $reason }

# The file has the wrong size. Sizes are already formatted.
updates-why-size = Pobrany plik ma { $got }, a dla tej wersji podano { $expected }.

# The file does not match its checksum.
updates-why-checksum = Pobrany plik nie zgadza się z sumą kontrolną podaną dla tej wersji.

# Android: the file does not match its checksum, and nothing was installed.
updates-why-checksum-android = Pobrany plik nie zgadza się z sumą kontrolną podaną dla tej wersji, więc nie został zainstalowany.

# Android: not an app.
updates-why-not-app = Pobrany plik nie jest aplikacją Androida, więc nie został zainstalowany.

# Android: another app.
updates-why-other-app = Pobrany plik to inna aplikacja, więc nie został zainstalowany.

# Android: not signed with the right key.
updates-why-unsigned = Pobrany plik nie jest podpisany kluczem aplikacji Kaeri, więc nie został zainstalowany.

# Android: not newer.
updates-why-not-newer = Pobrany plik nie jest nowszy niż ta wersja, więc nie został zainstalowany.

# Android: no space.
updates-why-space = Za mało wolnego miejsca na aktualizację. Zwolnij trochę i spróbuj ponownie.

# Android: install failed.
updates-why-install = Nie udało się zainstalować aktualizacji. Spróbuj ponownie.

# Android: the download did not work.
updates-why-download = Nie udało się pobrać aktualizacji. Sprawdź połączenie i spróbuj ponownie.

# Android: the download did not start.
updates-why-start = Nie udało się rozpocząć pobierania. Spróbuj ponownie.

# Android: the system stopped the download.
updates-why-system = Android zatrzymał pobieranie

# The installer would not start. The reason is a sentence fragment.
updates-why-installer = Instalator nie mógł się uruchomić: { $reason }

# Title of the step.
updates-allow-title = Zezwól aplikacji Kaeri na instalowanie jej aktualizacji

# Name of the Android setting.
updates-unknown-apps = Instalowanie nieznanych aplikacji

# Step one.
updates-allow-step-1 = Wybierz Otwórz ustawienia. Android pokaże aplikacje, które mogą instalować inne aplikacje.

# Step two.
updates-allow-step-2 = Włącz Kaeri.

# Step three.
updates-allow-step-3 = Naciśnij Wstecz. Aktualizacja się pobierze, a Android poprosi o jej potwierdzenie.

# Line while waiting for the switch. The path is the Android settings path.
updates-allow-waiting = Czekam na przełącznik. Jeśli strona Androida się nie otworzyła, znajdziesz ją w: { $path }.

# Line the first time. The path is the Android settings path.
updates-allow-once = Android pyta o to raz. Jeśli jego strona się nie otworzy, przełącznik jest w: { $path }.

# Switch in the Updates section of Settings. Off by default.
updates-beta = Aktualizacje beta

# Line under the switch.
updates-beta-detail = Dostawaj każdą nową wersję zaraz po zbudowaniu. Bez tego aktualizacje przychodzą raz w tygodniu.

# Status line on a beta build when beta updates are off: no stable version is newer yet.
updates-stable-behind = Masz { $version }, wersję beta. Aktualizacje wrócą, gdy pojawi się nowsza wersja stabilna.

# The version in About when the running build is a beta.
updates-version-beta = { $version } beta

