    { $days ->
        [one] za jeden dzień o { $time }
        [few] za { $days } dni o { $time }
        [many] za { $days } dni o { $time }
       *[other] za { $days } dni o { $time }
    }

# Part of an air time: the broadcast is more than a week away. The date is year-month-day.
