# Toast when something that needs a title's full page is asked from a list.
title-recommendations-off-page = Otwórz stronę tytułu, aby zobaczyć rekomendacje.

# Toast when something that needs a title's full page is asked from a list.
title-seasons-off-page = Otwórz stronę tytułu, aby zobaczyć powiązane sezony.

# Toast when a title has no trailer on record.
title-no-trailer = Dla tego tytułu nie ma zapisanego zwiastuna.

# Toast when a title has no recommendations.
title-no-recommendations = Nie znamy rekomendacji dla tego tytułu.

# Toast when a title has no connected seasons.
title-no-seasons = Nie znamy powiązanych sezonów tego tytułu.

# Toast when the { -source } picker is asked for from a list.
title-pin-off-page = Otwórz stronę tytułu, aby wybrać dla niego źródło.

# Toast when the { -source } picker is asked for and no { -source } is registered. They register a moment after launch.
title-no-sources-yet = Źródła wciąż się wczytują. Spróbuj ponownie za chwilę.

# Toast when a list status or rating is asked for and no { -tracker } is signed in. The command is typed as it is.
