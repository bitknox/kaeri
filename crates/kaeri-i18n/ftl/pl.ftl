reading-downloads-done-series = Rozdziały z { $count } serii są gotowe do czytania offline.

# Row heading on reading's Home: manga that are trending on AniList now.
read-home-trending-manga = Manga na topie

# Row heading on reading's Home: webtoons that are trending on AniList now.
read-home-trending-webtoons = Webtoony na topie

# Row heading on reading's Home: light novels that are trending on AniList now.
read-home-trending-novels = Light novel na topie

# Row heading on reading's Home: the most popular manga that started in the last 12 months.
read-home-new-manga = Nowa manga

# Row heading on reading's Home: the most popular webtoons that started in the last 12 months.
read-home-new-webtoons = Nowe webtoony

# Row heading on reading's Home: the most popular light novels that started in the last 12 months.
read-home-new-novels = Nowe light novel

# Side text beside a New row's heading, in a quieter style: what the row covers.
read-home-new-side = Ostatnie 12 miesięcy

# Row heading on reading's Home: the most popular manga that have finished.
read-home-finished-manga = Zakończona manga

# Row heading on reading's Home: the most popular webtoons that have finished.
read-home-finished-webtoons = Zakończone webtoony

# Row heading on reading's Home: the most popular light novels that have finished.
read-home-finished-novels = Zakończone light novel

# Side text beside a Finished row's heading, in a quieter style: how the row is sorted.
read-home-finished-side = Najpopularniejsze

# A choice of reading Search's Started filter: series that started at any time.
read-search-started-any = Kiedykolwiek

# A choice of reading Search's Started filter: series that started in the last 12 months.
read-search-started-year = Ostatnie 12 miesięcy

# A choice of reading Search's Started filter: series that started in the last 3 years.
read-search-started-3-years = Ostatnie 3 lata

# Under a source's hit in Search: the chapters it holds, from the first.
read-hit-chapters = Rozdziały od 1 do { $last }

# Under a source's hit in Search: a web novel's episodes it holds, from the first.
read-hit-episodes = Odcinki od 1 do { $last }

# Under a source's hit in Search: a light novel's parts it holds.
read-hit-parts =
    { $count ->
        [one] 1 część
        [few] { $count } części
        [many] { $count } części
       *[other] { $count } części
    }

# Under a source's hit in Search: the book files it holds.
read-hit-files =
    { $count ->
        [one] 1 plik
        [few] { $count } pliki
        [many] { $count } plików
       *[other] { $count } pliku
    }

# Under a source's hit in Search: the book files it holds, all in one format ("CBZ").
read-hit-files-format =
    { $count ->
        [one] 1 plik · { $format }
        [few] { $count } pliki · { $format }
        [many] { $count } plików · { $format }
       *[other] { $count } pliku · { $format }
    }

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Dołączono do { $store } jako { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Dołączono do { $store } bez nazwy.

# Toast after leaving a plugin store.
store-left = Opuszczono { $store }. Jego wtyczki pozostają zainstalowane.

# Toast after a plugin is deleted from this device.
plugin-removed = Usunięto { $plugin }.

# Toast after a store owner removes a member.
store-member-removed = Usunięto. Sklep z wtyczkami nie przyjmuje już te urządzenia.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Zaproszenie anulowano. Link przestał działać.

# Toast after cancelling an invite that people joined with.
store-invite-cancelled-kept =
    { $count ->
        [one] Zaproszenie anulowane. Osoba, która dołączyła, zostaje członkiem.
        [few] Zaproszenie anulowane. { $count } osoby, które dołączyły, zostają członkami.
        [many] Zaproszenie anulowane. { $count } osób, które dołączyły, zostaje członkami.
       *[other] Zaproszenie anulowane. { $count } osoby, które dołączyły, zostają członkami.
    }

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Teraz dołączyć może każdy, kto ma link. Skopiuj go z ekranu członków.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Teraz mogą dołączać tylko zaproszone osoby.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
        [one] Teraz mogą dołączać tylko zaproszone osoby. Dołączone linkiem urządzenie działa dalej, dopóki nie zostanie usunięte.
        [few] Teraz mogą dołączać tylko zaproszone osoby. Dołączone linkiem urządzenia ({ $devices }) działają dalej, dopóki nie zostaną usunięte.
        [many] Teraz mogą dołączać tylko zaproszone osoby. Dołączone linkiem urządzenia ({ $devices }) działają dalej, dopóki nie zostaną usunięte.
       *[other] Teraz mogą dołączać tylko zaproszone osoby. Dołączone linkiem urządzenia ({ $devices }) działają dalej, dopóki nie zostaną usunięte.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Sklep z wtyczkami nie przyjmuje już to urządzenie.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Usunięto wszystkie urządzenia, które dołączyły linkiem.

# Toast after a plugin is published to a store.
plugin-published = Opublikowano { $plugin } { $version }.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = Nie oferuje się już: { $plugin }.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Otwarto stronę administracyjną w przeglądarce. Link działa raz, przez 10 minut.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Nie udało się otworzyć przeglądarki ({ $reason }). Na komputerze, na którym działa sklep z wtyczkami, uruchom „kaeri store admin”, aby wydrukować link.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = Zainstalowano { $plugin } { $version }, ale wtyczki są wyłączone, więc wtyczka nie zostanie wykorzystana.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = Zainstalowano { $plugin }, ale źródło wbudowane ma nazwę { $id }, więc wtyczka nie została wczytana.

# Toast after a plugin is installed and ready to use.
plugin-installed = Zainstalowano { $plugin } { $version }.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = Zainstalowano { $plugin }, ale nie udało się wczytać. { $reason }

# Toast after a plugin is installed but was built for an older plugin interface, so it was not loaded.
plugin-installed-outdated = Zainstalowano { $plugin }, ale ta wtyczka powstała dla starszej wersji Kaeri i wymaga aktualizacji. Poproś autora o nową wersję.

# Note on the sources screen when plugins were skipped because they were built for an older plugin interface.
plugins-outdated =
    { $count ->
        [one] Jedna wtyczka powstała dla starszej wersji Kaeri i wymaga aktualizacji: { $names }.
        [few] { $count } wtyczki powstały dla starszej wersji Kaeri i wymagają aktualizacji: { $names }.
        [many] { $count } wtyczki powstało dla starszej wersji Kaeri i wymaga aktualizacji: { $names }.
       *[other] { $count } wtyczki powstało dla starszej wersji Kaeri i wymaga aktualizacji: { $names }.
    }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Wtyczka: gotowa aktualizacja: { $names }.
        [few] Wtyczki: gotowe aktualizacje: { $names }.
        [many] Wtyczki: gotowe aktualizacje: { $names }.
       *[other] Wtyczki: gotowe aktualizacje: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Nie udało się wczytać wtyczki. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Urządzenie nie ma zapisanego tokenu dla { $store }. Dołącz ponownie nowym zaproszeniem.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Sklep z wtyczkami nie jest już dołączony.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = Sklep z wtyczkami ma uszkodzony klucz podpisu. Opuść go i dołącz ponownie nowym zaproszeniem.

# Error: a store rejected this device's token.
store-device-refused = { $store } nie przyjmuje już to urządzenie. Dołącz ponownie nowym zaproszeniem.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Nie udało się połączyć z { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = { $store } jest dołączony pod adresem { $current }, ale ten link wskazuje na { $target }. Jeśli sklep z wtyczkami się przeniósł, najpierw go opuść i dołącz ponownie.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Dołączono do { $store } jako { $member }. Ten link dołączyłby ponownie bez podanej nazwy, więc nic nie zmieniono.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = Nie udało się potwierdzić, że pod { $url } jest sklep z wtyczkami z zaproszenia ({ $reason }). Nic nie dołączono.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Nie udało się zapisać tokenu dla tego sklepu z wtyczkami. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = To zaproszenie zostało już użyte, anulowane lub wygasło. Poproś o nowe.

# Error: the invite was used as many times as it allows.
store-invite-used-up = To zaproszenie zostało wykorzystane. Poproś { $owners } o nowe.

# Error: the invite's end date passed.
store-invite-ended = To zaproszenie wygasło { $when }. Poproś { $owners } o nowe.

# Error: an owner cancelled the invite.
store-invite-was-cancelled = To zaproszenie zostało anulowane. Poproś { $owners } o nowe.

# Line under any of these when the store has a contact.
store-invite-contact = Kontakt: { $contact }

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Ten link nie pozwala już nikomu dołączyć. Poproś właściciela o nowy link albo zaproszenie.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = Wtyczka nie może nazywać się { $plugin }, bo tak nazywa się źródło wbudowane.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } nie oferuje już { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } zmienił { $plugin } od chwili pokazania. Sprawdź to ponownie przed instalacją.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = Zainstalowano { $plugin } z { $store }. { $store } zapewnia aktualizacje.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } już deklaruje { $plugin }. Najpierw usuń ten plik, bo uruchomią się dwie kopie.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Nie udało się zainstalować { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Nie udało się opublikować { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } nie ma w folderze, w którym są wtyczki.

# Error: a book source cannot be published to a store whose server is too old to list book sources.
store-takes-no-books = { $store } nie obsługuje jeszcze źródła z książkami. Jego właściciel może zaktualizować sklep z wtyczkami, aby je dodać.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = To urządzenie dołączyło do { $store } linkiem. Wklej ten sam link na drugim urządzenie.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = Sklep z wtyczkami wysłał link, który nie daje się odczytać. Poproś o sprawdzenie. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = Sklep z wtyczkami wysłał link z innym kluczem. Sprawdź adres, z którego zaczęto.

# Error: the store's server has no admin page.
store-admin-missing = { $store } nie ma strony administracyjnej. Jego serwer może być starszy.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } wysłał link administracyjny do innego adresu.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = Serwer { $store } jest starszy i nie pozwala nikomu dołączyć linkiem. Najpierw go zaktualizuj.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = Wyłączono { $name }. Kaeri pomija to źródło przy szukaniu odcinków.

# Toast after a source (plugin) is switched on.
source-switched-on = Włączono { $name }.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = Nie wczytano { $id }. Sprawdź instalację.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = Ten tytuł używa teraz: { $name }.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Nie udało się zapisać wyboru. { $reason }

# Note on the sources screen: the proxy for torrent traffic failed its check, so torrents wait.
torrent-proxy-waiting = Sprawdzenie proxy nie powiodło się. Torrenty ruszą, gdy je przejdzie.

# Note on the sources screen: the proxy for torrent traffic hasn't been checked yet.
torrent-proxy-unchecked = Torrenty ruszą, gdy proxy przejdzie sprawdzenie.

# Error: the link or file given to open is not a magnet link, an info hash or a torrent file.
torrent-link-unusable = To nie jest link magnet ani plik torrent.

# Error: a link the viewer opened can't play or download while torrent playback is off.
torrent-link-playback-off = Włącz odtwarzanie torrentów w Ustawieniach, aby odtwarzać własne linki.

# Error: the search for what a link the viewer opened is didn't work. The reason comes from the catalogue.
opened-search-failed = Nie udało się wyszukać tego tytułu. { $reason }

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = Zamknięto Kaeri, zanim ruszyły torrenty.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Nie udało się uruchomić sesji torrentów. { $reason }

# Toast when the proxy setting can't be used. The reason comes from the proxy setting.
torrent-proxy-unusable = Nie można użyć ustawienia proxy. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on and a proxy set.
sources-reloaded-torrents-checking = Źródła: wczytano ponownie. Torrenty ruszą, gdy proxy przejdzie sprawdzenie.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrenty są wyłączone. Sesja została zatrzymana.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Czekanie na limit zapytań AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Czekanie { $wait } na limit zapytań AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList nie odpowiada. Na razie pokazano dane z innego serwisu.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Żadna usługa metadanych nie odpowiedziała. Pokazano ostatnie zapisane dane.

# Toast when AniList answers again.
notice-anilist-back = AniList znowu odpowiada.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Wspólne oglądania nie są w tej wersji aplikacji.

# Notice after the demo is removed. It offers Undo for 8 seconds.
sources-demo-removed = Demo usunięte

# Notice after the first plugin from a store installs while the demo is on. It offers Remove demo for 8 seconds.
stores-ready-demo-stays = { $store } jest gotowy. Demo zostaje na końcu listy: Źródła.

# The page the browser shows after signing in to a cloud drive on a computer (Windows, Linux or the terminal), once Kaeri has caught the sign-in. The person goes back to the app by themselves.
cloud-loopback-done = Możesz zamknąć tę kartę i wrócić do Kaeri.

# The error line under Sync on a device that another of the person's devices removed from sync. Joining again, with a code or the recovery key, or setting sync up again adds it as a new device.
sync-device-removed = Inne urządzenie usunęło to urządzenie z synchronizacji. Dołącz ponownie, aby je synchronizować.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Zalogowano do { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Zalogowano do { $tracker }. Token zapisano w pęku kluczy systemu.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Zalogowano do { $tracker }. Pęk kluczy jest niedostępny, więc token zapisano w prywatnym pliku na tym komputerze.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Zalogowano do { $tracker }, ale token nie został zapisany, więc przy następnym uruchomieniu trzeba będzie zalogować się ponownie. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Nie udało się zapisać tokenu logowania. Spróbuj zalogować się ponownie. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Nie udało się zalogować do { $tracker }. Spróbuj ponownie. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = Logowanie do { $tracker } zostało przerwane, zanim się zakończyło. Spróbuj ponownie. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Nie udało się otrzymać tokenu od { $tracker }. Spróbuj zalogować się ponownie. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Nie udało się otworzyć przeglądarki do logowania. Sprawdź, czy któraś jest zainstalowana, i spróbuj ponownie. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Przyszła odpowiedź logowania z { $tracker }, ale żadne logowanie na nią nie czekało. Rozpocznij logowanie od nowa.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = Odpowiedź logowania z { $tracker } nie pasuje do żądania. Rozpocznij logowanie od nowa.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = Logowanie do { $tracker } wróciło bez tokenu. Spróbuj ponownie.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Nie udało się dokończyć logowania do MyAnimeList: ta wersja nie zawiera klienta dla tej usługi.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Logowanie do Kitsu odbywa się z ekranu kont.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Logowanie do { $tracker } nie jest jeszcze obsługiwane.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Logowanie do { $tracker } wymaga przekierowania w przeglądarce, którego ta aplikacja nie może odebrać.

# Toast when AniList is set to a sign-in method only the Kaeri app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Ta metoda logowania AniList działa tylko w aplikacji Kaeri. Aby zalogować się tutaj, ustaw { $setting } na „loopback” w pliku konfiguracyjnym.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList wymaga identyfikatora klienta i sekretu. Ustaw { $client } i { $secret } w pliku konfiguracyjnym, a potem zaloguj się ponownie. Adres logowania podaje polecenie: kaeri --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Wklejanie kodu nie jest tu możliwe. Zakończ działanie i uruchom zamiast tego kaeri --login.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList wymaga identyfikatora klienta. Zarejestruj aplikację z typem „other” na myanimelist.net/apiconfig, a potem ustaw { $setting } w pliku konfiguracyjnym.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = Czekanie, aż { $tracker } przekieruje z powrotem…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList nie wydało tokenu odświeżania. Logowanie wygaśnie za około miesiąc i trzeba będzie zalogować się ponownie.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Najpierw ustaw { $setting } w pliku konfiguracyjnym.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Wylogowano z { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Wylogowano z { $tracker }. Jedna zmiana w kolejce zostanie zachowana na następne logowanie.
        [few] Wylogowano z { $tracker }. { $count } zmiany w kolejce zostaną zachowane na następne logowanie.
        [many] Wylogowano z { $tracker }. { $count } zmian w kolejce zostanie zachowanych na następne logowanie.
       *[other] Wylogowano z { $tracker }. { $count } zmian w kolejce zostanie zachowanych na następne logowanie.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Nie udało się wylogować z { $tracker }. Spróbuj ponownie. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Nie udało się zapisać tego ustawienia. { $cause }

# Toast when the proxy for torrent traffic was saved.
