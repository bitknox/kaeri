settings-label-adult-titles = Tytuły dla dorosłych

# Settings row: whether an episode's AniList forum thread is looked up and opened in the app.
settings-label-episode-discussions = Dyskusje o odcinkach

# Settings row: whether images in discussion comments load inline.
settings-label-comment-images = Wczytuj obrazy w komentarzach

# Settings row: whether Calendar shows only the shows on the person's list.
settings-label-calendar-mine = Kalendarz tylko z twojej listy

# Note under the titles row.
settings-note-titles = Wybór AniList zależy od konta AniList, a po wylogowaniu używany jest angielski.

# Note under the trailers row. The terminal never plays trailers by itself; the setting is shared with the apps.
settings-note-trailers = Aplikacje desktopowe odtwarzają zwiastuny bez dźwięku w podglądzie po najechaniu. Terminal zachowuje to ustawienie i niczego nie odtwarza.

# Note under the subtitles row.
settings-note-subtitles = Naciśnij Enter, aby wpisać kod języka. Wartości są zbyt liczne, by je przełączać.

# Note under the opening and ending marks row.
settings-note-mark-chapters = Dodaje znaczniki rozdziałów na pasku przewijania, gdy strumień ich nie ma.

# Note under the skip button row.
settings-note-skip-button = Pokazuje przycisk nad czołówką i zakończeniem, gdy pomijanie nie jest automatyczne.

# Note under the fullscreen row. "f" is mpv's own key and is not translated.
settings-note-fullscreen = mpv otwiera się na pełnym ekranie. Jego własny klawisz f nadal wychodzi z pełnego ekranu.

# Note under the upscaling row.
settings-note-upscaling = Dostosowuje się do wideo i karty graficznej. Działa od kolejnego odcinka.

# Note under the player interface row.
settings-note-player-ui = Pokazuje miniatury, menu i przycisk pomijania w wyglądzie Kaeri.

# Note under the night mode row.
settings-note-night-mode = Wyrównuje ciche dialogi i głośną muzykę.

# Note under the download folder row.
settings-note-download-dir = Naciśnij Enter, aby wpisać ścieżkę. Działa przy kolejnym pobraniu.

# Note under the merge subtitles row.
settings-note-merge-subtitles = Działa przy kolejnym zakończonym pobieraniu.

# Note under the keep seeding row.
settings-note-keep-seeding = Domyślnie wyłączone, by oszczędzać wysyłanie. Włącz, aby oddawać coś roju.

# Note under the after each download row.
settings-note-download-hook = Naciśnij Enter, aby wpisać polecenie. Uruchamia się po każdym zakończonym pobraniu.

# Note under the Syncplay row. The key is the one that plays a single episode in a { -watch-party }.
settings-note-syncplay = Naciśnij { $key }, aby odtworzyć jeden odcinek w pokoju ustawionym poniżej. Gdy włączone, każde odtworzenie trafia tam.

# Note under the Syncplay server row.
settings-note-syncplay-server = Naciśnij Enter, aby wpisać host:port. Serwer nie jest ustawiony, dopóki nie zostanie wybrany.

# Note under the Syncplay room row.
settings-note-syncplay-room = Naciśnij Enter, aby wpisać pokój znajomego. Zostaw puste, aby założyć pokój, którego nikt nie odgadnie.

# Note under the check for updates row.
settings-note-update-check = Jedno zapamiętane zapytanie dziennie, wysyłane przy uruchomieniu.

# Note under the Discord presence row once a client ID is set.
settings-note-presence = Działa od kolejnego odcinka.

# Note under the Discord presence row when no client ID is set. The address is a web address.
settings-note-presence-needs-client = Najpierw ustaw identyfikator klienta. Aby go dostać, zarejestruj aplikację na discord.com/developers.

# Note under the presence title row. The quoted text is what Discord shows.
settings-note-presence-title = Wyłączone pokazuje „Ogląda anime” bez nazwy tytułu.

# Note under the rich presence row.
settings-note-presence-rich = Dodaje okładkę, pasek postępu i link do AniList, o ile tytuł jest pokazywany.

# Note under the torrent playback row.
settings-note-torrents = Domyślnie wyłączone. Działa od razu.

# Note under the torrent proxy row. config.toml is a file name and is not translated.
settings-note-torrent-proxy = Opcjonalne. Edytuj config.toml, aby kierować ruch torrentów przez proxy SOCKS5.

# Note under the seed after watching row.
settings-note-seed-ratio = Utrzymuje udostępnianie obejrzanych odcinków, gdy Kaeri jest otwarte.

# Note under the seed for at most row.
settings-note-seed-hours = Najdłużej jeden odcinek jest udostępniany, bez względu na współczynnik.

# Note under the upload limit row.
settings-note-upload-limit = Ogranicza całe wysyłanie torrentów, więc udostępnianie nigdy nie spowalnia odtwarzania.

# Note under the token storage row. The option is a command-line flag and is not translated.
settings-note-token-storage = Użyj --token-to-file, aby przenieść istniejący token.

# Heading of the { -plugin-store } screens when the terminal is too small to draw them.
stores-needs-larger-terminal = Potrzebny większy terminal

# Heading of the list of { -plugin-store-pl } this machine has joined.
stores-list-heading = Sklepy z wtyczkami

# Heading of one { -plugin-store }'s page while it loads, and when the terminal is too small.
stores-page-heading = Sklep z wtyczkami

# Heading of a { -plugin-store }'s members screen when the terminal is too small.
stores-members-placeholder-heading = Członkowie

# Column heading over the names of the stores joined.
stores-column-store = Sklep

# Column heading over how many plugins each store offers. Ten cells wide.
stores-column-plugins = Wtyczki

# Column heading over whether this person owns the store or is a member. Ten cells wide.
stores-column-you = Ty

# Column heading over each store's condition: up to date, offline, access removed. Takes the rest of the row.
stores-column-state = Stan

# Shown under the column headings when no { -plugin-store } has been joined.
stores-none-joined = Nie dołączono jeszcze do żadnego sklepu

# Role in a store, in the list of stores and on the members screen. Ten cells wide.
stores-role-owner = Zarządca

# Role in a store, in the list of stores and on the members screen. Ten cells wide.
stores-role-member = Członek

# Row under the list of stores that opens the prompt for joining another.
stores-join-row = + Dołącz do sklepu

# State of a store whose owner removed this device. Column of about 30 cells.
stores-state-revoked = Dostęp odebrany

# State of a store that could not be reached. The symbol before it is drawn by the program.
stores-state-offline = Brak połączenia

# State of a store with nothing to update. The symbol before it is drawn by the program.
stores-state-up-to-date = Aktualny

# State of a store that has newer versions of installed plugins.
stores-state-updates =
    { $count ->
        [one] { $count } aktualizacja
        [few] { $count } aktualizacje
        [many] { $count } aktualizacji
       *[other] { $count } aktualizacji
    }

# Footer of the list of stores when the focused store has removed this device's access.
stores-footer-revoked = Urządzenie nie jest już przyjmowane przez ten sklep. Właściciel może wysłać nowe zaproszenie.

# Footer of the list of stores when the focused store cannot be reached. The reason comes from the network.
stores-footer-offline = { $url } ({ $reason })

# Part of a store's footer line: the store's key fingerprint, as groups of hexadecimal digits.
stores-key = Klucz { $fingerprint }

# Part of a store's footer line when this device joined with the store's link, which keeps no name.
stores-joined-without-name = Dołączono bez nazwy

# Part of a store's footer line: the name this device joined under.
stores-joined-as = Dołączono jako { $name }

# Footer of the list of stores when the focused row is the one that joins another store.
stores-footer-join = Wklej otrzymane zaproszenie albo link do sklepu

# Tag at the top right of a store's page when this person owns it. Up to seven cells wide.
stores-owner-tag = Właśc.

# Part of a store's note line when anyone with its link can join.
stores-anyone-can-join = Każdy z linkiem może dołączyć

# Note under a store's name when it cannot be reached and its last list is shown. The reason comes from the network.
stores-note-offline = Brak połączenia, pokazano ostatnią otrzymaną listę ({ $reason })

# Note under a store's name when it removed this device's access.
stores-note-revoked = Urządzenie nie jest już przyjmowane przez ten sklep. To, co zainstalowano, nadal działa.

# Column heading of a store's page over the plugin names.
stores-column-plugin = Wtyczka

# Column heading of a store's page over the plugin versions. Fourteen cells wide.
stores-column-version = Wersja

# Shown on a store's page when it offers nothing and this person owns it, who can publish from the rows below.
stores-empty-owner = Nic jeszcze nie opublikowano. Poniżej można opublikować wtyczki.

# Shown on a store's page when it offers nothing and this person is a member.
stores-empty-member = Nic jeszcze nie opublikowano

# Row on a store's page: makes a one-time link that joins another computer of this person's.
stores-line-link-device = Połącz kolejne urządzenie

# Row on a store's page: makes an invite for someone new. Owners only.
stores-line-invite = Zaproś kogoś

# Row on a store's page: opens the members screen. Owners only.
stores-line-members = Członkowie

# Row on a store's page: switches between invite-only and open to anyone with the link. Owners only.
stores-line-who-can-join = Kto może dołączyć

# Row on a store's page: offers a plugin from the plugin directory. Owners only.
stores-line-publish = Opublikuj z katalogu

# Row on a store's page: opens the store's admin page in a browser. Owners only.
stores-line-admin = Otwórz panel administracyjny

# Row on a store's page: leaves the store.
stores-line-leave = Opuść ten sklep

# What a plugin is, in a store's page, when it is not installed. Column of about 20 cells.
stores-plugin-not-installed = Nie zainstalowano

# What a plugin is, in a store's page, when it is installed. The symbol before it is drawn by the program.
stores-plugin-installed = Zainstalowano

# What a plugin is, in a store's page, when a newer version is offered. Column of about 20 cells.
stores-plugin-update-from = Aktualizacja z { $from }

# What a plugin is, in a store's page, when the same file was put in the plugin directory by hand.
stores-plugin-added-by-hand = Dodano ręcznie

# What a plugin is, in a store's page, when another store installed it.
stores-plugin-from-another-store = Z innego sklepu

# Footer of a store's page on a plugin whose update asks to contact more hosts than before.
stores-footer-update-hosts = Aktualizacja chce się też łączyć z: { $hosts }

# Footer of a store's page on a plugin: the hosts it may contact, as a list.
stores-footer-may-contact = Może łączyć się z: { $hosts }

# Footer of a store's page on the row that makes a link for another of this person's computers.
stores-footer-link-device = Jednorazowy link, który dołącza kolejne twoje urządzenie jako ciebie

# Footer of a store's page on the row that makes an invite.
stores-footer-invite = Jednorazowy link dla nowej osoby

# Footer of a store's page on the row that opens the members screen.
stores-footer-members = Zobacz, kto dołączył, i odbierz komuś dostęp

# Footer of a store's page on the row that changes who can join, while the store is open to anyone with its link. Enter is the key on this screen.
stores-footer-close-join = ↵ Zezwalaj tylko zaproszonym osobom i zablokuj link

# Footer of a store's page on the row that changes who can join, while the store is invite-only. Enter is the key on this screen.
stores-footer-open-join = ↵ Pozwól każdemu z linkiem do sklepu dołączyć bez nazwy

# Footer of a store's page on the row that publishes a plugin.
stores-footer-publish = Opublikuj z katalogu na tym komputerze

# Footer of a store's page on the row that opens the admin page.
stores-footer-admin = Członkowie, zaproszenia i wtyczki: zarządzaj w przeglądarce

# Footer of a store's page on the row that leaves the store.
stores-footer-leave = Wtyczki zainstalowane z niego zostają na tym urządzeniu i przestają się aktualizować

# Value beside the "who can join" row while anyone with the store's link can join. Takes the rest of the row.
stores-who-open = Każdy z linkiem

# Value beside the "who can join" row while only invited people can join. Takes the rest of the row.
stores-who-invite-only = Tylko zaproszone osoby

# Label before the number of plugins a store offers, in the join confirmation. Padded to line up with the other labels there.
stores-label-offers = Oferty

# The number of plugins a store offers, after the label "Offers".
stores-offers-count =
    { $count ->
        [one] { $count } wtyczka
        [few] { $count } wtyczki
        [many] { $count } wtyczek
       *[other] { $count } wtyczek
    }

# A plugin the store offers, in the join confirmation. The hosts are what the plugin may contact.
stores-offered-plugin = { $name } { $version }  może łączyć się z: { $hosts }

# Added after an offered plugin that is already installed here.
stores-offered-installed = Zainstalowano

# Added after an offered plugin when an older version is installed here.
stores-offered-installed-version = Zainstalowano { $from }

# Added after an offered plugin when the same file was put in the plugin directory by hand.
stores-offered-added-by-hand = Dodano ręcznie

# Added after an offered plugin that another store installed here.
stores-offered-from-other = Z { $other }

# Last line of the plugins a store offers, when only the first few are listed.
stores-offered-more = i jeszcze { $count }

# What a plugin may contact when it has no hosts. It follows "may contact" in a sentence, so it is lower case.
stores-hosts-none = niczym

# Shown on the members screen while the members load.
stores-loading = Wczytywanie…

# After a member's name, when that member is this person.
stores-member-you = { $name } (ty)

# Column heading of the members screen over names.
stores-column-name = Nazwa

# Column heading of the members screen over the role. Ten cells wide.
stores-column-role = Rola

# Column heading of the members screen over how many devices each member has. Ten cells wide.
stores-column-devices = Urządzenia

# Column heading of the members screen over when each member was last seen. Takes the rest of the row.
stores-column-last-seen = Ostatnia aktywność

# Title of the members screen.
stores-members-heading = Członkowie · { $name }

# Name of a store on the members screen when it is not known.
stores-unnamed = Sklep z wtyczkami

# Heading over invites that have not been used.
stores-invites-heading = Niewykorzystane zaproszenia

# An invite on the members screen that makes a link for another of the person's own computers.
