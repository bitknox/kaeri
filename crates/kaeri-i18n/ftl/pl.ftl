# Toast when no episode falls in the range typed for a download.
episodes-range-empty = Żaden odcinek nie mieści się w tym zakresie. Spróbuj innego zakresu.

# Toast after a range is queued for download.
episodes-queueing =
    { $count ->
        [one] Dodaję { $count } odcinek do pobrania.
        [few] Dodaję { $count } odcinki do pobrania.
        [many] Dodaję { $count } odcinków do pobrania.
       *[other] Dodaję { $count } odcinków do pobrania.
    }

