       *[other] Usuń wszystkie { $count }
    }

# Footer of the members screen on this person's own row.
stores-footer-you = To konto jest właścicielem. Sklep zawsze zachowuje swojego właściciela.

# Footer of the members screen on another member's row. Enter is the key on this screen.
stores-footer-remove-member = ↵ Odbierz dostęp

# Footer of the members screen on an invite not used yet.
stores-footer-cancel-invite = ↵ Anuluj to zaproszenie

# Footer of the members screen on the store's link row.
stores-footer-show-link = ↵ Pokaż link, aby go skopiować i udostępnić

# Footer of the members screen on a device that joined with the store's link.
stores-footer-remove-anonymous = ↵ Usuń to urządzenie, znane tylko po czasie dołączenia

# Footer of the members screen on the row that removes every device that joined with the link.
stores-footer-remove-all-anonymous = ↵ Usuń wszystkie urządzenia, które dołączyły przez link

# Line in the store's link overlay, once the link was copied.
stores-link-copied = Skopiowano, jeśli terminal na to pozwala. Jeśli nie, zaznacz link, aby go skopiować.

# Line in a link overlay before the link was copied, or when the terminal cannot copy.
stores-link-select = Zaznacz, aby skopiować.

# Line in the store's link overlay.
stores-open-link-warning = Każdy z linkiem może dołączyć bez nazwy, ile razy chce.

# Line in the store's link overlay.
