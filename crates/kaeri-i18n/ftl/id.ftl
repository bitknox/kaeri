lists-status-airing = Sedang tayang

# A filter value for whether a title is still airing.
lists-status-finished = Selesai tayang

# A filter value for whether a title is still airing.
lists-status-upcoming = Akan tayang

# A search sort order.
lists-sort-popularity = Popularitas

# A search sort order.
lists-sort-score = Skor

# A search sort order.
lists-sort-trending = Tren

# A search sort order.
