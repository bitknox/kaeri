# Marking line in Now playing. $kind is in lower case: opening, ending or recap.
playback-mark-line = Tandai { $kind }

# Key hints on the marking line.
playback-mark-keys-start = ↵ tandai awal   ←→ 1 dtk   tab jenis   esc

playback-mark-keys-end = ↵ tandai akhir   ←→ 1 dtk   esc kembali

playback-mark-keys-review = ↵ simpan   tab awal atau akhir   ←→ 1 dtk   esc kembali

# Key help entry.
keys-action-mark-skips = Tandai waktu lewati

# Note on the transition when finding a stream takes more than a moment. The time is how long it has taken so far.
