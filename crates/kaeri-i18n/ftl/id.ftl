# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since August".
reading-since-august = sejak Agustus

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since September".
reading-since-september = sejak September

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since October".
reading-since-october = sejak Oktober

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since November".
reading-since-november = sejak November

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since December".
reading-since-december = sejak Desember

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Bergabung dengan { $store } sebagai { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Bergabung dengan { $store } tanpa nama.

# Toast after leaving a plugin store.
store-left = Keluar dari { $store }. plugin-plugin tetap terpasang.

# Toast after a plugin is deleted from this device.
plugin-removed = { $plugin } dihapus.

# Toast after a store owner removes a member.
store-member-removed = Anggota dihapus, dan perangkat miliknya tidak lagi bekerja dengan toko plugin ini.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Undangan dibatalkan. Tautannya tidak lagi berfungsi.

# Toast after cancelling an invite that people joined with.
store-invite-cancelled-kept =
    { $count ->
       *[other] Undangan dibatalkan. { $count } orang yang sudah bergabung tetap menjadi anggota.
    }

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Siapa pun yang memiliki tautan toko plugin ini bisa bergabung sekarang. Salin dari layar anggota.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Hanya orang yang Anda undang yang bisa bergabung sekarang.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
       *[other] Hanya orang yang Anda undang yang bisa bergabung sekarang. { $devices } perangkat yang bergabung lewat tautan tetap berfungsi sampai Anda menghapusnya.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Satu perangkat itu tidak lagi bekerja dengan toko plugin ini.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Semua perangkat yang bergabung lewat tautan sudah dihapus.

# Toast after a plugin is published to a store.
plugin-published = { $plugin } { $version } diterbitkan.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } tidak lagi ditawarkan.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Halaman admin dibuka di peramban Anda. Tautannya hanya bisa dipakai sekali, selama 10 menit.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Tidak bisa membuka peramban ({ $reason }). Di mesin toko plugin, jalankan "kaeri store admin" untuk mencetak tautan.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = Terpasang { $plugin } { $version }, tetapi plugin-plugin dimatikan di urutan sumber, jadi tidak dipakai.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = Terpasang { $plugin }, tetapi { $id } adalah nama sumber bawaan, jadi tidak dimuat.

# Toast after a plugin is installed and ready to use.
plugin-installed = Terpasang { $plugin } { $version }.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = Terpasang { $plugin }, tetapi tidak bisa dimuat. { $reason }

# Toast after a plugin is installed but was built for an older plugin interface, so it was not loaded.
plugin-installed-outdated = { $plugin } terpasang, tetapi dibuat untuk Kaeri versi lama dan perlu diperbarui. Minta pembuatnya untuk build baru.

# Note on the sources screen when plugins were skipped because they were built for an older plugin interface.
plugins-outdated =
    { $count ->
       *[other] { $count } plugin dibuat untuk Kaeri versi lama dan perlu diperbarui: { $names }.
    }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
       *[other] { $count } pembaruan plugin siap: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Tidak bisa memuat plugin-plugin. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Tidak ada token untuk { $store } di perangkat ini. Bergabung lagi dengan undangan baru.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Anda tidak lagi bergabung dengan toko plugin itu.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = Kunci untuk toko plugin ini di perangkat ini rusak. Keluar dari toko plugin, lalu bergabung lagi dengan undangan baru.

# Error: a store rejected this device's token.
store-device-refused = { $store } tidak lagi menerima perangkat ini. Bergabung lagi dengan undangan baru.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Tidak bisa menjangkau { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = { $store } sudah bergabung di { $current }, tetapi tautan ini mengarah ke { $target }. Jika toko plugin sudah pindah, keluar dulu, lalu bergabung lagi.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Anda sudah bergabung dengan { $store } sebagai { $member }. Tautan ini akan bergabung lagi tanpa nama Anda, jadi tidak ada yang diubah.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } bukan toko plugin dalam undangan ({ $reason }). Tidak ada yang bergabung.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Tidak bisa menyimpan token untuk toko plugin ini. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Undangan itu sudah dipakai, dibatalkan, atau kedaluwarsa. Minta yang baru.

# Error: the invite was used as many times as it allows.
store-invite-used-up = Undangan ini sudah habis dipakai. Minta undangan baru ke { $owners }.

# Error: the invite's end date passed.
store-invite-ended = Undangan ini berakhir { $when }. Minta undangan baru ke { $owners }.

# Error: an owner cancelled the invite.
store-invite-was-cancelled = Undangan ini dibatalkan. Minta undangan baru ke { $owners }.

# Line under any of these when the store has a contact.
store-invite-contact = Kontak: { $contact }

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Tautan itu sudah tidak mengizinkan siapa pun bergabung. Minta tautan atau undangan baru dari pemilik toko plugin.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } adalah nama sumber bawaan, jadi tidak bisa menjadi plugin.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } tidak lagi menawarkan { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } mengubah { $plugin } setelah ditampilkan. Lihat lagi sebelum memasangnya.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } dipasang dari { $store }, yang menjaganya tetap diperbarui.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } sudah mendeklarasikan { $plugin }. Hapus file itu dulu, atau dua salinan akan berjalan.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Tidak bisa memasang { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Tidak bisa menerbitkan { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } tidak lagi ada di folder plugin.

# Error: a book source cannot be published to a store whose server is too old to list book sources.
store-takes-no-books = { $store } belum mencantumkan sumber-sumber buku. Pemiliknya bisa memperbarui toko plugin untuk menambahkannya.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Anda sudah bergabung dengan { $store } dari perangkat ini lewat tautan. Tempelkan tautan yang sama di perangkat lain.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = Tautan yang dikirim toko plugin tidak berfungsi. Minta pemiliknya memeriksa toko plugin. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = Tautan dari toko plugin ini memakai kunci yang berbeda. Periksa alamat tempat toko plugin itu dijalankan.

# Error: the store's server has no admin page.
store-admin-missing = { $store } tidak punya halaman admin. Servernya mungkin versi lama.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } mengirim tautan admin untuk alamat lain.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = Server { $store } versi lama dan tidak bisa mengizinkan siapa pun bergabung lewat tautan. Perbarui dulu.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = { $name } dimatikan. Kaeri melewatinya saat mencari episode.

# Toast after a source (plugin) is switched on.
source-switched-on = { $name } dinyalakan.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } tidak dimuat. Periksa apakah sudah terpasang di Sumber-sumber.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = Judul ini sekarang memakai { $name }.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Pilihan itu tidak bisa disimpan. { $reason }

# Note on the sources screen: the proxy for torrent traffic failed its check, so torrents wait.
torrent-proxy-waiting = Pemeriksaan proxy gagal. Torrent mulai setelah pemeriksaan lolos.

# Note on the sources screen: the proxy for torrent traffic hasn't been checked yet.
torrent-proxy-unchecked = Torrent mulai setelah pemeriksaan proxy lolos.

# Error: the link or file given to open is not a magnet link, an info hash or a torrent file.
torrent-link-unusable = Itu bukan tautan magnet atau berkas torrent.

# Error: a link the viewer opened can't play or download while torrent playback is off.
torrent-link-playback-off = Aktifkan pemutaran torrent di Pengaturan untuk memutar tautan Anda sendiri.

# Error: the search for what a link the viewer opened is didn't work. The reason comes from the catalogue.
opened-search-failed = Tidak bisa mencari judul itu. { $reason }

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = Kaeri ditutup sebelum torrent mulai.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Tidak bisa memulai sesi torrent. { $reason }

# Toast when the proxy setting can't be used. The reason comes from the proxy setting.
torrent-proxy-unusable = Pengaturan proxy tidak dapat dipakai. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on and a proxy set.
sources-reloaded-torrents-checking = Sumber-sumber dimuat ulang. Torrent mulai setelah pemeriksaan proxy lolos.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrent dimatikan. Sesinya dihentikan.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Menunggu batas permintaan AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Menunggu { $wait } karena batas permintaan AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList tidak menjawab. Untuk sementara menampilkan data dari layanan lain.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Tidak ada layanan metadata yang menjawab. Menampilkan data terakhir yang tersimpan.

# Toast when AniList answers again.
notice-anilist-back = AniList sudah kembali.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Nonton bareng tidak disertakan di aplikasi ini.

# Notice after the demo is removed. It offers Undo for 8 seconds.
sources-demo-removed = Demo dihapus

# Notice after the first plugin from a store installs while the demo is on. It offers Remove demo for 8 seconds.
stores-ready-demo-stays = { $store } siap. Demo tetap di urutan terakhir di Sumber-sumber Anda.

# The page the browser shows after signing in to a cloud drive on a computer (Windows, Linux or the terminal), once Kaeri has caught the sign-in. The person goes back to the app by themselves.
cloud-loopback-done = Anda bisa menutup tab ini dan kembali ke Kaeri.

# The error line under Sync on a device that another of the person's devices removed from sync. Joining again, with a code or the recovery key, or setting sync up again adds it as a new device.
sync-device-removed = Perangkat ini dihapus dari sinkronisasi di perangkat lain. Gabung lagi untuk menyinkronkannya.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Berhasil masuk ke { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Berhasil masuk ke { $tracker }. Token disimpan di rantai kunci sistem.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Berhasil masuk ke { $tracker }. Rantai kunci tidak tersedia, jadi token disimpan dalam berkas pribadi di perangkat ini.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Berhasil masuk ke { $tracker }, tetapi token tidak tersimpan, jadi Anda perlu masuk lagi nanti. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Token masuk tidak dapat disimpan. Coba masuk lagi. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Tidak dapat masuk ke { $tracker }. Coba lagi. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = Proses masuk ke { $tracker } berhenti sebelum selesai. Coba lagi. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Tidak dapat memperoleh token dari { $tracker }. Coba masuk lagi. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Tidak dapat membuka peramban untuk masuk. Pastikan ada peramban yang terpasang, lalu coba lagi. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Balasan masuk dari { $tracker } tiba, tetapi tidak ada proses masuk yang menunggunya. Mulai masuk lagi.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = Balasan masuk dari { $tracker } tidak cocok dengan permintaannya. Mulai masuk lagi.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = Proses masuk ke { $tracker } kembali tanpa token. Coba lagi.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Tidak dapat menyelesaikan masuk ke MyAnimeList: build ini tidak punya klien untuk itu.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Kitsu masuk dari layar Akun.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Masuk ke { $tracker } belum didukung.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Masuk ke { $tracker } memerlukan pengalihan peramban, yang tidak dapat diterima aplikasi ini.

# Toast when AniList is set to a sign-in method only the Kaeri app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Metode masuk AniList ini hanya berfungsi di aplikasi Kaeri. Untuk masuk di sini, atur { $setting } ke "loopback" dalam berkas konfigurasi.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList memerlukan ID dan rahasia klien. Atur { $client } dan { $secret } dalam berkas konfigurasi, lalu masuk lagi. Untuk mendapatkan alamat masuk, jalankan kaeri --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Menempel kode tidak dapat dilakukan di sini. Keluar lalu jalankan kaeri --login.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList memerlukan ID klien. Daftarkan aplikasi dengan jenis "other" di myanimelist.net/apiconfig, lalu atur { $setting } dalam berkas konfigurasi.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = Menunggu { $tracker } mengalihkan kembali…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList tidak mengeluarkan refresh token. Anda perlu masuk lagi dalam sekitar satu bulan.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Atur { $setting } dalam berkas konfigurasi terlebih dahulu.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Keluar dari { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
       *[other] Keluar dari { $tracker }. { $count } perubahan dalam antrean disimpan untuk masuk lagi nanti.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Tidak dapat keluar dari { $tracker }. Coba lagi. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Tidak dapat menyimpan pengaturan itu. { $cause }

# Toast when the proxy for torrent traffic was saved.
notice-proxy-saved = Lalu lintas torrent kini melewati proxy.

# Toast when the proxy for torrent traffic was turned off.
notice-proxy-removed = Torrent kini terhubung langsung, tanpa proxy.

# Toast when the proxy could not be checked. The cause says why.
notice-proxy-not-checked = Proxy tidak dapat diperiksa. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Tidak dapat menyimpan kata sandi proxy. Masukkan lagi untuk mencoba menyimpannya. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Tidak dapat menyimpan pengaturan itu. { $value } bukan nilai untuk { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Tidak dapat mengatur ulang pengaturan judul ini. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Tidak dapat menyimpan pilihan subtitle itu. Judul ini belum pernah memakai subtitle tersebut.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Data pemetaan diperbarui.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Tidak dapat memperbarui data pemetaan ({ $datasets }). Mencoba lagi dalam { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, episode { $episode }, sudah tayang selagi Anda pergi.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
       *[other] { $count } episode baru dari judul yang Anda tonton sudah tayang. Kalender memuatnya.
    }

# Toast when a new release of Kaeri is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = { $tag } sudah tersedia. Jalankan kaeri --update untuk memasangnya.

# The reason a proxy was refused: it has no host or no port.
cause-proxy-needs-address = Proxy memerlukan host dan port.

# The reason a proxy could not be checked: its address is not one the check can use.
cause-proxy-address-unusable = Pemeriksaan proxy tidak bisa memakai alamat ini.

# The reason a request failed: it never reached the server.
cause-server-unreachable = Server tidak dapat dihubungi.

# The legal line, shown in About beside Legal and contact. It exists once, so no translation can paraphrase it.
legal-hosts-no-content = Kaeri tidak menghosting tayangan atau buku apa pun. Anda menambahkan sumber-sumber Anda sendiri.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = { $label } disimpan.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = Tidak dapat menyimpan pengaturan itu. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = Tidak dapat memuat judul ini. Periksa koneksi Anda, lalu coba lagi.

# Toast when playback stops with an error.
notice-playback-failed = Pemutaran gagal. Coba sumber lain.

# Toast when something went wrong inside the engine and it carried on.
notice-engine-fault = Terjadi kesalahan di dalam Kaeri. Aplikasi tetap berjalan, tetapi jika layar terlihat macet, keluar lalu buka lagi.

# Toast at launch when the database was damaged, so a fresh one was started. The path is where the damaged file was moved, kept for recovery. Watch history and downloads start over; what the trackers hold comes back with the next sync.
notice-database-set-aside = Basis data rusak, jadi Kaeri membuat yang baru. Berkas lama disimpan di { $path }. Apa yang disimpan pelacak-pelacak Anda kembali saat sinkronisasi selanjutnya.

# Message when Kaeri could not start because a folder could not be made. The path is the folder, the reason comes from the system.
start-failed-folder = Kaeri tidak dapat membuat folder { $path }. Pastikan disk masih punya ruang dan folder itu dapat ditulisi, lalu coba lagi. { $reason }

# Message when Kaeri could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can.
start-failed-config = { $path } memiliki pengaturan yang tidak dapat digunakan Kaeri: { $problem }. Perbaiki atau hapus pengaturan itu, lalu coba lagi.

# Message when the settings could not be reset after a start failed on them: the config file could not be moved aside. The path is the file, the reason comes from the system.
config-reset-failed = Kaeri tidak dapat memindahkan { $path } untuk mengatur ulang pengaturan. { $reason }

# Message when Kaeri could not start because its database could not be opened. The path is the database file, the reason comes from the system.
start-failed-database = Kaeri tidak dapat membuka basis datanya di { $path }. Jika aplikasi Kaeri lain sedang terbuka di folder ini, keluar dari aplikasi itu, lalu coba lagi. { $reason }

# Message when Kaeri could not start its network connection from the network settings.
start-failed-network = Kaeri tidak dapat terhubung dengan pengaturan jaringan di config.toml. Periksa pengaturannya, lalu coba lagi. { $reason }

# Message when Kaeri itself could not start. The reason comes from the system or the engine.
start-failed = Kaeri tidak dapat dimulai. Keluar, lalu buka lagi. { $reason }

# Message when the TV remote could not start listening or could not forget a phone.
start-failed-remote = Kendali jarak jauh tidak dapat dimulai. { $reason }

# Message when the built-in player could not start.
start-failed-player = Pemutar tidak dapat dimulai. { $reason }

# Toast after episodes are added to the download queue.
notice-episodes-queued =
