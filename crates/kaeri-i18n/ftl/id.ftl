# A download's state in the table. A narrow column.
downloads-state-paused = Dijeda

# A download's state in the table. A narrow column.
downloads-state-done = Diunduh

# A download's state in the table. A narrow column.
downloads-state-failed = Gagal

# Detail line for a download queued ahead of time, on its own.
downloads-detail-ahead = Diunduh lebih awal, dihapus sehari setelah Anda menontonnya

# Detail line for a download queued ahead of time: where it stands, then what becomes of it.
downloads-detail-with-ahead = { $detail } · diunduh lebih awal, dihapus sehari setelah Anda menontonnya

# Detail line for a paused download. Both sizes are already formatted (such as "734 MB").
downloads-detail-paused-at = Dijeda di { $downloaded } dari { $total } (dilanjutkan dari situ)

# Detail line for a download paused before any bytes arrived.
downloads-detail-paused-early = Dijeda sebelum mulai

# Detail line for a queued download while torrents are off. The key opens the Settings screen, as the key map draws it.
downloads-detail-torrents-off = Unduhan membutuhkan torrent, yang sedang dimatikan (tekan { $key } untuk Pengaturan)

# Detail line for a queued download.
downloads-detail-queued = Diantrekan (mulai saat slot unduhan kosong)

# Detail line for a running download that has no size yet.
downloads-detail-waiting-metadata = Menunggu metadata torrent

# Heading of the list of torrents still seeding after the episode was watched.
downloads-seeding-heading = Masih dibagikan setelah ditonton

# A seeding torrent: the share ratio so far, the ratio it is aiming for, the time left and the amount uploaded. The ratios are already formatted with one decimal.
downloads-seeding-detail = { $ratio } dari { $goal } · sisa { $left } · { $uploaded } terunggah

# Toast when Enter is pressed on a failed download that has no recorded reason.
downloads-failed-no-reason = Unduhan gagal dan tidak ada alasan yang tercatat.

# Toast when Enter is pressed on a download that is running and has not finished.
downloads-not-finished = Unduhan itu belum selesai.

# Title of the Accounts screen, shown in the placeholder when the terminal is too small.
accounts-screen-title = Akun

# A { -tracker }'s chip in the header when it needs signing in again. The mark is a symbol that says the account is down.
accounts-badge-sign-in = { $tracker } { $mark } masuk lagi

# Toast when a { -tracker } needs signing in again. The key opens the Accounts screen, as the key map draws it.
accounts-needs-sign-in = { $tracker } perlu masuk lagi. Tekan { $key } untuk membuka Akun.

# Toast when sync differences appear. The key opens the list of them, as the key map draws it.
accounts-conflicts-found =
    { $count ->
       *[other] { $count } perbedaan sinkronisasi ditemukan. Tekan { $key } untuk meninjaunya.
    }

# Toast when the sync differences list is opened and there are none.
accounts-conflicts-none = Tidak ada perbedaan sinkronisasi untuk ditinjau.

# Toast when a sync is asked for and no { -tracker } is set up. The key opens the Accounts screen, as the key map draws it.
accounts-no-tracker = Belum ada pelacak yang terhubung. Tekan { $key } untuk membuka Akun.

# Heading of the sign-in prompt shown while a device code is waiting to be entered.
accounts-finish-signing-in = Selesaikan masuk ke { $tracker }

# First step of the device-code sign-in: the address to open. The spaces keep it aligned with the next step.
accounts-step-open = 1. Buka   { $url }

# Second step of the device-code sign-in: the code is shown after this, in the same row.
accounts-step-enter = 2. Masukkan

# Under a device code that is about to run out, seconds left.
accounts-code-expires-seconds = Kedaluwarsa dalam { $seconds } dtk

# Under a device code, whole minutes left.
accounts-code-expires-minutes = Kedaluwarsa dalam { $minutes } mnt

# Under a device code that has run out. Pressing Enter on the row asks for a new one.
accounts-code-expired = Kode kedaluwarsa

# Column heading above the { -tracker-pl }' names.
accounts-column-tracker = Pelacak

# Column heading above each account's state.
accounts-column-state = Status

# Column heading above the number of changes waiting to be sent to the { -tracker }.
accounts-column-queued = Antre

# Column heading above where the sign-in token is stored.
accounts-column-token = Token

# Heading when no { -tracker } is enabled in the config file.
accounts-empty-heading = Tidak ada pelacak-pelacak yang diaktifkan

# Hint under the empty Accounts screen. The setting is the config key that lists the enabled { -tracker-pl }, such as trackers.enabled, and stays as written; config.toml is the file name.
accounts-empty-hint = Tambahkan satu ke { $setting } di config.toml. Riwayat tontonan Anda tetap berfungsi tanpanya.

# State of an account whose sign-in has lapsed. A narrow column, after a mark.
accounts-state-sign-in-again = Masuk lagi

# State of a signed-in account. A narrow column, after a mark.
accounts-state-connected = Terhubung

# State of an account that is not signed in. A narrow column, after a mark.
accounts-state-not-connected = Belum terhubung

# Under an account whose last fetch of the list failed, when it failed today. The time is already formatted, and the reason is the { -tracker }'s own text.
accounts-pull-failed-today = Mengambil daftar Anda gagal pukul { $time }: { $error }

# Under an account whose last fetch of the list failed, on an earlier day.
accounts-pull-failed-dated = Mengambil daftar Anda gagal pada { $date } pukul { $time }: { $error }

# Under an account whose last fetch of the list failed, when the time is not known.
accounts-pull-failed = Mengambil daftar Anda gagal: { $error }

# Note under the accounts when sign-in tokens are kept in files because the system keychain cannot be used. 0600 is the file permission and stays as written.
accounts-token-files = Token disimpan dalam berkas dengan izin 0600 karena keychain sistem tidak tersedia.

# Hint under the accounts for the selected row that is connected. Enter signs it out.
accounts-enter-sign-out = ↵ Keluar

# Hint under the accounts for the selected row that is not connected. Enter signs it in.
accounts-enter-sign-in = ↵ Masuk

# Action on an account row whose sign-in has lapsed.
accounts-action-sign-in-again = Masuk lagi

# Action on a connected account row.
accounts-action-sign-out = Keluar

# Action on an account row that is not connected.
accounts-action-sign-in = Masuk

# Overlay row shown when no { -tracker } is enabled. The setting is the config key that lists the enabled { -tracker-pl }, and stays as written; config.toml is the file name.
accounts-rows-empty = Belum ada pelacak-pelacak yang diaktifkan. Tambahkan satu ke { $setting } di config.toml.

# Part of an account's overlay row: who is signed in.
accounts-row-signed-in-as = Masuk sebagai { $user }

# Part of an account's overlay row: signed in with no user name known.
accounts-row-connected = Terhubung

# Part of an account's overlay row: not signed in.
accounts-row-not-connected = Belum terhubung

# Part of an account's overlay row: changes waiting to be sent.
accounts-row-queued =
    { $count ->
       *[other] { $count } antre
    }

# Part of an account's overlay row: changes waiting to be sent, and some of them held back until the title is matched to the { -tracker }'s own id.
accounts-row-queued-held = { $queued } antre, { $held } menunggu pencocokan

# Action beside a sync difference in the overlay: Enter keeps the value on this device.
accounts-conflict-keep-mine = Pakai lokal

# Action under a sync difference in the overlay: Enter keeps the { -tracker }'s value instead.
accounts-conflict-keep-theirs = Pakai pelacak

# A sync difference in the overlay: the title, the field that differs, then this device's value and the { -tracker }'s. The title is cut to 34 characters before it goes in.
accounts-conflict-row = { $title }  ·  { $field }: lokal { $local } / pelacak { $remote }

# Title of the Library screen, shown in the placeholder when the terminal is too small.
lists-library-title = Pustaka

# Toast when the remove key is pressed outside the { -continue-cap } list.
lists-remove-wrong-list = Judul hanya bisa disembunyikan dari daftar Lanjutkan menonton.

# Toast when a title is removed from the { -continue-cap } list.
lists-continue-removed = { $title } disembunyikan dari Lanjutkan menonton. Menontonnya lagi akan memunculkannya kembali.

# Toast when Enter is pressed on a list with nothing highlighted.
lists-nothing-selected = Tidak ada judul yang dipilih.

# The search box's prompt: the label, then what has been typed (and the cursor).
lists-search-prompt = Cari { $query }

# Heading when a list could not be loaded. The reason follows under it.
lists-load-failed = Daftar ini tidak bisa dimuat

# Shown beside the loading skeleton.
lists-loading = Memuat…

# Heading of an empty search whose query has been typed but not yet sent.
lists-empty-press-enter = Tekan ↵ untuk mencari

# Heading of the Search screen before anything is searched.
lists-empty-type-to-search = Ketik untuk mencari

# Hint under the Search heading when filters are set. ↵ is the Enter key.
lists-empty-browse-filtered = Tekan ↵ untuk menelusuri dengan filter ini.

# Hint under the Search heading when no filter is set. ↵ is the Enter key.
lists-empty-browse-popular = Tekan ↵ untuk menelusuri judul paling populer.

# Heading when a search or a browse found nothing.
lists-empty-no-matches = Tidak ada hasil

# Hint when browsing with filters found nothing.
lists-empty-fewer-filters = Coba kurangi filter.

# Hint when a search found nothing.
lists-empty-shorter-query = Coba kata kunci yang lebih pendek, atau judul romaji.

# Heading of the { -continue-cap } list when there is no watch history.
lists-empty-nothing-watched = Belum ada yang ditonton

# Hint under the empty { -continue-cap } and Library lists. The keys are the ones bound to the Seasonal screen and to search, as the key map draws them.
lists-empty-ways-on = Tekan { $seasonal } untuk musim ini, atau { $search } untuk mencari.

# Heading of the { -continue-cap } list when everything in the history was removed from it.
lists-empty-nothing-to-continue = Tidak ada yang bisa lanjutkan menonton

# Hint under it. The keys are the ones bound to the Seasonal screen and to search.
lists-empty-hidden-come-back = Judul yang Anda sembunyikan akan muncul lagi saat Anda menontonnya. Tekan { $seasonal } untuk musim ini, atau { $search } untuk mencari.

# Heading of any other empty list.
lists-empty-nothing-here = Belum ada apa-apa di sini

# Heading of the Library when no account is connected.
lists-library-no-account = Belum ada akun yang terhubung

# Line under it.
lists-library-works-without = Riwayat tontonan Anda tetap berfungsi tanpanya. Pustaka mencerminkan daftar di pelacak.

# Line under it when no { -tracker } is enabled. The key opens the Accounts screen, as the key map draws it. The setting is the config key that lists the enabled { -tracker-pl }, and stays as written; config.toml is the file name.
lists-library-enable-tracker = Tambahkan satu ke { $setting } di config.toml, lalu tekan { $key } untuk membuka Akun.

# Line under it when a { -tracker } is enabled but not signed in. The key opens the Accounts screen.
lists-library-sign-in = Tekan { $key } untuk membuka Akun dan masuk.

# A Library segment in the strip across the top.
lists-segment-watching = Menonton

# A Library segment in the strip across the top.
lists-segment-planning = Rencana

# A Library segment in the strip across the top.
lists-segment-completed = Selesai

# A Library segment in the strip across the top.
lists-segment-paused = Dijeda

# A Library segment in the strip across the top.
lists-segment-dropped = Ditinggalkan

# An episode in a list row.
lists-episode = E{ $episode }

# An episode in a list row, for a title watched dubbed.
lists-episode-dubbed = E{ $episode } · Berdubbing

# A title's AniList score, out of a hundred, in its facts line and at the end of a list row.
lists-score = { $score }%

# A search result's count at the end of its row: the number of episodes out of how many there will be, while it airs. The table is narrow, so it is the two numbers alone.
lists-count-out-of = { $out }/{ $total }

# A search result's count at the end of its row: the number of episodes out of a total no one has announced yet.
lists-count-out = { $out }/?

# A search result's count at the end of its row, for a movie. Lower case, like the other words in the column.
lists-count-movie = film

# A search result's count at the end of its row, for a title not out yet whose start date AniList does not know.
lists-count-soon = segera

# A search result's count at the end of its row, for a title not out yet: the day and month it starts, such as "9 Jan". The month is the short month name.
lists-count-starts = { $day } { $month }

# After a search result's count, for a title a source said has a dub that does not say how far it goes. Lower case, like the other words in the column.
lists-count-dub = dub

# After a search result's count: how far the dub goes, as "d12" for a dub to episode 12. The column is narrow, so it is one letter and the number.
lists-count-dub-through = d{ $through }

# Column heading above search results' episode counts, from 100 columns wide. Short for episodes.
lists-column-episodes = Eps

# Column heading above how far each search result's dub goes, from 100 columns wide.
lists-column-dub = Dub

# A row on the { -continue-cap } list: the episode and how far into it the person stopped.
lists-row-resume-percent = { $episode } · { $percent }%

# A row on the { -continue-cap } list: the episode and the playhead where the person stopped.
lists-row-resume-clock = { $episode } · { $clock }

# A row for a show with an episode out that has not been watched.
lists-episode-out = { $episode } sudah tayang

# A row, or a line in the preview, for the next episode and the time until it airs. The countdown is already formatted (such as "4d 20h").
lists-episode-in = { $episode } tayang dalam { $countdown }

# A row, or a line in the preview, for a show whose next episode number is not known.
lists-next-in = Tayang dalam { $countdown }

# A line in the preview: an episode that came out a while ago. The countdown is already formatted.
lists-episode-out-ago = { $episode } tayang { $countdown } lalu

# A line in the preview: an episode that came out under a minute ago.
lists-episode-out-just-now = { $episode } baru saja tayang

# The calendar's time column for an episode still to come. The countdown is already formatted.
lists-time-in = Dalam { $countdown }

# The calendar's time column for an episode that aired a while ago.
lists-time-ago = { $countdown } lalu

# The calendar's time column for an episode that aired under a minute ago.
lists-time-just-now = Baru saja

# The calendar's time column when the broadcast time is an estimate. The time is already formatted, with "In" or "ago".
lists-time-approximate = ~{ $time }

# A calendar day heading.
lists-day-today = Hari ini

# A calendar day heading.
lists-day-yesterday = Kemarin

# A calendar day heading.
lists-day-tomorrow = Besok

# The line in the preview that says where the person stopped. The mark in front is added by the screen.
lists-preview-continue-percent = Lanjutkan menonton { $episode } pada { $clock } ({ $percent }%)

# The same line when the fraction is not known.
lists-preview-continue = Lanjutkan menonton { $episode } pada { $clock }

# Beside the progress meter: episodes watched out of the total.
lists-progress-aired =
    { $total ->
       *[other] { $done } dari { $total } episode telah tayang
    }

# Beside the progress meter when there is nothing to count against.
lists-progress-watched =
    { $count ->
       *[other] { $count } episode ditonton
    }

