# Notice when the viewer comes back from a licensed service after long enough to have watched an episode. It holds Mark as watched for 8 seconds. The service is the one they opened, such as Hikari Library.
licensed-return = Bạn đã xem tập { $episode } trên { $service } chưa?

# Notice after Mark as watched on the return notice. It holds Undo.
licensed-marked = Đã đánh dấu tập { $episode } là đã xem.

# A reason on its own, as a toast or a failed play's explanation. The reason is one of the engine's own reasons, so it is translated.
notice-reason = { $reason }

# Reason: no source is set up, so nothing can be played or downloaded. Shown in a toast.
cause-no-sources = Chưa thiết lập các nguồn. Hãy thêm một nguồn trong mục Các nguồn.

# Reason: the play waited two minutes for a connection and the device stayed offline. Shown in a toast and on the failure screen.
cause-no-connection = Không có kết nối. Hãy thử lại khi bạn trực tuyến.

# A play's explanation: the episode's broadcast is still ahead. The "when" says today, tomorrow or a date.
notice-not-aired = Tập { $episode } sẽ phát sóng { $when }.

# A play's explanation: the episode is after the next one to air. The "when" says when that one airs.
notice-not-aired-yet = Tập { $episode } chưa phát sóng. Tập { $next } sẽ phát sóng { $when }.

# Part of an air time: the broadcast is later today. The time is the viewer's local time.
cause-airs-today = hôm nay lúc { $time }

# Part of an air time: the broadcast is tomorrow. The time is the viewer's local time.
cause-airs-tomorrow = ngày mai lúc { $time }

# Part of an air time: the broadcast is within the next week.
cause-airs-in-days =
    { $days ->
       *[other] sau { $days } ngày lúc { $time }
    }

# Part of an air time: the broadcast is more than a week away. The date is year-month-day.
cause-airs-on-date = vào { $date } lúc { $time }

# Reason: the source answered but gave nothing to play.
cause-no-playable-stream = Nguồn đã trả lời nhưng không có gì để phát. Hãy thử nguồn khác.

# Reason: no source could be matched to the title. The detail is what each source said.
cause-title-no-match = Không khớp được tựa này: { $detail }

# Reason: the source the person picked is no longer installed or enabled.
cause-source-gone = Nguồn { $source } không còn khả dụng. Hãy chọn một nguồn khác.

# Reason: the release the person picked would not start. The detail comes from the source.
cause-release-failed = Không khởi chạy được bản phát hành đó: { $detail }

# Reason: a play waited too long for its sources to give it a stream, and gave up.
cause-sources-timed-out = Các nguồn phản hồi quá lâu. Hãy thử lại hoặc chọn một nguồn khác.

# Reason: every source matched the title but none has the episode. The detail is what each said.
cause-no-source-has-episode = Không có nguồn nào có tập { $episode }: { $detail }

# Reason: the source streams episodes but only torrents can be downloaded.
cause-source-cannot-download = Nguồn này phát được tập nhưng không tải về được.

# Reason: the title was never listed by a source, so it can't be downloaded.
cause-no-source-could-list-show = Không có nguồn nào liệt kê được tựa này, nên không tải về được.

# Part of a finished download's toast: subtitle files were merged into the video.
cause-subtitles-merged =
    { $tracks ->
       *[other] Đã gộp { $tracks } bản phụ đề vào video.
    }

# Part of a finished download's toast: merging failed, so the subtitles stay as files beside it.
cause-subtitles-left-apart = Phụ đề vẫn nằm trong tệp riêng bên cạnh. { $reason }

# Part of a download toast: how many episodes of the range were in the queue already.
cause-already-in-downloads =
    { $count ->
       *[other] { $count } tập đã có trong mục tải về.
    }

# Job note while a play looks the title up.
status-looking-up-title = Đang tìm tựa…

# Job note while a play waits for the sources to arrive.
status-loading-sources = Đang tải các nguồn…

# Starting screen, step line while the title is looked up.
start-looking-up-title = Đang tìm tiêu đề

# Starting screen, step line while sources still being set up are waited for.
start-getting-sources-ready = Đang chuẩn bị các nguồn của bạn

# Starting screen, step line while one source is asked for the episode. The name is the source's own.
start-asking-source = Đang hỏi { $name }

# Starting screen, step line once a stream is found and the player opens it.
start-opening-stream = Đang mở luồng

# Starting screen, step line when a stream showed no video and the next stream of the same source is opened.
start-trying-another-stream = Đang thử luồng khác

# Starting screen, step line while a torrent looks for peers that can send it. Never says torrent.
start-finding-peers = Đang tìm peer

# Starting screen, step line while the player waits for data to fill its buffer.
start-buffering = Đang đệm

# Job note while the sources are asked for an episode. The episode is its label, often a number.
status-searching-sources = Đang tìm trong các nguồn tập { $episode }…

# Toast when the player cannot be started. The reason comes from the system.
notice-player-failed-to-start = Không khởi chạy được mpv. Hãy kiểm tra mpv chạy được khi mở riêng. ({ $reason })

# Toast when a stream never showed a frame and the next one is tried.
notice-stream-no-video = Luồng này không có hình. Đang thử { $next } trên { $total }.

# Toast when mpv gave up on a file. The reason is mpv's own line.
notice-player-could-not-play = mpv không phát được tệp này. { $reason }

# Toast when mpv closed without playing and without saying why.
notice-player-exited-silently = mpv đã đóng mà không phát gì và không nêu lý do. Hãy thử nguồn khác.

# Toast when no picture has appeared a while after the player opened.
notice-player-not-playing = mpv chưa bắt đầu phát sau { $seconds } giây. Nguồn có thể không có dữ liệu. Hãy kiểm tra mpv có phát được một tệp khi chạy riêng không.

# Toast when a play is asked for in a build with no player.
notice-no-player = Phiên bản Kaeri này không phát được video.

# Toast at launch when the mpv program is missing. The binary is the name the settings give it. Terminal only: the engine never sends it to the apps.
notice-mpv-missing = Không tìm thấy { $binary }. Hãy cài mpv để phát tập.

# Toast at launch when mpv is too old for Kaeri's own player. Terminal only: the engine never sends it to the apps.
notice-mpv-old = mpv { $version } có thể phát, nhưng trình phát của Kaeri cần mpv 0.36 trở lên cho nút bỏ qua, thẻ Tiếp theo, menu và ảnh xem trước.

# Toast when an episode plays with no subtitles because none of the source's subtitle files could be downloaded.
notice-subtitles-unavailable = Không tải được phụ đề của nguồn này. Hãy chọn một nguồn khác để thử lại.

# Toast after a link was handed to the browser.
notice-opened-in-browser = Đã mở trong trình duyệt.

# Toast when a link could not be opened. The reason comes from the system.
notice-could-not-open = Không mở được. { $reason }

# Toast when a trailer plays in mpv.
notice-trailer-playing = Đang phát trailer trong mpv.

# Toast when a trailer opens in the browser.
notice-trailer-opened = Đã mở trailer trong trình duyệt.

# Toast when a trailer could not be opened. The reason comes from the system.
notice-trailer-failed = Không mở được trailer. { $reason }

# Toast when the next episode is not the one after this because filler was skipped.
notice-filler-skipped = Đã bỏ qua tập filler. Tiếp theo là tập { $episode }.

# Toast after switching the audio while playing.
notice-audio-now-subbed = Âm thanh hiện là có phụ đề.

# Toast after switching the audio while playing.
notice-audio-now-dubbed = Âm thanh hiện là lồng tiếng.

# Toast when the previous-episode control is used on the first episode.
notice-already-first-episode = Đây đã là tập đầu tiên.

# Toast when the next-episode control is used on the last known episode.
notice-last-episode = Không có tập sau. Tập { $episode } là tập cuối.

# Toast when the next-episode control is used and the next episode is not known.
notice-no-next-episode = Không có tập sau.

# Toast when the previous-episode control finds no previous episode.
notice-no-previous-episode = Không còn tập trước.

# Toast when the title's episode match could not be cleared. The reason comes from the system.
notice-match-reset-failed = Không đặt lại được kết quả khớp. { $reason }

# Toast when the chosen match could not be saved. The reason comes from the system.
notice-match-save-failed = Không lưu được kết quả khớp đó. { $reason }

# Toast when a chosen match still left the title undecided.
notice-match-did-not-stick = Kết quả khớp đó không được giữ lại. Nguồn có thể đã thay đổi. Hãy thử chọn lại.

# Toast when a search of the sources for a title found nothing.
notice-source-search-empty = Không tìm thấy gì cho “{ $query }”. Hãy thử tìm bằng từ khóa khác.

# In the list of titles a source offers for a show, in place of how close a title is: it was ruled out because its format cannot be the show's, as an OVA for a TV series.
match-ruled-out-format = Khác định dạng

# In the list of titles a source offers for a show, in place of how close a title is: it was ruled out because it lists more episodes than the show has.
match-ruled-out-episodes = Nhiều tập hơn tựa này

# In the list of titles a source offers for a show, in place of how close a title is: it was ruled out because it started in another year.
match-ruled-out-year = Khác năm

# Why a search of a source for a show's match failed, under "Couldn't search" and the source's name: the source took too long to answer.
match-search-timed-out = Không phản hồi kịp thời.

# Why a search of a source for a show's match failed: the source isn't installed or switched on.
match-search-source-off = Chưa được bật.

# Toast after the person picked a source for one title.
notice-source-pinned = Tựa này giờ phát từ { $source }.

# Toast after the person went back to automatic source selection for one title.
notice-source-automatic = Quay lại chọn nguồn tự động.

# Toast when the source choice for a title could not be saved. The reason comes from the system.
notice-source-choice-failed = Không lưu được lựa chọn đó. { $reason }

# Toast when no source could list a show's episodes. The reason is what the sources said.
notice-no-source-could-list = Không có nguồn nào liệt kê được tựa này: { $reason }

# Why a title's episodes could not be loaded at all, shown on its page and as a toast. The reason comes from AniList or the network.
notice-episodes-failed = Không tải được danh sách tập. { $reason }

# Toast when a source found several shows that could be this one and could not tell which. The episodes shown are AniList's until one is picked. The source is its name.
notice-match-uncertain = { $source } tìm thấy nhiều hơn một tựa có thể là tựa này, nên tạm thời hiển thị tập từ AniList.

# Toast when a title cannot be taken off the Continue row. The reason comes from the system.
notice-continue-hide-failed = Không xóa được tựa này khỏi Xem tiếp. { $reason }

# Toast after an episode was added to the download queue.
notice-download-queued = Đã thêm tập { $episode } của { $title } vào hàng chờ tải.

# Toast when an episode asked for is in downloads already.
notice-download-already-queued = Tập { $episode } của { $title } đã có trong mục tải về.

# Toast when a waiting or paused download was moved to the front and started.
notice-download-starting-now = Đang bắt đầu tải tập { $episode } của { $title }.

# Toast after a download was cancelled.
notice-download-cancelled = Đã hủy tải về.

# Toast after a download and its file were deleted.
notice-download-file-deleted = Đã xóa bản tải về và tệp.

# Toast after a download was removed whose file was already gone.
notice-download-removed-file-gone = Đã xóa bản tải về. Tệp của nó đã không còn.

# Toast after a download was removed but its file could not be deleted. The reason comes from the system.
notice-download-removed-file-kept = Đã xóa bản tải về, nhưng không xóa được tệp. { $reason }

# Toast after a download with no file was removed.
notice-download-removed = Đã xóa bản tải về.

# Toast after finished downloads were cleared from the list.
notice-downloads-cleared =
    { $count ->
       *[other] Đã xóa { $count } bản tải về đã xong.
    }

# Toast after the skip times the viewer marked were cleared, from Settings.
notice-skip-marks-cleared =
    { $count ->
       *[other] Đã xóa { $count } mốc bỏ qua bạn đã đánh dấu.
    }

# Toast after clearing skip times from Settings when none were marked.
notice-skip-marks-none = Bạn chưa đánh dấu mốc bỏ qua nào.

# Toast when clearing the skip times the viewer marked failed. The reason comes from the local database.
notice-skip-marks-not-cleared = Không xóa được các mốc bỏ qua của bạn. { $reason }

# Toast when an episode finished downloading.
notice-download-finished = Đã tải xong tập { $episode } của { $title }.

# Toast when an episode finished downloading and the note says what happened to its subtitles.
notice-download-finished-note = Đã tải xong tập { $episode } của { $title }. { $note }

# Toast when a download could not start. The reason comes from the torrent client.
notice-download-failed = Không tải được tập { $episode } của { $title }. { $reason }

# Toast after a range was asked for and nothing was queued.
notice-downloads-none-queued = Chưa thêm gì vào hàng chờ.

# Toast after a range was asked for and nothing was queued, and the reason it stopped.
notice-downloads-none-queued-stopped = Chưa thêm gì vào hàng chờ. { $reason }

# Toast after a range was asked for and every episode was in the queue already. `existing` is the sentence of `cause-already-in-downloads`.
notice-downloads-none-new = Chưa thêm gì mới vào hàng chờ. { $existing }

# Toast as above, with the reason the range stopped. `existing` is the sentence of `cause-already-in-downloads`; `reason` is a sentence saying why the range stopped.
notice-downloads-none-new-stopped = Chưa thêm gì mới vào hàng chờ. { $existing } { $reason }

# Toast after a range was asked for, some episodes were queued and some were there already. `existing` is the sentence of `cause-already-in-downloads`.
notice-episodes-queued-existing =
    { $count ->
       *[other] Đã thêm { $count } tập vào hàng chờ. { $existing }
    }

# Toast as above, with the reason the range stopped.
notice-episodes-queued-stopped =
    { $count ->
       *[other] Đã thêm { $count } tập vào hàng chờ, sau đó dừng. { $reason }
    }

# Toast as above, with some episodes in the queue already and the reason the range stopped. `existing` is the sentence of `cause-already-in-downloads`; `reason` is a sentence saying why the range stopped.
notice-episodes-queued-existing-stopped =
    { $count ->
       *[other] Đã thêm { $count } tập vào hàng chờ, sau đó dừng. { $existing } { $reason }
    }

# Toast when keep next found no room for another episode.
notice-keep-next-full = Không đủ dung lượng trống để giữ các tập sau đã tải. Hãy giải phóng thêm dung lượng để tải thêm.

# Message when a watch party was asked for with no server chosen. The names are a suggested server and who runs it. Terminal only: the engine never sends it to the apps.
party-needs-server = Hãy chọn máy chủ cho xem chung trước, dưới tên syncplay.server. { $server } do { $operator } vận hành.

# Message when an app asked for a watch party with no server chosen. The names are a suggested server and who runs it.
party-choose-server = Hãy chọn máy chủ cho xem chung trước. { $server } do { $operator } vận hành.

# Toast when a watch party is asked for in a build without watch parties.
notice-no-party = Các buổi xem chung không có trong phiên bản Kaeri này.

# Message when a watch party was asked for with no room named.
party-needs-room = Một buổi xem chung cần một phòng để gặp nhau. Hãy chọn phòng trước.

# Message in a watch party when its server connection dropped and is retried.
party-server-lost = Mất máy chủ của xem chung. Đang thử lại.

# Message in a watch party when the connection came back.
party-rejoined = Đã trở lại xem chung.

# Message when the person left a watch party.
party-left = Đã rời xem chung.

# Message when a watch party's server could not be reached, in the lobby or when looking in.
party-server-unreachable = Không kết nối được với { $server }. Hãy kiểm tra máy chủ hoặc thử lại.

# Under a cover: the chapter that is next to read. The chapter is its number, such as 44 or 10.5.
reading-next-chapter = Chương { $chapter }

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-mondays = Thường ra vào thứ Hai

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-tuesdays = Thường ra vào thứ Ba

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-wednesdays = Thường ra vào thứ Tư

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-thursdays = Thường ra vào thứ Năm

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-fridays = Thường ra vào thứ Sáu

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-saturdays = Thường ra vào thứ Bảy

# Under a cover or on a series page: when new chapters usually come out.
reading-usually-sundays = Thường ra vào Chủ nhật

# Under a cover or on a series page: how often new chapters come out, in weeks.
reading-about-every-weeks =
    { $weeks ->
       *[other] Khoảng { $weeks } tuần một lần
    }

# On a book's series page, when the same story is also a show. Shown only to someone who both watches and reads.
reading-also-a-show = Cũng có bản phim

# On a show's page, when the same story is also a manga or a novel. Shown only to someone who both watches and reads.
reading-also-a-book = Cũng có bản truyện

# Under a tracker on a series page, when the furthest chapter read is a half chapter. Trackers count whole chapters only. The chapter is its number, such as 10.5; whole is the number the tracker gets, such as 10.
reading-split-chapter = Chương { $chapter } được gửi tới các dịch vụ theo dõi là chương { $whole }.

# A notice over the page when a chapter opens where it was left. It offers Start over.
reader-resumed = Mở lại ở trang { $page }

# The same notice in a webtoon strip, which counts images rather than pages.
reader-resumed-image = Mở lại ở ảnh { $image }

# A notice in the corner after jumping away with the scrubber or the page grid. Tapping it goes back to the page.
reader-back-to-page = Quay lại trang { $page }

# A notice when another device read further, so the reader moved on to where it stopped. It offers Go back. The chapter is its whole label, such as The Long Night or Episode 63, and the device is its name, such as Living room tablet. A chapter with only a number uses the next message.
reader-moved = Đã chuyển tới { $chapter }, trang { $page }, nơi { $device } dừng lại

# The same notice for a chapter known only by its number, such as 14 or 14.5.
reader-moved-number = Đã chuyển tới chương { $chapter }, trang { $page }, nơi { $device } dừng lại

# A notice the first time a series opens with its reading direction guessed. It offers Change.
reader-detected-right-to-left = Có vẻ đọc từ phải sang trái

# A notice the first time a series opens with its reading direction guessed. It offers Change.
reader-detected-left-to-right = Có vẻ đọc từ trái sang phải

# A notice the first time a series opens as one long strip, guessed from its pages. It offers Change.
reader-detected-strip = Có vẻ là truyện cuộn dọc

# Why a chapter or a list could not load: there is no connection.
reading-failed-offline = Bạn đang ngoại tuyến. Các chương đã tải vẫn mở được.

# Why a chapter or a list could not load: the source did not answer. The source is its name.
reading-failed-source-down = { $source } không phản hồi. Hãy thử lại sau.

# Why a chapter could not load: the source no longer has it.
reading-failed-not-found = Nguồn này không còn có nội dung đó. Hãy thử nguồn khác.

# Why a chapter or a list could not load: the source refused. The reason comes from the source.
reading-failed-blocked = { $source } đã từ chối yêu cầu. { $reason }

# Why a chapter or a list could not load: the source answered with something Kaeri could not read.
reading-failed-parse = Kaeri không đọc được dữ liệu mà { $source } gửi về. Có thể plugin của nó cần cập nhật.

# Why one page did not load. The status is the server's HTTP status code, such as 404.
reading-failed-page = Trang này không tải được (lỗi { $status }). Hãy thử lại.

# Why something could not load: a sign-in is needed. What is a server's or a tracker's name.
reading-failed-sign-in = Hãy đăng nhập lại vào { $what } để đọc tiếp.

# Why a book could not open: its file or folder is gone, perhaps on a drive that is not connected. The path is the file's.
reading-failed-file-missing = { $path } không còn ở đó nữa. Nếu nó nằm trên ổ đĩa, hãy kết nối ổ đĩa rồi thử lại.

# Why a book could not open: the file is damaged or not what its name says. The format is a short name such as CBZ or EPUB.
reading-failed-unreadable = Không đọc được { $path } dưới dạng { $format }. Tệp có thể đã bị hỏng.

# Why a file was not added: Kaeri does not read its kind. The kind is a file extension such as .djvu.
reading-failed-unsupported = Kaeri không đọc được tệp { $kind }.

# Why a book could not open: it is copy-protected or encrypted.
reading-failed-protected = Sách này được bảo vệ bản quyền nên Kaeri không mở được.

# Why a chapter could not be saved: the disk is full.
reading-failed-disk-full = Thiết bị này đã hết dung lượng trống. Hãy giải phóng bớt rồi thử lại.

# Why a novel could not open: the system's web view is too old. The version is its major version number, such as 80.
reading-failed-webview = Tiểu thuyết cần System WebView mới hơn phiên bản { $version }. Hãy cập nhật Android System WebView rồi thử lại.

# Why a book plugin could not be used: it was built for a newer Kaeri. The world is the plugin interface's name and version.
reading-failed-needs-newer = Plugin này cần Kaeri mới hơn ({ $world }). Hãy cập nhật Kaeri để dùng.

# Why a reading request was refused: reading is not available in this build.
reading-failed-off = Bản Kaeri này chưa hỗ trợ đọc truyện.

# Why something about reading failed, for any other reason. The reason is as it came.
reading-failed-other = Đã xảy ra lỗi. { $reason }

# Why Send to e-reader stopped before sending: the file it made is bigger than the e-reader or its service takes. File is the file's name, target the e-reader's name such as Kindle. Shown with Try again.
reading-failed-send-too-large = { $file } có dung lượng { $size }, còn { $target } chỉ nhận tệp tối đa { $limit }. Hãy gửi ít chương hơn mỗi lần rồi thử lại.

# Why Send to e-reader stopped before sending: a part the book needs is not in the file Kaeri made. Part is a path inside the file, such as OEBPS/content.opf. Shown with Try again.
reading-failed-send-missing = { $file } thiếu { $part } nên tệp chưa được gửi. Hãy thử lại.

# Why Send to e-reader stopped before sending: a part of the file Kaeri made does not declare or use the UTF-8 text encoding. Part is a path inside the file. Shown with Try again.
reading-failed-send-encoding = { $part } trong { $file } dùng sai mã hóa văn bản nên tệp chưa được gửi. Hãy thử lại.

# Why Send to e-reader stopped before sending: a part of the file Kaeri made is not laid out as the book format requires. Part is a path inside the file. Shown with Try again.
reading-failed-send-malformed = { $part } trong { $file } không hợp lệ nên tệp chưa được gửi. Hãy thử lại.

# Under a cover or on a series page: what kind of book it is. Manga is drawn in Japan.
reading-kind-manga = Manga

# Under a cover or on a series page: what kind of book it is. Manhwa is drawn in Korea.
reading-kind-manhwa = Manhwa

# Under a cover or on a series page: what kind of book it is. Manhua is drawn in China or Taiwan.
reading-kind-manhua = Manhua

# Under a cover or on a series page: what kind of book it is. A webtoon is drawn as one long strip that scrolls down.
reading-kind-webtoon = Webtoon

# Under a cover or on a series page: what kind of book it is. A one-shot is a story told in a single chapter.
reading-kind-one-shot = One-shot

# Under a cover or on a series page: what kind of book it is. A light novel is a novel from Japan.
reading-kind-light-novel = Light novel

# Under a cover or on a series page: what kind of book it is, for a novel from anywhere else.
reading-kind-novel = Tiểu thuyết

# Under a cover or on a series page: new chapters are still coming out.
reading-status-releasing = Đang ra

# Under a cover or on a series page: the story is complete.
reading-status-finished = Đã hoàn thành

# Under a cover or on a series page: new chapters have stopped for a while.
reading-status-hiatus = Tạm ngưng

# Under a cover or on a series page: the story was stopped before it ended.
reading-status-cancelled = Đã hủy

# Under a cover or on a series page: the first chapter is not out yet.
reading-status-not-yet = Chưa phát hành

# Under a cover or on a series page: how many chapters the series has.
reading-chapters =
    { $count ->
       *[other] { $count } chương
    }

# Under a cover or on a series page: how many volumes the series has.
reading-volumes =
    { $count ->
       *[other] { $count } tập
    }

# Under a cover: the series is on the person's Planning list.
reading-on-planning = Trong danh sách dự định của bạn

# Above the big picture at the top of reading's Home, saying why this series is there: a new chapter came out in a series the person reads.
reading-spotlight-new-chapter = Chương mới của truyện bạn theo dõi

# Above the big picture at the top of reading's Home: the series the person was reading last.
reading-spotlight-continue = Đọc tiếp

# Above the big picture at the top of reading's Home: the first series on the person's Planning list, or one like what they read.
reading-spotlight-up-next = Tiếp theo cho bạn

# Above the big picture at the top of reading's Home: a popular series that is still coming out, shown when the person has nothing of their own yet. It is not a pick for them.
reading-spotlight-popular = Phổ biến, đang ra

# Under the big picture on reading's Home: a chapter that came out today. The chapter is its number, such as 88.
reading-out-today = Chương { $chapter } ra hôm nay

# Under the big picture on reading's Home: a chapter that came out today, with its title.
reading-out-today-titled = Chương { $chapter }, { $title }, ra hôm nay

# Under a cover or the big picture: the page the person stopped on in a chapter.
reading-chapter-page = Chương { $chapter } · trang { $page }

# Under a cover or the big picture: how far into a novel's chapter the person is.
reading-chapter-percent = Chương { $chapter } · { $percent }%

# Under a cover: a chapter came out that the person has not read. The chapter is its number.
reading-chapter-new = Chương { $chapter } là chương mới

# Under a cover: a light novel's part, next to read or in progress. Light novels read in parts.
reading-next-part = Phần { $part }

# Under a cover or the big picture: how far into a light novel's part the person is.
reading-part-percent = Phần { $part } · { $percent }%

# Under a cover: a light novel's part came out that the person has not read.
reading-part-new = Phần { $part } là phần mới

# Under a cover or the big picture: how far into a light novel's part the person is, the part named in the source's own words ("Part 3", "Chapter 3"), as its row on the series page names it.
reading-label-percent = { $label } · { $percent }%

# Under a cover: a light novel's part came out that the person has not read, named in the source's own words ("Part 4", "Chapter 4").
reading-label-new = { $label } là phần mới

# Under a This week cell: a light novel's part that came out that day, with its own title.
reading-part-titled = Phần { $part } · { $title }

# Under a This week cell: a light novel's part that came out that day, with its own title, the part named in the source's own words ("Part 4", "Chapter 4").
reading-label-titled = { $label } · { $title }

# Under the big picture on reading's Home: a light novel's part that came out today.
reading-part-out-today = Phần { $part } ra hôm nay

# Under the big picture on reading's Home: a light novel's part that came out today, named in the source's own words ("Part 4", "Chapter 4").
reading-label-out-today = { $label } ra hôm nay

# Under the big picture on reading's Home: a light novel's part that came out today, with its title.
reading-part-out-today-titled = Phần { $part }, { $title }, ra hôm nay

# Under the big picture on reading's Home: a light novel's part that came out today, with its title, the part named in the source's own words ("Part 4", "Chapter 4").
reading-label-out-today-titled = { $label }, { $title }, ra hôm nay

# Under a Library cover: the chapter the person is at, and the newest chapter there is.
reading-chapter-of = Chương { $chapter } / { $of }

# Under a Library cover: the volume and part of a light novel the person is at.
reading-volume-part = Tập { $volume }, phần { $part }

# Under a Library cover: the volume of a light novel the person is at, and the part in the source's own words ("Part 5", "Chapter 5").
reading-volume-label = Tập { $volume }, { $label }

# A search filter: books from Japan.
reading-origin-japan = Nhật Bản

# A search filter: books from Korea.
reading-origin-korea = Hàn Quốc

# A search filter: books from China.
reading-origin-china = Trung Quốc

# A search filter: books from Taiwan.
reading-origin-taiwan = Đài Loan

# Send to e-reader: a device class with no brand, for e-readers not listed by name. Opens CBZ and EPUB.
export-device-other = Máy đọc sách khác

# Send to e-reader: a device class, a grey e-ink screen of about 6 inches.
export-device-eink-6 = E-ink, 6 inch

# Send to e-reader: a device class, a grey e-ink screen of about 7 or 8 inches.
export-device-eink-7 = E-ink, 7 inch

# Send to e-reader: a device class, a colour e-ink screen of about 7 inches.
export-device-colour-eink = E-ink màu, 7 inch

# Send to e-reader: a device class, a colour tablet.
export-device-tablet = Máy tính bảng

# A table of contents entry in a file sent to an e-reader. The chapter is its number, such as 44 or 10.5.
export-chapter = Chương { $chapter }

# Send to e-reader: a send that waits because chapters must be fetched and downloads are kept to Wi-Fi. A send makes its files from every chapter at once, so all of it waits. n is how many chapters it still has to fetch.
export-waits-for-wifi =
    { $n ->
       *[other] { $n } chương chưa được tải, nên lượt gửi này sẽ chờ Wi-Fi rồi tự chạy tiếp.
    }

# Under a This week cell: the chapter that came out that day, with its own title.
reading-chapter-titled = Chương { $chapter } · { $title }

# A chapter row's state: the person read it.
reading-row-read = Đã đọc

# A chapter row's state: it came out since the person last read and is not read.
reading-row-new = Mới

# A chapter row's state: it is kept on this device to read offline.
reading-row-downloaded = Đã tải

# A chapter row's state: it is downloaded on this device, and the source no longer lists it. It still opens from the download.
reading-row-gone-from-source = Đã bị gỡ khỏi nguồn

# A chapter row's state: it is read from the source and nothing of it is on this device.
reading-row-not-downloaded = Chưa tải

# A chapter row's state: a file in one of the person's folders, or one already on the device.
reading-row-on-device = Trên thiết bị này

# A chapter row's state: it waits its turn to download.
reading-row-queued = Đang chờ

# A chapter row's state: it waits to download until the device is on Wi-Fi.
reading-row-waits-wifi = Đang chờ · cần Wi-Fi

# A chapter row's state: it waits to download until the device has free space again. A full device stopped the downloads; they go on by themselves once there is room.
reading-row-waits-room = Đang chờ · cần dung lượng trống

# A chapter row's state while it downloads.
reading-row-downloading = Đang tải · { $done }/{ $total } trang

# A chapter row's state: the download failed. The reason follows as the next part.
reading-row-failed = Không tải được

# A chapter row's state: the page the person stopped on, of how many.
reading-row-page-of = Trang { $page }/{ $of }

# A chapter row's state: the page the person stopped on, when the length isn't known.
reading-row-page = Trang { $page }

# A novel's chapter row: how far into it the person is.
reading-row-percent = { $percent }%

# A novel's chapter row: the person opened it, and how far in is too little to say as a percent.
reading-row-opened = Đã mở

# A chapter row's state: the person bookmarked it. Bookmarked chapters are kept when read downloads are cleared.
reading-row-bookmarked = Đã đánh dấu

# A chapter row: how long its pages are, for a file on the device.
reading-row-pages =
    { $n ->
       *[other] { $n } trang
    }

# A chapter row: how many versions the person's sources have of it. The row's menu lists them.
reading-row-versions =
    { $n ->
       *[other] { $n } phiên bản
    }

# A chapter row: when it was read or came out, under a minute ago.
reading-ago-now = vừa xong

# A chapter row: when it was read or came out, in minutes.
reading-ago-minutes = { $minutes } phút trước

# A chapter row: when it was read or came out, earlier today.
reading-ago-today = hôm nay

# A chapter row: when it was read or came out, the day before today.
reading-ago-yesterday = hôm qua

# A chapter row: when it was read or came out, in days, under a week.
reading-ago-days =
    { $days ->
       *[other] { $days } ngày trước
    }

# A chapter row: when it was read or came out, in weeks, under two months.
reading-ago-weeks =
    { $weeks ->
       *[other] { $weeks } tuần trước
    }

# A chapter row: when it was read or came out, in months, under a year.
reading-ago-months =
    { $months ->
       *[other] { $months } tháng trước
    }

# A chapter row: when it was read or came out, in years.
reading-ago-years =
    { $years ->
       *[other] { $years } năm trước
    }

# The tracker took the series off its list.
reading-removed-from = Đã xóa khỏi { $tracker }

# The tracker's list did not hold the series, so there was nothing to remove.
reading-removed-not-there = Không có trong danh sách { $tracker } của bạn

# The app never learned which of the tracker's entries this series is, so it asked nothing.
reading-removed-unmatched = Chưa khớp trên { $tracker }, nên ở đó không có gì thay đổi

# The tracker could not take the series off. The reason follows.
reading-removed-failed = Vẫn còn trong danh sách { $tracker } của bạn

# Why a removal failed: the tracker turned the sign-in away.
reading-removed-sign-in = Hãy đăng nhập lại vào { $tracker }, rồi thử một lần nữa.

# The source answered the search and has no series by the series' names.
reading-miss-no-series = Không có truyện nào tên này

# The source has failed every ask since this time of day, in the person's zone.
reading-miss-down-since = Không phản hồi từ { $time }

# The source has failed every ask, since a time on another day or not known.
reading-miss-down = Không phản hồi

# How many parts of a light novel are downloaded.
reading-dl-parts =
    { $count ->
       *[other] { $count } phần
    }

# What the downloads take up on this device.
reading-dl-size = { $size }

# How many of the downloaded chapters are read, which Delete read clears.
reading-dl-read = { $count } đã đọc

# The chapter downloading now.
reading-dl-chapter = Chương { $chapter }

# How far the chapter downloading now has come.
reading-dl-pages = { $done }/{ $total } trang

# Chapters waiting their turn after the one downloading.
reading-dl-more-queued = { $count } đang chờ nữa

# Chapters waiting their turn, none downloaded yet.
reading-dl-queued = { $count } đang chờ

# Chapters that wait for Wi-Fi to download.
reading-dl-waits-wifi = chờ Wi-Fi

# Chapters that wait for free space to download: a full device stopped the downloads, and they go on by themselves once there is room.
reading-dl-waits-room = chờ dung lượng trống

# A chapter that failed. The reason follows as the next part.
reading-dl-failed = Chương { $chapter } không tải được

# After "Chapter 2 couldn't download" when there was no network: the downloads banner says the rest.
reading-dl-offline = Ngoại tuyến

# After "Chapter 2 couldn't download" when the device is full and more chapters were queued after it. Downloads go on by themselves, with this chapter first, once some space is free.
reading-dl-no-room =
    { $count ->
       *[other] Hết dung lượng. Mục này và { $count } mục nữa sẽ tải khi có dung lượng trống.
    }

# How much the chosen chapters will take, from their pages and the size of pages downloaded before.
reading-estimate-size = Khoảng { $size }

# The chapters download only on Wi-Fi, as the settings say.
reading-estimate-wifi = qua Wi-Fi

# The device is on mobile data, and the settings let chapters download on it.
reading-estimate-mobile = qua dữ liệu di động

# The device is on mobile data and the chapters wait until it's on Wi-Fi.
reading-estimate-waits-wifi = chờ Wi-Fi

# The notification's title.
reading-downloads-done-title = Đã tải xong

# The notification's text: one series' chapters are downloaded.
reading-downloads-done-chapters =
    { $count ->
       *[other] { $count } chương của { $title } đã sẵn sàng để đọc ngoại tuyến.
    }

# The notification's text: one light novel's parts are downloaded.
reading-downloads-done-parts =
    { $count ->
       *[other] { $count } phần của { $title } đã sẵn sàng để đọc ngoại tuyến.
    }

# The notification's text: chapters of several series are downloaded.
reading-downloads-done-series = Các chương của { $count } bộ truyện đã sẵn sàng để đọc ngoại tuyến.

# Row heading on reading's Home: manga that are trending on AniList now.
read-home-trending-manga = Manga thịnh hành

# Row heading on reading's Home: webtoons that are trending on AniList now.
read-home-trending-webtoons = Webtoon thịnh hành

# Row heading on reading's Home: light novels that are trending on AniList now.
read-home-trending-novels = Light novel thịnh hành

# Row heading on reading's Home: the most popular manga that started in the last 12 months.
read-home-new-manga = Manga mới

# Row heading on reading's Home: the most popular webtoons that started in the last 12 months.
read-home-new-webtoons = Webtoon mới

# Row heading on reading's Home: the most popular light novels that started in the last 12 months.
read-home-new-novels = Light novel mới

# Side text beside a New row's heading, in a quieter style: what the row covers.
read-home-new-side = 12 tháng qua

# Row heading on reading's Home: the most popular manga that have finished.
read-home-finished-manga = Manga đã hoàn thành

# Row heading on reading's Home: the most popular webtoons that have finished.
read-home-finished-webtoons = Webtoon đã hoàn thành

# Row heading on reading's Home: the most popular light novels that have finished.
read-home-finished-novels = Light novel đã hoàn thành

# Side text beside a Finished row's heading, in a quieter style: how the row is sorted.
read-home-finished-side = Phổ biến nhất

# A choice of reading Search's Started filter: series that started at any time.
read-search-started-any = Mọi thời điểm

# A choice of reading Search's Started filter: series that started in the last 12 months.
read-search-started-year = 12 tháng qua

# A choice of reading Search's Started filter: series that started in the last 3 years.
read-search-started-3-years = 3 năm qua

# Under a source's hit in Search: the chapters it holds, from the first.
read-hit-chapters = Chương 1 đến { $last }

# Under a source's hit in Search: a web novel's episodes it holds, from the first.
read-hit-episodes = Kỳ 1 đến { $last }

# Under a source's hit in Search: a light novel's parts it holds.
read-hit-parts =
    { $count ->
       *[other] { $count } phần
    }

# Under a source's hit in Search: the book files it holds.
read-hit-files =
    { $count ->
       *[other] { $count } tệp
    }

# Under a source's hit in Search: the book files it holds, all in one format ("CBZ").
read-hit-files-format =
    { $count ->
       *[other] { $count } tệp · { $format }
    }

# The name of the folders on this device, which read as one source: a Search group's heading, the source a series reads from, "In Folders" on a search result. It stands alone, with no word for its kind beside it.
read-source-folders = Thư mục

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since January".
reading-since-january = từ tháng 1

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since February".
reading-since-february = từ tháng 2

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since March".
reading-since-march = từ tháng 3

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since April".
reading-since-april = từ tháng 4

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since May".
reading-since-may = từ tháng 5

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since June".
reading-since-june = từ tháng 6

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since July".
reading-since-july = từ tháng 7

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since August".
reading-since-august = từ tháng 8

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since September".
reading-since-september = từ tháng 9

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since October".
reading-since-october = từ tháng 10

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since November".
reading-since-november = từ tháng 11

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since December".
reading-since-december = từ tháng 12

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Đã tham gia { $store } với tên { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Đã tham gia { $store } mà không có tên.

# Toast after leaving a plugin store.
store-left = Đã rời { $store }. Các plugin đã cài vẫn được giữ lại.

# Toast after a plugin is deleted from this device.
plugin-removed = Đã xóa { $plugin }.

# Toast after a store owner removes a member.
store-member-removed = Đã xóa. Các thiết bị của họ không còn hoạt động với cửa hàng plugin này.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Đã hủy lời mời. Liên kết không còn hoạt động.

# Toast after cancelling an invite that people joined with.
store-invite-cancelled-kept =
    { $count ->
       *[other] Đã hủy lời mời. { $count } người đã tham gia vẫn là thành viên.
    }

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Bất kỳ ai có liên kết của cửa hàng plugin giờ đều có thể tham gia. Sao chép liên kết từ màn hình thành viên.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Chỉ những người bạn mời mới có thể tham gia.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
       *[other] Chỉ những người bạn mời mới có thể tham gia. { $devices } thiết bị đã tham gia bằng liên kết vẫn hoạt động cho đến khi bạn xóa đi.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Thiết bị đó không còn hoạt động với cửa hàng plugin này.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Đã xóa mọi thiết bị đã tham gia bằng liên kết.

# Toast after a plugin is published to a store.
plugin-published = Đã đăng { $plugin } { $version }.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } không còn được cung cấp.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Đã mở trang quản trị trong trình duyệt. Liên kết chỉ dùng được một lần, trong 10 phút.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Không mở được trình duyệt ({ $reason }). Trên máy của cửa hàng plugin, hãy chạy "kaeri store admin" để in liên kết.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = Đã cài { $plugin } { $version }, nhưng các plugin đang tắt trong thứ tự nguồn, nên không được dùng.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = Đã cài { $plugin }, nhưng { $id } là tên của một nguồn tích hợp sẵn, nên không được tải.

# Toast after a plugin is installed and ready to use.
plugin-installed = Đã cài { $plugin } { $version }.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = Đã cài { $plugin }, nhưng không tải được. { $reason }

# Toast after a plugin is installed but was built for an older plugin interface, so it was not loaded.
plugin-installed-outdated = Đã cài { $plugin }, nhưng bản này được tạo cho phiên bản Kaeri cũ hơn và cần cập nhật. Hãy nhờ tác giả cung cấp bản mới.

# Note on the sources screen when plugins were skipped because they were built for an older plugin interface.
plugins-outdated =
    { $count ->
       *[other] { $count } plugin được tạo cho phiên bản Kaeri cũ hơn và cần cập nhật: { $names }.
    }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
       *[other] Plugin có { $count } bản cập nhật sẵn sàng: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Không tải được các plugin. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Không có mã thông báo cho { $store } trên thiết bị này. Hãy tham gia lại bằng lời mời mới.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Cửa hàng plugin đó không còn trong danh sách đã tham gia.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = Khóa của cửa hàng plugin này trên thiết bị bị hỏng. Hãy rời khỏi cửa hàng plugin và tham gia lại bằng lời mời mới.

# Error: a store rejected this device's token.
store-device-refused = { $store } không còn chấp nhận thiết bị này. Hãy tham gia lại bằng lời mời mới.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Không kết nối được với { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = { $store } đã tham gia ở { $current }, nhưng liên kết này trỏ tới { $target }. Nếu cửa hàng plugin đã chuyển đi, hãy rời khỏi trước rồi tham gia lại.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Bạn đã tham gia { $store } với tên { $member }. Liên kết này sẽ tham gia lại mà không có tên của bạn, nên chưa có gì thay đổi.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } không phải là cửa hàng plugin trong lời mời ({ $reason }). Chưa tham gia gì cả.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Không lưu được mã thông báo cho cửa hàng plugin này. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Lời mời này đã được dùng, đã bị hủy hoặc đã hết hạn. Hãy xin lời mời mới.

# Error: the invite was used as many times as it allows.
store-invite-used-up = Lời mời này đã hết lượt dùng. Hãy nhờ { $owners } gửi lời mời mới.

# Error: the invite's end date passed.
store-invite-ended = Lời mời này đã hết hạn { $when }. Hãy nhờ { $owners } gửi lời mời mới.

# Error: an owner cancelled the invite.
store-invite-was-cancelled = Lời mời này đã bị hủy. Hãy nhờ { $owners } gửi lời mời mới.

# Line under any of these when the store has a contact.
store-invite-contact = Liên hệ: { $contact }

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Liên kết này không còn cho phép ai tham gia. Hãy xin chủ cửa hàng plugin gửi liên kết hoặc lời mời mới.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } là tên của một nguồn tích hợp sẵn, nên không thể là một plugin.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } không còn cung cấp { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } đã thay đổi { $plugin } sau khi được hiển thị. Hãy xem lại trước khi cài đặt.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } được cài từ { $store }, nơi tiếp tục cập nhật nó.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } đã khai báo { $plugin }. Hãy xóa tệp đó trước, nếu không hai bản sẽ chạy cùng lúc.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Không cài được { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Không đăng được { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } không còn trong thư mục plugin.

# Error: a book source cannot be published to a store whose server is too old to list book sources.
store-takes-no-books = { $store } chưa liệt kê các nguồn sách. Chủ sở hữu có thể cập nhật cửa hàng plugin để thêm chúng.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Thiết bị này đã tham gia { $store } bằng liên kết. Hãy dán cùng liên kết đó vào thiết bị kia.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = Cửa hàng plugin gửi một liên kết không dùng được. Hãy nhờ chủ cửa hàng plugin kiểm tra lại. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = Cửa hàng plugin đã tạo liên kết với một khóa khác. Hãy kiểm tra địa chỉ đã dùng khi khởi động.

# Error: the store's server has no admin page.
store-admin-missing = { $store } không có trang quản trị. Máy chủ của nó có thể cũ hơn.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } gửi một liên kết quản trị dẫn đến địa chỉ khác.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = Máy chủ của { $store } cũ hơn và không thể cho phép ai tham gia bằng liên kết. Hãy cập nhật trước.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = { $name } đã tắt. Kaeri bỏ qua nó khi tìm tập.

# Toast after a source (plugin) is switched on.
source-switched-on = { $name } đã bật.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } chưa được tải. Hãy kiểm tra plugin đã được cài trong mục Các nguồn chưa.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = Tựa này giờ dùng { $name }.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Không lưu được lựa chọn đó. { $reason }

# Note on the sources screen: the proxy for torrent traffic failed its check, so torrents wait.
torrent-proxy-waiting = Kiểm tra proxy không đạt. Torrent sẽ bắt đầu khi proxy đạt kiểm tra.

# Note on the sources screen: the proxy for torrent traffic hasn't been checked yet.
torrent-proxy-unchecked = Torrent sẽ bắt đầu khi proxy đạt kiểm tra.

# Error: the link or file given to open is not a magnet link, an info hash or a torrent file.
torrent-link-unusable = Đây không phải liên kết magnet hay tệp torrent.

# Error: a link the viewer opened can't play or download while torrent playback is off.
torrent-link-playback-off = Hãy bật phát torrent trong Cài đặt để phát liên kết của bạn.

# Error: the search for what a link the viewer opened is didn't work. The reason comes from the catalogue.
opened-search-failed = Không tìm được tựa phim đó. { $reason }

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = Kaeri đã đóng trước khi torrent bắt đầu.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Không khởi động được phiên torrent. { $reason }

# Toast when the proxy setting can't be used. The reason comes from the proxy setting.
torrent-proxy-unusable = Không dùng được cài đặt proxy. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on and a proxy set.
sources-reloaded-torrents-checking = Đã tải lại Các nguồn. Torrent sẽ bắt đầu khi proxy đạt kiểm tra.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrent đang tắt. Phiên đã dừng.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Đang chờ giới hạn tốc độ của AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Đang chờ { $wait } vì giới hạn tốc độ của AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList không phản hồi. Hiện đang hiển thị dữ liệu từ dịch vụ khác.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Không có dịch vụ siêu dữ liệu nào phản hồi. Đang hiển thị dữ liệu đã lưu gần nhất.

# Toast when AniList answers again.
notice-anilist-back = AniList đã hoạt động trở lại.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Các buổi xem chung chưa có trong ứng dụng này.

# Notice after the demo is removed. It offers Undo for 8 seconds.
sources-demo-removed = Đã gỡ bản demo

# Notice after the first plugin from a store installs while the demo is on. It offers Remove demo for 8 seconds.
stores-ready-demo-stays = { $store } đã sẵn sàng. Bản demo vẫn nằm cuối mục Các nguồn của bạn.

# The page the browser shows after signing in to a cloud drive on a computer (Windows, Linux or the terminal), once Kaeri has caught the sign-in. The person goes back to the app by themselves.
cloud-loopback-done = Bạn có thể đóng thẻ này và quay lại Kaeri.

# The error line under Sync on a device that another of the person's devices removed from sync. Joining again, with a code or the recovery key, or setting sync up again adds it as a new device.
sync-device-removed = Thiết bị này đã bị xóa khỏi đồng bộ trên một thiết bị khác. Hãy tham gia lại để đồng bộ.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Đã đăng nhập vào { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Đã đăng nhập vào { $tracker }. Mã đăng nhập được lưu trong chuỗi khóa của hệ điều hành.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Đã đăng nhập vào { $tracker }. Không có chuỗi khóa nào, nên mã đăng nhập được lưu trong một tệp riêng chỉ người dùng này đọc được, trên thiết bị này.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Đã đăng nhập vào { $tracker }, nhưng không lưu được mã, nên lần sau bạn sẽ phải đăng nhập lại. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Không lưu được mã đăng nhập. Hãy thử đăng nhập lại. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Không đăng nhập được vào { $tracker }. Hãy thử lại. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = Việc đăng nhập vào { $tracker } đã dừng trước khi xong. Hãy thử lại. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Không nhận được mã từ { $tracker }. Hãy thử đăng nhập lại. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Không mở được trình duyệt để đăng nhập. Hãy kiểm tra xem đã cài trình duyệt chưa rồi thử lại. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Đã nhận phản hồi đăng nhập từ { $tracker }, nhưng không có lần đăng nhập nào đang chờ. Hãy bắt đầu đăng nhập lại.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = Phản hồi đăng nhập từ { $tracker } không khớp với yêu cầu. Hãy bắt đầu đăng nhập lại.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = Phiên đăng nhập vào { $tracker } trả về mà không có mã. Hãy thử lại.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Không hoàn tất được đăng nhập MyAnimeList: bản dựng này chưa có thành phần kết nối cho dịch vụ đó.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Kitsu đăng nhập từ màn hình Tài khoản.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Chưa hỗ trợ đăng nhập vào { $tracker }.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Đăng nhập vào { $tracker } cần chuyển hướng qua trình duyệt, nhưng ứng dụng này không nhận được chuyển hướng đó.

# Toast when AniList is set to a sign-in method only the Kaeri app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Kiểu đăng nhập AniList này chỉ hoạt động trong ứng dụng Kaeri. Để đăng nhập ở đây, hãy đặt { $setting } thành "loopback" trong tệp cấu hình.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList cần client id và secret. Hãy đặt { $client } và { $secret } trong tệp cấu hình, rồi đăng nhập lại. Để lấy địa chỉ đăng nhập, chạy kaeri --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Không dán được mã ở đây. Hãy thoát rồi chạy kaeri --login.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList cần client id. Hãy đăng ký một ứng dụng với loại "other" tại myanimelist.net/apiconfig, rồi đặt { $setting } trong tệp cấu hình.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = Đang chờ { $tracker } chuyển hướng về…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList không cấp mã làm mới. Khoảng một tháng nữa bạn sẽ phải đăng nhập lại.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Hãy đặt { $setting } trong tệp cấu hình trước.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Đã đăng xuất khỏi { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
       *[other] Đã đăng xuất khỏi { $tracker }. { $count } thay đổi đang chờ được giữ lại cho lần đăng nhập sau.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Không đăng xuất được khỏi { $tracker }. Hãy thử lại. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Không lưu được cài đặt đó. { $cause }

# Toast when the proxy for torrent traffic was saved.
notice-proxy-saved = Lưu lượng torrent giờ đi qua proxy.

# Toast when the proxy for torrent traffic was turned off.
notice-proxy-removed = Torrent giờ kết nối trực tiếp, không qua proxy.

# Toast when the proxy could not be checked. The cause says why.
notice-proxy-not-checked = Không kiểm tra được proxy. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Không giữ được mật khẩu proxy. Hãy nhập lại để thử lưu. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Không lưu được cài đặt đó. { $value } không phải giá trị hợp lệ cho { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Không đặt lại được cài đặt của bộ phim này. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Không lưu được lựa chọn phụ đề đó. Bộ phim này chưa từng dùng phụ đề đó.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Đã làm mới dữ liệu ánh xạ.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Không làm mới được dữ liệu ánh xạ ({ $datasets }). Sẽ thử lại sau { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, tập { $episode }, đã phát sóng khi bạn vắng mặt.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
       *[other] Có { $count } tập mới của các bộ phim bạn theo dõi đã phát sóng. Lịch chiếu đã có các tập đó.
    }

# Toast when a new release of Kaeri is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = Đã có bản { $tag }. Chạy kaeri --update để cài đặt.

# The reason a proxy was refused: it has no host or no port.
cause-proxy-needs-address = Proxy cần có máy chủ và cổng.

# The reason a proxy could not be checked: its address is not one the check can use.
cause-proxy-address-unusable = Bước kiểm tra proxy không dùng được địa chỉ này.

# The reason a request failed: it never reached the server.
cause-server-unreachable = Không kết nối được tới máy chủ.

# The legal line, shown in About beside Legal and contact. It exists once, so no translation can paraphrase it.
legal-hosts-no-content = Kaeri không host bất kỳ bộ phim hay cuốn sách nào. Bạn tự thêm các nguồn của mình.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = Đã lưu { $label }.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = Không lưu được cài đặt đó. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = Không tải được chi tiết của bộ phim này. Hãy kiểm tra kết nối rồi thử lại.

# Toast when playback stops with an error.
notice-playback-failed = Không phát được. Hãy thử nguồn khác.

# Toast when something went wrong inside the engine and it carried on.
notice-engine-fault = Có lỗi xảy ra bên trong Kaeri. Ứng dụng vẫn chạy tiếp, nhưng nếu màn hình có vẻ bị treo, hãy thoát rồi mở lại.

# Toast at launch when the database was damaged, so a fresh one was started. The path is where the damaged file was moved, kept for recovery. Watch history and downloads start over; what the trackers hold comes back with the next sync.
notice-database-set-aside = Cơ sở dữ liệu bị hỏng, nên Kaeri đã tạo một cơ sở dữ liệu mới. Tệp cũ được giữ tại { $path }. Dữ liệu trên các dịch vụ theo dõi của bạn sẽ trở lại ở lần đồng bộ sau.

# Message when Kaeri could not start because a folder could not be made. The path is the folder, the reason comes from the system.
start-failed-folder = Kaeri không tạo được thư mục { $path }. Hãy kiểm tra xem ổ đĩa còn chỗ trống và thư mục có ghi được không, rồi thử lại. { $reason }

# Message when Kaeri could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can.
start-failed-config = { $path } có một cài đặt mà Kaeri không dùng được: { $problem }. Hãy sửa hoặc xóa cài đặt đó, rồi thử lại.

# Message when the settings could not be reset after a start failed on them: the config file could not be moved aside. The path is the file, the reason comes from the system.
config-reset-failed = Kaeri không di chuyển được { $path } đi chỗ khác để đặt lại cài đặt. { $reason }

# Message when Kaeri could not start because its database could not be opened. The path is the database file, the reason comes from the system.
start-failed-database = Kaeri không mở được cơ sở dữ liệu tại { $path }. Nếu có ứng dụng Kaeri khác đang mở thư mục này, hãy thoát ứng dụng đó rồi thử lại. { $reason }

# Message when Kaeri could not start its network connection from the network settings.
start-failed-network = Kaeri không kết nối được với các cài đặt mạng trong config.toml. Hãy kiểm tra chúng rồi thử lại. { $reason }

# Message when Kaeri itself could not start. The reason comes from the system or the engine.
start-failed = Kaeri không khởi động được. Hãy thoát rồi mở lại. { $reason }

# Message when the TV remote could not start listening or could not forget a phone.
start-failed-remote = Không khởi động được chức năng điều khiển từ xa. { $reason }

# Message when the built-in player could not start.
start-failed-player = Không khởi động được trình phát. { $reason }

# Toast after episodes are added to the download queue.
notice-episodes-queued =
    { $count ->
       *[other] Đã thêm { $count } tập vào hàng đợi tải xuống.
    }

# Notice after the subtitle style is reset. It offers Undo.
settings-subs-reset-done = Đã đặt lại kiểu phụ đề

# Notice at the next launch after a crash, while saving and asking are on.
crash-notice = Kaeri đã đóng sau một sự cố.

# The same notice on the TV, which has no button.
crash-notice-tv = Kaeri đã đóng sau một sự cố. Bạn có thể báo cáo trong Cài đặt, Giới thiệu.

# Toast: Surprise me on a search found no title matching the filters.
notice-surprise-empty-filters = Không có tựa nào khớp với các bộ lọc này.

# Toast: Surprise me on the Planning list, which has nothing on it to pick.
notice-surprise-empty-planning = Danh sách Dự định xem đang trống.

# Toast: Surprise me on the filters while the device is offline; AniList is how a title is picked.
notice-surprise-offline = Bạn đang ngoại tuyến. Gợi ý ngẫu nhiên cần AniList để chọn một tựa.

# Toast: Surprise me on the filters, and AniList could not be asked.
notice-surprise-failed = Không kết nối được với AniList để chọn một tựa. Hãy thử lại sau giây lát.

# Title of the dialog that edits the proxy.
torrents-linux-edit-proxy-title = Sửa proxy

# Seeding row: time left until the goal, in a span already worded ("18h", "1d 6h").
downloads-linux-seed-left = Còn { $span }

# Seeding row: less than an hour left until the goal.
downloads-linux-seed-left-soon = Còn chưa đầy một giờ

# Storage row: free space, the disk's size and what downloads take. All three are sizes already formatted.
downloads-linux-space-free = Còn trống { $free } trên { $total } · tải xuống chiếm { $taken }

# Placeholder of the search field. It also finds settings.
search-linux-placeholder = Tìm phim và cài đặt

# Tooltip of the button that clears the recent searches.
search-linux-clear-recent = Xóa tìm kiếm gần đây

# Title of the state when a browse with no filters lists nothing.
search-linux-nothing-found = Không tìm thấy gì

# Title of the state when a typed search waits for Enter.
search-linux-press-enter = Nhấn Enter để tìm

# Line under the Enter title: why results do not come as you type. The tracker is a name.
search-linux-paused = Tìm khi đang gõ tạm dừng một lúc để không vượt giới hạn của { $tracker }.

# Menu title over the sort choices of the filter row.
filter-linux-sort-by = Sắp xếp theo

# Sort choice: what is rising now.
filter-linux-sort-trending = Thịnh hành

# Sort choice: the most recent first.
filter-linux-sort-newest = Mới nhất

# Sort choice: the earliest first.
filter-linux-sort-oldest = Cũ nhất

# Sort choice: the most favourited first.
filter-linux-sort-favourites = Được yêu thích

# Genre filter button when several genres are set.
filter-linux-genres-count =
    { $count ->
       *[other] { $count } thể loại
    }

# Format filter button when several formats are set.
filter-linux-formats-count =
    { $count ->
       *[other] { $count } định dạng
    }

# Status filter button when several statuses are set.
filter-linux-statuses-count =
    { $count ->
       *[other] { $count } trạng thái
    }

# Search filter button, before a choice is made, and the first choice in its menu.
filter-linux-available = Có sẵn

# Choice in the Available menu that sets no filter.
filter-linux-available-any = Ở mọi nơi

# Choice in the Available menu, and the chip once set: titles the viewer's own sources have.
filter-linux-available-here = Phát được tại đây

# Choice in the Available menu, and the chip once set: titles on a licensed service the viewer added.
filter-linux-available-services = Trên dịch vụ của bạn

# Chip for a genre that is left out of the results. The genre is already named.
filter-linux-not = Không { $genre }

# Button that takes off every filter chip.
filter-linux-clear-all = Xóa tất cả

# Tooltip of the arrow that scrolls the filter row back.
filter-linux-earlier = Bộ lọc trước

# Tooltip of the arrow that scrolls the filter row on.
filter-linux-more = Thêm bộ lọc

# What a screen reader says for a broadcast whose time is an estimate. The time is already formatted.
calendar-linux-about = khoảng { $time }

# What a screen reader says for a broadcast that is the dub's.
calendar-linux-dubbed = lồng tiếng

# Title of the menu, and tooltip of its button, that orders a list.
library-linux-order = Thứ tự

# A list's tab: its name and how many titles it holds.
library-linux-list-count = { $list } { $count }

# Description read by a screen reader on the button that plays the shown episode on a TV.
title-linux-play-on-tv-help = Phát tập này trên TV bằng Kaeri

# Description read by a screen reader on an episode's watched check box.
title-linux-episode-watched = Tập { $episode } đã xem

# Line in a day's column when nothing airs that day.
calendar-linux-day-empty = Không có tập nào chiếu

# Accessible name of the reading Library's list menu, the button that says the list on screen.
linux-read-library-list = Danh sách

# Under No downloads on Downloads, Reading side.
linux-read-downloads-empty = Chương đã tải mở được khi không có kết nối.

# Accessible label of the line that says how the watch party form is getting on.
party-status = Trạng thái xem chung

# Accessible label of the list of people in the watch party, in the player's panel.
party-members = Thành viên

# Title of the dialog that lists the sources that have the watch party's episode.
party-choose-a-source = Chọn một nguồn

# Line when no source lists the watch party's episode. A plugin store adds plugins, which add sources.
party-sources-none-listed = Không nguồn nào có tập { $episode }. Các nguồn đến từ các plugin bạn thêm từ một cửa hàng plugin.

# Line above the list of sources that have the watch party's episode.
party-sources-found-line =
    { $count ->
       *[other] { $count } nguồn có tập này. Nguồn bạn chọn sẽ phát cùng xem chung.
    }

# Notice when the player could not start, or could not be reached to add a track.
player-could-not-start = Trình phát không khởi động được. Hãy thử lại hoặc chọn nguồn khác.

# Notice when the file chosen for a subtitle or audio track has no path the app can read.
player-file-unreadable = Không đọc được tệp đó. Hãy thử tệp khác.

# The reason the system gives for keeping the screen awake and the computer from sleeping while an episode plays. Other apps and the desktop may show it.
player-inhibit-reason = Đang phát tập

# Accessible description of the time left in the episode, beside the countdown.
player-time-left = Còn { $time }

# Line on the starting screen after a note from the engine, with the seconds waited.
player-note-waited = { $note } · { $seconds } giây

# Starting screen's line before the episode is known.
player-starting-plain = Đang khởi động

# Tooltip of the Undo button on the card that says an opening was skipped. The letter is the key that does the same.
player-undo-tooltip = Hoàn tác (U)

# Over the timeline: the time under the pointer, when it is inside an opening.
player-time-opening = { $clock } · Mở đầu

# Over the timeline: the time under the pointer, when it is inside an ending.
player-time-ending = { $clock } · Kết thúc

# Name of a one-channel audio track in the audio menu.
player-channels-mono = Mono

# Name of a two-channel audio track in the audio menu.
player-channels-stereo = Stereo

# Name of an audio track with some other number of channels.
player-channels =
    { $count ->
       *[other] { $count } kênh
    }

# Accessible label of the two buttons that switch between subbed and dubbed audio.
player-translation-label = Có phụ đề hoặc lồng tiếng

# What a screen reader says for the volume slider's value.
player-volume-percent = { $percent } phần trăm

# Said to a screen reader when the Up next card appears with its countdown running.
player-announce-up-next-counting = Tiếp theo, { $title }. Phát sau { $seconds } giây. Nhấn Escape để hủy.

# Said to a screen reader when the Up next card appears and waits.
player-announce-up-next-waiting = Tiếp theo, { $title }. Nhấn Enter để phát, hoặc Escape để hủy.

# Said to a screen reader when the Skip opening or Skip ending card appears. The label is the card's button.
player-announce-skip = { $label }. Nhấn S.

# Said to a screen reader when a skip has just happened and can be taken back. The line is "Skipped opening".
player-announce-undo = { $line }. Nhấn U để hoàn tác.

# Accessible name of a comment's like button: the word Like and how many likes it has.
discussion-like-named =
    { $count ->
       *[other] Thích, { $count } lượt thích
    }

# Chip inside the invite field once an invite link is pasted: the invite's code, hidden but for its last four characters.
linux-store-invite-chip = Lời mời ••••{ $last }

# How many hosts a plugin may contact, filling { $hosts } in "Version 1.4 · may contact 2 hosts".
linux-store-plugin-hosts =
    { $count ->
       *[other] { $count } máy chủ
    }

# Beside a spinner in the plugin store form while the invite is spent, after 600 ms.
linux-store-joining = Đang tham gia…

# The Install all button while the plugins install.
linux-store-installing = Đang cài đặt…

# Third line of a book server's row in Your sources when its sign-in no longer works.
linux-book-server-signed-out = Đã đăng xuất · đăng nhập lại từ Sửa

# Switch on a book server's page: its series show in Kaeri while it is on.
linux-book-server-use = Dùng máy chủ này

# Title of the dialog that asks before a book server is removed.
linux-book-server-remove-title = Xóa { $host }?

# First run's join page, paired: the line under "Kaeri is for" when the other device's answer is Watch.
linux-join-medium-line-watch = Xem, như trên { $device }

# First run's join page, paired: the line under "Kaeri is for" when the other device's answer is Both.
linux-join-medium-line-both = Xem và đọc, như trên { $device }

# Switch on a book plugin's page: its series show in Kaeri while it is on.
linux-book-plugin-use = Dùng plugin này

# Tooltip of the reader toolbar's settings button.
