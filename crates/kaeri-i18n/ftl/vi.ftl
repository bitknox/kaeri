# Line in the publish dialog when this device has no plugin to offer. Follows stores-publish-none.
stores-publish-none-hint = Một plugin bạn xây dựng hoặc cài đặt sẽ hiện ở đây.

# Line under a plugin in the publish dialog that the store does not have yet.
stores-not-published = Chưa có trong cửa hàng plugin

# Line under a plugin in the publish dialog that the store has in another version.
stores-store-offers = Cửa hàng plugin có { $version }

# Line under a plugin in the publish dialog whose version the store already has.
stores-published-current = Đã cập nhật trong cửa hàng plugin

# Word at the end of that row.
stores-published-state = Đã đăng

# Accessible name of a row's Publish button.
stores-publish-label = Đăng { $name } { $version }

# Footnote on the recovery key dialog; the lock is the account password, asked through polkit.
rkey-lock-linux = Bạn có thể xem lại trong Cài đặt, Các thiết bị, sau khi nhập mật khẩu tài khoản.

# Reason polkit shows when it asks for the account password before the recovery key.
rkey-lock-reason = Hiện khóa khôi phục của Kaeri

# Accessible name of the sidebar account row when it opens the profile popover.
profiles-popover-name = Hồ sơ

# Button that makes the first profile when none exists; the Profiles pane’s add row.
profiles-add-row-action = Thêm

# Name of the folder picker dialog for a cloud folder on this computer.
cloud-folder-chooser = Chọn một thư mục

# Button that saves the recovery key to a file.
rkey-save-as-file = Lưu thành tệp

# Button that closes the dialog that shows a device paired.
pair-done-action = Xong

# Under a release in the source picker: how many people share it right now.
source-picker-seeders-linux =
    { $count ->
       *[other] { $count } người chia sẻ
    }

# Tooltip on the header bar button that shows the sidebar while the window is narrow.
sidebar-show = Hiện thanh bên

# Faint line over the calendar's placeholders while it loads.
activity-calendar = Đang tải lịch

# Faint line over a title page's episode placeholders while they load.
activity-episodes = Đang tải các tập

# Faint line over the Sources page while the sources are checked.
activity-sources = Đang kiểm tra các nguồn

# Faint line over the Downloads page while it loads.
activity-downloads = Đang tải phần tải xuống

# Faint line over Search's placeholders while it lists titles with no query typed.
activity-browse = Đang tải danh sách phim

# A transfer rate: a size already worded, per second.
size-per-second = { $size }/s

# A wait that is over.
time-now = Bây giờ

# How long ago, when it was inside the last minute.
time-just-now = Vừa xong

# A length of time said for a screen reader, in hours.
spoken-hours =
    { $count ->
       *[other] { $count } giờ
    }

# A length of time said for a screen reader, in minutes.
spoken-minutes =
    { $count ->
       *[other] { $count } phút
    }

# A length of time said for a screen reader, in seconds.
spoken-seconds =
    { $count ->
       *[other] { $count } giây
    }

# Continue row: nothing new to watch, and the next episode airs at a known time. The time is already worded: "in 2d 3h".
continue-row-caught-up-airs = Đã xem hết · E{ $episode } phát sóng { $when }

# Continue row: nothing new to watch, and the next episode has no date.
continue-row-caught-up-not-out = Đã xem hết · E{ $episode } chưa phát sóng

# Name of a language, in a list of subtitle languages.
language-name-english = Tiếng Anh

# Name of a language, in a list of subtitle languages.
language-name-japanese = Tiếng Nhật

# Name of a language, in a list of subtitle languages.
language-name-spanish = Tiếng Tây ban nha

# Name of a language, in a list of subtitle languages.
language-name-portuguese = Tiếng Bồ đào nha

# Name of a language, in a list of subtitle languages.
language-name-french = Tiếng Pháp

# Name of a language, in a list of subtitle languages.
language-name-german = Tiếng Đức

# Name of a language, in a list of subtitle languages.
language-name-italian = Tiếng Ý

# Name of a language, in a list of subtitle languages.
language-name-russian = Tiếng Nga

# Name of a language, in a list of subtitle languages.
language-name-arabic = Tiếng Ả rập

# Name of a language, in a list of subtitle languages.
language-name-indonesian = Tiếng Indonesia

# Name of a language, in a list of subtitle languages.
language-name-korean = Tiếng Hàn

# Name of a language, in a list of subtitle languages.
language-name-chinese = Tiếng Trung

# Seasonal's format toggle: every format.
seasonal-format-all = Tất cả

# Seasonal's format toggle: ONA, OVA and specials together.
seasonal-format-ona-ova = ONA và OVA

# Accessible name of a title's banner, which opens its page.
title-open-named = Mở { $title }

# Accessible name of a card or row in Continue: the title, then what is said under it.
continue-row-spoken = { $title }, { $detail }

# Accessible name of the pane beside Continue's queue that previews the selected title.
continue-preview = Xem trước

# Under a suggestion that airs later today when no episode number is known: the time it airs.
up-next-airs-at = Chiếu lúc { $time }

# Accessible name of a progress bar on a row that has no better name, such as a download's.
progress-name = Tiến độ

# What a screen reader says for a progress bar's value.
progress-percent = { $percent } phần trăm

# Accessible name of a grid of show covers.
poster-grid-name = Tựa phim

# Line under the title of the last welcome page: what the app plays, without a promise of its own.
onboarding-where-hosts-linux = Kaeri phát những gì bạn đã có: tệp trên thiết bị này, máy chủ Jellyfin của bạn, và các plugin từ các cửa hàng plugin bạn tham gia.

# Words before the link on the empty Sources page.
sources-empty-or = Hoặc

# A folder's line once it is read.
library-row-summary-linux =
    { $episodes ->
       *[other] { $episodes } tập của { $series } bộ
    }

# A folder page's line when changes are noticed as they happen.
library-page-watching-linux = Theo dõi thay đổi

# A folder page's line when changes are found only when the app starts or is asked.
library-page-no-watch-linux = Kiểm tra thay đổi khi Kaeri khởi động

# Heading over the matched series.
library-matched-linux = Đã khớp

# Row line for a series in Needs a look: the title found, if any.
library-best-guess-linux = Đoán gần nhất: { $title }

# Line on a result in the match picker whose episode count does not fit the folder's files.
library-fix-count-mismatch-linux =
    { $episodes ->
       *[other] Có { $episodes } tập, thư mục này có { $files }
    }

# Header title on a terminal too narrow for the rail: the product name, then the section on screen.
chrome-header-section = Kaeri · { $section }

# Header chip while the metadata sources are degraded. The mark is a status glyph. Shown beside the { -source } chips, which are short.
chrome-meta-chip = Siêu dữ liệu { $mark }

# Activity row: how many more running jobs there are than fit. It follows the last job shown.
chrome-activity-more = +{ $count }

# Activity row: a running job that is held up (a rate-limit pause), with the wait counting down. The note says what it waits on; the countdown is a clock such as 0:12.
chrome-job-held = { $note }, { $countdown }

# Heading of an overlay that lists the lines of a long table: which lines are in view.
overlays-window-position = { $from }–{ $to } trên { $total }

# Heading of the help overlay when its table does not fit on one page.
overlays-help-page = Trang { $page } trên { $pages }

# The log overlay, when nothing has been logged this session.
overlays-logs-empty = Chưa có nhật ký nào

# Prompt hint under the manual search heading. The footer names its keys.
overlays-hint-manual-query = Nhập nội dung cần tìm, hoặc để trống để khớp tự động.

# Prompt hint for the first step of signing in to Kitsu.
overlays-hint-kitsu-username = Email hoặc tên người dùng.

# Prompt hint for the second step of signing in to Kitsu. The password is shown as dots.
overlays-hint-kitsu-password = Mật khẩu của bạn được đổi lấy mã thông báo và không được lưu.

# Prompt hint for the download range. The examples are episode numbers and stay as written.
overlays-hint-download-range = 4 cho một tập, 1-12 cho một loạt, 7- cho mọi tập từ đó trở đi.

# Prompt hint for editing a setting: its label on the Settings screen. The footer names the keys.
overlays-hint-edit-setting = Nhập giá trị mới cho { $setting }.

# Prompt hint for joining a { -plugin-store }.
overlays-hint-join-store = Dán liên kết mời hoặc liên kết cửa hàng mà bạn được gửi.

# Prompt hint for naming the person an invite link is for.
overlays-hint-invite-name = Tên của họ, như danh sách thành viên sẽ hiển thị.

# Overlay heading after the title: the plugin's version and the { -plugin-store } it comes from. The plugin's name leads the heading.
overlays-heading-plugin = { $name }   { $version }  ·  từ { $store }

# Overlay heading, after the title "Invite link": whom the link is for.
overlays-heading-invite-for = Dành cho { $name }

# Title of the invite link overlay when the link is not for a named person.
overlays-title-link-device = Liên kết thiết bị khác

# Overlay heading, after the title of the store's link: which { -plugin-store } it opens.
overlays-heading-open-link-of = { $store }

# Overlay heading, after the title of the publish list: where the plugin goes.
overlays-heading-publish-to = Đến { $store }

# Overlay heading, after the title "Which one": the title being matched.
overlays-heading-disambiguate = Khớp với { $name }

# Overlay heading, after the title "Watch order": the title the order is built around.
overlays-heading-watch-order = Quanh { $name }

# Overlay heading, after the title "Recommended": the title the list came from.
overlays-heading-recommendations = Vì bạn thích { $name }

# Overlay heading, after the title of the release list.
overlays-heading-release = Các nguồn khác bù phần còn thiếu.

# Overlay heading, after the title of the { -source } list: the choice is kept for this title.
overlays-heading-source = { $name }

# Overlay heading, after the title of the releases list: the episode it is for.
overlays-heading-releases = Tập { $episode }. Enter để phát lựa chọn của bạn.

# Same, when no episode is known.
overlays-heading-releases-bare = Enter để phát lựa chọn của bạn.

# Toast: a download that is finished cannot be cancelled, only deleted. The key is the delete key.
toast-download-done = Đã tải xuống. Nhấn { $delete } để xóa tập này và tệp của nó.

# Toast: a command needs a title and none is selected.
toast-nothing-selected = Chưa chọn gì. Hãy chọn một phim trước.

# Toast: the download-range key was pressed away from the episode table.
toast-ranges-elsewhere = Các khoảng được xếp hàng từ bảng tập.

# Toast: the filter key was pressed on a screen without filters.
toast-filters-elsewhere = Bộ lọc nằm ở tìm kiếm và bảng tập.

# Toast: a watched-mark key was pressed away from the episode table.
toast-watched-elsewhere = Dấu đã xem nằm ở bảng tập.

# Toast: Back was pressed at the top of a section. The key is the quit key.
toast-at-top = Bạn đang ở đầu. Nhấn { $quit } để thoát.

# Toast: an action was run that does nothing on this screen. The action is its label, such as "Mark all previous watched"; the place says where it works, such as "in the episode table".
toast-works-elsewhere = { $action } hoạt động { $place }.

# Toast: the bug report is being opened.
toast-bug-report-opening = Đang mở báo lỗi trong trình duyệt. Liên kết nằm trong nhật ký.

# Log line holding the whole bug report link, for a terminal that cannot open it.
tui-log-bug-report-link = Báo lỗi: { $url }

# Toast: a key binding in the config file was refused. The problem says which and why.
toast-keybinding-not-applied = Phím tắt chưa được áp dụng: { $problem }. Kiểm tra mục phím trong tệp cấu hình.

# Standing notice: the config file did not load. The problem is the parser's own text.
tui-config-problem = { $file }: { $what }. Đang dùng mặc định cho đến khi sửa.

# Same, when the problem is on a known line.
tui-config-problem-at-line = { $file } dòng { $line }: { $what }. Đang dùng mặc định cho đến khi sửa.

# Log line for the same problem. The path is the whole path of the config file.
tui-config-problem-logged = { $path }: { $problem }. Đang dùng mặc định.

# The status line at the foot of the screen when nothing is being said: the source in use, the audio and the quality.
chrome-status-state = { $source } · { $audio } · { $quality }p

# Heading of the title page when no title is highlighted.
title-heading = Phim

# Under the heading of the title page and the episode table when no title is highlighted.
title-nothing-selected-note = Chưa chọn gì

# Toast when a title action is asked for and no title is highlighted.
title-nothing-selected = Chưa chọn gì. Hãy đánh dấu một phim rồi thử lại.

# Toast when something that needs a title's full page is asked from a list.
title-trailer-off-page = Mở trang của phim để tìm trailer.

# Toast when something that needs a title's full page is asked from a list.
title-recommendations-off-page = Mở trang của phim để xem đề xuất.

# Toast when something that needs a title's full page is asked from a list.
title-seasons-off-page = Mở trang của phim để xem các mùa liên quan.

# Toast when a title has no trailer on record.
title-no-trailer = Chưa có trailer nào cho phim này.

# Toast when a title has no recommendations.
title-no-recommendations = Chưa biết đề xuất nào cho phim này.

# Toast when a title has no connected seasons.
title-no-seasons = Chưa biết mùa liên quan nào của phim này.

# Toast when the { -source } picker is asked for from a list.
title-pin-off-page = Mở trang của phim để chọn nguồn cho phim này.

# Toast when the { -source } picker is asked for and no { -source } is registered. They register a moment after launch.
title-no-sources-yet = Các nguồn vẫn đang tải. Hãy thử lại sau giây lát.

# Toast when a list status or rating is asked for and no { -tracker } is signed in. The command is typed as it is.
title-status-needs-tracker = Trạng thái danh sách của bạn được lưu trên dịch vụ theo dõi, và chưa có dịch vụ nào đăng nhập. Dùng :accounts để đăng nhập.

# Toast when a rating is asked for and no { -tracker } is signed in. The command is typed as it is.
title-rating-needs-tracker = Điểm đánh giá được lưu trên dịch vụ theo dõi, và chưa có dịch vụ nào đăng nhập. Dùng :accounts để đăng nhập.

# Toast after a list status is picked. The status is one of the status names; the trackers are a comma separated list.
title-status-set = Đã đặt trạng thái thành { $status }. Đã xếp hàng để gửi tới { $trackers }.

# Toast after a rating is picked.
title-rated = Đã chấm { $score }/10. Đã xếp hàng để gửi tới { $trackers }.

# List status in the status picker and in the toast after picking one.
title-status-watching = Đang xem

# List status in the status picker and in the toast after picking one.
title-status-planning = Kế hoạch

# List status in the status picker and in the toast after picking one.
title-status-completed = Hoàn thành

# List status in the status picker and in the toast after picking one.
title-status-paused = Tạm dừng

# List status in the status picker and in the toast after picking one.
title-status-dropped = Bỏ dở

# Beside the Completed status in the status picker, when the title has progress: what choosing it does.
title-status-completed-hint = Đặt tiến độ đến tập cuối

# A rating in the rating picker, beside the number 10.
title-rating-10 = Kiệt tác

# A rating in the rating picker, beside the number 9.
title-rating-9 = Rất hay

# A rating in the rating picker, beside the number 8.
title-rating-8 = Hay

# A rating in the rating picker, beside the number 7.
title-rating-7 = Khá tốt

# A rating in the rating picker, beside the number 6.
title-rating-6 = Khá

# A rating in the rating picker, beside the number 5.
title-rating-5 = Trung bình

# A rating in the rating picker, beside the number 4.
title-rating-4 = Kém

# A rating in the rating picker, beside the number 3.
title-rating-3 = Dở

# A rating in the rating picker, beside the number 2.
title-rating-2 = Rất dở

# A rating in the rating picker, beside the number 1.
title-rating-1 = Tệ hại

# Place of a title in the watch order: the nth season of its franchise. Sits in a narrow column.
title-season = Mùa { $number }

# Place of a title in the watch order: it comes before this one.
title-relation-prequel = Phần trước

# Place of a title in the watch order: it is the story this one comes from.
title-relation-parent = Phim gốc

# Place of a title in the watch order: it comes after this one.
title-relation-sequel = Phần sau

# First choice in the { -source } picker: let Kaeri pick.
title-source-automatic = Tự động (nguồn tốt nhất có sẵn)

# Beside a { -source } in the picker when it is failing and so not used.
title-source-failing = Lỗi

# First choice in the { -release } picker: the { -source } decides.
title-release-first = Bản phát hành nào nguồn xếp đầu

# The services a title is available on, under its metadata. The list is already joined.
title-available-on = Có trên { $services }

# Beside the progress meter on the title page: the episode that follows what has been watched.
title-up-next = Tiếp theo: tập { $next }

# Beside the progress meter when the watched count is against the episodes that have aired so far.
title-progress-aired = { $done } trên { $aired } tập đã phát sóng

# Beside the progress meter when there is nothing to count against.
title-progress-watched = { $done } tập đã xem

# Heading of the episode table when the title is not known.
episodes-heading = Các tập

# Column heading over the episode titles.
episodes-column-title = Tiêu đề

# Column heading over the running time of each episode.
episodes-column-run = Phút

# Column heading over how much of each episode is watched.
episodes-column-watched = Đã xem

# Beside a finished episode, in the last column.
episodes-done = Xong

# In the last column for an episode that is not out yet. The span is short, such as 2d 3h.
episodes-airs-in = Sau { $span }

# Episode kind in the last column: the story episodes.
episodes-kind-canon = Chính

# Episode kind in the last column: part story, part filler.
episodes-kind-mixed = Hỗn hợp

# Episode kind in the last column: filler, which can be skipped.
episodes-kind-filler = Lấp chỗ

# Episode kind in the last column: made for the anime and not in the book it comes from.
episodes-kind-anime-canon = Chính gốc anime

# The episode filter shown when nothing is filtered, and named at the top right of the table.
episodes-filter-all = Tất cả tập

# The episode filter that hides the episodes already watched.
episodes-filter-unwatched = Chưa xem

# The episode filter that hides filler.
episodes-filter-no-filler = Bỏ tập lấp chỗ

# Toast after the filter changes.
episodes-showing-all = Đang hiện tất cả các tập.

# Toast after the filter changes.
episodes-showing-unwatched = Đang hiện các tập chưa xem.

# Toast after the filter changes.
episodes-showing-no-filler = Đang hiện các tập không phải lấp chỗ.

# Top right of the episode table: how far the dub goes, for a dub that stops short of what has aired.
episodes-dub-through = Lồng tiếng đến tập { $through }

# Top right of the episode table: the dub has every episode.
episodes-dub-complete = Lồng tiếng

# Heading of the empty episode table when the filter hides every episode.
episodes-empty-filtered = Không có tập nào khớp bộ lọc

# Under the heading when the filter hides every episode. The key is the filter key.
episodes-empty-filtered-hint = Bộ lọc ẩn mọi tập. Nhấn { $key } để đổi.

# Heading of the empty episode table when no { -source } is ready.
episodes-empty-no-source = Chưa có tập nào

# Under the heading when no { -source } is ready. The key opens the { -source-pl } screen.
episodes-empty-no-source-hint = AniList chưa liệt kê tập nào cho phim này, và chưa có nguồn nào sẵn sàng. Nhấn { $key } để mở màn hình Các nguồn.

# Heading of the empty episode table when the title has not aired yet.
episodes-empty-unaired = Chưa có tập nào phát sóng

# Under the heading when the title has not aired yet. The span is short, such as 2d 3h.
episodes-empty-unaired-hint = Tập { $episode } chiếu sau { $span }.

# Heading of the empty episode table when a { -source } matched the title and listed nothing.
episodes-empty-none-listed = Chưa có tập nào được liệt kê

# Under the heading when a { -source } listed no episodes. The keys search by hand and pick another { -source }.
episodes-empty-none-listed-hint = Nguồn không liệt kê tập nào cho phim này. Nhấn { $search } để tìm đúng kết quả, hoặc { $pick } để chọn nguồn khác.

# Toast when an episode has no { -release } to pick from.
episodes-no-releases = Tập này không có các bản phát hành nào để chọn.

# Toast when a download is asked for from a table listed from AniList alone. The key opens the { -source-pl } screen.
episodes-add-source-to-download = Thêm một nguồn trước khi tải xuống. Nhấn { $key } để mở màn hình Các nguồn.

# Toast when marking the episodes before the highlighted one and the table is empty.
episodes-mark-none-listed = Không có tập nào được liệt kê để đánh dấu.

# Toast when marking the episodes before the first one.
episodes-mark-nothing-before = Không có gì trước tập đầu tiên.

# Toast when every episode before the highlighted one is already watched.
episodes-mark-already-watched = Mọi tập trước tập { $episode } đã được xem.

# Toast after the episodes before the highlighted one are marked watched.
episodes-marked-watched =
    { $count ->
       *[other] Đã đánh dấu { $count } tập là đã xem.
    }

# Toast when the range typed for a download is not understood. The examples are typed as they are.
episodes-range-invalid = Không đọc được khoảng đó. Dùng một tập (4), một khoảng (1-12) hoặc mọi tập từ một tập trở đi (7-).

# Toast when no episode falls in the range typed for a download.
episodes-range-empty = Không có tập nào trong khoảng đó. Thử khoảng khác.

# Toast after a range is queued for download.
episodes-queueing =
