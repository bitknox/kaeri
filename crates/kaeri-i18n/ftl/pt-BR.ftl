# Under a source's hit in Search: the chapters it holds, from the first.
read-hit-chapters = Capítulos 1 a { $last }

# Under a source's hit in Search: a web novel's episodes it holds, from the first.
read-hit-episodes = Episódios 1 a { $last }

# Under a source's hit in Search: a light novel's parts it holds.
read-hit-parts =
    { $count ->
        [one] 1 parte
        [many] { $count } de partes
       *[other] { $count } partes
    }

# Under a source's hit in Search: the book files it holds.
read-hit-files =
    { $count ->
        [one] 1 arquivo
        [many] { $count } de arquivos
       *[other] { $count } arquivos
    }

# Under a source's hit in Search: the book files it holds, all in one format ("CBZ").
read-hit-files-format =
    { $count ->
        [one] 1 arquivo · { $format }
        [many] { $count } de arquivos · { $format }
       *[other] { $count } arquivos · { $format }
    }

# The name of the folders on this device, which read as one source: a Search group's heading, the source a series reads from, "In Folders" on a search result. It stands alone, with no word for its kind beside it.
read-source-folders = Pastas

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since January".
reading-since-january = desde janeiro

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since February".
reading-since-february = desde fevereiro

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since March".
reading-since-march = desde março

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since April".
reading-since-april = desde abril

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since May".
reading-since-may = desde maio

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since June".
reading-since-june = desde junho

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since July".
reading-since-july = desde julho

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since August".
reading-since-august = desde agosto

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since September".
reading-since-september = desde setembro

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since October".
reading-since-october = desde outubro

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since November".
reading-since-november = desde novembro

# On a cover in a New row, after the country: the month the series started, within the last 12 months, as in "Japan · since December".
reading-since-december = desde dezembro

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Entrou em { $store } como { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Entrou em { $store } sem nome.

# Toast after leaving a plugin store.
store-left = Saiu de { $store }. Os plugins continuam instalados.

# Toast after a plugin is deleted from this device.
plugin-removed = { $plugin } removido.

# Toast after a store owner removes a member.
store-member-removed = Removido. Os dispositivos desse membro deixaram de funcionar com esta loja de plugins.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Convite cancelado. O link não funciona mais.

# Toast after cancelling an invite that people joined with.
store-invite-cancelled-kept =
    { $count ->
        [one] Convite cancelado. A pessoa que entrou continua como membro.
        [many] Convite cancelado. As { $count } de pessoas que entraram continuam como membros.
       *[other] Convite cancelado. As { $count } pessoas que entraram continuam como membros.
    }

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Quem tiver o link da loja de plugins pode entrar agora. Copie o link na tela de membros.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Agora só entra quem você convidar.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
        [one] Agora só entra quem você convidar. O dispositivo que entrou pelo link continua funcionando até você removê-lo.
        [many] Agora só entra quem você convidar. Os { $devices } dispositivos que entraram pelo link continuam funcionando até você removê-los.
       *[other] Agora só entra quem você convidar. Os { $devices } dispositivos que entraram pelo link continuam funcionando até você removê-los.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Esse dispositivo não funciona mais com esta loja de plugins.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Removido cada dispositivo que entrou pelo link.

# Toast after a plugin is published to a store.
plugin-published = { $plugin } { $version } publicado.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } não é mais oferecido.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Página de administração aberta no navegador. O link funciona uma vez, por 10 minutos.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Não foi possível abrir o navegador ({ $reason }). Na máquina da loja de plugins, rode "kaeri store admin" para imprimir um link.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = { $plugin } { $version } instalado, mas os plugins estão desligados na ordem das fontes, então não é usado.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = { $plugin } instalado, mas { $id } é o nome de uma fonte integrada, então não foi carregado.

# Toast after a plugin is installed and ready to use.
plugin-installed = { $plugin } { $version } instalado. Pronto para usar.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = { $plugin } instalado, mas não carregou. { $reason }

# Toast after a plugin is installed but was built for an older plugin interface, so it was not loaded.
plugin-installed-outdated = { $plugin } foi instalado, mas foi criado para uma versão mais antiga do Kaeri e precisa ser atualizado. Peça uma atualização ao autor.

# Note on the sources screen when plugins were skipped because they were built for an older plugin interface.
plugins-outdated =
    { $count ->
        [one] Um plugin foi criado para uma versão mais antiga do Kaeri e precisa ser atualizado: { $names }.
        [many] { $count } de plugins foram criados para uma versão mais antiga do Kaeri e precisam ser atualizados: { $names }.
       *[other] { $count } plugins foram criados para uma versão mais antiga do Kaeri e precisam ser atualizados: { $names }.
    }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Atualização de Plugin pronta: { $names }.
        [many] Atualizações de Plugin prontas: { $names }.
       *[other] Atualizações de Plugin prontas: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Não foi possível carregar os plugins. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Não há token de { $store } neste dispositivo. Entre de novo com um convite novo.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Você não está mais nessa loja de plugins.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = A chave desta loja de plugins neste dispositivo está danificada. Saia da loja de plugins e entre de novo com um convite novo.

# Error: a store rejected this device's token.
store-device-refused = { $store } não aceita mais este dispositivo. Entre de novo com um convite novo.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Não foi possível acessar { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = { $store } está salva em { $current }, mas este link aponta para { $target }. Se a loja de plugins mudou, saia dela antes e entre de novo.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Você entrou em { $store } como { $member }. Este link faria você entrar de novo sem o seu nome, então nada foi alterado.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } não é a loja de plugins do convite ({ $reason }). Você não entrou.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Não foi possível salvar o token desta loja de plugins. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Este convite já foi usado, foi cancelado ou expirou. Peça um novo.

# Error: the invite was used as many times as it allows.
store-invite-used-up = Este convite já foi usado o máximo de vezes. Peça um novo a { $owners }.

# Error: the invite's end date passed.
store-invite-ended = Este convite expirou { $when }. Peça um novo a { $owners }.

# Error: an owner cancelled the invite.
store-invite-was-cancelled = Este convite foi cancelado. Peça um novo a { $owners }.

# Line under any of these when the store has a contact.
store-invite-contact = Contato: { $contact }

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Este link não deixa mais ninguém entrar. Peça um novo link ou um convite ao dono da loja de plugins.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } é o nome de uma fonte integrada, então não pode ser um plugin.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } não oferece mais { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } mudou { $plugin } depois que ele foi mostrado. Veja de novo antes de instalar.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } foi instalado de { $store }, que o mantém atualizado.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } já declara { $plugin }. Remova esse arquivo primeiro, senão duas cópias vão rodar.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Não foi possível instalar { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Não foi possível publicar { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } não está mais na pasta de plugin.

# Error: a book source cannot be published to a store whose server is too old to list book sources.
store-takes-no-books = { $store } ainda não lista fontes de livros. O dono pode atualizar a loja de plugins para incluí-las.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Este dispositivo entrou em { $store } pelo link. Cole o mesmo link no outro dispositivo.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = A loja de plugins enviou um link que não funciona. Peça ao dono para conferir a loja de plugins. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = A loja de plugins gerou um link com outra chave. Confira o endereço usado para iniciá-la.

# Error: the store's server has no admin page.
store-admin-missing = { $store } não tem página de administração. O servidor pode ser mais antigo.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } enviou um link de administração para outro endereço.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = O servidor de { $store } é mais antigo e não deixa ninguém entrar com link. Atualize-o primeiro.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = A fonte { $name } está desligada. O Kaeri a ignora ao buscar episódios.

# Toast after a source (plugin) is switched on.
source-switched-on = Fonte { $name } está ligada.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } não está carregado. Confira se ele está instalado em Fontes.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = Este título agora usa { $name }.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Não foi possível salvar essa escolha. { $reason }

# Note on the sources screen: the proxy for torrent traffic failed its check, so torrents wait.
torrent-proxy-waiting = A verificação do proxy falhou. Os torrents começam quando ela passar.

# Note on the sources screen: the proxy for torrent traffic hasn't been checked yet.
torrent-proxy-unchecked = Os torrents começam quando o proxy passar na verificação.

# Error: the link or file given to open is not a magnet link, an info hash or a torrent file.
torrent-link-unusable = Isso não é um link magnet nem um arquivo torrent.

# Error: a link the viewer opened can't play or download while torrent playback is off.
torrent-link-playback-off = Ative a reprodução de torrents em Configurações para reproduzir seus próprios links.

# Error: the search for what a link the viewer opened is didn't work. The reason comes from the catalogue.
opened-search-failed = Não foi possível buscar esse título. { $reason }

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = A Kaeri foi fechada antes de os torrents começarem.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Não foi possível iniciar a sessão de torrents. { $reason }

# Toast when the proxy setting can't be used. The reason comes from the proxy setting.
torrent-proxy-unusable = Não é possível usar a configuração do proxy. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on and a proxy set.
sources-reloaded-torrents-checking = Fontes recarregadas. Os torrents começam quando o proxy passar na verificação.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Os torrents estão desligados. A sessão foi encerrada.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Aguardando o limite de requisições do AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Aguardando { $wait } pelo limite de requisições do AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = O AniList não está respondendo. Por enquanto, mostrando dados de outro serviço.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Nenhum serviço de metadados respondeu. Mostrando o que foi salvo por último.

# Toast when AniList answers again.
notice-anilist-back = O AniList voltou.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Sessões em grupo não estão incluídas neste app.

# Notice after the demo is removed. It offers Undo for 8 seconds.
sources-demo-removed = Demo removida

# Notice after the first plugin from a store installs while the demo is on. It offers Remove demo for 8 seconds.
stores-ready-demo-stays = { $store } está pronta. A demo continua por último em Suas fontes.

# The page the browser shows after signing in to a cloud drive on a computer (Windows, Linux or the terminal), once Kaeri has caught the sign-in. The person goes back to the app by themselves.
cloud-loopback-done = Você pode fechar esta aba e voltar ao Kaeri.

# The error line under Sync on a device that another of the person's devices removed from sync. Joining again, with a code or the recovery key, or setting sync up again adds it as a new device.
sync-device-removed = Este dispositivo foi removido da sincronização em outro dispositivo. Entre de novo para sincronizá-lo.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Conectado ao { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Conectado ao { $tracker }. O token está no chaveiro do sistema.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Conectado ao { $tracker }. Não há chaveiro disponível, então o token fica em um arquivo privado neste dispositivo.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Conectado ao { $tracker }, mas o token não foi salvo. Será preciso conectar de novo na próxima vez. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Não foi possível salvar o token de entrada. Tente conectar de novo. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Não foi possível conectar ao { $tracker }. Tente de novo. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = A conexão com o { $tracker } parou antes de terminar. Tente de novo. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Não foi possível receber um token do { $tracker }. Tente conectar de novo. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Não foi possível abrir um navegador para a conexão. Verifique se há um instalado e tente de novo. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Chegou uma resposta de login de { $tracker }, mas nenhum login estava esperando por ela. Comece o login de novo.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = A resposta de login de { $tracker } não corresponde ao pedido. Comece o login de novo.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = A conexão com o { $tracker } voltou sem token. Tente de novo.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Não foi possível concluir a conexão com o MyAnimeList: este app não inclui um cliente para ela.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = O Kitsu se conecta pela tela de Contas.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Ainda não é possível conectar ao { $tracker }.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Conectar ao { $tracker } precisa de um redirecionamento pelo navegador, que este app não consegue receber.

# Toast when AniList is set to a sign-in method only the Kaeri app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Este método de conexão do AniList funciona só no app Kaeri. Para conectar aqui, defina { $setting } como "loopback" no arquivo de configuração.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = O AniList precisa de um ID de cliente e de um segredo. Defina { $client } e { $secret } no arquivo de configuração e conecte de novo. Para obter o endereço de conexão, execute kaeri --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Não é possível colar um código aqui. Saia e execute kaeri --login em vez disso.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = O MyAnimeList precisa de um ID de cliente. Registre um app do tipo "other" em myanimelist.net/apiconfig e defina { $setting } no arquivo de configuração.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = Aguardando o { $tracker } redirecionar de volta…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = O MyAnimeList não emitiu um token de atualização. Será preciso conectar de novo em cerca de um mês.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Defina { $setting } no arquivo de configuração primeiro.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Desconectado do { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Desconectado do { $tracker }. Uma alteração na fila foi mantida para a próxima conexão.
        [many] Desconectado do { $tracker }. { $count } alterações na fila foram mantidas para a próxima conexão.
       *[other] Desconectado do { $tracker }. { $count } alterações na fila foram mantidas para a próxima conexão.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Não foi possível desconectar do { $tracker }. Tente de novo. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Não foi possível salvar essa configuração. { $cause }

# Toast when the proxy for torrent traffic was saved.
notice-proxy-saved = O tráfego dos torrents agora passa pelo proxy.

# Toast when the proxy for torrent traffic was turned off.
notice-proxy-removed = Os torrents agora se conectam diretamente, sem proxy.

# Toast when the proxy could not be checked. The cause says why.
notice-proxy-not-checked = Não foi possível verificar o proxy. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Não foi possível guardar a senha do proxy. Digite a senha de novo para tentar salvar. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Não foi possível salvar essa configuração. { $value } não é um valor aceito para { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Não foi possível redefinir as configurações desta série. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Não foi possível salvar essa escolha de legenda. Esta série nunca usou essas legendas.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Dados de mapeamento atualizados.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Não foi possível atualizar os dados de mapeamento ({ $datasets }). Nova tentativa em { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, episódio { $episode }, foi ao ar enquanto você estava fora.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
        [one] Um novo episódio de uma série que você acompanha foi ao ar. Ele está no calendário.
        [many] { $count } novos episódios de séries que você acompanha foram ao ar. Eles estão no calendário.
       *[other] { $count } novos episódios de séries que você acompanha foram ao ar. Eles estão no calendário.
    }

# Toast when a new release of Kaeri is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = { $tag } está disponível. Execute kaeri --update para instalar.

# The reason a proxy was refused: it has no host or no port.
cause-proxy-needs-address = Um proxy precisa de um endereço e de uma porta.

# The reason a proxy could not be checked: its address is not one the check can use.
cause-proxy-address-unusable = A verificação do proxy não pode usar este endereço.

# The reason a request failed: it never reached the server.
cause-server-unreachable = Não foi possível alcançar o servidor.

# The legal line, shown in About beside Legal and contact. It exists once, so no translation can paraphrase it.
legal-hosts-no-content = O Kaeri não hospeda séries nem livros. Você adiciona suas próprias fontes.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = Configuração salva: { $label }.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = Não foi possível salvar essa configuração. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = Não foi possível carregar este título. Verifique sua conexão e tente de novo.

# Toast when playback stops with an error.
notice-playback-failed = A reprodução falhou. Tente outra fonte.

# Toast when something went wrong inside the engine and it carried on.
notice-engine-fault = Algo deu errado dentro do Kaeri. Ele continuou funcionando, mas se alguma tela parecer travada, saia e abra de novo.

# Toast at launch when the database was damaged, so a fresh one was started. The path is where the damaged file was moved, kept for recovery. Watch history and downloads start over; what the trackers hold comes back with the next sync.
notice-database-set-aside = O banco de dados estava danificado, então o Kaeri criou um novo. O arquivo antigo foi guardado em { $path }. O que seus serviços de acompanhamento guardam volta na próxima sincronização.

# Message when Kaeri could not start because a folder could not be made. The path is the folder, the reason comes from the system.
start-failed-folder = O Kaeri não conseguiu criar a pasta { $path }. Verifique se o disco tem espaço e se é possível gravar nela, e tente de novo. { $reason }

# Message when Kaeri could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can.
start-failed-config = { $path } tem uma configuração que o Kaeri não consegue usar: { $problem }. Corrija ou remova, depois tente de novo.

# Message when the settings could not be reset after a start failed on them: the config file could not be moved aside. The path is the file, the reason comes from the system.
config-reset-failed = O Kaeri não conseguiu mover { $path } para redefinir os ajustes. { $reason }

# Message when Kaeri could not start because its database could not be opened. The path is the database file, the reason comes from the system.
start-failed-database = O Kaeri não conseguiu abrir o banco de dados em { $path }. Se outro Kaeri estiver aberto nesta pasta, feche-o e tente de novo. { $reason }

# Message when Kaeri could not start its network connection from the network settings.
start-failed-network = O Kaeri não conseguiu se conectar com as configurações de rede do config.toml. Confira essas configurações e tente de novo. { $reason }

# Message when Kaeri itself could not start. The reason comes from the system or the engine.
start-failed = O Kaeri não conseguiu iniciar. Saia e abra de novo. { $reason }

# Message when the TV remote could not start listening or could not forget a phone.
start-failed-remote = O controle remoto não conseguiu iniciar. { $reason }

# Message when the built-in player could not start.
start-failed-player = O player não conseguiu iniciar. { $reason }

# Toast after episodes are added to the download queue.
notice-episodes-queued =
    { $count ->
        [one] Um episódio adicionado à fila.
        [many] { $count } episódios adicionados à fila.
       *[other] { $count } episódios adicionados à fila.
    }

# Notice after the subtitle style is reset. It offers Undo.
settings-subs-reset-done = Estilo de legenda redefinido

# Notice at the next launch after a crash, while saving and asking are on.
crash-notice = O Kaeri fechou após um problema.

# The same notice on the TV, which has no button.
crash-notice-tv = O Kaeri fechou após um problema. Você pode relatá-lo em Configurações, Sobre.

# Toast: Surprise me on a search found no title matching the filters.
notice-surprise-empty-filters = Nenhum título corresponde a estes filtros.

# Toast: Surprise me on the Planning list, which has nothing on it to pick.
notice-surprise-empty-planning = A lista Planejado está vazia.

# Toast: Surprise me on the filters while the device is offline; AniList is how a title is picked.
notice-surprise-offline = Você está offline. Me surpreenda precisa do AniList para escolher um título.

# Toast: Surprise me on the filters, and AniList could not be asked.
notice-surprise-failed = Não foi possível acessar o AniList para escolher um título. Tente de novo daqui a pouco.

# Title of the dialog that edits the proxy.
torrents-linux-edit-proxy-title = Editar proxy

# Seeding row: time left until the goal, in a span already worded ("18h", "1d 6h").
downloads-linux-seed-left = { $span } restantes

# Seeding row: less than an hour left until the goal.
downloads-linux-seed-left-soon = Falta menos de uma hora

# Storage row: free space, the disk's size and what downloads take. All three are sizes already formatted.
downloads-linux-space-free = { $free } de { $total } livres · downloads ocupam { $taken }

# Placeholder of the search field. It also finds settings.
search-linux-placeholder = Pesquisar títulos e configurações

# Tooltip of the button that clears the recent searches.
search-linux-clear-recent = Limpar pesquisas recentes

# Title of the state when a browse with no filters lists nothing.
search-linux-nothing-found = Nada encontrado

# Title of the state when a typed search waits for Enter.
search-linux-press-enter = Pressione Enter para pesquisar

# Line under the Enter title: why results do not come as you type. The tracker is a name.
search-linux-paused = A pesquisa enquanto você digita está pausada por um momento, para respeitar os limites de { $tracker }.

# Menu title over the sort choices of the filter row.
filter-linux-sort-by = Ordenar por

# Sort choice: what is rising now.
filter-linux-sort-trending = Em alta

# Sort choice: the most recent first.
filter-linux-sort-newest = Mais recentes

# Sort choice: the earliest first.
filter-linux-sort-oldest = Mais antigos

# Sort choice: the most favourited first.
filter-linux-sort-favourites = Mais favoritos

