# Line of the In a party block. The episode is a number or label.
together-in-party-line = Episódio { $episode } · { $count } na sala · { $ready } prontos

# Button that opens the lobby of the watch party you are in.
together-open-lobby = Abrir sala de espera

# Button that opens the player of the watch party you are in.
together-open-player = Abrir player

# Heading of the list of the last ten watch parties on this device.
together-recent = Salas recentes

# Line of a recent room under its title. The names are who was there; the time is already formatted, such as Tuesday.
together-recent-row = Episódio { $episode } · com { $names } · { $when }

# Line shown when no recent rooms are kept yet.
together-recent-empty = As últimas dez salas em que você entrar aparecem aqui.

# Button on a recent room that goes straight to its lobby with the next episode.
together-rejoin = Voltar

# Menu item that removes a recent room from the list.
together-forget-room = Remover das salas recentes

# Line that says who is in a recent room now, after looking in. The names are already joined.
together-someone-here =
    { $count ->
        [one] { $names } está na sala
        [many] { $names } estão na sala
       *[other] { $names } estão na sala
    }

# Line that says a recent room has nobody in it now.
together-nobody-here = Ninguém aqui agora

# Heading of the small list of servers on the place.
together-servers = Servidores

# Line under the suggested server. The operator is who runs it, such as the Syncplay project.
together-server-suggested = Sugerido · mantido por { $operator }

# Line under a server that parties were held on.
together-server-used =
    { $count ->
        [one] Usado em 1 sessão
        [many] Usado em { $count } de sessões
       *[other] Usado em { $count } sessões
    }

# Button that adds a server to the list.
together-add-server = Adicionar servidor

# Hint on the place that a link or code can be pasted anywhere on the page.
together-paste-shortcut-hint = Cole um link ou código em qualquer lugar desta página.

# Heading of the step that asks what to watch in a new watch party.
party-pick-title = O que você está assistindo?

# Line under a title in the picker: which episode comes next.
party-pick-next = Episódio { $episode } a seguir

# Placeholder of the picker's search field.
party-pick-search = Buscar títulos

# Heading of the step that asks for a server and a name the first time.
party-first-server-title = Escolha um servidor

# Button that makes the room and opens the lobby.
party-start-party = Iniciar sessão em grupo

# Line in the lobby when your own sources have the room's episode.
party-lobby-sources-found = Reproduz das suas fontes

# Line in the lobby when none of your sources has the room's episode.
party-lobby-sources-missing = Ainda não está nas suas fontes

# Line in the lobby when the room's episode is not out. The day is already formatted, such as Saturday.
party-lobby-out-on = Sai em { $day }

# Line that says you stay in the room while you have no source for the episode.
party-still-in-room = Você continua na sala.

# Line in the lobby that counts the room.
party-lobby-count = Na sala · { $ready } de { $count } prontos

# Line in the lobby of an invite: who invited.
party-invited-by = { $name } convidou você

# Line shown while the app looks into a room, after a short wait.
party-looking-in = Espiando a sala

# Note that opening a room shows you in it for a moment.
party-looking-in-note = Abrir uma sala mostra você nela por um instante.

# State of a member whose file is not open yet.
party-member-joining = Entrando

# State of a member from the second episode on who is finding a source.
party-member-finding = Procurando uma fonte

# State of a member who is watching. The time is already formatted, such as 2:14.
party-member-watching-from = Assistindo desde { $time }

# Label of the Ready to watch button once you are ready.
party-ready-on = Pronto

# Heading of the invite block in the lobby.
party-invite = Convite

# Label of the short code in the lobby.
party-code = Código

# Button that opens the system share sheet with the invite link.
party-share = Compartilhar…

# Text shared beside the invite link.
party-share-text = Sessão em grupo · { $title } · Episódio { $episode }

# Notice after the invite link was copied.
party-invite-copied = Link do convite copiado

# Line in the lobby before everyone is ready.
party-starts-line = Começa em 0:00 quando todos estiverem prontos

# Button that starts the room without waiting for those who are not ready.
party-start-anyway = Iniciar mesmo assim

# Line during the three second count before play.
party-starting = Começando em { $seconds }

# Button in the lobby that changes the room's episode.
party-change-episode = Trocar episódio

# Button that changes the server after it could not be reached.
party-change-server = Trocar servidor

# Label over the title and episode the room is watching.
party-room-watching = A sala está assistindo

# Line in the lobby of a room with nothing open.
party-room-nothing = Ainda não há nada aberto na sala.

# Second line under Nothing is open in the room yet.
party-room-nothing-line = Começa quando alguém escolher um episódio.

# Button that picks what the room watches.
party-room-pick = Escolher o que assistir

# Line in the lobby when the room is on a later episode than the invite.
party-room-moved-on = A sala avançou para o episódio { $episode }.

# Notice when someone changes the room's episode.
party-room-changed = { $name } trocou o episódio para { $episode }

# Line in the lobby when a member plays a plain file with no title in its name. The file is its name, such as kzm_08_720p.mkv.
party-room-plain-file = { $name } abriu { $file }

# Label under a title that was found from a plain file's name.
party-room-matched = Identificado pelo nome do arquivo

# Button that rejects a title matched from a file name.
party-room-not-this = Não é este título

# Heading over up to three guesses for a plain file's title.
party-room-guesses = Qual é este título?

# Line when the room's title was found by its name because its id is unknown here.
party-room-found-by-name = Encontrado pelo nome.

# Line when the room's title could not be found in your sources or on AniList.
party-room-not-found = Não foi possível encontrar o que a sala está assistindo nas suas fontes nem no AniList.

# Error under the Join field when a code has the wrong shape. The example is a code such as kite-7qm4-xr9d.
party-code-shape = Um código é uma palavra e oito letras e números, como { $example }.

# Line in the lobby when nobody is in the room of a code.
party-code-empty-room = Ninguém está em { $code } ainda. Confira o código ou espere aqui.

# Button that waits in an empty room.
party-code-wait = Esperar aqui

# Error when a code is used on another server. The server is the suggested one.
party-code-other-server = Códigos funcionam em { $server }. Para outro servidor, peça o link do convite.

# Title line of the bar above the tabs while you are in a party.
party-bar-title = { $title } · Episódio { $episode }

# Second line of the bar above the tabs.
party-bar-line = { $count } na sala · { $ready } prontos

# Second line of the bar when nothing plays for you.
party-bar-idle = Na sala · nada reproduzindo para você

# Second line of the bar while the room has nothing picked: a play anywhere in the app picks the episode for the room.
party-bar-pick = Pressione Reproduzir em qualquer episódio para assistir com a sala

# Notice in the player when someone pauses.
party-paused-by = Pausado por { $name }

# Notice in the player when someone plays.
party-played-by = Reproduzido por { $name }

# Notice in the player when someone moves the position. The time is already formatted.
party-seeked-by = { $name } foi para { $time }

# Line on the Up Next card in a party.
party-next-line = Todos avançam em { $seconds } s

# Line on the starting screen while the room waits for a member.
party-next-waiting = Aguardando { $name } · { $seconds } s

# Notice when a member who was behind joins. The time is already formatted.
party-next-joined-at = { $name } entrou em { $time }

# Line that replaces the autoplay switch in a party.
party-next-off = A sala avança junta no final.

# Line in the lobby after the last episode that is out.
party-last-out = Esse foi o último episódio lançado.

# Line after the last episode out, when the next one has a date. The day is already formatted.
party-last-out-airs = O episódio { $episode } sai em { $day }.

# Button that picks a new title for the room.
party-watch-something-else = Assistir outra coisa

# Notice when a member joins.
party-member-joined = { $name } entrou

# Notice when a member leaves.
party-member-left = { $name } saiu

# Notice when the member who started the party leaves.
party-starter-left = { $name } saiu. A sessão continua.

# Notice after you leave.
party-you-left = Você saiu da sessão em grupo.

# Line under the QR code on the TV.
party-tv-scan = Escaneie para enviar o convite do celular

# Line over the code on the TV.
party-tv-or-code = Ou digite o código

# Line on the TV's page: joining a friend's party goes through a paired phone.
party-tv-join-from-phone = Para entrar na sessão de um amigo, abra o convite dele num celular pareado e escolha esta TV.

# Button that pairs a phone with the TV.
party-tv-pair = Parear um celular

# Button on a phone's sheet that joins on the paired TV. The device is its name, such as Living room TV.
party-join-on-device = Entrar em { $device }

# Button on a phone's sheet that joins on the phone itself.
party-join-on-this-phone = Entrar neste celular

# Line on a phone when its paired TV is in the party.
party-device-in-party = { $device } está nesta sessão

# Button on a phone that sends the invite to others.
party-share-invite = Compartilhar convite

# Button on the phone's remote screen that readies the TV.
party-ready-on-device = Pronto em { $device }

# Button on the phone's remote screen that leaves the party on the TV.
party-leave-on-device = Sair da sessão em grupo em { $device }

# Heading of the lobby's member list.
party-in-the-room = Na sala

# Beside that heading while looking into a room before joining it: how many are there.
party-here-count = { $count } aqui

# Beside the Recent rooms heading.
together-recent-note = As últimas dez, guardadas neste dispositivo

# The start sheet's button after a title is picked.
party-pick-continue = Continuar

# Placeholder of every chat field, and the label of the button that opens it.
party-chat-field = Diga algo

# Button that sends a chat line.
party-chat-send = Enviar

# Heading of the conversation in the lobby, on a phone's remote screen and the Android action that opens chat.
party-chat-title = Chat

# End of the chat field while sending waits, after three messages in five seconds.
party-chat-wait = Aguarde { $seconds } s

# Spoken once when sending waits, for screen readers.
party-chat-wait-spoken =
    { $seconds ->
        [one] Aguarde { $seconds } segundo
        [many] Aguarde { $seconds } de segundos
       *[other] Aguarde { $seconds } segundos
    }

# Line after the three newest chat lines on the video, which opens the conversation.
party-chat-more = Mais { $count } no chat

# Notice when the room's server has chat turned off, and the line that replaces the field.
party-chat-off = O servidor desta sala está com o chat desativado

# Line under the chat field in the lobby, shown once.
party-chat-privacy = As mensagens passam pelo servidor da sala. O Kaeri não guarda nenhuma.

# Heading in the conversation when Hide chat is on.
party-chat-hidden = O chat está oculto

# Line under it.
party-chat-hidden-line = Ocultar chat está ativado em Configurações, em Reprodução.

# Button that turns Hide chat off.
party-chat-show = Mostrar chat

# Settings switch that hides chat in every watch party on this device.
settings-hide-chat = Ocultar chat nas sessões em grupo

# Line under that switch.
settings-hide-chat-line = As mensagens, as reações e suas marcas na barra de progresso ficam fora do vídeo, e o campo de chat some. A lista de pessoas continua mostrando quem está na sala.

# Member menu item and accessibility action that hides a member's lines and reactions for this party.
party-mute = Silenciar { $name }

# Member menu item and accessibility action that shows a muted member's lines again.
party-unmute = Reativar { $name }

# Button in the conversation on the line that says a member is muted.
party-unmute-short = Reativar

# State on a muted member's row.
party-member-muted = Silenciado

# Line in the conversation where a muted member's lines were.
party-muted-line = { $name } está silenciado

# Line in the conversation when a message never came back from the server, five seconds after it was sent.
party-chat-not-sent = Não enviada

# Button after it, which sends the same text again.
party-chat-retry = Tentar de novo

# Button on the TV's controls that opens the four reactions.
party-react = Reagir

# Label of the laugh reaction button.
party-react-laugh = Risada

# Label of the gasp reaction button.
party-react-gasp = Susto

# Label of the clap reaction button.
party-react-clap = Palmas

# Label of the cry reaction button.
party-react-cry = Choro

# Line in the conversation and in the terminal: a member laughed.
party-reacted-laugh = Risada de { $name }

# Line in the conversation and in the terminal: a member gasped.
party-reacted-gasp = Susto de { $name }

# Line in the conversation and in the terminal: a member clapped.
party-reacted-clap = Palmas de { $name }

# Line in the conversation and in the terminal: a member cried.
party-reacted-cry = Choro de { $name }

# A reaction line with the moment in the episode it was made at, such as "Ren and Mika laughed at 12:04". The line is one of the party-reacted messages, the time is minutes and seconds.
party-reacted-at = { $line } aos { $time }

# Two members named together, for a reaction made by both: "Ren and Mika".
party-names-two = { $first } e { $second }

# Three members named together.
party-names-three = { $first }, { $second } e { $third }

# More than three members named together: two names and how many others.
party-names-others = { $first }, { $second } e mais { $count }

# Name of this device's own member in the conversation and on its reactions.
party-chat-you = Você

# Line on a phone's remote screen under the chat field: which device the line is said as.
party-sends-as = Envia como { $device }

# Label on the seek bar when pointing near a reaction tick: the moment and who reacted.
party-tick-label = { $time } · { $names }

# Spoken by a screen reader when a chat line arrives.
party-chat-announce = { $name } diz { $message }

# Spoken by a screen reader once, when 20 characters are left in the chat field.
party-chat-left =
    { $count ->
        [one] Resta { $count } caractere
        [many] Restam { $count } de caracteres
       *[other] Restam { $count } caracteres
    }

# Label on the card for the episode that plays after this one.
player-up-next = Próximo

# Label before the name of the work a show is based on.
title-based-on = Baseado em

# Line on the starting screen, from the moment the player is asked to play until the first frame.
player-starting = Iniciando episódio { $episode }

# Line on the starting screen after a few seconds: the app is looking for a stream.
player-finding-source = Procurando uma fonte · { $seconds } s

# Same line before the wait is counted.
player-finding-source-plain = Procurando uma fonte

# Title of the card shown when an episode could not play.
player-failed-title = Não foi possível reproduzir o episódio { $episode }

# Line under the failure title when every { -source } was tried.
player-failed-detail = Nenhuma fonte tinha um stream que reproduzisse. Tente outra.

# Line when nothing is installed to play from.
player-failed-no-sources = Nenhuma fontes ainda. Adicione uma loja de plugins para reproduzir.

# Button that opens the { -source } picker.
player-choose-source = Escolher fonte

# Button on the failure card of the TV: offers a different { -source }.
player-choose-another-source = Escolher outra fonte

# Button that adds a { -plugin-store } when there are no { -source-pl }.
player-add-plugin-store = Adicionar loja de plugins

# Short word while the video buffers.
player-buffering = Carregando

# Detail line while a source is asked and more than one is in the viewer's order.
player-start-place = { $place } de { $total } fontes

# Detail line while the source asked is the one the show is pinned to.
player-start-pinned = Sua escolha para esta série

# Detail line when a source has no match for the show.
player-start-miss-no-match = { $name } não tem esta série

# Detail line when a source has the show and not the episode. The episode is its label.
player-start-miss-no-episode = { $name } não tem o episódio { $episode }

# Detail line when the show is pinned to a source that does not have the episode yet, and the next source plays it.
player-start-pin-missed = { $name } ainda não tem o episódio { $episode }. Reproduzindo da próxima fonte.

# Detail line when a source failed and the next is asked.
player-start-miss-failed = { $name } não respondeu

# Detail line when a source took too long and the next is asked.
player-start-miss-timed-out = { $name } demorou demais

# Detail line after the viewer skipped the source being asked.
player-start-miss-skipped = Você pulou { $name }

# Details row for sources passed over because they failed lately. The name goes before it.
player-start-resting = Ignoradas após falhas recentes

# Detail line once the streams are found and the player opens one. The name is the source's.
player-start-from = De { $name }

# Detail line when a stream showed no video and another opens.
player-start-no-video = O primeiro não mostrou vídeo

# Detail line with the place of the stream being opened.
player-start-stream-place = Stream { $next } de { $total }

# Detail line while a torrent has peers.
player-start-peers =
    { $count ->
        [one] { $count } peer
        [many] { $count } de peers
       *[other] { $count } peers
    }

# Detail line with the speed data arrives at, already sized with one decimal, such as "3.4 MB".
player-start-speed = { $speed }/s

# Step line while the player fills its buffer and gives a number.
player-start-buffering-percent = Carregando buffer · { $percent }

# Step line while the episode resumes where it was left.
player-start-resuming = Retomando em { $clock }

# Button on the starting screen that plays the episode from its beginning.
player-start-from-beginning = Assistir do início

# Button on the starting screen that opens the list of steps.
player-start-details = Detalhes

# Button that skips the source being asked. The name is the source's.
player-start-skip-source = Pular { $name }

# Button that opens the next stream of the same source.
player-start-skip-stream = Pular este stream

# Step line when a start is slow: still waiting for the source. The name is the source's.
player-start-still-waiting = Ainda aguardando { $name }

# Step line while the device is offline and the episode will start when it is back.
player-start-offline = Aguardando conexão

# Detail line while offline. The episode is its label.
player-start-offline-detail = Você está offline. O episódio { $episode } começa quando você voltar.

# Button on the failure screen that opens the fix for a title that matched the wrong show.
player-start-fix-match = Corrigir correspondência

# Details row label for the translation of the episode.
player-start-translation = Áudio e legendas

# Details row once the title has been looked up.
player-start-looked-up = Título encontrado

# Seconds on the starting screen's detail line and Details rows.
player-start-seconds = { $seconds } s

# Spoken once, when a start has taken more than a few seconds.
player-start-still-starting = Ainda iniciando. Você pode escolher fonte.

# Spoken when a start begins. The episode is its label.
player-start-announce = Iniciando o episódio { $episode }, { $title }

# Spoken when a start fails: the title, then the reason.
player-start-failed-announce = { $title }. { $reason }

# Accessibility value of the starting screen: the step line, then the detail line.
player-start-status = { $step }, { $detail }

# Detail line on the starting screen after the viewer chose to play from the beginning.
player-start-beginning = Começando do início

# Details row while a source is being asked.
player-start-row-asking = Consultando

# Details row outcome when a source has no match for the show.
player-start-row-no-match = Não tem esta série

# Details row outcome when a source has the show and not the episode. The episode is its label.
player-start-row-no-episode = Não tem o episódio { $episode }

# Details row outcome when a source failed.
player-start-row-failed = Não respondeu

# Details row outcome when a source took too long.
player-start-row-timed-out = Demorou demais

# Details row outcome when the viewer skipped a source.
player-start-row-skipped = Pulada

# Second clause of a failure: the sources that were asked, joined as a list by the app.
player-start-asked = { $names } foram consultadas.

# Label of the switch in the Details list that plays the episode with its subtitles.
player-start-subtitled = Com legendas

# Title of the stall card. The seconds count up.
player-stall-title = A Fonte está carregando · { $seconds } s

# Line under the stall title.
player-stall-detail = Outro stream pode reproduzir sem esperar.

# Button on the stall card that moves to another { -source }.
player-switch-source = Trocar fonte

# Button on the stall card that keeps waiting.
player-keep-waiting = Continuar esperando

# Line on the Up next card: the episode starts when the count ends.
player-plays-in = Reproduz em { $seconds } s

# Button that skips the opening.
player-skip-opening = Pular abertura

# Button that skips the ending.
player-skip-ending = Pular encerramento

# Note after the opening was skipped by itself.
player-skipped-opening = Abertura pulada

# Note after the ending was skipped by itself.
player-skipped-ending = Encerramento pulado

# Button that skips the recap at the start of an episode.
player-skip-recap = Pular resumo

# Note after the recap was skipped by itself.
player-skipped-recap = Resumo pulado

# Player menu item that starts marking an opening, ending or recap.
player-mark-skip-times = Marcar tempos de pulo

# Player menu item that opens the list of this episode's skip times.
player-skip-times = Tempos de pulo

# Segmented control in the marking bar. Each is a kind of segment.
player-mark-kind-opening = Abertura

player-mark-kind-ending = Encerramento

player-mark-kind-recap = Resumo

# The same kinds in lower case, inside a sentence such as "Play to where the opening starts".
player-mark-kind-opening-inline = abertura

player-mark-kind-ending-inline = encerramento

player-mark-kind-recap-inline = resumo

# The same kinds in lower case and plural, inside "AniSkip takes openings up to 3 min".
player-mark-kind-opening-plural = aberturas

player-mark-kind-ending-plural = encerramentos

player-mark-kind-recap-plural = resumos

# Marking bar, first step. $kind is in lower case: opening, ending or recap.
player-mark-step-start = { $kind }: reproduza até o início e marque.

# Marking bar, second step.
player-mark-step-end = { $kind }: reproduza até o fim e marque.

# Buttons of the marking bar.
player-mark-start = Marcar início

player-mark-end = Marcar fim

# Label before the start time and the end time in the bar and the review.
player-mark-starts = Início

player-mark-ends = Fim

# Title of the review. $kind is capitalised: Opening, Ending or Recap. $length is a length such as "1 min 30 s".
player-mark-review-title = { $kind } · { $length }

# Buttons that move an edge by one second. Spoken labels are below.
player-mark-back-1 = −1 s

player-mark-forward-1 = +1 s

# The edges, inside the spoken labels below.
player-mark-edge-start = início

player-mark-edge-end = fim

# Spoken labels of the same buttons. $edge is "start" or "end".
player-mark-back-1-label = Mover o { $edge } um segundo para trás

# $edge is "start" or "end".
player-mark-forward-1-label = Mover o { $edge } um segundo para a frente

# Button that plays a few seconds around each edge.
player-mark-watch-edges = Ver as pontas

# Line in the review with sharing on.
player-mark-shares = Ao salvar, estes tempos são compartilhados com o AniSkip.

# Review line when the stretch under review was found from the audio, not marked by hand.
player-mark-found = O Kaeri encontrou estes tempos a partir do áudio.

# Line in the review when the mark replaces AniSkip's times.
player-mark-replaces = Substitui o trecho do AniSkip, de { $start } a { $end }, que será informado como errado.

# Line in the review when the show has no MyAnimeList entry.
player-mark-no-mal = O AniSkip não tem registro deste título, então isto fica nos seus dispositivos.

# Line when the marked stretch is too short. Save is off.
player-mark-too-short = Isso tem menos de 5 segundos. Marque onde termina.

# Line when the stretch is longer than AniSkip takes. $kind is in lower case and plural: openings, endings or recaps. $most is a length such as "3 min".
player-mark-too-long = Salvo só neste dispositivo. O AniSkip aceita { $kind } de até { $most } num episódio deste tamanho.

# Button that keeps the mark.
player-mark-save = Salvar

# Notice after saving. $kind is in lower case: opening, ending or recap.
player-mark-saved = Salvo ({ $kind }). Esse trecho será pulado daqui em diante.

# Notice after saving a mark that matched AniSkip.
player-mark-confirmed = Salvo. Você confirmou os tempos do AniSkip.

# Menu item dimmed in a watch party or while casting, with this reason under it.
player-mark-unavailable = Marque os tempos de pulo depois da sessão em grupo.

player-mark-unavailable-cast = Marque os tempos de pulo no dispositivo que está reproduzindo.

# Note after Undo on AniSkip times. $kind is in lower case: opening, ending or recap.
player-skip-wrong = Tempos de { $kind } errados?

