---
/**
 * The thin pixel strip above the footer, with a small Nagare on the rooftop. With a script she blinks
 * now and then while the strip is on screen, and runs along it and back once when she is tapped or
 * pressed. Her pixels and run cycle are the hero runner's (src/game/sprites.ts), drawn at the strip's
 * own scale: no game, no score, no obstacles. Without a script, or under Reduce Motion, she stands still.
 *
 * The city is at dusk in the dark theme and by day in the light one (scripts/strip-day.ts makes the
 * day strips from the dusk ones). Without a script the page is always in the light theme, so the
 * baked day strip is in a noscript. With one, the script gives the bare strips their sources and the
 * theme shows one of them; they are lazy, so the browser fetches only the one on show.
 */
import { useSite } from '../i18n/site';

const { t } = useSite(Astro);
---

<div class="strip" data-strip>
	<noscript><img class="strip-baked" src="/scene-strip-day.png" width="480" height="44" alt={t('home.strip.alt')} loading="lazy" decoding="async" /></noscript>
	<img class="strip-dusk" data-src="/scene-strip-bare.png" width="480" height="44" alt={t('home.strip.alt')} loading="lazy" decoding="async" />
	<img class="strip-day" data-src="/scene-strip-day-bare.png" width="480" height="44" alt={t('home.strip.alt')} loading="lazy" decoding="async" />
	<canvas class="strip-canvas" width="480" height="44" aria-hidden="true"></canvas>
	<button type="button" class="strip-nagare" aria-label={t('home.strip.run')} hidden></button>
</div>

<style is:global>
	.strip {
		position: relative;
		width: 100%;
		aspect-ratio: 480 / 44;
		background: var(--ani-ground);
		overflow: hidden;
	}

	.strip img,
	.strip canvas {
		position: absolute;
		inset: 0;
		display: none;
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
	}

	/* One image shows: without a script the baked strip, with Nagare in it, and with one the bare
	   strip of the theme, dusk or day, with her on the canvas. */
	:root:not(.js) .strip-baked,
	:root.js[data-theme='dark'] .strip-dusk[src],
	:root.js:not([data-theme='dark']) .strip-day[src],
	:root.js .strip canvas {
		display: block;
	}

	.strip-nagare {
		position: absolute;
		top: 0;
		height: 100%;
		width: calc(100% * 22 / 480);
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.strip-nagare:focus-visible {
		outline: 2px solid var(--ani-focus);
		outline-offset: -2px;
	}
</style>

<script>
	import { NAGARE } from '../game/sprites';

	const strip = document.querySelector<HTMLElement>('[data-strip]');
	for (const img of strip?.querySelectorAll<HTMLImageElement>('img[data-src]') ?? []) img.src = img.dataset.src!;
	const canvas = strip?.querySelector<HTMLCanvasElement>('canvas');
	const button = strip?.querySelector<HTMLButtonElement>('button');
	const ctx = canvas?.getContext('2d');

	if (strip && canvas && button && ctx) {
		const still = window.matchMedia('(prefers-reduced-motion: reduce)');
		/** Where she stands, in strip pixels. */
		const HOME = { x: 327, y: 9 };
		const W = 480;
		const art = NAGARE.stand;
		const blinkArt = { ...art, px: art.px.slice() };
		// Eyes shut: the eye's pixel takes the skin's shade. The sprite is turned to face right, so the column is mirrored.
		blinkArt.px[9 * art.w + (art.w - 1 - 5)] = [208, 168, 131];

		type Frame = { w: number; h: number; px: ([number, number, number] | null)[] };
		const draw = (frame: Frame, x: number, y: number, faceLeft: boolean) => {
			// The art faces right; flipping it faces her left, as she stands on the rooftop.
			for (let j = 0; j < frame.h; j++) {
				for (let i = 0; i < frame.w; i++) {
					const c = frame.px[j * frame.w + (faceLeft ? frame.w - 1 - i : i)];
					if (!c) continue;
					ctx.fillStyle = `rgb(${c[0]} ${c[1]} ${c[2]})`;
					ctx.fillRect(Math.round(x) + i, y + j, 1, 1);
				}
			}
		};

		let x = HOME.x;
		let running = false;
		let raf = 0;
		let blinkTimer = 0;
		let onScreen = false;

		const place = () => {
			button.style.left = `${((x - 1) / W) * 100}%`;
		};
		const stand = (frame: Frame = art) => {
			ctx.clearRect(0, 0, W, 44);
			draw(frame, x, HOME.y, true);
			place();
		};

		const blink = () => {
			blinkTimer = 0;
			if (running || !onScreen || still.matches || document.hidden) return;
			stand(blinkArt);
			window.setTimeout(() => !running && stand(), 150);
			schedule();
		};
		const schedule = () => {
			window.clearTimeout(blinkTimer);
			if (!onScreen || still.matches || document.hidden || running) return;
			blinkTimer = window.setTimeout(blink, 4000 + Math.random() * 2000);
		};

		const SPEED = 110; // strip pixels a second
		const FRAME_MS = 110;
		const SPAN = HOME.x - 24;
		const run = () => {
			if (running || still.matches) return;
			running = true;
			window.clearTimeout(blinkTimer);
			let start = 0;
			let last = 0;
			const total = (2 * SPAN) / SPEED;
			const step = (now: number) => {
				if (document.hidden) {
					// Held while the tab is hidden: the clock starts again from where she is.
					start = 0;
					raf = requestAnimationFrame(step);
					return;
				}
				if (!start) start = now - last;
				const elapsed = (now - start) / 1000;
				last = now - start;
				if (elapsed >= total) {
					x = HOME.x;
					running = false;
					stand();
					schedule();
					return;
				}
				const out = elapsed < total / 2;
				const travelled = out ? elapsed * SPEED : (total - elapsed) * SPEED;
				x = HOME.x - travelled;
				ctx.clearRect(0, 0, W, 44);
				draw(NAGARE.run[Math.floor((elapsed * 1000) / FRAME_MS) % NAGARE.run.length], x, HOME.y, out);
				place();
				raf = requestAnimationFrame(step);
			};
			raf = requestAnimationFrame(step);
		};

		const settle = () => {
			button.hidden = still.matches;
			if (still.matches) {
				cancelAnimationFrame(raf);
				running = false;
				x = HOME.x;
			}
			stand();
			schedule();
		};

		button.addEventListener('click', run);
		new IntersectionObserver((entries) => {
			onScreen = entries.some((e) => e.isIntersecting);
			if (onScreen) schedule();
			else window.clearTimeout(blinkTimer);
		}).observe(strip);
		document.addEventListener('visibilitychange', schedule);
		still.addEventListener('change', settle);
		settle();
	}
</script>
