---
// The <head> the landing, apps and features pages share: their title and description, the
// social preview, the icons, the theme colours, and the theme the docs remember, set before the
// first paint.
import { MULTILINGUAL, useSite } from '../../i18n/site';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const { t, alternates } = useSite(Astro);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:image" content={new URL('/og.png', Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t('site.ogAlt')} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
<meta name="twitter:image:alt" content={t('site.ogAlt')} />
{
	MULTILINGUAL && (
		<>
			{alternates.map((l) => (
				<link rel="alternate" hreflang={l.lang} href={new URL(l.href, Astro.site)} />
			))}
			<link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, Astro.site)} />
		</>
	)
}
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#f0ede4" />
<script is:inline>
	// Light, unless the visitor picked dark. The docs' ThemeProvider override does the same.
	document.documentElement.classList.add('js');
	try {
		document.documentElement.dataset.theme = localStorage.getItem('starlight-theme') === 'dark' ? 'dark' : 'light';
	} catch (e) {
		document.documentElement.dataset.theme = 'light';
	}
</script>
