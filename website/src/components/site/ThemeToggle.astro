---
// The theme switch: a real button, the pixel sun or moon for the theme it switches to. The site is
// light until the visitor picks dark, whatever the system's theme. Dark is kept under Starlight's
// own key, so the docs and the other pages read one setting; picking light again clears it.
import { useSite } from '../../i18n/site';

const { t } = useSite(Astro);
---

<button
	type="button"
	class="bar-icon theme-toggle"
	data-theme-toggle
	data-to-light={t('site.theme.toLight')}
	data-to-dark={t('site.theme.toDark')}
	aria-label={t('site.theme.toDark')}
	title={t('site.theme.toDark')}
>
	<svg class="glyph glyph-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 9 9" shape-rendering="crispEdges"
		><path fill="currentColor" d="M2 0h4v1h-4zM1 1h2v1h-2zM0 2h2v1h-2zM0 3h2v1h-2zM0 4h2v1h-2zM0 5h2v1h-2zM0 6h2v1h-2zM8 6h1v1h-1zM1 7h2v1h-2zM6 7h2v1h-2zM2 8h4v1h-4z"></path></svg
	>
	<svg class="glyph glyph-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 9 9" shape-rendering="crispEdges"
		><path fill="currentColor" d="M4 0h1v1h-1zM1 1h1v1h-1zM7 1h1v1h-1zM3 2h3v1h-3zM2 3h5v1h-5zM0 4h1v1h-1zM2 4h5v1h-5zM8 4h1v1h-1zM2 5h5v1h-5zM3 6h3v1h-3zM1 7h1v1h-1zM7 7h1v1h-1zM4 8h1v1h-1z"></path></svg
	>
</button>

<script>
	const KEY = 'starlight-theme';
	const root = document.documentElement;
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');

	const current = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');
	const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
	const paint = () => themeColor?.setAttribute('content', current() === 'dark' ? '#10131f' : '#f0ede4');
	paint();

	function label(button: HTMLElement) {
		const text = current() === 'dark' ? button.dataset.toLight! : button.dataset.toDark!;
		button.setAttribute('aria-label', text);
		button.title = text;
	}

	function set(theme: string) {
		root.dataset.theme = theme;
		paint();
		try {
			if (theme === 'dark') localStorage.setItem(KEY, theme);
			else localStorage.removeItem(KEY);
		} catch {
			// No storage here: the choice lasts for this page.
		}
	}

	const buttons = [...document.querySelectorAll<HTMLElement>('[data-theme-toggle]')];
	for (const button of buttons) {
		label(button);
		button.addEventListener('click', () => {
			const next = current() === 'dark' ? 'light' : 'dark';
			const apply = () => {
				set(next);
				for (const b of buttons) {
					label(b);
					b.classList.remove('swap');
					void b.offsetWidth;
					if (!still.matches) b.classList.add('swap');
				}
			};
			const start = (document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<unknown> } }).startViewTransition;
			if (start && !still.matches) {
				root.classList.add('theme-switching');
				const transition = start.call(document, apply);
				transition.finished.finally(() => root.classList.remove('theme-switching'));
			} else {
				apply();
			}
		});
	}
</script>
