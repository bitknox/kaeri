---
/**
 * A short left-to-right diagram of plain boxes: each box has a title and a line, and the words
 * between them say what passes along. Stacked on a phone. Described once for a screen reader.
 */
interface Props {
	label: string;
	steps: { title: string; text: string }[];
	between: string[];
	/** Boxes that stand side by side in the last place, as the plugin store's devices do. */
	last?: { title: string; text: string }[];
	/** Boxes stacked in the first place, as the places books come from, and the words after them. */
	first?: { title: string; text: string }[];
	firstBetween?: string;
}

const { label, steps, between, last, first, firstBetween } = Astro.props;
const arrow = '<svg width="40" height="8" viewBox="0 0 40 8" shape-rendering="crispEdges"><path d="M0 3h36v2H0zM34 1h2v6h-2zM36 2h2v4h-2zM38 3h2v2h-2z" fill="currentColor"></path></svg>';
---

<div class="flow" role="img" aria-label={label}>
	{
		first && (
			<>
				<div class="flow-stack">
					{first.map((box) => (
						<div class="flow-box">
							<div class="flow-title">{box.title}</div>
							<div class="flow-text">{box.text}</div>
						</div>
					))}
				</div>
				<div class="flow-link" aria-hidden="true">
					<span>{firstBetween}</span>
					<Fragment set:html={arrow} />
				</div>
			</>
		)
	}
	{
		steps.map((step, i) => (
			<>
				<div class="flow-box">
					<div class="flow-title">{step.title}</div>
					<div class="flow-text">{step.text}</div>
				</div>
				{(between[i] !== undefined) && (
					<div class="flow-link" aria-hidden="true">
						<span>{between[i]}</span>
						<svg width="40" height="8" viewBox="0 0 40 8" shape-rendering="crispEdges"><path d="M0 3h36v2H0zM34 1h2v6h-2zM36 2h2v4h-2zM38 3h2v2h-2z" fill="currentColor"></path></svg>
					</div>
				)}
			</>
		))
	}
	{
		last && (
			<div class="flow-stack">
				{last.map((box) => (
					<div class="flow-box">
						<div class="flow-title">{box.title}</div>
						<div class="flow-text">{box.text}</div>
					</div>
				))}
			</div>
		)
	}
</div>

<style is:global>
	.flow {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.flow-box {
		flex: 1;
		min-width: 0;
		padding: 20px 22px;
		border: 1px solid var(--ani-rule);
		border-radius: 10px;
		background: var(--ani-raised);
	}

	.flow-title {
		font-size: 17px;
		font-weight: 600;
	}

	.flow-text {
		margin-top: 2px;
		font-size: 14px;
		color: var(--ani-dim);
	}

	.flow-link {
		flex: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		color: var(--ani-dim);
	}

	.flow-stack {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	@media (max-width: 700px) {
		.flow {
			flex-direction: column;
			align-items: stretch;
		}

		.flow-link {
			flex-direction: row;
			justify-content: center;
		}

		.flow-link svg {
			transform: rotate(90deg);
		}
	}
</style>
