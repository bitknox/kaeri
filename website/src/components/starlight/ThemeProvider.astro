---
// The docs' theme before the first paint, as on the other pages (SiteHead): the system's, unless
// the visitor picked one with the theme switch. The docs have no theme select of Starlight's, so its
// pickers have nothing to update.
---

<script is:inline>
	try {
		var picked = localStorage.getItem('starlight-theme');
	} catch (e) {}
	document.documentElement.dataset.theme =
		picked === 'dark' || picked === 'light' ? picked : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	window.StarlightThemeProvider = { updatePickers() {} };
</script>
