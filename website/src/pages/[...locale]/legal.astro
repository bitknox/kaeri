---
import '../../styles/prose.css';
import { getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { localePaths, useSite } from '../../i18n/site';

export const getStaticPaths = localePaths;

const { t } = useSite(Astro);
const entry = (await getEntry('legal', 'legal'))!;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---

<Page title={entry.data.title} description={entry.data.description}>
	<div class="prose-wrap">
		<article class="prose">
			<h1>{entry.data.title}</h1>
			<Content />
		</article>
		<aside class="prose-aside">
			<nav aria-label={t('legal.toc')}>
				<h2>{t('legal.toc')}</h2>
				<ul>
					{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
				</ul>
			</nav>
			<div class="prose-contact">
				<p>{t('legal.reports')}</p>
				<p><a href="mailto:legal@kaeri.app">legal@kaeri.app</a></p>
			</div>
		</aside>
	</div>
</Page>
