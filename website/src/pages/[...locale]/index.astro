---
import '../../styles/pages.css';
import DownloadGrid from '../../components/DownloadGrid.astro';
import Faq from '../../components/Faq.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import NagareStrip from '../../components/NagareStrip.astro';
import Pic from '../../components/Pic.astro';
import TermShot from '../../components/TermShot.astro';
import Page from '../../layouts/Page.astro';
import { CC, DEMO_PART_1, DOWNLOAD, FEATURES, GITHUB, RELEASES } from '../../data/site';
import { VERSION } from '../../data/version';
import { localePaths, useSite } from '../../i18n/site';

// One source, served once per language: English at the root, the others under their prefix.
export const getStaticPaths = localePaths;

const { t, href, words } = useSite(Astro);

const bands = ['f1', 'f2', 'f3', 'f4'] as const;
---

<Page title={t('home.title')} description={t('home.description')} credit={1}>
	<script type="application/json" data-words="dl.hero." set:html={words('dl.hero.')}></script>

	<section class="hero" aria-labelledby="hero-h">
		<div class="hero-copy">
			<h1 id="hero-h">{t('home.hero.title')}</h1>
			<div class="hero-side">
				<p class="k-lede">{t('home.hero.sub')}</p>
				<div class="hero-actions">
					<a class="k-btn k-btn-primary k-btn-lg" href="#download" data-hero-download>{t('dl.hero.any.label')}</a>
					<a class="k-arrow" href="#download">
						{t('home.hero.platforms')}
						<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</a>
				</div>
				<p class="hero-note" data-hero-note>{t('dl.hero.any.note', { version: VERSION })}</p>
			</div>
		</div>

		<figure class="devices">
			<div class="devices-stage">
				<div class="dev-mac">
					<HeroVideo eager morph="shot-hero" alt={t('home.hero.macAlt')} />
				</div>
				<div class="dev-ipad bezel">
					<Pic name="ipad-title" sizes="(min-width: 1280px) 420px, 34vw" alt={t('home.hero.ipadAlt')} />
				</div>
				<div class="dev-phone bezel">
					<Pic name="iphone-title" sizes="(min-width: 1280px) 190px, 154px" alt={t('home.hero.phoneAlt')} />
				</div>
			</div>
			<figcaption><span class="cap-wide">{t('home.hero.caption')}</span><span class="cap-narrow">{t('home.hero.captionNarrow')}</span></figcaption>
		</figure>
	</section>

	<section class="band band-rise" aria-labelledby="read-h">
		<div class="band-in">
			<div class="band-head">
				<h2 id="read-h">{t('home.read.title')}</h2>
				<p><span class="lead">{t('home.read.lead')}</span> {t('home.read.text')}</p>
			</div>
			<figure class="rise-fig">
				<figcaption>{t('home.read.caption')}</figcaption>
				<div class="rise rise-ipad">
					<div class="rise-device">
						<Pic name="ipad-reading" sizes="(min-width: 1100px) 1000px, 92vw" alt={t('home.read.alt')} />
					</div>
				</div>
			</figure>
		</div>
	</section>

	<section class="band theatre" aria-labelledby="f3-h">
		<div class="band-in">
			<div class="band-head">
				<h2 id="f3-h">{t('home.f3.title')}</h2>
				<p><span class="lead">{t('home.f3.lead')}</span> {t('home.f3.text')}</p>
			</div>
			<figure class="player-fig">
				<div class="player-bezel" style="view-transition-name: shot-player">
					<Pic name="iphone-player" sizes="(min-width: 1100px) 1020px, 90vw" alt={t('home.f3.alt')} />
				</div>
				<figcaption set:html={t('home.f3.caption', { source: DEMO_PART_1, licence: CC })} />
			</figure>
		</div>
	</section>

	<section class="band" aria-labelledby="together-h">
		<div class="band-in">
			<div class="band-head">
				<h2 id="together-h">{t('home.together.title')}</h2>
				<p><span class="lead">{t('home.together.lead')}</span> {t('home.together.text')}</p>
			</div>
			<figure>
				<div class="together">
					<div class="player-bezel together-party">
						<Pic name="android-party-chat" sizes="(min-width: 1100px) 900px, 92vw" alt={t('features.together.alt')} />
					</div>
					<div class="bezel together-remote">
						<Pic name="iphone-tv-remote" sizes="(min-width: 1100px) 240px, 40vw" alt={t('features.tv.remoteAlt')} />
					</div>
				</div>
				<figcaption set:html={t('home.together.caption', { source: DEMO_PART_1, licence: CC })} />
			</figure>
		</div>
	</section>

	<section class="band" aria-labelledby="fx-h">
		<div class="band-in">
			<div class="band-head">
				<h2 id="fx-h">{t('home.fx.title')}</h2>
				<p><span class="lead">{t('home.fx.lead')}</span> {t('home.fx.text')}</p>
			</div>
			<div class="fx-grid">
				<figure>
					<div class="fx-crop"><Pic name="tv-continue" sizes="(min-width: 1200px) 420px, 60vw" style="left: -14%; top: 0; height: 100%; width: auto; max-width: none" alt={t('home.fx.tvAlt')} /></div>
					<figcaption>{t('home.fx.tv')}</figcaption>
				</figure>
				<figure>
					<div class="fx-crop"><Pic name="android-continue" sizes="(min-width: 1200px) 288px, 45vw" style="left: 0; top: -10%; width: 100%" alt={t('home.fx.androidAlt')} /></div>
					<figcaption>{t('home.fx.android')}</figcaption>
				</figure>
				<figure>
					<div class="fx-crop"><Pic name="windows-stores" sizes="(min-width: 1200px) 420px, 60vw" style="left: -39%; top: 0; height: 100%; width: auto; max-width: none" alt={t('home.fx.windowsAlt')} /></div>
					<figcaption>{t('home.fx.windows')}</figcaption>
				</figure>
				<figure>
					<div class="fx-crop"><Pic name="linux-continue" sizes="(min-width: 1200px) 420px, 60vw" style="left: -25%; top: 0; height: 100%; width: auto; max-width: none" alt={t('home.fx.linuxAlt')} /></div>
					<figcaption>{t('home.fx.linux')}</figcaption>
				</figure>
			</div>
			<figure class="fx-term">
				<TermShot name="home" alt={t('home.fx.terminalAlt')} />
				<figcaption>{t('home.fx.terminal')}</figcaption>
			</figure>
			<p class="more"><a class="k-arrow" href={href(FEATURES)}>
				{t('home.more')}
				<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</a></p>
		</div>
	</section>

	<section class="band" aria-labelledby="f1-h">
		<div class="band-in">
			<div class="band-head">
				<h2 id="f1-h">{t('home.f1.title')}</h2>
				<p><span class="lead">{t('home.f1.lead')}</span> {t('home.f1.text')}</p>
			</div>
			<figure>
				<div class="crop crop-a crop-continue" style="view-transition-name: shot-continue">
					<Pic name="mac-continue" sizes="(min-width: 701px) min(1452px, 121vw), 227vw" alt={t('home.f1.alt')} />
				</div>
				<figcaption>{t('home.f1.caption')}</figcaption>
			</figure>
		</div>
	</section>

	<section class="dl-sect" id="download" aria-labelledby="dl-h">
		<div class="dl-in">
			<h2 id="dl-h" class="dl-title">{t('dl.title')}</h2>
			<p class="dl-version">{t('dl.version')} <span data-version>{VERSION}</span>. <a href={`${RELEASES}`}>{t('dl.notes')}</a></p>
			<DownloadGrid steps={href(DOWNLOAD)} />
			<nav class="dl-more" aria-label={t('dl.moreLabel')}>
				<a href={href(DOWNLOAD)}>{t('dl.more.steps')}</a>
				<a href={`${href(DOWNLOAD)}#check`}>{t('dl.more.check')}</a>
				<a href={`${href(DOWNLOAD)}#older`}>{t('dl.more.older')}</a>
			</nav>
		</div>
	</section>

	<Faq />

	<section class="oss" aria-labelledby="oss-h">
		<div class="oss-in">
			<div>
				<h2 id="oss-h">{t('home.oss.title')}</h2>
				<p>{t('home.oss.text')}</p>
			</div>
			<ul class="oss-links">
				<li><a href={GITHUB}>{t('home.oss.source')}<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li>
				<li><a href={href('/docs/plugins/authoring/')}>{t('home.oss.plugin')}<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li>
				<li><a href={`${GITHUB}/blob/main/docs/translations.md`}>{t('home.oss.translate')}<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li>
				<li><a href={`${GITHUB}/issues`}>{t('home.oss.issue')}<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li>
			</ul>
		</div>
	</section>

	<NagareStrip slot="before-footer" />
</Page>
