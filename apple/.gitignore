# What apple/scripts/engine.sh builds: the engine's XCFramework and Swift bindings per flavour.
/.engine/
# What it links into the KaeriKit package from there.
/Packages/KaeriKit/Engine/
/Packages/KaeriKit/Sources/KaeriKit/Generated/
# SwiftPM's own, in each package.
/Packages/*/.build/
/Packages/*/.swiftpm/
/Packages/*/Package.resolved
# XcodeGen's output: project.yml is the source.
/Kaeri.xcodeproj/
# The signing team, which is each developer's own: see Config/Local.xcconfig.example.
/Config/Local.xcconfig
# The dev harness's and shots.sh's screenshots, and shots.sh's builds.
/.shots/
/.derived/
# What apple/scripts/mpv.sh builds and caches: libmpv's XCFramework, downloads, tools, builds.
/.mpv/
# Its link into the KaeriPlayer package.
/Packages/KaeriPlayer/Mpv/
# What apple/scripts/fonts.sh fetches: the CJK subtitle font the iOS app bundles.
/.fonts/
