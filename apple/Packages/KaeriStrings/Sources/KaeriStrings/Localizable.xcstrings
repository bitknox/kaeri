    "profiles-delete-alert-line" : {
      "comment" : "Alert message. Argument 1: name (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf und Anmeldungen von %1$@ werden auf diesem Gerät entfernt. Geräte, die mit %1$@ abgleichen, behalten ihre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@’s history and sign-ins on this device are removed. Devices that sync with %1$@ keep theirs."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitan el historial y los inicios de sesión de %1$@ en este dispositivo. Los dispositivos que se sincronizan con %1$@ conservan los suyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique et les connexions de %1$@ sur cet appareil sont supprimés. Les appareils qui se synchronisent avec %1$@ gardent les leurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat dan data masuk profil %1$@ di perangkat ini dihapus. Perangkat yang tersinkron dengan %1$@ tetap menyimpan miliknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia e gli accessi di %1$@ su questo dispositivo vengono rimossi. I dispositivi che si sincronizzano con %1$@ tengono i propri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスにある%1$@の履歴とサインインは削除されます。%1$@と同期しているデバイスには、そのまま残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia i logowania profilu %1$@ na tym urządzeniu zostaną usunięte. Urządzenia synchronizowane z profilem %1$@ zachowują swoje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico e os logins de %1$@ neste dispositivo são removidos. Os dispositivos que sincronizam com %1$@ mantêm os deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История и входы профиля %1$@ на этом устройстве будут удалены. Устройства, синхронизируемые с профилем %1$@, сохранят свои."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historiken och inloggningarna för %1$@ tas bort från den här enheten. Enheter som synkar med %1$@ behåller sina."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ profilinin bu cihaz cihazdaki geçmişi ve girişleri kaldırılır. %1$@ ile eşitlenen cihazlar kendi verilerini tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử và các lượt đăng nhập của %1$@ trên thiết bị này sẽ bị xóa. Các Các thiết bị đồng bộ với %1$@ vẫn giữ bản của chúng."
          }
        }
      }
    },
