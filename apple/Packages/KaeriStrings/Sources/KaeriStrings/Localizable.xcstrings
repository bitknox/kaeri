    "tv-scan-hint" : {
      "comment" : "Line telling how to scan the TV's code.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera-App auf den Code am Fernseher. Sie öffnet Kaeri und koppelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point the camera app at the code on the TV. It opens Kaeri and pairs."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara al código del televisor. Se abre Kaeri y se vincula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez la caméra de l'appareil vers le code de la TV. Il ouvre Kaeri et associe les deux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan aplikasi kamera ke kode di TV. Aplikasi itu membuka Kaeri dan memasangkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta la fotocamera sul codice della TV. Si apre Kaeri e si collega."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラアプリでテレビのコードを読み取ってください。Kaeriが開き、ペアリングされます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skieruj aparat na kod w telewizorze. Otworzy się Kaeri i nastąpi parowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte a câmera para o código da TV. Ele abre o Kaeri e pareia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите камеру на код на телевизоре. Откроется Kaeri и выполнит подключение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rikta kameraappen mot koden på TV:n. Den öppnar Kaeri och parar ihop."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera uygulamasını TV'deki koda doğrultun. Kaeri açılır ve eşleşir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hướng ứng dụng camera vào mã trên TV. Ứng dụng sẽ mở Kaeri và ghép nối."
          }
        }
      }
    },
