    "opds-footer" : {
      "comment" : "Footnote under the feed settings. Argument 1: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Feed läuft nur, solange Kaeri auf diesem %1$@ geöffnet ist. Fortschritt auf diesen E-Readern bleibt dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feed runs only while Kaeri is open on this %1$@. Progress on those e-readers stays there."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El catálogo solo funciona mientras Kaeri está abierto en este %1$@. El progreso en esos lectores electrónicos se queda allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flux ne fonctionne que lorsque Kaeri est ouvert sur votre %1$@. La progression sur ces liseuses reste sur elles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feed hanya berjalan saat Kaeri terbuka di %1$@ ini. Kemajuan di e-reader tersebut tetap di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il feed funziona solo mentre Kaeri è aperto su questo %1$@. I progressi su quegli e-reader restano lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードは、この%1$@でKaeriを開いている間だけ動作します。それらの電子書籍リーダーでの進捗は、そちらに残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanał działa tylko wtedy, gdy Kaeri jest otwarty na tym urządzeniu (%1$@). Postęp na tych e-czytnikach zostaje na nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
