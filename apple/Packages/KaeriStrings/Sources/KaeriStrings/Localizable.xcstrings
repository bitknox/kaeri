    "tv-sync-start-foot" : {
      "comment" : "TV Devices footer while sync is off, after devices-sync-foot.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Koppeln mit deinem Smartphone schaltet die Synchronisierung ein. Danach kann dieser Fernseher deinem Cloud-Ordner beitreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing with your phone turns sync on. Then this TV can join your cloud folder."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincular con tu teléfono activa la sincronización. Entonces este televisor puede unirse a tu carpeta en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appairage avec votre téléphone active la synchronisation. Cette TV peut ensuite rejoindre votre dossier cloud."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memasangkan dengan ponsel Anda mengaktifkan sinkronisasi. Lalu TV ini bisa bergabung ke folder cloud Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associare il telefono attiva la sincronizzazione. Poi questa TV può unirsi alla tua cartella cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンとペアリングすると、同期がオンになります。そのあと、このテレビもクラウドフォルダに参加できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparowanie z telefonem włącza synchronizację. Wtedy ten telewizor może dołączyć do twojego folderu w chmurze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parear com seu celular ativa a sincronização. Aí esta TV pode entrar na sua pasta na nuvem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Связывание с телефоном включает синхронизацию. Тогда этот телевизор сможет присоединиться к вашей облачной папке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkoppling med din mobil slår på synk. Sedan kan den här TV:n gå med i din molnmapp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuzla eşleşmek eşitlemeyi açar. Sonra bu TV bulut klasörünüze katılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghép nối với điện thoại sẽ bật đồng bộ. Sau đó TV này có thể tham gia thư mục đám mây của bạn."
          }
        }
      }
    },
    "tv-talk-failed" : {
      "comment" : "Line when something failed while talking to the TV.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung zum Fernseher verloren. Prüfe, ob er eingeschaltet und im selben Netzwerk ist, und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost contact with the TV. Check that it's on and on the same network, then try again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perdió la conexión con el televisor. Revisa que esté encendido y en la misma red, y luego inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion perdue avec la TV. Vérifiez qu'elle est allumée et sur le même réseau, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi ke TV terputus. Pastikan TV menyala dan terhubung ke jaringan yang sama, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione con la TV persa. Controlla che sia accesa e sulla stessa rete, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビとの接続が途切れました。電源が入っていて同じネットワークに接続されていることを確認して、もう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono kontakt z telewizorem. Sprawdź, czy jest włączony i w tej samej sieci, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com a TV foi perdida. Verifique se ela está ligada e na mesma rede, e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Связь с телевизором потеряна. Проверьте, что он включён и подключён к той же сети, и попробуйте ещё раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tappade kontakten med TV:n. Kontrollera att den är på och på samma nätverk, och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ile bağlantı koptu. Açık olduğunu ve aynı ağda bulunduğunu denetleyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mất kết nối với TV. Kiểm tra TV đã bật và cùng mạng chưa, rồi thử lại."
          }
        }
      }
    },
