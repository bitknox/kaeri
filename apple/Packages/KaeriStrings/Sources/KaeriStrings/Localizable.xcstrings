          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin-plugin menambahkan sumber-sumber. Setiap plugin mencantumkan host yang dihubunginya sebelum Anda memasangnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Plugin aggiungono fonti. Ognuno elenca gli host che contatta prima che tu lo installi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインはソースを追加します。それぞれ、インストールする前に接続先のホストを一覧で示します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczki dodają źródła. Każda z nich pokazuje hosty, z którymi się łączy, zanim ją zainstalujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
