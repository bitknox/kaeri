    "send-no-place" : {
      "comment" : "Under the e-readers in the Send to e-reader sheet: what Kaeri cannot know after the files are sent.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri sieht nicht, wo du auf diesem E-Reader bist. Wenn du zurückkommst, fragt die Serienseite, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri can't see your place on this e-reader. When you come back, the series page asks where you stopped."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri no puede ver por dónde vas en este lector electrónico. Cuando vuelvas, la página de la serie te preguntará dónde te quedaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri ne voit pas votre position sur cette liseuse. À votre retour, la page de la série vous demande où vous vous êtes arrêté."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri tidak bisa melihat posisi Anda di e-reader ini. Saat Anda kembali, halaman seri menanyakan di mana Anda berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri non vede a che punto sei su questo e-reader. Quando torni, la pagina della serie ti chiede dove ti sei fermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriからは、この電子書籍リーダーで読んだ位置がわかりません。戻ってきたときに、作品ページでどこまで読んだかを尋ねます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri nie widzi, w którym miejscu jesteś na tym e-czytniku. Gdy wrócisz, strona serii zapyta, gdzie przerwano czytanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri não consegue ver onde você está neste e-reader. Quando você voltar, a página da série pergunta onde você parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri не видит, докуда вы дочитали на этом ридере. Когда вы вернётесь, страница серии спросит об этом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kan inte se var du är på den här e-läsaren. När du kommer tillbaka frågar seriesidan var du slutade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri bu e-okuyucudaki yerinizi göremez. Döndüğünüzde seri sayfası nerede kaldığınızı sorar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri không biết bạn đọc tới đâu trên máy đọc sách này. Khi bạn quay lại, trang truyện sẽ hỏi bạn đã dừng ở đâu."
          }
        }
      }
    },
