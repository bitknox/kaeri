          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te vinculas con él, este dispositivo recibe tus fuentes, servicios de seguimiento y tu historial, y el resto de la configuración queda hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
