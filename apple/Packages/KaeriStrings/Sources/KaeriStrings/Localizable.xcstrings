    "first-other-line" : {
      "comment" : "Under the title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel es, dann bekommt dieses Gerät deine Quellen, Tracker und den Verlauf, und der Rest der Einrichtung ist für dich erledigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
