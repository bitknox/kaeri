    "updates-beta-detail" : {
      "comment" : "Line under the switch.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede neue Version bekommen, sobald sie gebaut ist. Ohne das kommen Updates einmal pro Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get each new version as soon as it's built. Without this, updates come once a week."
          }
