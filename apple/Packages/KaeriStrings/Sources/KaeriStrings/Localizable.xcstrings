    "report-detail" : {
      "comment" : "Line under the title of the Report a bug sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das öffnet ein neues Issue auf GitHub, wo du dich anmeldest, schilderst, was passiert ist, und es abschickst. Issues auf GitHub sind öffentlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This opens a new issue on GitHub, where you sign in, say what happened and submit. Issues on GitHub are public."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto abre un nuevo issue en GitHub, donde inicias sesión, cuentas qué pasó y lo envías. Los issues de GitHub son públicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ouvre un nouveau ticket sur GitHub, où vous vous connectez, décrivez ce qui s’est passé et l’envoyez. Les tickets GitHub sont publics."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini membuka isu baru di GitHub, tempat Anda masuk, menjelaskan apa yang terjadi, lalu mengirim. Isu di GitHub bersifat publik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si apre una nuova segnalazione su GitHub, dove accedi, racconti cosa è successo e la invii. Le segnalazioni su GitHub sono pubbliche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubで新しいissueが開きます。サインインして状況を書き、送信してください。GitHubのissueは公開されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otworzy to nowe zgłoszenie na GitHubie, gdzie zalogujesz się, opiszesz, co się stało, i je wyślesz. Zgłoszenia na GitHubie są publiczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso abre uma nova issue no GitHub, onde você entra, conta o que aconteceu e envia. As issues no GitHub são públicas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откроется новая задача на GitHub: там вы войдёте, опишете, что произошло, и отправите её. Задачи на GitHub публичны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här öppnar ett nytt ärende på GitHub, där du loggar in, beskriver vad som hände och skickar in. Ärenden på GitHub är offentliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, GitHub'da yeni bir sorun kaydı açar. Orada giriş yapar, ne olduğunu yazar ve gönderirsiniz. GitHub'daki kayıtlar herkese açıktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này mở một issue mới trên GitHub, nơi bạn đăng nhập, mô tả sự việc và gửi. Issue trên GitHub là công khai."
          }
        }
      }
