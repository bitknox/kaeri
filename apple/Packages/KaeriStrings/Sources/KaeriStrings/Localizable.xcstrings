    "profiles-kids-hidden" : {
      "comment" : "Settings foot in a kids profile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen und Geräte sind in einem Kinderprofil ausgeblendet, und Titel für Erwachsene bleiben aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources and Devices are hidden in a kids profile, and adult titles stay off."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Fuentes y los Dispositivos se ocultan en un perfil infantil, y los títulos para adultos quedan fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources et les appareils sont masqués dans un profil enfant, et les titres pour adultes restent masqués."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber-sumber dan Perangkat disembunyikan di profil anak, dan judul dewasa tidak ditampilkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonti e Dispositivi sono nascosti in un profilo per bambini e i titoli per adulti restano nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子ども用プロファイルでは、ソースとデバイスは非表示で、アダルト向けの作品も表示されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródła i Urządzenia są ukryte w profilu dziecięcym, a tytuły dla dorosłych są wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Fontes e os Dispositivos ficam ocultos em um perfil infantil, e os títulos adultos ficam de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В детском профиле скрыты источники и устройства, а тайтлы для взрослых отключены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Källor och Enheter är dolda i en barnprofil, och vuxentitlar hålls borta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çocuk profilinde Kaynaklar ve Cihazlar gizlidir, yetişkin başlıkları kapalı kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nguồn và Các thiết bị bị ẩn trong hồ sơ trẻ em, và tựa dành cho người lớn cũng bị ẩn."
          }
        }
      }
    },
    "profiles-kids-line" : {
      "comment" : "Switch footer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel für Erwachsene bleiben aus, und Quellen, Geräte und Torrent-Einstellungen sind darin ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
