          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ berukuran %3$@, dan %2$@ hanya menerima file hingga %4$@. Kirim lebih sedikit bab sekaligus, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pesa %3$@ e %2$@ accetta file fino a %4$@. Invia meno capitoli alla volta e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%3$@ですが、%2$@で扱えるファイルは%4$@までです。一度に送る章を減らして、もう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ma %3$@, a %2$@ przyjmuje pliki do %4$@. Wyślij mniej rozdziałów naraz i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tem %3$@, e %2$@ aceita arquivos de até %4$@. Envie menos capítulos por vez e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ весит %3$@, а %2$@ принимает файлы до %4$@. Отправляйте меньше глав за раз и попробуйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ är %3$@, och %2$@ tar emot filer upp till %4$@. Skicka färre kapitel åt gången och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %3$@ boyutunda, %2$@ ise en fazla %4$@ boyutunda dosya alıyor. Tek seferde daha az bölüm gönderip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ có dung lượng %3$@, còn %2$@ chỉ nhận tệp tối đa %4$@. Hãy gửi ít chương hơn mỗi lần rồi thử lại."
          }
        }
      }
    },
