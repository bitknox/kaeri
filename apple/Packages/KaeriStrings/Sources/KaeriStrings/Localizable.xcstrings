            "value" : "Ve a %1$@ e ingresa este código. Kaeri inicia sesión cuando lo hayas hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendez-vous sur %1$@ et saisissez ce code. Kaeri se connecte une fois que c'est fait."
          }
        },
        "id" : {
          "stringUnit" : {
