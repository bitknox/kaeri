        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wejdź na %1$@ i wpisz ten kod. Kaeri zaloguje się po wpisaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
