    "licensed-body" : {
      "comment" : "Line under the title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kann Titel in Streaming-Diensten öffnen, für die du bezahlst. Es spielt sie nie selbst ab. Die Links kommen von AniList."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri can open titles in streaming services you pay for. It never plays them itself. Links come from AniList."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri puede abrir títulos en los servicios de streaming que pagas. Nunca los reproduce por sí misma. Los enlaces vienen de AniList."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri peut ouvrir des titres dans les services de streaming que vous payez. Il ne les lit jamais lui-même. Les liens viennent d’AniList."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri bisa membuka judul di layanan streaming yang Anda bayar. Aplikasi ini tidak pernah memutarnya sendiri. Tautan berasal dari AniList."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri può aprire i titoli nei servizi di streaming a cui sei abbonato. Non li riproduce mai da sé. I link provengono da AniList."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriでは、あなたが契約している配信サービスで作品を開けます。再生はKaeri自体では行いません。リンクはAniListから取得します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri może otwierać tytuły w serwisach streamingowych, za które płacisz. Sam ich nigdy nie odtwarza. Linki pochodzą z AniList."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri pode abrir títulos em serviços de streaming que você assina. Ele nunca os reproduz por conta própria. Os links vêm do AniList."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri может открывать тайтлы в стриминговых сервисах, за которые вы платите. Сам он их никогда не воспроизводит. Ссылки берутся из AniList."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kan öppna titlar i streamingtjänster du betalar för. Den spelar dem aldrig själv. Länkarna kommer från AniList."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri, ücretini ödediğiniz yayın hizmetlerindeki başlıkları açabilir. Kendisi hiçbirini oynatmaz. Bağlantılar AniList'ten gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri có thể mở tựa phim trong các dịch vụ phát trực tuyến bạn trả phí. Ứng dụng không bao giờ tự phát chúng. Liên kết lấy từ AniList."
          }
        }
      }
    },
