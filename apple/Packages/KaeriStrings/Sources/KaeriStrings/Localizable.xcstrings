    "settings-share-skips-detail" : {
      "comment" : "Line under it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip ist eine gemeinsame Liste von Vor- und Abspännen, die viele Player nutzen. Es erhält die Zeiten, die du markierst, und die gefundenen, die du bestätigst, die MyAnimeList-Nummer der Serie, die Folge und eine zufällige ID für diese Installation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip is a shared list of openings and endings that many players use. It gets the times you mark and the found times you confirm, the show's MyAnimeList number, the episode and a random id for this install."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip es una lista compartida de aperturas y finales que usan muchos reproductores. Recibe los tiempos que marcas y los tiempos encontrados que confirmas, el número de MyAnimeList de la serie, el episodio y un id aleatorio de esta instalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip est une liste partagée d’intros et de génériques que de nombreux lecteurs utilisent. Il reçoit les repères que vous marquez et ceux trouvés que vous confirmez, le numéro MyAnimeList de la série, l’épisode et un identifiant aléatoire pour cette installation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip adalah daftar pembukaan dan penutup bersama yang dipakai banyak pemutar. Ia menerima waktu yang Anda tandai dan waktu temuan yang Anda konfirmasi, nomor MyAnimeList serial itu, episode, dan id acak untuk instalasi ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip è un elenco condiviso di aperture e chiusure usato da molti player. Riceve i tempi che segni e quelli trovati che confermi, il numero MyAnimeList della serie, l'episodio e un id casuale per questa installazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkipは、多くのプレーヤーが使っている、オープニングとエンディングの共有リストです。あなたがマークした位置と、確認した検出済みの位置、作品のMyAnimeList番号、エピソード、このインストール用のランダムなIDが送信されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip to wspólna lista czołówek i zakończeń, z której korzysta wiele odtwarzaczy. Dostaje czasy, które zaznaczysz, oraz znalezione czasy, które potwierdzisz, numer serialu z MyAnimeList, odcinek i losowy identyfikator tej instalacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AniSkip é uma lista compartilhada de aberturas e encerramentos que muitos players usam. Ele recebe os tempos que você marca e os tempos encontrados que você confirma, o número do título no MyAnimeList, o episódio e um id aleatório desta instalação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip: общий список опенингов и эндингов, которым пользуются многие плееры. Он получает отмеченные вами моменты и подтверждённые найденные, номер сериала в MyAnimeList, эпизод и случайный идентификатор этой установки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip är en delad lista över intron och outron som många spelare använder. Den får tiderna du markerar och de hittade tider du bekräftar, seriens MyAnimeList-nummer, avsnittet och ett slumpmässigt id för den här installationen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip, birçok oynatıcının kullandığı ortak bir açılış ve kapanış listesidir. İşaretlediğiniz zamanları, onayladığınız bulunmuş zamanları, dizinin MyAnimeList numarasını, bölümü ve bu kurulum için rastgele bir kimliği alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip là danh sách chung về đoạn mở đầu và đoạn kết mà nhiều trình phát dùng. Nó nhận các mốc bạn đánh dấu và các mốc tìm thấy mà bạn xác nhận, số MyAnimeList của phim, tập phim và một mã ngẫu nhiên cho bản cài đặt này."
          }
        }
      }
    },
