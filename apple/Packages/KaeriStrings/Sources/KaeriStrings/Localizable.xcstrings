    "stores-server-older" : {
      "comment" : "Line when the store's server cannot offer the choice.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server für diesen Plugin-Store ist älter. Er lässt nur Personen herein, die du einlädst. Ein Update schaltet die Auswahl frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plugin store's server is older, and lets in only people you invite. Updating it adds the choice."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de esta tienda de complementos es más antiguo y solo deja entrar a personas que invites. Al actualizarlo se agrega esta opción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur de cette boutique de plugins est plus ancien. Il ne laisse entrer que les personnes que vous invitez. Le mettre à jour ajoute ce choix."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server toko plugin ini lebih lama dan hanya mengizinkan orang yang Anda undang. Memperbaruinya akan menambahkan pilihan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server di questo negozio di plugin è più vecchio e fa entrare solo le persone invitate. Aggiornandolo si ottiene la scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプラグインストアのサーバーは古く、招待した人のみ参加を許可しています。更新すると、選択肢が追加されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer jest starszy i wpuszcza tylko zaproszone osoby. Aktualizacja serwera doda tę opcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor desta loja de plugins é mais antigo e aceita apenas pessoas convidadas por você. Atualizá-lo adiciona a opção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер этого магазина старше и пускает только приглашённых. Обновление добавит этот выбор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här tilläggsbutikens server är äldre och släpper bara in personer du bjuder in. Att uppdatera servern lägger till valet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eklenti mağazasının sunucusu eski sürümde; yalnızca davet ettiğiniz kişileri kabul ediyor. Güncellenirse bu seçenek eklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ của cửa hàng plugin này cũ hơn, và chỉ cho phép những người bạn mời vào. Cập nhật máy chủ sẽ thêm lựa chọn này."
          }
        }
      }
    },
