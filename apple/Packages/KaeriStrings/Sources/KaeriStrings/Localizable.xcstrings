    "servers-error-plain-http" : {
      "comment" : "Error under the address field.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse liegt nicht in deinem Netzwerk und verwendet kein HTTPS, dein Passwort würde also ungeschützt übertragen. Verwende eine https://-Adresse."
          }
        },
        "en" : {
