        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasangkan, lalu perangkat ini mendapatkan sumber-sumber, pelacak-pelacak, dan riwayat Anda, dan sisa penyiapan pun selesai untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
