    "tv-cloud-needs-phone-has" : {
      "comment" : "TV, Dropbox, a paired phone has it. Argument 1: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist bei Dropbox angemeldet. Dieser Fernseher kann diese Anmeldung über deine Kopplung nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is signed in to Dropbox. This TV can use that sign-in over your paired link."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene la sesión de Dropbox iniciada. Este televisor puede usar ese inicio de sesión por el vínculo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est connecté à Dropbox. Cette TV peut utiliser cette connexion via votre lien appairé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sudah masuk ke Dropbox. TV ini dapat memakai proses masuk itu lewat tautan pemasangan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha effettuato l'accesso a Dropbox. Questa TV può usare quell'accesso tramite il collegamento associato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はDropboxにサインイン済みです。このテレビは、ペアリング済みの接続を通じて、そのサインインを使えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ jest zalogowany w Dropboksie. Ten telewizor może użyć tego logowania przez sparowane połączenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está conectado ao Dropbox. Esta TV pode usar esse login pelo link pareado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ вошёл в Dropbox. Этот телевизор может использовать этот вход по связанному соединению."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ är inloggad på Dropbox. Den här TV:n kan använda den inloggningen över din parkoppling."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Dropbox'ta oturum açmış durumda. Bu TV, eşleşmiş bağlantınız üzerinden bu girişi kullanabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã đăng nhập Dropbox. TV này có thể dùng lượt đăng nhập đó qua liên kết đã ghép nối."
          }
        }
      }
    },
    "tv-cloud-needs-phone-none" : {
      "comment" : "TV, Dropbox, no phone has it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Dropbox kann ein Fernseher sich nicht selbst anmelden. Öffne Kaeri auf deinem Smartphone, dann Einstellungen, Geräte, Cloud-Ordner, und melde dich dort bei Dropbox an. Wähle danach hier noch einmal Dropbox."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropbox has no sign-in a TV can do. On your phone, open Kaeri, then Settings, Devices, Cloud folder, and sign in to Dropbox there. Then choose Dropbox here again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropbox no tiene un inicio de sesión que un televisor pueda hacer. En tu teléfono, abre Kaeri, luego Ajustes, Dispositivos, Carpeta en la nube, e inicia sesión en Dropbox ahí. Después elige Dropbox aquí de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropbox n’a pas de connexion qu’une TV peut faire. Sur votre téléphone, ouvrez Kaeri, puis Réglages, Appareils, Dossier cloud, et connectez-vous à Dropbox là-bas. Choisissez ensuite Dropbox ici à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropbox tidak punya proses masuk yang bisa dilakukan di TV. Di ponsel Anda, buka Kaeri, lalu Pengaturan, Perangkat, Folder cloud, dan masuk ke Dropbox di sana. Lalu pilih Dropbox lagi di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropbox non ha un accesso che una TV possa fare. Sul telefono apri Kaeri, poi Impostazioni, Dispositivi, Cartella cloud, e accedi lì a Dropbox. Poi scegli di nuovo Dropbox qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビでできるDropboxのサインインはありません。スマートフォンでKaeriを開き、設定、デバイス、クラウドフォルダの順に進んで、そこでDropboxにサインインしてください。そのあと、ここでもう一度Dropboxを選んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telewizor nie może zalogować się do Dropboksa. Na telefonie otwórz Kaeri, potem Ustawienia, Urządzenia, Folder w chmurze i zaloguj się tam do Dropboksa. Potem wybierz tutaj Dropboksa ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dropbox não tem um login que uma TV consiga fazer. No seu celular, abra o Kaeri, depois Configurações, Dispositivos, Pasta na nuvem, e faça login no Dropbox lá. Depois escolha o Dropbox aqui de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизор не может войти в Dropbox. На телефоне откройте Kaeri, затем «Настройки», «Устройства», «Облачная папка» и войдите там в Dropbox. Потом снова выберите здесь Dropbox."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropbox har ingen inloggning som en TV kan göra. Öppna Kaeri på din mobil, sedan Inställningar, Enheter, Molnmapp, och logga in på Dropbox där. Välj sedan Dropbox här igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropbox için bir TV'de yapılabilecek bir giriş yok. Telefonunuzda Kaeri uygulamasını açın, Ayarlar, Cihazlar, Bulut klasörü yolunu izleyin ve orada Dropbox'a giriş yapın. Sonra burada yeniden Dropbox'ı seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV không tự đăng nhập Dropbox được. Trên điện thoại, hãy mở Kaeri, rồi vào Cài đặt, Các thiết bị, Thư mục đám mây và đăng nhập Dropbox ở đó. Sau đó chọn lại Dropbox tại đây."
          }
        }
      }
    },
