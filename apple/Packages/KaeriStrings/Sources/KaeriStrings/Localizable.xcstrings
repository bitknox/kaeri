        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu navegador abriu a página do %1$@. Permita o acesso lá e o Kaeri continua sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
