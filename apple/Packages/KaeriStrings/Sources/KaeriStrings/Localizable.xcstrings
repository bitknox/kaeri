    "book-sources-unmatched-note" : {
      "comment" : "Footnote of the Check matches sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serien ohne Zuordnung kannst du trotzdem aus dem Ordner lesen. Sie bekommen keinen Tracker-Fortschritt, bis sie zugeordnet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can still read unmatched series from the folder. They get no tracker progress until they're matched."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las series sin coincidencia se pueden leer igual desde la carpeta. No tienen progreso en un servicio de seguimiento hasta que tengan coincidencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez toujours lire les séries sans correspondance depuis le dossier. Elles n'ont pas de progression sur un service de suivi tant qu'elles ne sont pas associées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tetap bisa membaca seri yang belum cocok dari folder. Seri itu belum mendapat kemajuan di pelacak sampai dicocokkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi comunque leggere dalla cartella le serie senza corrispondenza. Non ricevono progressi sul tracker finché non trovano una corrispondenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未一致の作品もフォルダから読めます。一致するまで、連携サービスの進捗は記録されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serie bez dopasowania nadal możesz czytać z folderu. Trackery nie zobaczą ich postępu, dopóki ich nie dopasujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda pode ler pela pasta as séries sem correspondência. Elas não recebem progresso no serviço de acompanhamento até terem correspondência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серии без совпадения можно читать из папки. Трекер не получает по ним прогресс, пока совпадение не найдено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fortfarande läsa omatchade serier från mappen. De får inget förlopp hos någon tracker förrän de matchats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleşmeyen serileri yine klasörden okuyabilirsiniz. Eşleşene kadar ilerlemeleri takip hizmetine gitmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn vẫn đọc được các bộ truyện chưa khớp từ thư mục. Chúng chưa có tiến độ dịch vụ theo dõi cho đến khi được khớp."
          }
        }
      }
    },
