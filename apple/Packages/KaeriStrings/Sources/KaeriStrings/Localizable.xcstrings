        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu cihaz üzerine kaydedildi. AniSkip bu uzunluktaki bir bölümde en fazla %2$@ süren %1$@ kabul eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
