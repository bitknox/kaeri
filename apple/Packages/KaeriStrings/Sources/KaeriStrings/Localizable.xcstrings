    "plugin-duplicate-file" : {
      "comment" : "Error: a plugin file added by hand already declares the same name. Argument 1: path (Text). Argument 2: plugin (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ erklärt bereits %2$@. Entferne zuerst diese Datei, sonst laufen zwei Kopien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ already declares %2$@. Remove that file first, or two copies would run."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya declara %2$@. Quita ese archivo primero, o correrían dos copias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ déclare déjà %2$@. Supprimez d’abord ce fichier, sinon deux copies s’exécuteraient."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sudah mendeklarasikan %2$@. Hapus file itu dulu, atau dua salinan akan berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dichiara già %2$@. Rimuovi prima quel file, altrimenti girerebbero due copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@にはすでに%2$@が宣言されています。先にそのファイルを削除してください。そのままだと、2つのコピーが動いてしまいます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ już deklaruje %2$@. Najpierw usuń ten plik, bo uruchomią się dwie kopie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ já declara %2$@. Remova esse arquivo primeiro, senão duas cópias vão rodar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл %1$@ уже объявляет %2$@. Сначала удалите его, иначе запустятся две копии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
