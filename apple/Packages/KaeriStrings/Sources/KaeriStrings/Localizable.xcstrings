    "torrents-proxy-route-detail" : {
      "comment" : "Line under the switch.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Torrent-Verkehr läuft über einen SOCKS5-Proxy, den du selbst betreibst oder mietest. Solange das aus ist, verbinden sich Torrents direkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrent traffic goes through a SOCKS5 proxy you run or rent. While this is off, torrents connect directly."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tráfico de torrents pasa por un proxy SOCKS5 que tú administras o alquilas. Mientras esto esté desactivado, los torrents se conectan directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trafic des torrents passe par un proxy SOCKS5 que vous gérez ou louez. Tant que c’est désactivé, les torrents se connectent directement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalu lintas torrent melewati proxy SOCKS5 yang Anda jalankan atau sewa. Selama ini nonaktif, torrent terhubung langsung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il traffico dei torrent passa da un proxy SOCKS5 che gestisci o noleggi. Finché è disattivato, i torrent si connettono direttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントの通信が、自分で運用または契約しているSOCKS5プロキシを経由します。オフの間、トレントは直接接続します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruch torrentów idzie przez proxy SOCKS5, które prowadzisz lub wynajmujesz. Gdy jest wyłączone, torrenty łączą się bezpośrednio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tráfego dos torrents passa por um proxy SOCKS5 que você administra ou aluga. Enquanto isto estiver desativado, os torrents se conectam diretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трафик торрентов идёт через прокси SOCKS5, который вы запускаете или арендуете. Пока выключено, торренты подключаются напрямую."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
