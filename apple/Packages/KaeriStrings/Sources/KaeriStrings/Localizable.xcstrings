    "rkey-enter-line-generic" : {
      "comment" : "Restore sheet line when the folder's device count is not known. Argument 1: service (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ enthält den Verlauf deiner anderen Geräte. Der Schlüssel, den du beim Einschalten der Synchronisierung gesichert hast, öffnet ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ holds history from your other devices. The key you saved when sync was turned on opens it."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ guarda el historial de tus otros dispositivos. La clave que guardaste al activar la sincronización lo abre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ contient l’historique de vos autres appareils. La clé que vous avez enregistrée à l’activation de la synchronisation l’ouvre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ menyimpan riwayat dari perangkat Anda yang lain. Kunci yang Anda simpan saat sinkronisasi diaktifkan akan membukanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ contiene la cronologia dei tuoi altri dispositivi. La chiave che hai salvato quando hai attivato la sincronizzazione la apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@には、ほかのデバイスの履歴が保存されています。同期をオンにしたときに保存したキーで開けます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ przechowuje historię z twoich innych urządzeń. Otworzy ją klucz zapisany przy włączaniu synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ guarda o histórico dos seus outros dispositivos. A chave que você salvou ao ativar a sincronização o abre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ хранит историю с ваших других устройств. Её откроет ключ, который вы сохранили при включении синхронизации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ innehåller historik från dina andra enheter. Nyckeln du sparade när synkningen slogs på öppnar den."
