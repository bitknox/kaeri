    "settings-aside-reading" : {
      "comment" : "The Reading pane's column beside it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reader-Standards sind der Ausgangspunkt jeder Serie. Eine Serie, die du im Reader änderst, behält ihre eigenen Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reader defaults are where every series starts. A series you change in the reader keeps its own choices."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores del lector son el punto de partida de cada serie. Una serie que cambies en el lector conserva sus propias opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
