    "stores-offline-last-list" : {
      "comment" : "Line when the store cannot be reached but a list was kept. The reason is a sentence fragment. Argument 1: reason (Cause).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline: %1$@. Angezeigt wird die letzte Liste, die er geschickt hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline: %1$@. Showing the last list it sent."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión: %1$@. Se muestra la última lista que envió."
          }
        },
        "fr" : {
