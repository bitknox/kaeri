    "profiles-one-foot" : {
      "comment" : "Profiles page with one.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile trennen Verlauf, Weiterschauen und Konten für Leute, die sich dieses Gerät teilen. Mit einem Profil gibt es in Kaeri keine Auswahl und keine Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiles keep separate history, Continue and accounts for people who share this device. With one profile, Kaeri has no picker and no names."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles guardan historial, Continuar viendo y cuentas por separado para quienes comparten este dispositivo. Con un solo perfil, Kaeri no tiene selector ni nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils gardent un historique, Reprendre et des comptes séparés pour les personnes qui partagent cet appareil. Avec un seul profil, Kaeri n’affiche ni sélecteur ni noms."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil menyimpan riwayat, lanjutkan menonton, dan akun terpisah untuk orang-orang yang memakai perangkat ini bersama. Dengan satu profil, Kaeri tidak menampilkan pemilih maupun nama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili tengono separati cronologia, Continua a guardare e account per chi condivide questo dispositivo. Con un solo profilo, Kaeri non mostra selettore né nomi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルを使うと、このデバイスを共有する人ごとに、履歴、続きを見る、アカウントを分けられます。プロファイルが1つのときは、選択画面も名前も表示されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile mają osobną historię, sekcję Kontynuuj oglądanie i konta dla osób, które dzielą to urządzenie. Przy jednym profilu Kaeri nie pokazuje wyboru ani nazw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis guardam histórico, Continuar assistindo e contas separados para quem divide este dispositivo. Com um só perfil, o Kaeri não tem seletor nem nomes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили хранят отдельные история, раздел «Продолжить просмотр» и аккаунты для людей, которые делят это устройство. С одним профилем в Kaeri нет выбора и имён."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler håller historik, Fortsätt titta och konton åtskilda för personer som delar den här enheten. Med en profil har Kaeri ingen väljare och inga namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiller, bu cihaz cihazı paylaşan kişiler için ayrı geçmiş, izlemeye devam et ve hesaplar tutar. Tek profilde Kaeri seçici ve ad göstermez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ giúp tách riêng lịch sử, Xem tiếp và tài khoản cho những người dùng chung thiết bị này. Khi chỉ có một hồ sơ, Kaeri không hiện trình chọn hay tên nào."
          }
        }
      }
    },
