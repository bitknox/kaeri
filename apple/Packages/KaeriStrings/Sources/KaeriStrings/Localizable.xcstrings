    "torrents-check-note" : {
      "comment" : "Under the proxy form: what the app checks.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri prüft vor dem Start von Torrents, ob der Proxy erreichbar ist. Torrents warten, solange die Prüfung fehlschlägt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri checks that it can reach the proxy before torrents start. Torrents wait while that check fails."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri comprueba que puede llegar al proxy antes de que empiecen los torrents. Los torrents esperan mientras esa verificación falle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri vérifie qu’il peut joindre le proxy avant le démarrage des torrents. Les torrents attendent tant que cette vérification échoue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri memeriksa bahwa proxy dapat dijangkau sebelum torrent mulai. Torrent menunggu selama pemeriksaan itu gagal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri controlla di poter raggiungere il proxy prima che i torrent partano. I torrent restano in attesa finché il controllo fallisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriは、トレントの開始前に、プロキシに接続できるかを確認します。確認に失敗している間、トレントは待機します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri sprawdza, czy może połączyć się z proxy, zanim ruszą torrenty. Torrenty czekają, gdy sprawdzenie kończy się błędem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri verifica se consegue alcançar o proxy antes de os torrents começarem. Os torrents aguardam enquanto essa verificação falhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri проверяет, что может подключиться к прокси, прежде чем запустятся торренты. Пока проверка не проходит, торренты ждут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kontrollerar att proxyn går att nå innan torrenter startar. Torrenter väntar medan kontrollen misslyckas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri, torrent'ler başlamadan önce proxy'ye ulaşabildiğini denetler. Denetim başarısız olduğu sürece torrent'ler bekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kiểm tra xem có kết nối được với proxy không trước khi torrent bắt đầu. Torrent chờ trong lúc kiểm tra còn không đạt."
          }
        }
      }
    },
