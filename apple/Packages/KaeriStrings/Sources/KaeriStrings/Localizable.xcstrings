    "settings-aside-advanced" : {
      "comment" : "Side note in Advanced.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Option hier kann eine Einstellung bei der Wiedergabe aufheben, etwa Hochskalierung oder Nachtmodus. Die meisten brauchen diesen Bereich nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An option here can undo a Playback setting, such as upscaling or night mode. Most people never need this pane."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una opción de aquí puede anular un ajuste de Reproducción, como el escalado o el modo nocturno. Casi nadie necesita este panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une option ici peut annuler un réglage de Lecture, comme la mise à l’échelle ou le mode nuit. La plupart des gens n’ont jamais besoin de ce volet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsi di sini dapat membatalkan pengaturan Pemutaran, seperti peningkatan skala gambar atau mode malam. Kebanyakan orang tidak pernah memerlukan panel ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'opzione qui può annullare un'impostazione di riproduzione, come l'upscaling o la modalità notturna. La maggior parte delle persone non ne ha mai bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでの設定は、アップスケールやナイトモードなど再生の設定を上書きする場合があります。ほとんどの方はこのパネルを使う必要はありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja w tym miejscu może cofnąć ustawienie odtwarzania, na przykład skalowanie albo tryb nocny. Większość osób nigdy nie potrzebuje tego panelu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma opção aqui pode desfazer uma configuração de Reprodução, como o aumento de resolução ou o modo noturno. A maioria das pessoas nunca precisa deste painel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройка здесь может отменить параметр воспроизведения, например апскейлинг или ночной режим. Большинству эта панель не нужна."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett alternativ här kan ta över en inställning under Uppspelning, som uppskalning eller nattläge. De flesta behöver aldrig den här fliken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada bir seçenek, büyütme ya da gece modu gibi Oynatma ayarlarını geri alabilir. Çoğu kişinin bu bölüme hiç ihtiyacı olmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tùy chọn ở đây có thể ghi đè cài đặt trong mục Phát, như nâng tỉ lệ hình hoặc chế độ ban đêm. Hầu hết mọi người không cần đến mục này."
          }
        }
      }
    },
