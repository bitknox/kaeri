    "medium-join-line" : {
      "comment" : "Line of the sheet on joining. Argument 1: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wofür Kaeri auf diesem %1$@ gedacht ist. Jedes Gerät behält seine eigene Antwort."
