    "tv-problem-busy" : {
      "comment" : "The TV cannot take another connection now.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher ist mit so vielen Geräte verbunden, wie er kann. Versuch es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The TV is connected to as many devices as it can. Try again soon."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV está conectada a tantos dispositivos como puede. Inténtalo de nuevo pronto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV a atteint le nombre maximal d’appareils connectés. Réessayez bientôt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
