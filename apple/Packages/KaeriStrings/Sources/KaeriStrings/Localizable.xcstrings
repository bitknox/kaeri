    "sources-torrents-note" : {
      "comment" : "Note under the facts on the Torrents page in Sources. Torrents are built in, not a plugin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrents gehören zu Kaeri und sind kein Plugin. Proxy und Seeding stellst du in den Einstellungen unter Quellen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrents are part of Kaeri, not a plugin. The proxy and seeding are set in Settings, under Sources."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los torrents forman parte de Kaeri, no de un complemento. El proxy y compartir se configuran en Ajustes, en Fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les torrents font partie de Kaeri, pas d’un plugin. Le proxy et le partage se règlent dans Réglages, sous Sources."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrent adalah bagian dari Kaeri, bukan plugin. Proxy dan seeding diatur di Pengaturan, di bawah Sumber-sumber."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I torrent fanno parte di Kaeri, non sono un plugin. Il proxy e il seeding si impostano in Impostazioni, sotto Fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントはプラグインではなく、Kaeriに含まれています。プロキシとシーディングは、設定のソースで設定します。"
          }
        },
        "pl" : {
          "stringUnit" : {
