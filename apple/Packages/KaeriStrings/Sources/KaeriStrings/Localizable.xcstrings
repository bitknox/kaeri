    "stores-intro" : {
      "comment" : "Line under the title of the screen when plugins add sources.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins fügen Quellen hinzu. Jedes listet die Hosts auf, die es kontaktiert, bevor du es installierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins add sources. Each one lists the hosts it contacts before you install it."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los complementos añaden fuentes. Cada uno muestra los hosts a los que se conecta antes de que lo instales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
