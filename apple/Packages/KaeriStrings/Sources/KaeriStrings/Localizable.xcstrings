        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirmeler ve eşitleme de onunla birlikte durdu. Kaldığınız yerden sürdürmek için Kaeri uygulamasını yeniden başlatın."
          }
