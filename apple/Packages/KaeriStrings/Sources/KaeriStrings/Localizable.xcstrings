    "profiles-ask-foot" : {
      "comment" : "iPad footer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig aus. Schalte es für ein iPad ein, das sich der ganze Haushalt teilt. Über die Kontozeile kannst du jederzeit das Profil wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. Turn it on for an iPad the whole household shares. You can switch profiles from the account row at any time."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado de forma predeterminada. Actívalo en un iPad que comparte todo el hogar. Puedes cambiar de perfil desde la fila de la cuenta en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé par défaut. Activez-le sur un iPad que tout le foyer partage. Vous pouvez changer de profil depuis la ligne du compte à tout moment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktif secara bawaan. Aktifkan untuk iPad yang dipakai bersama seisi rumah. Anda bisa mengganti profil dari baris akun kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato per impostazione predefinita. Attivalo su un iPad che tutta la casa condivide. Puoi cambiare profilo dalla riga dell'account in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期設定ではオフです。家族全員で共有するiPadではオンにしてください。プロファイルは、アカウントの行からいつでも切り替えられます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie wyłączone. Włącz na iPadzie, którego używa cały dom. Profil możesz zmienić w każdej chwili w wierszu konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por padrão. Ative para um iPad que toda a casa compartilha. Você pode trocar de perfil pela linha da conta a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. Включите для iPad, которым пользуется вся семья. Сменить профиль можно в строке аккаунта в любой момент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av som standard. Slå på det för en iPad som hela hushållet delar. Du kan byta profil från kontoraden när som helst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak kapalıdır. Tüm evin paylaştığı bir iPad için açın. Profilleri istediğiniz zaman hesap satırından değiştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định tắt. Hãy bật cho iPad mà cả nhà dùng chung. Bạn có thể đổi hồ sơ từ hàng tài khoản bất cứ lúc nào."
          }
        }
      }
    },
