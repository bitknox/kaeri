    "stores-open-join-off-detail" : {
      "comment" : "Line under the switch of the who-can-join sheet while only invited people can join.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Personen, die du einlädst, können beitreten. Schaltest du das ein, kann jede Person mit dem Link beitreten, ohne Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only people you invite can join. Turn this on and anyone with the link can join, without a name."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo pueden unirse las personas que invitas. Si lo activas, cualquiera con el enlace puede unirse, sin nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les personnes que vous invitez peuvent rejoindre. Activez ce réglage et toute personne disposant du lien peut rejoindre, sans nom."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya orang yang Anda undang yang bisa bergabung. Nyalakan ini dan siapa pun yang punya tautan bisa bergabung, tanpa nama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possono unirsi solo le persone che inviti. Se lo attivi, chiunque abbia il link può unirsi, senza nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待した人だけが参加できます。オンにすると、リンクを持つ人なら誰でも名前なしで参加できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogą dołączać tylko osoby, które zaprosisz. Po włączeniu każdy z linkiem może dołączyć, bez nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só entram as pessoas que você convidar. Ligue isto e qualquer pessoa com o link pode entrar, sem nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключиться могут только те, кого вы пригласите. Если включить, подключиться сможет любой, у кого есть ссылка, без имени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara personer du bjuder in kan gå med. Slår du på det kan alla med länken gå med, utan namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca davet ettiğiniz kişiler katılabilir. Bunu açarsanız bağlantısı olan herkes ad vermeden katılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ những người bạn mời mới tham gia được. Bật mục này thì bất kỳ ai có liên kết đều tham gia được, không cần tên."
          }
        }
      }
    },
    "stores-open-join-on-detail" : {
      "comment" : "Line under the switch of the who-can-join sheet while anyone with the link can join.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen treten ohne Namen bei. Schaltest du das aus, funktioniert der Link nicht mehr. Schaltest du es wieder ein, gibt es einen neuen Link."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People join without a name. Turn this off and the link stops working. Turn it on again for a new link."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas se unen sin nombre. Si lo desactivas, el enlace deja de funcionar. Si lo vuelves a activar, hay un enlace nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes rejoignent sans nom. Désactivez ce réglage et le lien ne fonctionne plus. Réactivez-le pour obtenir un nouveau lien."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang bergabung tanpa nama. Matikan ini dan tautan berhenti berfungsi. Nyalakan lagi untuk mendapat tautan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone si uniscono senza nome. Se lo disattivi, il link smette di funzionare. Se lo riattivi, ne ottieni uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前なしで参加します。オフにするとリンクは使えなくなります。もう一度オンにすると新しいリンクになります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby dołączają bez nazwy. Po wyłączeniu link przestaje działać. Po ponownym włączeniu powstaje nowy link."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pessoas entram sem nome. Desligue isto e o link para de funcionar. Ligue de novo para ter um novo link."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди подключаются без имени. Если выключить, ссылка перестанет работать. Если включить снова, появится новая ссылка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folk går med utan namn. Stänger du av det slutar länken fungera. Slå på det igen för en ny länk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişiler ad vermeden katılır. Bunu kapatırsanız bağlantı çalışmayı bırakır. Yeni bir bağlantı için yeniden açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi người tham gia mà không cần tên. Tắt mục này thì liên kết ngừng hoạt động. Bật lại để có liên kết mới."
          }
        }
      }
