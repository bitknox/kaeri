    "search-rate-limit-return" : {
      "comment" : "Line while results wait for the rate limit to recover, on a Mac where Return runs the search.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche beim Tippen ist kurz pausiert, um AniLists Grenzen einzuhalten. Drücke Return, um jetzt zu suchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searching as you type is paused for a moment, to stay within AniList's limits. Press Return to search now."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda mientras escribes está en pausa un momento, para no superar los límites de AniList. Presiona Regreso para buscar ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
