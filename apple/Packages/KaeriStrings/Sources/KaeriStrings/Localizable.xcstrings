          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагины добавляют источники. Каждый показывает серверы, с которыми связывается, до установки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillägg lägger till källor. Varje visar vilka värdar den kontaktar innan du installerar den."
