    "devices-switches-foot" : {
      "comment" : "Device page footer when the device has a Remote switch. The kind is this device's word, such as computer or PC. Argument 1: kind (Text). Argument 2: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung teilt, wo du aufgehört hast, deinen Verlauf und deine Einstellungen. Mit der Fernsteuerung steuerst du %2$@ von diesem %1$@ aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync shares where you stopped, your history and your settings. Remote lets this %1$@ drive %2$@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización comparte dónde te quedaste, tu historial y tus ajustes. El control remoto permite que este dispositivo (%1$@) controle %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation partage où vous vous êtes arrêté, votre historique et vos réglages. Télécommande permet à cet %1$@ de piloter %2$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi membagikan posisi terakhir, riwayat, dan pengaturan Anda. Remote membuat %1$@ ini bisa mengendalikan %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione condivide dove ti sei fermato, la cronologia e le impostazioni. Telecomando permette a questo %1$@ di controllare %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期では、続きの位置、履歴、設定が共有されます。リモコンをオンにすると、この%1$@から%2$@を操作できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja przenosi miejsce, w którym skończono oglądać, historię i ustawienia. Pilot pozwala temu urządzeniu (%1$@) sterować: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização compartilha onde você parou, seu histórico e suas configurações. O controle remoto deixa este dispositivo (%1$@) controlar %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация переносит место, где вы остановились, историю и настройки. Пульт позволяет этому устройству (%1$@) управлять: %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synk delar var du slutade, din historik och dina inställningar. Med fjärrstyrning kan den här %1$@ styra %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşitleme, kaldığınız yeri, geçmişinizi ve ayarlarınızı paylaşır. Uzaktan kumanda, bu %1$@ cihazın %2$@ aygıtını yönetmesini sağlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ chia sẻ chỗ bạn đã xem dở, lịch sử và cài đặt của bạn. Điều khiển cho phép %1$@ này điều khiển %2$@."
          }
        }
      }
    },
