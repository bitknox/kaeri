    "party-room-hint" : {
      "comment" : "Line under the room: how others join.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Namen des Raums kennt, kann beitreten. Der Einladungslink enthält ihn, damit ihn niemand vorlesen muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who knows the room's name can join it. The invite link carries it, so nobody has to read it out."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que conozca el nombre de la sala puede unirse. El enlace de invitación lo incluye, así que nadie tiene que leerlo en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne qui connaît le nom du salon peut le rejoindre. Le lien d'invitation le contient, personne n'a donc besoin de le lire à voix haute."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang tahu nama ruang ini bisa bergabung. Tautan undangan sudah memuatnya, jadi tidak perlu dibacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque conosca il nome della stanza può entrare. Il link di invito lo contiene, quindi nessuno deve leggerlo ad alta voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルーム名を知っている人なら、誰でも参加できます。招待リンクにルーム名が含まれるので、読み上げて伝える必要はありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto zna nazwę pokoju, może do niego dołączyć. Link zaproszenia ją zawiera, więc nikt nie musi jej przepisywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem souber o nome da sala pode entrar. O link de convite já o contém, então ninguém precisa ler em voz alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присоединиться к комнате может любой, кто знает её название. Ссылка-приглашение его содержит, поэтому никому не нужно его диктовать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som känner till rummets namn kan gå med i det. Inbjudningslänken innehåller det, så ingen behöver läsa upp det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oda adını bilen herkes katılabilir. Davet bağlantısı oda adını taşır, kimsenin bunu okuyup bildirmesi gerekmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai biết tên phòng đều có thể tham gia. Liên kết mời mang theo tên phòng, nên không cần đọc to."
          }
        }
      }
    },
