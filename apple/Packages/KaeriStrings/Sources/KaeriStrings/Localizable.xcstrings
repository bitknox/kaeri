        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誤りと報告されているAniSkipの%1$@から%2$@を置き換えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
