    "cloud-browser-line" : {
      "comment" : "Windows and Linux dialog line while the browser is open for a cloud sign-in. Argument 1: service (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Browser hat die Seite von %1$@ geöffnet. Erlaube dort den Zugriff, den Rest erledigt Kaeri von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your browser opened %1$@'s page. Allow access there, and Kaeri carries on by itself."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu navegador abrió la página de %1$@. Permite el acceso allí y Kaeri continúa solo."
