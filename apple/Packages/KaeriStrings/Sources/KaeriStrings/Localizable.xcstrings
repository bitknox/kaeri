    "medium-off-read-body" : {
      "comment" : "What turning reading off does. Argument 1: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates und dein Lesen verschwinden aus Kaeri auf diesem %1$@. Deine Liste, dein Fortschritt und deine Downloads bleiben und kommen zurück, wenn du Lesen wieder einschaltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates and your reading leave Kaeri on this %1$@. Your list, progress and downloads stay, and come back if you turn reading on again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novedades y tu lectura salen de Kaeri en este %1$@. Tu lista, tu progreso y tus descargas se quedan, y vuelven si activas de nuevo la lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mises à jour et votre lecture quittent Kaeri sur %1$@. Votre liste, votre progression et vos téléchargements restent, et reviennent si vous réactivez la lecture."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan dan bacaan Anda hilang dari Kaeri di %1$@ ini. Daftar, kemajuan, dan unduhan Anda tetap ada, dan kembali jika Anda menyalakan fitur membaca lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornamenti e la tua lettura escono da Kaeri su questo %1$@. La tua lista, i progressi e i download restano, e tornano se riattivi la lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%1$@のKaeriから、更新と読書が表示されなくなります。リスト、進捗、ダウンロードは残り、読書をオンに戻すと復活します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacje i twoje czytanie znikają z aplikacji Kaeri na: %1$@. Lista, postęp i pobrane pliki zostają i wracają, jeśli ponownie włączysz czytanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidades e sua leitura saem do Kaeri neste %1$@. Sua lista, seu progresso e seus downloads ficam e voltam se você ligar a leitura de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Обновления» и ваше чтение исчезнут из Kaeri на %1$@. Список, прогресс и загрузки сохранятся и вернутся, если снова включить чтение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdateringar och din läsning lämnar Kaeri på den här %1$@. Din lista, ditt förlopp och dina nedladdningar finns kvar och kommer tillbaka om du slår på läsning igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellemeler ve okuduklarınız bu %1$@ üzerinde Kaeri içinden kalkar. Listeniz, ilerlemeniz ve indirmeleriniz kalır; okumayı yeniden açarsanız geri gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cập nhật và phần đọc của bạn sẽ biến mất khỏi Kaeri trên %1$@ này. Danh sách, tiến độ và các bản tải vẫn còn, và quay lại nếu bạn bật lại việc đọc."
          }
        }
      }
    },
