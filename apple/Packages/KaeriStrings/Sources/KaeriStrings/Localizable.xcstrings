    "party-nosource-unaired-plain" : {
      "comment" : "Line under a title that says the episode has not aired and no date is known.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Quellen werden sie bis dahin nicht haben. Die Folge läuft mit dem Raum, sobald eine davon sie hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sources won't have it before then. It plays with the room once one of them does."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fuentes no lo tendrán antes de entonces. Se reproduce con la sala cuando una de ellas lo tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos sources ne l'auront pas avant. Il sera partagé avec le salon dès que l'une d'elles l'aura."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber-sumber Anda belum akan memilikinya sebelum waktu itu. Episode ini akan diputar bersama ruang setelah salah satunya tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue fonti non l'avranno prima di allora. Viene riprodotto nella stanza quando una di esse lo avrà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放送されるまで、お使いのソースにはありません。どれかのソースで配信されると、ルームと一緒に再生されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródła nie będą mieć go wcześniej. Odtwarzanie ruszy w pokoju, gdy pojawi się w którymś z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas fontes não o terão antes disso. Ele será reproduzido com a sala assim que uma delas tiver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши источники не будут её содержать до выхода. Она будет воспроизводиться в комнате, как только её добавит один из них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina källor har det inte förrän då. Det spelas med rummet när någon av dem har det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynaklarınız o zamana kadar bunu içermeyecek. Bunlardan biri içerdiğinde odayla birlikte oynatılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước đó, các nguồn của bạn sẽ chưa có tập này. Tập sẽ phát cùng phòng khi một trong số đó có tập."
          }
        }
      }
    },
