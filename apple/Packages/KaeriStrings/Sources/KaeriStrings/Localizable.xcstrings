          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните сопряжение, и это устройство получит ваши источники, трекеры и историю, а остальная настройка пройдёт сама."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkoppla med den, så får den här enheten dina källor, trackers och din historik, och resten av konfigurationen görs åt dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onunla eşleştirin; bu cihaz kaynaklarınızı, takip hizmetlerinizi ve geçmişinizi alır, kurulumun geri kalanı da sizin için yapılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghép nối với nó, thiết bị này sẽ nhận các nguồn, các dịch vụ theo dõi và lịch sử của bạn, và các bước thiết lập còn lại được làm sẵn cho bạn."
          }
        }
      }
