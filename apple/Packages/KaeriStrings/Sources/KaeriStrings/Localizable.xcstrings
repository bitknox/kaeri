    "updates-confirm-on-android" : {
      "comment" : "Line after Android is asked to install.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android fragt, ob das Update installiert werden soll. Bestätige auf seinem Bildschirm. Deine Anmeldungen, Listen und Einstellungen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android is asking to install the update. Confirm on its screen; your sign-ins, lists and settings stay."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android pide instalar la actualización. Confírmalo en su pantalla; tus sesiones, listas y ajustes se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android demande d’installer la mise à jour. Confirmez sur son écran ; vos connexions, listes et réglages sont conservés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android meminta izin untuk memasang pembaruan. Konfirmasi di layarnya; masuk, daftar, dan pengaturan Anda tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android chiede di installare l'aggiornamento. Conferma sulla sua schermata; i tuoi accessi, le liste e le impostazioni restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidがアップデートのインストールを確認しています。その画面で確認してください。サインイン、リスト、設定はそのまま残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android prosi o zgodę na instalację aktualizacji. Potwierdź na jego ekranie. Twoje logowania, listy i ustawienia zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Android está pedindo para instalar a atualização. Confirme na tela dele. Suas contas, listas e configurações continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android просит установить обновление. Подтвердите действие на его экране: входы, списки и настройки сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android frågar om du vill installera uppdateringen. Bekräfta på skärmen. Dina inloggningar, listor och inställningar finns kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android güncellemeyi kurmak için izin istiyor. Ekranında onaylayın; oturum açmalarınız, listeleriniz ve ayarlarınız kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android đang yêu cầu cài đặt bản cập nhật. Xác nhận trên màn hình của Android. Đăng nhập, danh sách và cài đặt của bạn vẫn được giữ."
          }
        }
      }
    },
