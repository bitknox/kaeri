    "stores-join-detail-desktop" : {
      "comment" : "Line under the form title on desktop, where nothing happens before the check.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den Einladungslink ein, den dir die Person schickt, die einen Plugin-Store betreibt. Du siehst, was im Plugin-Store ist, bevor du beitrittst oder etwas installierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the invite link a plugin store's owner sent you. You see what the plugin store has before you join or install anything."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega el enlace de invitación que te envió el propietario de una tienda de complementos. Antes de unirte o instalar algo, verás lo que tiene la tienda de complementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez le lien d’invitation d’une boutique de plugins que son propriétaire vous a envoyé. Vous voyez le contenu de la boutique de plugins avant de rejoindre ou d’installer quoi que ce soit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel tautan undangan yang dikirim pemilik toko plugin kepada Anda. Anda melihat isi toko plugin sebelum bergabung atau memasang apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla il link di invito che ti ha mandato il proprietario di un negozio di plugin. Prima di unirti o installare qualcosa, vedi cosa c'è nel negozio di plugin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインストアの運営者から届いた招待リンクを貼り付けます。参加やインストールの前に、プラグインストアの内容を確認できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej link z zaproszeniem, który wysłał ci właściciel sklepu z wtyczkami. Zanim do czegoś dołączysz lub coś zainstalujesz, zobaczysz, co jest w sklepie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole o link de convite que o dono de uma loja de plugins enviou para você. Você vê o que a loja de plugins tem antes de entrar ou instalar qualquer coisa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте ссылку-приглашение, которую вам прислал владелец. До подключения и установки вы увидите, что предлагает магазин плагинов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klistra in inbjudningslänken som ägaren till en tilläggsbutik skickade till dig. Du ser vad tilläggsbutiken har innan du går med eller installerar något."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir eklenti mağazasının sahibinin size gönderdiği davet bağlantısını yapıştırın. Katılmadan ya da bir şey yüklemeden önce eklenti mağazasının neler sunduğunu görürsünüz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán liên kết mời mà chủ của một cửa hàng plugin đã gửi cho bạn. Bạn sẽ thấy cửa hàng plugin có gì trước khi tham gia hoặc cài đặt bất cứ thứ gì."
          }
        }
      }
    },
