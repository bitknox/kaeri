    "stores-invite-rules" : {
      "comment" : "Line above the invite field in the Join sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Einladungslink gilt einmal, für eine Person, und sieben Tage. Frag den Besitzer des Plugin-Store nach einem neuen, wenn deiner abgelaufen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An invite link works once, for one person, and lasts seven days. Ask the plugin store's owner for a new one if yours has expired."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enlace de invitación funciona una vez, para una persona, y dura siete días. Pide uno nuevo al dueño de la tienda de complementos si el tuyo venció."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien d’invitation est valable une fois, pour une personne, pendant sept jours. Demandez-en un nouveau au propriétaire de la boutique de plugins si le vôtre a expiré."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan undangan berlaku sekali, untuk satu orang, dan bertahan tujuh hari. Minta yang baru ke pemilik toko plugin jika milik Anda sudah kedaluwarsa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un link d'invito vale una volta, per una persona, e dura sette giorni. Chiedi un nuovo link al proprietario del negozio di plugin se il tuo è scaduto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待リンクは、1人が1回だけ使え、7日間有効です。期限が切れた場合は、プラグインストアの所有者に新しいリンクを依頼してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link z zaproszeniem działa raz, dla jednej osoby, przez siedem dni. Jeśli twój wygasł, poproś właściciela sklepu o nowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um link de convite vale uma vez, para uma pessoa, e dura sete dias. Peça um novo ao dono da loja de plugins se o seu expirou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка-приглашение действует один раз, для одного человека, и семь дней. Если срок вашей истёк, попросите у владельца магазина плагинов новую."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En inbjudningslänk gäller en gång, för en person, och i sju dagar. Be tilläggsbutikens ägare om en ny om din har gått ut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir davet bağlantısı bir kişi için bir kez geçerlidir ve yedi gün sürer. Sizinkinin süresi dolduysa eklenti mağazası sahibinden yenisini isteyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liên kết mời dùng được một lần, cho một người, và có hiệu lực bảy ngày. Hãy xin chủ sở hữu cửa hàng plugin liên kết mới nếu liên kết của bạn đã hết hạn."
          }
        }
      }
    },
