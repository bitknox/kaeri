    "stores-invite-contact-needed" : {
      "comment" : "Line when Any number of times is picked and the store has no contact.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge zuerst einen Kontakt für diesen Store hinzu. Ein Link, der beliebig oft gilt, lässt sich weitergeben, wie der Link des Store selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a contact for this store first. A link that works any number of times can be passed on, like the store's own link."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero agrega un contacto para esta tienda. Un enlace que funciona cualquier número de veces se puede reenviar, como el enlace de la propia tienda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d’abord un contact pour cette boutique. Un lien utilisable autant de fois que voulu peut être transmis, comme le lien de la boutique elle-même."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan kontak untuk toko ini dulu. Tautan yang bisa dipakai berapa kali pun bisa diteruskan, seperti tautan toko itu sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima aggiungi un contatto per questo negozio. Un link che vale un numero qualsiasi di volte può essere girato ad altri, come il link del negozio stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先にこのストアの連絡先を追加してください。回数無制限のリンクは、ストア自体のリンクと同じように、他の人に渡される可能性があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw dodaj kontakt do tego sklepu. Link działający dowolną liczbę razy można przekazać dalej, tak jak własny link sklepu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione antes um contato para esta loja. Um link que vale para qualquer número de usos pode ser repassado, como o próprio link da loja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала добавьте контакт для этого магазина. Ссылку, которая работает сколько угодно раз, можно передать дальше, как и ссылку самого магазина."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg först till en kontakt för den här butik. En länk som gäller obegränsat många gånger kan skickas vidare, precis som butikens egen länk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce bu mağaza için bir iletişim bilgisi ekleyin. Sınırsız kullanılabilen bir bağlantı, mağazanın kendi bağlantısı gibi başkalarına iletilebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thêm thông tin liên hệ cho cửa hàng này trước. Liên kết dùng không giới hạn có thể bị chuyển tiếp, giống như liên kết của chính cửa hàng."
          }
        }
      }
    },
