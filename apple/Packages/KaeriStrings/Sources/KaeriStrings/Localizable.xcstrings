        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styled subtitles keep the fonts, colours and sign placement their authors gave them. Size and Raise still apply."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos con estilo conservan las fuentes, colores y posición de los letreros que les dieron sus autores. El tamaño y Subir siguen aplicándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres stylés gardent les polices, couleurs et placements que leurs auteurs ont choisis. La taille et la remontée s’appliquent toujours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitle bergaya mempertahankan font, warna, dan posisi tanda yang ditentukan pembuatnya. Ukuran dan Naikkan tetap berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli con stile mantengono caratteri, colori e posizione dei cartelli scelti dagli autori. Dimensione e Alza valgono comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタイル付き字幕は、作者が指定したフォント、色、看板の位置を保ちます。サイズと「字幕を上げる」は適用されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisy ze stylem zachowują czcionki, kolory i położenie znaków nadane przez autorów. Rozmiar i podniesienie nadal działają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As legendas estilizadas mantêm as fontes, as cores e a posição dos letreiros definidas por seus autores. Tamanho e Subir legendas ainda valem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Субтитры со стилем сохраняют шрифты, цвета и положение надписей, заданные авторами. Размер и подъём по-прежнему действуют."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stylade undertexter behåller de typsnitt, färger och den placering av skyltar som upphovsmakarna gav dem. Storlek och Höj gäller fortfarande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stilli altyazılar, yazarlarının verdiği yazı tiplerini, renkleri ve yazı yerleşimini korur. Boyut ve Yükselt yine de geçerlidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề có kiểu giữ phông chữ, màu sắc và vị trí biển hiệu do tác giả đặt. Cỡ chữ và Nâng lên vẫn áp dụng."
          }
        }
      }
    },
