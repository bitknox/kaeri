    "stores-not-from-app" : {
      "comment" : "Line under the join form: who supplies plugins.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins kommen von der Person, die den Plugin-Store betreibt, nicht von Kaeri. Du kannst einen Plugin-Store jederzeit verlassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins come from the plugin store's owner, not from Kaeri. You can leave a plugin store at any time."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los complementos vienen del propietario de la tienda de complementos, no de Kaeri. Puedes salir de una tienda de complementos cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plugins viennent du propriétaire de la boutique de plugins, pas de Kaeri. Vous pouvez quitter une boutique de plugins à tout moment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin-plugin berasal dari pemilik toko plugin, bukan dari Kaeri. Anda dapat keluar dari toko plugin kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Plugin arrivano dal proprietario del negozio di plugin, non da Kaeri. Puoi lasciare un negozio di plugin in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインは、プラグインストアの運営者が提供するもので、Kaeriが提供するものではありません。プラグインストアからはいつでも退出できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczki pochodzą od osoby, która prowadzi sklep z wtyczkami, nie od Kaeri. Możesz opuścić sklep z wtyczkami w każdej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins vêm do dono da loja de plugins, e não do Kaeri. Você pode sair de uma loja de plugins a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагины приходят от владельца магазина, а не от Kaeri. Выйти из магазина можно в любой момент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillägg kommer från tilläggsbutikens ägare, inte från Kaeri. Du kan lämna en tilläggsbutik när som helst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentiler eklenti mağazasının sahibinden gelir, Kaeri'den gelmez. İstediğiniz zaman eklenti mağazasından ayrılabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các plugin đến từ chủ của cửa hàng plugin, không phải từ Kaeri. Bạn có thể rời cửa hàng plugin bất cứ lúc nào."
          }
        }
      }
    },
