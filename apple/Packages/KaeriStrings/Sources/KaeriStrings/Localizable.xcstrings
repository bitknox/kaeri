    "stores-access-ended-detail" : {
      "comment" : "Line when the owner ended access. Installed plugins keep working.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person, die diesen Plugin-Store betreibt, hat deinen Zugriff beendet. Installierte Plugins funktionieren weiter, aber keine wird mehr aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plugin store's owner ended your access. Installed plugins keep working, and none will update."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El propietario de esta tienda de complementos terminó tu acceso. Los complementos instalados siguen funcionando, pero ninguno se actualizará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le propriétaire de cette boutique de plugins a mis fin à votre accès. Les plugins installés continuent de fonctionner, mais aucun ne sera mis à jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemilik toko plugin ini mengakhiri akses Anda. plugin-plugin yang sudah terpasang tetap berfungsi, tetapi tidak akan ada yang diperbarui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il proprietario di questo negozio di plugin ha terminato il tuo accesso. I plugin installati continuano a funzionare, ma nessuno sarà aggiornato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプラグインストアの運営者がアクセスを終了しました。インストール済みのプラグインは引き続き動作しますが、更新は行われません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Właściciel zakończył twój dostęp. Zainstalowane wtyczki nadal działają, ale żadna nie zostanie zaktualizowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dono desta loja de plugins encerrou seu acesso. Os plugins instalados continuam funcionando, mas nenhum será atualizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Владелец магазина закрыл вам доступ. Установленные плагины продолжают работать, но обновляться больше не будут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tilläggsbutikens ägare har avslutat din åtkomst. Installerade tillägg fungerar fortfarande, men ingen uppdateras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eklenti mağazasının sahibi erişiminizi sonlandırdı. Yüklü eklentiler çalışmaya devam eder, ancak hiçbiri güncellenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chủ cửa hàng plugin này đã kết thúc quyền truy cập của bạn, nhưng các plugin đã cài vẫn hoạt động và sẽ không được cập nhật nữa."
          }
        }
      }
    },
    "stores-access-ended-page" : {
      "comment" : "Line on the page of a store that no longer lets the device in.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Plugin-Store lässt dieses Gerät nicht mehr hinein. Seine Plugins bleiben installiert, bis du sie entfernst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plugin store no longer lets this device in. Its plugins stay installed until you remove them."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tienda de complementos ya no deja entrar a este dispositivo. Sus complementos siguen instalados hasta que los quites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette boutique de plugins ne laisse plus entrer cet appareil. Ses plugins restent installés jusqu'à ce que vous les supprimiez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toko plugin ini tidak lagi mengizinkan perangkat ini masuk. plugin-plugin yang terpasang tetap ada sampai Anda menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo negozio di plugin non fa più entrare questo dispositivo. I suoi plugin restano installati finché non li rimuovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプラグインストアは、このデバイスの参加をもう受け付けていません。プラグインは、削除するまでインストールされたままです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sklep z wtyczkami nie pozwala już na wejście. Jego wtyczki pozostają zainstalowane, dopóki ich nie usuniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta loja de plugins não deixa mais este dispositivo entrar. Os plugins continuam instalados até que você os remova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот магазин плагинов больше не пускает это устройство. Его плагины остаются установленными, пока вы их не удалите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här tilläggsbutiken släpper inte in den här enheten längre. Installerade tillägg finns kvar tills du tar bort dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eklenti mağazası artık bu cihazı kabul etmiyor. Yüklü eklentiler siz kaldırana kadar kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cửa hàng plugin này không còn cho thiết bị này truy cập, nhưng các plugin vẫn được cài cho đến khi bạn gỡ bỏ."
          }
        }
      }
    },
