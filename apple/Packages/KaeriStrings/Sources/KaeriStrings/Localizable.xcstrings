        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre una sala e invita a tus amigos con un enlace o un código, y luego presiona Reproducir en lo que quieran ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
