    "about-report-bug-detail" : {
      "comment" : "Line under it: what the report carries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet einen Fehlerbericht auf GitHub, wo du dich anmeldest. Er enthält deine Versionen und den letzten Fehler, ohne Adressen, Dateipfade oder Titel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a bug report on GitHub, where you sign in. It carries your versions and the last error, with no addresses, file paths or titles."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un reporte de error en GitHub, donde inicias sesión. Incluye tus versiones y el último error, sin direcciones, rutas de archivos ni títulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre un signalement de bug sur GitHub, où vous vous connectez. Il contient vos versions et la dernière erreur, sans adresses, chemins de fichiers ni titres."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka laporan bug di GitHub, tempat Anda masuk. Laporan memuat versi Anda dan galat terakhir, tanpa alamat, lokasi berkas, atau judul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre una segnalazione su GitHub, dove accedi. Include le versioni e l'ultimo errore, senza indirizzi, percorsi di file o titoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubで不具合報告を開きます（サインインが必要です）。バージョンと最後のエラーを含みます。アドレス、ファイルパス、タイトルは含まれません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera zgłoszenie błędu na GitHub, gdzie trzeba się zalogować. Zawiera wersje i ostatni błąd, bez adresów, ścieżek plików i tytułów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre um relatório de erro no GitHub, onde você entra na sua conta. Ele leva as versões e o último erro, sem endereços, caminhos de arquivos nem títulos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откроет отчёт об ошибке на GitHub, где нужно войти в аккаунт. В отчёт попадают версии и последняя ошибка, без адресов, путей к файлам и названий."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppnar en felrapport på GitHub, där du loggar in. Den innehåller dina versioner och senaste felet, utan adresser, sökvägar eller titlar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub'da bir hata bildirimi açar ve orada oturum açarsınız. Versiyon bilgilerinizi ve son hatayı taşır; adresleri, dosya yollarını veya başlıkları içermez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở một báo cáo lỗi trên GitHub, nơi bạn đăng nhập. Báo cáo gồm phiên bản của bạn và lỗi gần nhất, không có địa chỉ, đường dẫn tệp hay tiêu đề."
          }
        }
      }
    },
