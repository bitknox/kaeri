          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencarian saat mengetik dijeda sebentar agar tetap dalam batas AniList. Tekan Return untuk mencari sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca mentre scrivi è in pausa per un momento, per restare nei limiti di AniList. Premi Invio per cercare ora."
          }
