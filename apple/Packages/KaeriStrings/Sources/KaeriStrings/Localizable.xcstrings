    "tv-cloud-pick-foot" : {
      "comment" : "TV picker footer (decision 17).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den, den deine anderen Geräte nutzen. Ein neuer Cloud-Ordner wird auf einem Smartphone oder Computer hinzugefügt, wo sich sein Wiederherstellungsschlüssel sichern lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the one your other devices use. A new cloud folder is added on a phone or computer, where its recovery key can be saved."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la que usan tus otros dispositivos. Una carpeta nueva en la nube se añade en un teléfono o una computadora, donde se puede guardar su clave de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez celui que vos autres appareils utilisent. Un nouveau dossier cloud s’ajoute sur un téléphone ou un ordinateur, où sa clé de récupération peut être enregistrée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih yang dipakai perangkat Anda yang lain. Folder cloud baru ditambahkan di ponsel atau komputer, tempat kunci pemulihannya bisa disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quello che usano i tuoi altri dispositivi. Una nuova cartella cloud si aggiunge da un telefono o da un computer, dove si può salvare la sua chiave di ripristino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスで使っているものを選んでください。新しいクラウドフォルダは、復元キーを保存できるスマートフォンかコンピュータで追加します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz ten, którego używają twoje pozostałe urządzenia. Nowy folder w chmurze dodaje się na telefonie lub komputerze, gdzie można zapisać jego klucz odzyskiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a que seus outros dispositivos usam. Uma pasta nova na nuvem é adicionada em um celular ou computador, onde a chave de recuperação pode ser salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите тот, которым пользуются ваши остальные устройства. Новая облачная папка добавляется на телефоне или компьютере, где можно сохранить её ключ восстановления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj den som dina andra enheter använder. En ny molnmapp läggs till på en mobil eller dator, där återställningsnyckeln kan sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer cihazlar cihazlarınızın kullandığını seçin. Yeni bir bulut klasörü, kurtarma anahtarının kaydedilebileceği bir telefonda ya da bilgisayarda eklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chọn dịch vụ mà các các thiết bị khác của bạn đang dùng. Thư mục đám mây mới được thêm trên điện thoại hoặc máy tính, nơi lưu được khóa khôi phục của nó."
          }
        }
      }
    },
    "tv-cloud-revoked-line" : {
      "comment" : "TV cloud row. Argument 1: service (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat Kaeri abgemeldet. Auswählen, um dich wieder anzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ signed Kaeri out. Select to sign in again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cerró la sesión de Kaeri. Selecciona para iniciar sesión de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a déconnecté Kaeri. Sélectionnez pour vous reconnecter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ mengeluarkan Kaeri. Pilih untuk masuk lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha disconnesso Kaeri. Seleziona per accedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がKaeriをサインアウトさせました。選択すると、再びサインインできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wylogowało aplikację Kaeri. Wybierz, aby zalogować się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %1$@ desconectou o Kaeri. Selecione para fazer login de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ вывел Kaeri из аккаунта. Выберите, чтобы войти снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ loggade ut Kaeri. Välj för att logga in igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, Kaeri hesabının oturumunu kapattı. Yeniden giriş için seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã đăng xuất Kaeri. Chọn để đăng nhập lại."
          }
        }
      }
    },
    "tv-cloud-sign-out-line" : {
      "comment" : "TV ConfirmDialog, with Cancel focused and Sign out. Argument 1: service (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Fernseher gleicht nicht mehr über %1$@ ab. Änderungen warten hier, bis du dich wieder anmeldest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This TV stops syncing through %1$@. Changes wait here until you sign in again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este televisor deja de sincronizar a través de %1$@. Los cambios esperan aquí hasta que vuelvas a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette TV arrête de se synchroniser via %1$@. Les changements attendent ici jusqu’à votre nouvelle connexion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV ini berhenti menyinkronkan lewat %1$@. Perubahan menunggu di sini sampai Anda masuk lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa TV smette di sincronizzarsi tramite %1$@. Le modifiche restano in attesa qui finché non accedi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテレビは、%1$@経由の同期をやめます。再びサインインするまで、変更はここで待機します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten telewizor przestaje synchronizować przez %1$@. Zmiany czekają tutaj, dopóki nie zalogujesz się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta TV para de sincronizar pelo %1$@. As mudanças aguardam aqui até você fazer login de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот телевизор перестанет синхронизироваться через %1$@. Изменения будут ждать здесь, пока вы не войдёте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här TV:n slutar synka via %1$@. Ändringar väntar här tills du loggar in igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu TV, %1$@ üzerinden eşitlemeyi bırakır. Yeniden giriş yapana kadar değişiklikler burada bekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV này ngừng đồng bộ qua %1$@. Các thay đổi chờ ở đây cho đến khi bạn đăng nhập lại."
          }
        }
      }
    },
    "tv-cloud-sign-out-title" : {
      "comment" : "TV ConfirmDialog. Argument 1: service (Text).",
      "extractionState" : "manual",
      "localizations" : {
