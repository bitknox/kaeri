    "notice-engine-fault" : {
      "comment" : "Toast when something went wrong inside the engine and it carried on.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Kaeri ist etwas schiefgelaufen. Es läuft weiter, aber wenn ein Bildschirm hängen bleibt, beende Kaeri und öffne es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong inside Kaeri. It carried on, but if a screen looks stuck, quit and open it again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo salió mal dentro de Kaeri. Siguió funcionando, pero si una pantalla parece trabada, ciérrala y ábrela de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s’est produite dans Kaeri. L’application a continué, mais si un écran semble bloqué, quittez-la et ouvrez-la à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjadi kesalahan di dalam Kaeri. Aplikasi tetap berjalan, tetapi jika layar terlihat macet, keluar lalu buka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa non ha funzionato in Kaeri. Ha continuato a funzionare, ma se una schermata sembra bloccata, esci e riaprila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriの内部で問題が発生しました。処理は続行されましたが、画面が止まっているように見える場合は、終了してから開き直してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś poszło nie tak w Kaeri. Program działa dalej, ale jeśli ekran wygląda na zawieszony, zamknij go i otwórz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo deu errado dentro do Kaeri. Ele continuou funcionando, mas se alguma tela parecer travada, saia e abra de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутри Kaeri что-то пошло не так. Работа продолжилась, но если экран завис, закройте приложение и откройте его снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något gick fel i Kaeri. Appen fortsatte, men om en skärm verkar fast avslutar du och öppnar den igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri içinde bir sorun oluştu. Uygulama çalışmaya devam etti, ama bir ekran donmuş görünüyorsa çıkıp uygulamayı yeniden açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có lỗi xảy ra bên trong Kaeri. Ứng dụng vẫn chạy tiếp, nhưng nếu màn hình có vẻ bị treo, hãy thoát rồi mở lại."
          }
        }
      }
    },
