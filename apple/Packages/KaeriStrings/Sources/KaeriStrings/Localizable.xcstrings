          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há episódio seguinte. O episódio %1$@ é o último."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующего эпизода нет. Эпизод %1$@ последний."
          }
        },
        "sv" : {
          "stringUnit" : {
