    "sync-turn-off-alert-line" : {
      "comment" : "Alert message. Argument 1: kind (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem %1$@ wird nichts mehr mit deinen anderen Geräte geteilt. Alles, was darauf ist, bleibt hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This %1$@ stops sharing with your other devices. Everything it has stays here."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo (%1$@) deja de compartir con tus otros dispositivos. Todo lo que tiene se queda aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet %1$@ arrête de partager avec vos autres appareils. Tout ce qu’il a reste ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ini berhenti berbagi dengan perangkat Anda yang lain. Semua yang dimilikinya tetap di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo %1$@ smette di condividere con i tuoi altri dispositivi. Tutto ciò che ha resta qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%1$@は、ほかのデバイスとの共有をやめます。保存済みの内容はここに残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie (%1$@) przestaje dzielić dane z twoimi pozostałymi urządzeniami. Wszystko, co ma, zostaje tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo (%1$@) para de compartilhar com seus outros dispositivos. Tudo o que ele tem fica aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство (%1$@) перестаёт делиться данными с вашими остальными устройствами. Всё, что есть на нём, остаётся здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här %1$@ slutar dela med dina andra enheter. Allt den har finns kvar här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu %1$@, diğer cihazlar ile paylaşmayı bırakır. Elindeki her şey burada kalır."
