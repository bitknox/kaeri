    "series-remove-from-lists-line" : {
      "comment" : "Line in that question.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serie wird in jedem verbundenen Tracker aus deiner Liste entfernt. Deine Position und gelesene Kapitel bleiben in Kaeri."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It comes off your list on each tracker you have connected. Your place and read chapters stay in Kaeri."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quita de tu lista en cada servicio de seguimiento que tengas conectado. Tu avance y los capítulos leídos se quedan en Kaeri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle disparaît de votre liste sur chaque service de suivi connecté. Votre position et les chapitres lus restent dans Kaeri."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seri ini dihapus dari daftar di setiap pelacak yang Anda sambungkan. Posisi dan bab yang sudah dibaca tetap ada di Kaeri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esce dalla tua lista su ogni tracker collegato. Il tuo punto e i capitoli letti restano in Kaeri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続している各連携サービスのリストから外れます。読んだ位置と既読の章はKaeriに残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seria zniknie z listy w każdej połączonej usłudze śledzenia. Twoje miejsce i przeczytane rozdziały zostają w aplikacji Kaeri."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela sai da sua lista em cada serviço de acompanhamento conectado. Seu ponto de leitura e os capítulos lidos ficam no Kaeri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серия исчезнет из списка в каждом подключённом трекере. Ваше место и прочитанные главы останутся в Kaeri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tas bort från din lista på varje tracker du har anslutit. Din plats och lästa kapitel finns kvar i Kaeri."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağladığınız her takip hizmeti listesinden çıkar. Yeriniz ve okunan bölümler Kaeri içinde kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ truyện sẽ bị xóa khỏi danh sách trên mỗi dịch vụ theo dõi bạn đã kết nối. Vị trí đọc và các chương đã đọc vẫn ở lại trong Kaeri."
          }
        }
      }
    },
