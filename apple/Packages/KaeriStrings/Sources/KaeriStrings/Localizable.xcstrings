    "sync-off-line" : {
      "comment" : "Off state.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte sie ein, damit deine Geräte denselben Stand, Verlauf und dieselben Einstellungen haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it on to keep where you stopped, your history and your settings the same on your devices."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívala para mantener igual en tus dispositivos dónde te quedaste, tu historial y tus ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-la pour garder où vous vous êtes arrêté, votre historique et vos réglages identiques sur vos appareils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan agar posisi terakhir, riwayat, dan pengaturan Anda sama di semua perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivala per tenere uguali sui tuoi dispositivi il punto in cui ti sei fermato, la cronologia e le impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、続きの位置、履歴、設定をデバイスの間で同じに保てます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz ją, aby miejsce, w którym skończono oglądać, historia i ustawienia były takie same na twoich urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative para manter onde você parou, seu histórico e suas configurações iguais nos seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите её, чтобы место, где вы остановились, история и настройки были одинаковы на ваших устройствах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på den för att hålla var du slutade, din historik och dina inställningar likadana på dina enheter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaldığınız yerin, geçmişinizin ve ayarlarınızın cihazlar arasında aynı kalması için açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật lên để giữ chỗ xem dở, lịch sử và cài đặt giống nhau trên các các thiết bị của bạn."
          }
        }
      }
    },
