    "notice-cast-not-same-network" : {
      "comment" : "This device isn't on the TV's network, or reaches it through a VPN. The name is the TV's own. Argument 1: name (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät ist nicht im Netzwerk von %1$@ oder erreicht es über ein VPN. Verbinde beide mit demselben Netzwerk, um zu übertragen."
          }
        },
        "en" : {
