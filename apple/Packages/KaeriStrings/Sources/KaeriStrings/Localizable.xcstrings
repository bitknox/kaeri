    "settings-hide-chat-line" : {
      "comment" : "Line under that switch.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatzeilen, Reaktionen und ihre Markierungen auf der Zeitleiste bleiben vom Video fern, und das Chatfeld entfällt. Die Personenliste zeigt trotzdem, wer im Raum ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat lines, reactions and their ticks on the seek bar stay off the video, and the chat field is gone. The people list still shows who is in the room."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas del chat, las reacciones y sus marcas en la barra de reproducción no aparecen en el video, y el campo del chat desaparece. La lista de personas sigue mostrando quién está en la sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages du chat, les réactions et leurs repères sur la barre de lecture restent hors de la vidéo, et le champ du chat disparaît. La liste des personnes indique toujours qui est dans le salon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan obrolan, reaksi, dan tandanya di bilah geser tidak muncul di video, dan kolom obrolan hilang. Daftar orang tetap menunjukkan siapa yang ada di ruangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messaggi della chat, reazioni e i loro segni sulla barra di avanzamento restano fuori dal video e il campo della chat sparisce. L'elenco delle persone mostra comunque chi è nella stanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットのメッセージ、リアクション、シークバー上の目印は映像に表示されず、チャットの入力欄もなくなります。メンバー一覧では、ルームにいる人を確認できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomości czatu, reakcje i ich znaczniki na pasku przewijania nie pojawiają się na wideo, a pole czatu znika. Lista osób nadal pokazuje, kto jest w pokoju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens, as reações e suas marcas na barra de progresso ficam fora do vídeo, e o campo de chat some. A lista de pessoas continua mostrando quem está na sala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения чата, реакции и их метки на шкале перемотки не показываются поверх видео, а поле чата скрыто. Список участников по-прежнему показывает, кто в комнате."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chattrader, reaktioner och deras markeringar på tidslinjen hålls borta från videon, och chattfältet försvinner. Personlistan visar fortfarande vem som är i rummet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet satırları, tepkiler ve bunların arama çubuğundaki işaretleri videoda görünmez, sohbet alanı da kalkar. Kişi listesi odada kimlerin olduğunu yine gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin nhắn, biểu cảm và các vạch của chúng trên thanh tua không hiện trên video, và ô trò chuyện cũng biến mất. Danh sách người tham gia vẫn cho biết ai đang trong phòng."
          }
        }
