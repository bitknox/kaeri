    "cloud-foot" : {
      "comment" : "Group footer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner hält deine Geräte auf demselben Stand, solange sie getrennt sind, und bewahrt eine versiegelte Sicherung auf. Nur deine Geräte können sie lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder keeps your devices in step while they are apart, and holds a sealed backup. Only your devices can read it."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta mantiene tus dispositivos al día mientras están lejos y guarda una copia de respaldo sellada. Solo tus dispositivos pueden leerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier garde vos appareils à jour quand ils sont éloignés, et conserve une sauvegarde scellée. Seuls vos appareils peuvent la lire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder ini menjaga perangkat Anda tetap selaras saat berjauhan, dan menyimpan cadangan tersegel. Hanya perangkat Anda yang dapat membacanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella tiene allineati i tuoi dispositivi mentre sono lontani e conserva un backup sigillato. Solo i tuoi dispositivi possono leggerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダーが、離れている間もデバイスの状態をそろえ、封印したバックアップを保管します。読み取れるのは、あなたのデバイスだけです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder synchronizuje twoje urządzenia, gdy są daleko od siebie, i przechowuje zaszyfrowaną kopię zapasową. Odczytać ją mogą tylko twoje urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta mantém seus dispositivos em sincronia enquanto estão longe um do outro e guarda um backup selado. Só os seus dispositivos conseguem lê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка синхронизирует ваши устройства, пока они далеко друг от друга, и хранит зашифрованную резервную копию. Прочитать её могут только ваши устройства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen håller dina enheter i takt medan de är ifrån varandra och har en förseglad säkerhetskopia. Bara dina enheter kan läsa den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasör, cihazlarınızı birbirinden uzaktayken eşitler ve mühürlü bir yedek saklar. Onu yalnızca cihazlarınız okuyabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục này giữ các các thiết bị của bạn đồng bộ khi chúng ở xa nhau, và giữ một bản sao lưu đã niêm phong. Chỉ các các thiết bị của bạn đọc được nó."
          }
        }
      }
    },
