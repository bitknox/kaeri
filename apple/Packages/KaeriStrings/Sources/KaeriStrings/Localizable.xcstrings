    "store-key-damaged" : {
      "comment" : "Error: a store's signing key is unreadable. Shown as the reason a store is offline.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel dieses Plugin-Stores auf diesem Gerät ist beschädigt. Verlasse den Plugin-Store und tritt mit einer neuen Einladung erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plugin store's key on this device is damaged. Leave the plugin store and join it again with a new invite."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de esta tienda de complementos en este dispositivo está dañada. Sal de la tienda de complementos y vuelve a unirte con una invitación nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de cette boutique de plugins sur cet appareil est endommagée. Quittez la boutique de plugins et rejoignez-la avec une nouvelle invitation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci untuk toko plugin ini di perangkat ini rusak. Keluar dari toko plugin, lalu bergabung lagi dengan undangan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave di questo negozio di plugin su questo dispositivo è danneggiata. Lascia il negozio di plugin e unisciti di nuovo con un nuovo invito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに保存されている、このプラグインストアの鍵が破損しています。プラグインストアから退出し、新しい招待で参加し直してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sklep z wtyczkami ma uszkodzony klucz podpisu. Opuść go i dołącz ponownie nowym zaproszeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave desta loja de plugins neste dispositivo está danificada. Saia da loja de plugins e entre de novo com um convite novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "магазин плагинов: ключ повреждён, и устройство не может его прочитать. Выйдите из него и подключитесь снова с новым приглашением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyckeln för den här tilläggsbutiken på den här enheten är skadad. Lämna tilläggsbutik och gå med igen med en ny inbjudan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda eklenti mağazasının imza anahtarı bozuk. eklenti mağazasını bırakıp yeni bir davetle yeniden katılın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa của cửa hàng plugin này trên thiết bị bị hỏng. Hãy rời khỏi cửa hàng plugin và tham gia lại bằng lời mời mới."
          }
        }
      }
    },
