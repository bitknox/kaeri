        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV è già collegata al massimo di dispositivi consentiti. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテレビは接続中のデバイスが上限です。しばらくしてから、もう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telewizor ma już tyle połączeń, ile może obsłużyć. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV já tem o máximo de dispositivos conectados. Tente de novo em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизор уже принимает максимум подключений. Попробуйте позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV:n är ansluten till så många enheter som den klarar. Försök igen snart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV'ye daha fazla cihaz bağlanamıyor. Biraz sonra yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV đã kết nối với tối đa các thiết bị. Thử lại sau."
          }
        }
      }
    },
    "tv-problem-full" : {
      "comment" : "The TV cannot take another paired device.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
