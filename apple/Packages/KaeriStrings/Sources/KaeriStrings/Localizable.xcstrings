    "player-mark-no-mal" : {
      "comment" : "Line in the review when the show has no MyAnimeList entry.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip hat keinen Eintrag zu dieser Serie, deshalb bleibt das auf deinen Geräte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip has no entry for this show, so this stays on your devices."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip no tiene una entrada para esta serie, así que esto se queda en tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip n’a aucune entrée pour cette série, donc cela reste sur vos appareils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip tidak punya entri untuk acara ini, jadi tanda ini hanya tersimpan di perangkat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip non ha una voce per questa serie, quindi i tempi restano sui tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkipにこの作品の登録がないため、この位置はデバイス内にのみ保存されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip nie ma wpisu dla tego serialu, więc zostaje to na twoich urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AniSkip não tem registro deste título, então isto fica nos seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В AniSkip нет записи об этом тайтле, поэтому отметка остаётся только на ваших устройствах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip har ingen post för den här serien, så det här stannar på dina enheter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip'te bu dizi için kayıt yok, bu yüzden cihazlarınızda kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip không có mục cho phim này, nên mốc chỉ ở lại trên các thiết bị của bạn."
          }
        }
      }
    },
    "player-mark-replaces" : {
      "comment" : "Line in the review when the mark replaces AniSkip's times. Argument 1: start (Text). Argument 2: end (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt die Zeiten von AniSkip, %1$@ bis %2$@, die als falsch gemeldet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces AniSkip's %1$@ to %2$@, which is reported as wrong."
          }
