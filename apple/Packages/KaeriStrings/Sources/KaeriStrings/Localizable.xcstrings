    "player-subtitle-file-failed" : {
      "comment" : "Notice when a chosen subtitle file could not be loaded.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht als Untertitel geladen werden. Wähle eine Untertiteldatei, etwa .srt oder .ass."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load that file as subtitles. Choose a subtitle file, such as .srt or .ass."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar ese archivo como subtítulos. Elige un archivo de subtítulos, como .srt o .ass."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger ce fichier comme sous-titres. Choisissez un fichier de sous-titres, par exemple .srt ou .ass."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berkas itu tidak bisa dimuat sebagai subtitel. Pilih berkas subtitel, seperti .srt atau .ass."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare quel file come sottotitoli. Scegli un file di sottotitoli, ad esempio .srt o .ass."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのファイルを字幕として読み込めませんでした。.srtや.assなどの字幕ファイルを選んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać tego pliku jako napisów. Wybierz plik napisów, na przykład .srt lub .ass."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar esse arquivo como legenda. Escolha um arquivo de legenda, como .srt ou .ass."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить этот файл как субтитры. Выберите файл субтитров, например .srt или .ass."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att läsa in filen som undertexter. Välj en undertextfil, till exempel .srt eller .ass."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosya altyazı olarak yüklenemedi. .srt ya da .ass gibi bir altyazı dosyası seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tải được tệp đó làm phụ đề. Hãy chọn một tệp phụ đề, chẳng hạn .srt hoặc .ass."
          }
        }
      }
    },
