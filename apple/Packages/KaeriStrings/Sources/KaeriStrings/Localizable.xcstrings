    "accounts-code-detail" : {
      "comment" : "Line under the title: what to do. Argument 1: host (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe zu %1$@ und gib diesen Code ein. Kaeri meldet dich an, sobald du das getan hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to %1$@ and enter this code. Kaeri signs in once you have."
