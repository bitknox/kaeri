    "notice-anilist-paste-flow" : {
      "comment" : "Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Code einzufügen ist hier nicht möglich. Beende das Programm und starte Kaeri stattdessen mit --login."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting a code isn't possible here. Quit and run kaeri --login instead."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede pegar un código aquí. Cierra Kaeri y ejecuta kaeri --login en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coller un code n'est pas possible ici. Quittez et lancez kaeri --login à la place."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menempel kode tidak dapat dilakukan di sini. Keluar lalu jalankan kaeri --login."
          }
