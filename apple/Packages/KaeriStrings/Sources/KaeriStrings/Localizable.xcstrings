          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie com seu celular. Abra %1$@ nele, permita o Kaeri e cole o código nesta página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте телефоном. Откройте там %1$@, разрешите Kaeri, затем вставьте код на этой странице."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna med din telefon. Öppna %1$@ där, tillåt Kaeri och klistra in koden på den här sidan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuzla tarayın. %1$@ uygulamasını orada açın, Kaeri uygulamasına izin verin, ardından kodu bu sayfaya yapıştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
