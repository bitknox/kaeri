    "accounts-scan-code" : {
      "comment" : "Line on the TV's sign-in screen for a tracker that signs in by code. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne mit deinem Telefon. Öffne dort %1$@, erlaube Kaeri und füge dann den Code auf dieser Seite ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan with your phone. Open %1$@ there, allow Kaeri, then paste the code on this page."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea con tu teléfono. Abre %1$@ ahí, permite el acceso a Kaeri y luego pega el código en esta página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez avec votre téléphone. Ouvrez %1$@ là-bas, autorisez Kaeri, puis collez le code sur cette page."
