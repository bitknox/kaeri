    "store-join-would-unname" : {
      "comment" : "Error: an open link would replace the named membership this device already has. Argument 1: store (Text). Argument 2: member (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist %1$@ als %2$@ beigetreten. Mit diesem Link würdest du ohne deinen Namen erneut beitreten. Deshalb wurde nichts geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You joined %1$@ as %2$@. This link would join it again without your name, so nothing was changed."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te uniste a %1$@ como %2$@. Este enlace te uniría otra vez sin tu nombre, así que no se cambió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez rejoint %1$@ en tant que %2$@. Ce lien vous ferait rejoindre sans votre nom : rien n’a été modifié."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sudah bergabung dengan %1$@ sebagai %2$@. Tautan ini akan bergabung lagi tanpa nama Anda, jadi tidak ada yang diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti sei unito a %1$@ come %2$@. Questo link ti unirebbe di nuovo senza il tuo nome, quindi non è stato cambiato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@には%2$@として参加済みです。このリンクで参加すると名前が外れるため、何も変更しませんでした。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołączono do %1$@ jako %2$@. Ten link dołączyłby ponownie bez podanej nazwy, więc nic nie zmieniono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entrou em %1$@ como %2$@. Este link faria você entrar de novo sem o seu nome, então nada foi alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы подключились к %1$@ как %2$@. Эта ссылка подключила бы вас без имени, поэтому ничего не изменилось."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gick med i %1$@ som %2$@. Den här länken skulle gå med igen utan ditt namn, så ingenting ändrades."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ olarak katıldınız. Bu bağlantı adınız olmadan yeniden katılmanızı sağlardı, bu yüzden hiçbir şey değiştirilmedi."
          }
        },
        "vi" : {
