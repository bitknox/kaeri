    "reader-moved" : {
      "comment" : "A notice when another device read further, so the reader moved on to where it stopped. It offers Go back. The chapter is its whole label, such as The Long Night or Episode 63, and the device is its name, such as Living room tablet. A chapter with only a number uses the next message. Argument 1: chapter (Text). Argument 2: page (Plain). Argument 3: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewechselt zu %1$@, Seite %2$@, wo %3$@ aufgehört hat"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moved to %1$@, page %2$@, where %3$@ stopped"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasaste a %1$@, página %2$@, donde se quedó %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacé au %1$@, page %2$@, là où %3$@ s'est arrêté"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindah ke %1$@, halaman %2$@, tempat %3$@ berhenti"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
