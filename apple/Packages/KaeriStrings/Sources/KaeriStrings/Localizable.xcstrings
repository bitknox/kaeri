          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスはネットワーク内のものではなく、HTTPSも使っていないため、パスワードが保護されずに送信されます。https:// のアドレスを使ってください。"
