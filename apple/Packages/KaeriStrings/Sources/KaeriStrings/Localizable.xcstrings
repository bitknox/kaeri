    "settings-subs-styled-strip-detail" : {
      "comment" : "Line under the picker while Remove all styling is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile erscheint als einfacher Dialog unten, in deinem Stil. Schilder verlieren ihren Platz, und Karaoke und Effekte entfallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every line shows as plain dialogue at the bottom, in your style. Signs lose their place, and karaoke and effects are gone."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada línea se muestra como diálogo simple abajo, con tu estilo. Los letreros pierden su lugar y desaparecen el karaoke y los efectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne s’affiche en dialogue simple en bas, dans votre style. Les panneaux perdent leur place, et le karaoké et les effets disparaissent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap baris tampil sebagai dialog polos di bagian bawah, dengan gaya Anda. Tanda kehilangan posisinya, dan karaoke serta efek hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga appare come dialogo semplice in basso, con il tuo stile. I cartelli perdono il loro posto e karaoke ed effetti spariscono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての行が、あなたのスタイルで画面下部に通常のセリフとして表示されます。看板は位置を失い、カラオケや効果も消えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda linijka pojawia się jako zwykły dialog na dole, w twoim stylu. Znaki tracą swoje miejsce, a karaoke i efekty znikają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada linha aparece como diálogo simples na parte de baixo, no seu estilo. Os letreiros perdem o lugar, e o karaokê e os efeitos somem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая строка показывается обычным диалогом внизу, в вашем стиле. Надписи теряют своё место, караоке и эффекты пропадают."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje rad visas som vanlig dialog längst ned, i din stil. Skyltar förlorar sin plats, och karaoke och effekter försvinner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her satır altta, sizin stilinizde düz diyalog olarak görünür. Yazılar yerini kaybeder; karaoke ve efektler kalkar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi dòng hiện như thoại thường ở phía dưới, theo kiểu của bạn. Biển hiệu mất vị trí, karaoke và hiệu ứng cũng mất."
          }
        }
      }
    },
