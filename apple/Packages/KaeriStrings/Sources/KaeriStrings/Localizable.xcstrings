        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read marks belong to the series, so they carry over when you change. Downloads from the old source stay until you delete them."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las marcas de lectura pertenecen a la serie, así que se conservan al cambiar. Las descargas de la fuente anterior se quedan hasta que las elimines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les marques de lecture appartiennent à la série : elles restent quand vous changez. Les téléchargements de l'ancienne source restent jusqu'à leur suppression."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanda dibaca milik seri, jadi ikut pindah saat Anda berganti. Unduhan dari sumber lama tetap ada sampai Anda menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segni di lettura appartengono alla serie, quindi restano quando cambi. I download della vecchia fonte restano finché non li elimini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既読の記録は作品に紐づくため、変更しても引き継がれます。以前のソースからのダウンロードは、削除するまで残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznaczenia przeczytania należą do serii, więc zostają po zmianie. Pobrane rozdziały zostają, dopóki ich nie usuniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As marcas de lido pertencem à série, então passam com você quando você muda. Os downloads da fonte antiga ficam até você apagá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметки о прочтении принадлежат серии, поэтому при смене они сохраняются. Загрузки из прежнего источника остаются, пока вы их не удалите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läsmarkeringar tillhör serien, så de följer med när du byter. Nedladdningar från den gamla källan finns kvar tills du tar bort dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okundu işaretleri seriye aittir, bu yüzden değiştirdiğinizde taşınır. Eski kaynak indirmeleri siz silene kadar kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu đã đọc thuộc về bộ truyện, nên được giữ nguyên khi bạn đổi. Các bản tải từ nguồn cũ vẫn ở lại cho đến khi bạn xóa."
          }
        }
      }
    },
