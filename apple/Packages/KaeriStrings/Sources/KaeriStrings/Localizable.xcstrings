    "plugin-installed-outdated" : {
      "comment" : "Toast after a plugin is installed but was built for an older plugin interface, so it was not loaded. Argument 1: plugin (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde installiert, ist aber für eine ältere Version von Kaeri gebaut und muss aktualisiert werden. Frag den Autor nach einem neuen Build."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installed %1$@, but it was built for an older version of Kaeri and needs updating. Ask its author for a new build."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
