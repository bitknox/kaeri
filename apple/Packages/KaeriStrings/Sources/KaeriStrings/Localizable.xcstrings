    "settings-notify-detail" : {
      "comment" : "Line explaining what a notification says.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst eine Benachrichtigung, wenn eine Folge einer Serie erscheint, der du folgst. Sie nennt die Serie und die Folgennummer, nie den Folgentitel. Eine Serie kann ihre eigenen in den Einstellungen ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You get one notification when an episode of a show you follow comes out. It names the show and the episode's number, never the episode's title. A show can turn its own off in its settings."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibes un aviso cuando sale un episodio de una serie que sigues. Dice el nombre de la serie y el número del episodio, nunca el título del episodio. Una serie puede desactivarlo en sus ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous recevez une notification quand un épisode d’une série que vous suivez sort. Elle indique la série et le numéro de l’épisode, jamais le titre de l’épisode. Une série peut désactiver ses propres notifications dans ses réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mendapat satu notifikasi saat episode dari serial yang Anda ikuti terbit. Isinya nama serial dan nomor episode, tanpa judul episodenya. Serial bisa mematikan notifikasinya sendiri di pengaturannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica quando esce un episodio di una serie che segui. Indica la serie e il numero dell'episodio, mai il titolo dell'episodio. Una serie può disattivarle nelle proprie impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォローしている作品のエピソードが公開されると、1件通知が届きます。通知には作品名とエピソード番号だけが表示され、エピソード名は表示されません。作品ごとの設定でオフにできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostajesz jedno powiadomienie, gdy ukaże się odcinek śledzonego tytułu. Zawiera nazwę tytułu i numer odcinka, nigdy nazwę odcinka. Tytuł może wyłączyć swoje powiadomienia we własnych ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você recebe uma notificação quando sai um episódio de uma série que você acompanha. Ela traz o nome da série e o número do episódio, nunca o título dele. Cada série pode desligar o próprio aviso nas configurações dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы получаете одно уведомление, когда выходит эпизод тайтла, за которым вы следите. В нём указаны тайтл и номер эпизода, но не название эпизода. Уведомления для тайтла можно выключить в его настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en avisering när ett avsnitt av en serie du följer kommer ut. Den anger serien och avsnittets nummer, aldrig avsnittets titel. En serie kan stänga av sina egna aviseringar i sina inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takip ettiğiniz bir dizinin bölümü çıktığında tek bildirim alırsınız. Bildirim diziyi ve bölüm numarasını belirtir, bölümün adını hiçbir zaman belirtmez. Bir dizinin bildirimlerini kendi ayarlarından kapatabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn nhận một thông báo khi tập của tựa bạn theo dõi ra mắt. Thông báo ghi tên tựa và số tập, không bao giờ ghi tên tập. Mỗi tựa có thể tắt thông báo riêng trong cài đặt của nó."
          }
        }
      }
    },
    "settings-notify-explain-off" : {
      "comment" : "Under the notification preview while New episodes is off.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
