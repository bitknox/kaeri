    "sources-empty-body" : {
      "comment" : "Line under the empty state's title on a computer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen sind der Ort, woher Folgen kommen: Ordner auf diesem Gerät, dein Medienserver und Plugins aus Plugin-Stores, denen du beitrittst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources are where episodes come from: folders on this device, your media server, and plugins from plugin stores you join."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuentes son de donde vienen los episodios: carpetas de este dispositivo, tu servidor multimedia y complementos de las tiendas de complementos a las que te unes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources sont les endroits d’où viennent les épisodes : des dossiers sur cet appareil, votre serveur multimédia et des plugins issus des boutiques de plugins que vous rejoignez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber-sumber adalah asal episode: folder di perangkat ini, server media Anda, dan plugin-plugin dari toko-toko plugin yang Anda ikuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonti sono da dove arrivano gli episodi: le cartelle su questo dispositivo, il tuo server multimediale e i plugin dei negozi di plugin a cui ti unisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースはエピソードの入手元です。このデバイス内のフォルダー、メディアサーバー、参加したプラグインストアのプラグインが対象です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródła to miejsca, skąd pochodzą odcinki: foldery na tym urządzeniu, twój serwer multimediów i wtyczki ze sklepów z wtyczkami, do których dołączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fontes são de onde vêm os episódios: pastas neste dispositivo, seu servidor de mídia e plugins de lojas de plugins em que você entrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источники дают эпизоды: это папки на этом устройстве, ваш медиасервер и плагины из магазинов плагинов, к которым вы присоединились."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Källor är där avsnitten kommer ifrån: mappar på den här enheten, din mediaserver och tillägg från de tilläggsbutiker du går med i."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynaklar, bölümlerin geldiği yerlerdir: bu cihazdaki klasörler, medya sunucunuz ve katıldığınız eklenti mağazalarından gelen eklentiler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nguồn là nơi các tập phim đến: thư mục trên thiết bị này, máy chủ media của bạn, và các plugin từ các cửa hàng plugin bạn tham gia."
          }
        }
      }
    },
