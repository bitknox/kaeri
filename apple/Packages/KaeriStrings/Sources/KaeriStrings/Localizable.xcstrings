    "settings-medium-footer" : {
      "comment" : "Under the choices on the iPhone's page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Gerät behält seine eigene Antwort. Wenn du eines ausschaltest, bleiben Liste, Fortschritt und Downloads erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each device keeps its own answer. Turning one off keeps its list, progress and downloads."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dispositivo guarda su propia respuesta. Al desactivar una, se conservan su lista, su progreso y sus descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque appareil garde sa propre réponse. En désactiver un garde sa liste, sa progression et ses téléchargements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap perangkat menyimpan jawabannya sendiri. Mematikan salah satunya tidak menghapus daftar, kemajuan, dan unduhannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni dispositivo tiene la sua risposta. Disattivarne uno conserva la sua lista, i progressi e i download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択はデバイスごとに保存されます。オフにしても、リスト、進捗、ダウンロードは残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde urządzenie zachowuje własną odpowiedź. Wyłączenie jednej opcji zachowuje listę, postęp i pobrane pliki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dispositivo guarda a própria resposta. Desligar um mantém a lista, o progresso e os downloads dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое устройство хранит свой выбор. Если отключить режим, список, прогресс и загрузки сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje enhet behåller sitt eget svar. Att stänga av en behåller dess lista, förlopp och nedladdningar."
          }
        },
        "tr" : {
