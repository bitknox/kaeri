    "cloud-pick-foot" : {
      "comment" : "Picker footer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Geräte legen in diesem Ordner eine versiegelte Kopie ihrer Änderungen ab. Nur deine Geräte können sie lesen, und Kaeri betreibt keinen eigenen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your devices keep a sealed copy of their changes in this folder. Only your devices can read it, and Kaeri runs no server of its own."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus dispositivos guardan en esta carpeta una copia sellada de sus cambios. Solo tus dispositivos pueden leerla, y Kaeri no tiene un servidor propio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos appareils gardent dans ce dossier une copie scellée de leurs changements. Seuls vos appareils peuvent la lire, et Kaeri n’a pas de serveur à lui."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "perangkat Anda menyimpan salinan tersegel perubahannya di folder ini. Hanya perangkat Anda yang dapat membacanya, dan Kaeri tidak menjalankan server sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dispositivi tengono in questa cartella una copia sigillata delle loro modifiche. Solo i tuoi dispositivi possono leggerla e Kaeri non gestisce alcun server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスは、このフォルダに変更内容の封印したコピーを保管します。読み取れるのは、あなたのデバイスだけです。Kaeriは独自のサーバーを運営していません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje urządzenia trzymają w tym folderze zaszyfrowaną kopię swoich zmian. Odczytać ją mogą tylko twoje urządzenia, a Kaeri nie prowadzi własnego serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dispositivos guardam nesta pasta uma cópia selada das suas mudanças. Só os seus dispositivos conseguem lê-la, e o Kaeri não tem servidor próprio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши устройства хранят в этой папке зашифрованную копию своих изменений. Прочитать её могут только ваши устройства, а Kaeri не запускает собственного сервера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina enheter lägger en förseglad kopia av sina ändringar i den här mappen. Bara dina enheter kan läsa den, och Kaeri driver ingen egen server."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cihazlar, değişikliklerinin mühürlü bir kopyasını bu klasörde tutar. Yalnızca cihazlar okuyabilir ve Kaeri kendi sunucusunu işletmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các các thiết bị của bạn giữ một bản sao đã niêm phong các thay đổi trong thư mục này. Chỉ các các thiết bị của bạn đọc được, và Kaeri không chạy máy chủ riêng nào."
          }
        }
      }
    },
