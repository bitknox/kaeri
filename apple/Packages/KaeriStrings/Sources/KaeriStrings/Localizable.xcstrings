    "sync-store-err-not-allowed" : {
      "comment" : "Line on a store row when the paired device can't make invites to the store, because it isn't a named member there any more or joined through an open link. Argument 1: store (Text). Argument 2: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ kann keine anderen Geräte zu %1$@ einladen. Bitte den Besitzer des Plugin-Store um eine Einladung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ can't invite other devices to %1$@. Ask the plugin store's owner for an invite."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ no puede invitar a otros dispositivos a %1$@. Pide una invitación al propietario de la tienda de complementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ ne peut pas inviter d’autres appareils sur %1$@. Demandez une invitation au propriétaire de la boutique de plugins."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ tidak dapat mengundang perangkat lain ke %1$@. Minta undangan dari pemilik toko plugin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ non può invitare altri dispositivi su %1$@. Chiedi un invito al proprietario del negozio di plugin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@は、%1$@に他のデバイスを招待できません。プラグインストアの運営者に招待を依頼してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ nie może zapraszać innych urządzeń do: %1$@. Poproś właściciela o zaproszenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ não pode convidar outros dispositivos para %1$@. Peça um convite ao dono da loja de plugins."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ не может приглашать другие устройства в: %1$@. Попросите владельца о приглашении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ kan inte bjuda in andra enheter till %1$@. Be ägaren till tilläggsbutikn om en inbjudan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@, %1$@ için başka cihazlar davet edemez. eklenti mağazası sahibinden bir davet isteyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ không thể mời các các thiết bị khác vào %1$@. Hãy nhờ chủ của cửa hàng plugin gửi lời mời."
          }
        }
      }
    },
    "sync-store-err-offline" : {
      "comment" : "Line on a store row when joining it through a paired device failed because the store or the paired device could not be reached. The person can try again later. Argument 1: store (Text). Argument 2: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ oder %2$@ war nicht erreichbar. Versuch es noch einmal, wenn beide online sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach %1$@ or %2$@. Try again when both are online."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con %1$@ ni con %2$@. Inténtalo de nuevo cuando ambos estén en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %1$@ ou %2$@. Réessayez quand les deux sont en ligne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
