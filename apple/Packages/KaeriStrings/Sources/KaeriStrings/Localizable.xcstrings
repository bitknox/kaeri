    "settings-subs-styled-restyle-detail" : {
      "comment" : "Line under the picker while Restyle is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Schrift, Farbe, dein Rand und Hintergrund gelten auch für gestaltete Untertitel. Schilder können ihr Aussehen oder ihre Platzierung verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your font, colour, edge and background apply to styled subtitles too. Signs may lose their look or their placement."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu fuente, color, borde y fondo se aplican también a los subtítulos con estilo. Los letreros pueden perder su aspecto o su posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre police, couleur, bord et arrière-plan s’appliquent aussi aux sous-titres stylés. Les panneaux peuvent perdre leur aspect ou leur placement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Font, warna, tepi, dan latar Anda juga berlaku pada subtitle bergaya. Tanda bisa kehilangan tampilan atau posisinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carattere, colore, bordo e sfondo scelti da te valgono anche per i sottotitoli con stile. I cartelli possono perdere aspetto o posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのフォント、色、縁、背景がスタイル付き字幕にも適用されます。看板の見た目や位置が崩れることがあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja czcionka, kolor, krawędź i tło dotyczą także napisów ze stylem. Znaki mogą stracić wygląd lub położenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua fonte, cor, borda e fundo valem também para as legendas estilizadas. Os letreiros podem perder o visual ou a posição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши шрифт, цвет, контур и фон применяются и к субтитрам со стилем. Надписи могут потерять вид или положение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt typsnitt, din färg, kant och bakgrund gäller även stylade undertexter. Skyltar kan förlora sitt utseende eller sin placering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazı tipiniz, renginiz, kenarınız ve arka planınız stilli altyazılara da uygulanır. Yazılar görünümünü ya da yerini kaybedebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phông chữ, màu, viền và nền của bạn cũng áp dụng cho phụ đề có kiểu. Biển hiệu có thể mất dáng hoặc vị trí."
          }
        }
      }
    },
