    "notice-cast-lost" : {
      "comment" : "The TV stopped answering mid-cast. The name is the TV's own. Argument 1: name (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung zu %1$@ verloren, deshalb wurde das Übertragen beendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost %1$@, so casting stopped."
