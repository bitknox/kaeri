    "torrents-risk" : {
      "comment" : "Line about privacy in the torrent sheet, before torrents start.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere in einem Torrent können deine IP-Adresse sehen. Leite den Torrent-Verkehr über einen Proxy, um sie zu schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other people in a torrent can see your IP address. To keep it private, route torrent traffic through a proxy."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras personas en un torrent pueden ver tu dirección IP. Para mantenerla privada, pasa el tráfico de torrents por un proxy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres personnes dans un torrent peuvent voir votre adresse IP. Pour la garder privée, faites passer le trafic des torrents par un proxy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang lain di sebuah torrent dapat melihat alamat IP Anda. Agar tetap privat, arahkan lalu lintas torrent lewat proxy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre persone in un torrent possono vedere il tuo indirizzo IP. Per tenerlo privato, fai passare il traffico dei torrent da un proxy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントの参加者は、あなたのIPアドレスを見ることができます。非公開にするには、トレントの通信をプロキシ経由にしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne osoby w torrencie widzą twój adres IP. Aby go ukryć, skieruj ruch torrentów przez proxy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outras pessoas em um torrent podem ver seu endereço IP. Para mantê-lo privado, passe o tráfego dos torrents por um proxy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие участники торрента видят ваш IP-адрес. Чтобы скрыть его, направьте трафик торрентов через прокси."
          }
        },
        "sv" : {
