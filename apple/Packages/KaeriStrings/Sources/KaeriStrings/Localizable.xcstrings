    "profiles-add-line" : {
      "comment" : "Sheet line.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Profil hat seinen eigenen Verlauf, sein eigenes Weiterschauen und eigene Konten. Quellen und Downloads bleiben auf diesem Gerät gemeinsam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each profile keeps its own history, Continue and accounts. Sources and downloads stay shared on this device."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil guarda su propio historial, Continuar viendo y cuentas. Las Fuentes y las descargas se comparten en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque profil garde son propre historique, Reprendre et ses comptes. Les sources et les téléchargements restent partagés sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap profil menyimpan riwayat, lanjutkan menonton, dan akunnya sendiri. Sumber-sumber dan unduhan tetap dipakai bersama di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni profilo ha la propria cronologia, Continua a guardare e i propri account. Fonti e download restano condivisi su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルごとに、履歴、続きを見る、アカウントが別々になります。このデバイスでは、ソースとダウンロードは共有されたままです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy profil ma własną historię, sekcję Kontynuuj oglądanie i konta. Źródła i pobrane pliki są wspólne na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil guarda o próprio histórico, Continuar assistindo e contas. As Fontes e os downloads continuam compartilhados neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого профиля своя история, раздел «Продолжить просмотр» и аккаунты. Источники и загрузки общие на этом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje profil har sin egen historik, sitt eget Fortsätt titta och egna konton. Källor och nedladdningar delas på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her profil kendi geçmişini, izlemeye devam et listesini ve hesaplarını tutar. Kaynaklar ve indirmeler bu cihaz cihazda ortak kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi hồ sơ có lịch sử, Xem tiếp và tài khoản riêng. Các nguồn và các tệp tải xuống vẫn dùng chung trên thiết bị này."
          }
        }
      }
    },
