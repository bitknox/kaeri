            "value" : "Kaeri checks series on your Reading list that you are caught up on, a few times a day."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri revisa varias veces al día las series de tu lista Leyendo que tienes al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri vérifie plusieurs fois par jour les séries de votre liste Lecture que vous avez à jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri memeriksa seri di daftar Membaca Anda yang sudah Anda susul, beberapa kali sehari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri controlla alcune volte al giorno le serie nella tua lista In lettura di cui sei in pari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriは、「読書中」リストにある最新話まで読んだ作品を、1日に数回確認します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
