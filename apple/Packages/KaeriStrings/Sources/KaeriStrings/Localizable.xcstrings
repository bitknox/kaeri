    "onboarding-where-hosts" : {
      "comment" : "Line under it on a computer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri spielt ab, was du schon hast: Dateien auf diesem Gerät, deinen Jellyfin-Server und Plugins aus Stores, denen du beitrittst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri plays what you already have: files on this device, your Jellyfin server, and plugins from stores you join."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri reproduce lo que ya tienes: archivos de este dispositivo, tu servidor Jellyfin y complementos de las tiendas a las que te unes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri lit ce que vous avez déjà : des fichiers sur cet appareil, votre serveur Jellyfin et des plugins issus des boutiques que vous rejoignez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri memutar apa yang sudah Anda punya: berkas di perangkat ini, server Jellyfin Anda, dan plugin-plugin dari toko-toko plugin yang Anda ikuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri riproduce ciò che hai già: i file su questo dispositivo, il tuo server Jellyfin e i plugin dei negozi a cui ti unisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriは、お手元にあるもの(このデバイス内のファイル、Jellyfinサーバー、参加したストアのプラグイン)を再生します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri odtwarza to, co już masz: pliki na tym urządzeniu, twój serwer Jellyfin i wtyczki ze sklepów, do których dołączysz."
