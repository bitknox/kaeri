        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai dengan ponsel Anda. Buka %1$@ di sana, izinkan Kaeri, lalu tempel kodenya di halaman ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra con il telefono. Apri %1$@ lì, consenti Kaeri, poi incolla il codice in questa pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンで読み取ってください。そこで%1$@を開き、Kaeriを許可してから、このページにコードを貼り付けてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
