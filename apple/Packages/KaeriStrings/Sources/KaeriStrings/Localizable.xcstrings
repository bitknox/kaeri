    "start-failed" : {
      "comment" : "Message when Kaeri itself could not start. The reason comes from the system or the engine. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri konnte nicht gestartet werden. Beende Kaeri und öffne es erneut. %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri couldn't start. Quit and open it again. %1$@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri no pudo iniciarse. Ciérrala y ábrela de nuevo. %1$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri n’a pas pu démarrer. Quittez-le et ouvrez-le à nouveau. %1$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri tidak dapat dimulai. Keluar, lalu buka lagi. %1$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri non riesce ad avviarsi. Chiudi e riapri. %1$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriを起動できませんでした。一度終了してから、開き直してください。%1$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri nie mógł się uruchomić. Zamknij go i otwórz ponownie. %1$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri não conseguiu iniciar. Saia e abra de novo. %1$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить Kaeri. Закройте и откройте его снова. %1$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kunde inte starta. Avsluta och öppna den igen. %1$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri başlatılamadı. Çıkın ve yeniden açın. %1$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri không khởi động được. Hãy thoát rồi mở lại. %1$@"
          }
        }
      }
    },
    "start-failed-config" : {
      "comment" : "Message when Kaeri could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can. Argument 1: path (Text). Argument 2: problem (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ enthält eine Einstellung, die Kaeri nicht verwenden kann: %2$@. Korrigiere oder entferne sie und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has a setting Kaeri can't use: %2$@. Fix or remove it, then try again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene un ajuste que Kaeri no puede usar: %2$@. Corrígelo o quítalo, y luego inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ contient un réglage que Kaeri ne peut pas utiliser : %2$@. Corrigez-le ou supprimez-le, puis réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ memiliki pengaturan yang tidak dapat digunakan Kaeri: %2$@. Perbaiki atau hapus pengaturan itu, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ contiene un'impostazione che Kaeri non può usare: %2$@. Correggila o rimuovila, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に、Kaeriでは使用できない設定があります: %2$@。修正するか削除してから、もう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zawiera ustawienie, którego Kaeri nie może użyć: %2$@. Popraw je lub usuń, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tem uma configuração que o Kaeri não consegue usar: %2$@. Corrija ou remova, depois tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %1$@ есть настройка, которую Kaeri не может использовать: %2$@. Исправьте или удалите её и попробуйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ har en inställning som Kaeri inte kan använda: %2$@. Rätta till den eller ta bort den och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapılandırma dosyası (%1$@) Kaeri için kullanılamayan bir ayar içeriyor: %2$@. Ayarı düzeltin ya da kaldırın, sonra yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ có một cài đặt mà Kaeri không dùng được: %2$@. Hãy sửa hoặc xóa cài đặt đó, rồi thử lại."
          }
        }
      }
    },
    "start-failed-database" : {
      "comment" : "Message when Kaeri could not start because its database could not be opened. The path is the database file, the reason comes from the system. Argument 1: path (Text). Argument 2: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri konnte die Datenbank unter %1$@ nicht öffnen. Ist ein anderes Kaeri in diesem Ordner geöffnet, beende es und versuche es erneut. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri couldn't open its database at %1$@. If another Kaeri app is open on this folder, quit it and try again. %2$@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri no pudo abrir su base de datos en %1$@. Si otra app de Kaeri está abierta en esta carpeta, ciérrala e inténtalo de nuevo. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri n’a pas pu ouvrir sa base de données à %1$@. Si une autre application Kaeri est ouverte dans ce dossier, quittez-la, puis réessayez. %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri tidak dapat membuka basis datanya di %1$@. Jika aplikasi Kaeri lain sedang terbuka di folder ini, keluar dari aplikasi itu, lalu coba lagi. %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri non riesce ad aprire il suo database in %1$@. Se un'altra app Kaeri è aperta in questa cartella, chiudila e riprova. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriは%1$@のデータベースを開けませんでした。同じフォルダで別のKaeriアプリが開いている場合は、終了してからもう一度お試しください。%2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri nie mógł otworzyć bazy danych w: %1$@. Jeśli w tym folderze jest otwarta inna aplikacja Kaeri, zamknij ją i spróbuj ponownie. %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri não conseguiu abrir o banco de dados em %1$@. Se outro Kaeri estiver aberto nesta pasta, feche-o e tente de novo. %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть базу данных %1$@. Если в этой папке открыто другое приложение Kaeri, закройте его и попробуйте снова. %2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kunde inte öppna sin databas på %1$@. Om en annan app från Kaeri är öppen i den här mappen avslutar du den och försöker igen. %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri veritabanı dosyasını açamadı (%1$@). Bu klasörde başka bir Kaeri uygulaması açıksa onu kapatıp yeniden deneyin. %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri không mở được cơ sở dữ liệu tại %1$@. Nếu có ứng dụng Kaeri khác đang mở thư mục này, hãy thoát ứng dụng đó rồi thử lại. %2$@"
          }
        }
      }
    },
    "start-failed-folder" : {
      "comment" : "Message when Kaeri could not start because a folder could not be made. The path is the folder, the reason comes from the system. Argument 1: path (Text). Argument 2: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri konnte den Ordner %1$@ nicht anlegen. Prüfe, ob die Festplatte genug Platz hat und der Ordner beschreibbar ist, und versuche es dann erneut. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri couldn't create the folder %1$@. Check that the disk has room and the folder can be written to, then try again. %2$@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri no pudo crear la carpeta %1$@. Revisa que el disco tenga espacio y que se pueda escribir en la carpeta, y luego inténtalo de nuevo. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri n’a pas pu créer le dossier %1$@. Vérifiez que le disque a de la place et que le dossier est accessible en écriture, puis réessayez. %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri tidak dapat membuat folder %1$@. Pastikan disk masih punya ruang dan folder itu dapat ditulisi, lalu coba lagi. %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri non riesce a creare la cartella %1$@. Controlla che il disco abbia spazio e che la cartella sia scrivibile, poi riprova. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriはフォルダ %1$@を作成できませんでした。ディスクに空きがあり、フォルダに書き込めることを確認してから、もう一度お試しください。%2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri nie mógł utworzyć folderu %1$@. Sprawdź, czy na dysku jest miejsce i czy do folderu można zapisywać, a potem spróbuj ponownie. %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri não conseguiu criar a pasta %1$@. Verifique se o disco tem espaço e se é possível gravar nela, e tente de novo. %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось создать папку %1$@. Проверьте, есть ли место на диске и можно ли писать в эту папку, и попробуйте снова. %2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kunde inte skapa mappen %1$@. Kontrollera att disken har plats och att mappen går att skriva i, och försök igen. %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri %1$@ klasörünü oluşturamadı. Diskte yer olduğunu ve klasöre yazılabildiğini denetleyin, sonra yeniden deneyin. %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri không tạo được thư mục %1$@. Hãy kiểm tra xem ổ đĩa còn chỗ trống và thư mục có ghi được không, rồi thử lại. %2$@"
          }
        }
      }
    },
    "start-failed-network" : {
      "comment" : "Message when Kaeri could not start its network connection from the network settings. Argument 1: reason (Text).",
