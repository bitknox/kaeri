    "onboarding-books-line" : {
      "comment" : "Line under the title of the books page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri bringt keine Bücher mit. Füge hinzu, was du schon hast, oder tritt mit einer Einladung des Eigentümers einem Plugin-Store bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri comes with no books. Add what you already have, or join a plugin store with an invite from its owner."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri no incluye libros. Agrega los que ya tienes o únete a una tienda de complementos con una invitación de su propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri est livré sans livres. Ajoutez ce que vous avez déjà, ou rejoignez une boutique de plugins avec une invitation de son propriétaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri tidak menyertakan buku. Tambahkan yang sudah Anda punya, atau ikuti toko plugin dengan undangan dari pemiliknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri non include libri. Aggiungi quelli che hai già, oppure unisciti a un negozio di plugin con un invito del suo proprietario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriには本が付属していません。お持ちの本を追加するか、管理者から受け取った招待でプラグインストアに参加してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri nie zawiera żadnych książek. Dodaj to, co już masz, albo skorzystaj z zaproszenia od właściciela, który prowadzi sklep z wtyczkami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri não traz livros. Adicione o que você já tem ou entre em uma loja de plugins com um convite do dono."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri не содержит книг. Добавьте то, что у вас уже есть, или вступите в магазин плагинов по приглашению его владельца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri levereras utan böcker. Lägg till det du redan har, eller gå med i en tilläggsbutik med en inbjudan från dess ägare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kitapsız gelir. Elinizdekileri ekleyin ya da sahibinin davetiyle bir eklenti mağazasına katılın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri không đi kèm sách nào. Hãy thêm những gì bạn đã có, hoặc tham gia một cửa hàng plugin bằng lời mời từ chủ sở hữu."
          }
        }
      }
    },
    "onboarding-books-plugin-line" : {
      "comment" : "Line under the invite field: whose code a plugin is.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins führen Code von Leuten aus, denen du vertraust. Tritt nur Plugin-Stores bei, deren Eigentümer du kennst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins run code from people you trust. Only join plugin stores whose owner you know."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Complementos ejecutan código de personas en las que confías. Únete solo a tiendas de complementos cuyo propietario conozcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plugins exécutent du code de personnes en qui vous avez confiance. Ne rejoignez que des boutiques de plugins dont vous connaissez le propriétaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin-plugin menjalankan kode dari orang yang Anda percaya. Ikuti hanya toko-toko plugin yang pemiliknya Anda kenal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I plugin eseguono codice di persone di cui ti fidi. Unisciti solo a negozi di plugin il cui proprietario conosci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインは信頼できる人のコードを実行します。管理者を知っているプラグインストアにだけ参加してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczki uruchamiają kod od osób, którym ufasz. Wybieraj tylko te sklepy z wtyczkami, których właściciela znasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os plugins executam código de pessoas em quem você confia. Só entre em lojas de plugins cujo dono você conheça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагины запускают код людей, которым вы доверяете. Вступайте только в магазины плагинов, владельцев которых знаете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillägg kör kod från personer du litar på. Gå bara med i tilläggsbutiker vars ägare du känner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentiler, güvendiğiniz kişilerin kodunu çalıştırır. Yalnızca sahibini tanıdığınız eklenti mağazalarına katılın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các plugin chạy mã của những người bạn tin tưởng. Chỉ tham gia các cửa hàng plugin có chủ sở hữu mà bạn biết."
          }
        }
      }
    },
