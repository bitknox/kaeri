          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est installé, mais il a été conçu pour une version plus ancienne de Kaeri et doit être mis à jour. Demandez une nouvelle version à son auteur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ terpasang, tetapi dibuat untuk Kaeri versi lama dan perlu diperbarui. Minta pembuatnya untuk build baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installato %1$@, ma è stato creato per una versione precedente di Kaeri e va aggiornato. Chiedi all'autore una nuova versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@をインストールしましたが、Kaeriの古いバージョン向けに作られているため、更新が必要です。作者に新しいビルドを依頼してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstalowano %1$@, ale ta wtyczka powstała dla starszej wersji Kaeri i wymaga aktualizacji. Poproś autora o nową wersję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
