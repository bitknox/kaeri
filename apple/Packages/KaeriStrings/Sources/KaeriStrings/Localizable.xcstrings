    "servers-sign-out-line" : {
      "comment" : "Line under it: what signing out does.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Abmelden endet die Sitzung auf dem Server für dieses Gerät. Der Server und deine Downloads bleiben, wie sie sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing out ends this device's session on the server. The server and your downloads stay as they are."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar sesión desconecta este dispositivo del servidor. El servidor y tus descargas quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déconnecter met fin à la session de cet appareil sur le serveur. Le serveur et vos téléchargements restent tels quels."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar mengakhiri sesi perangkat ini di server. Server dan unduhan Anda tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnettersi chiude la sessione di questo dispositivo sul server. Il server e i tuoi download restano come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトすると、このデバイスのサーバー上のセッションが終了します。サーバーとダウンロードはそのまま残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wylogowaniu to urządzenie traci sesję na serwerze. Serwer i twoje pobrane odcinki zostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair encerra a sessão deste dispositivo no servidor. O servidor e seus downloads continuam como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход завершает сеанс, который это устройство открыло на сервере. Сам сервер и ваши загрузки остаются как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utloggning avslutar den här enhetens session på servern. Servern och dina nedladdningar förblir som de är."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumu kapatmak, bu cihazın sunucudaki oturumunu sonlandırır. Sunucu ve indirmeleriniz olduğu gibi kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng xuất sẽ kết thúc phiên của thiết bị này trên máy chủ. Máy chủ và các tập đã tải vẫn giữ nguyên."
          }
        }
      }
    },
    "servers-token-note" : {
      "comment" : "Line under the sign-in fields. The store is where the token is kept, such as Credential Manager. Argument 1: store (Text).",
