          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere %1$@ o %2$@. Riprova quando sono entrambi online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@または%2$@に接続できません。両方がオンラインのときにもう一度お試しください。"
