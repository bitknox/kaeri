    "stores-join-installs-nothing" : {
      "comment" : "Line: joining installs nothing.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beitreten installiert nichts. Du wählst aus, welche Plugins du installierst, und jedes fragt vorher nach den Hosts, die es kontaktiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joining installs nothing. You choose which plugins to install, and each one asks for the hosts it contacts."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unirse no instala nada. Tú eliges qué complementos instalar, y cada uno pide confirmación de los hosts a los que se conecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoindre n'installe rien. Vous choisissez quels plugins installer, et chacun demande les serveurs qu'il contacte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergabung tidak memasang apa pun. Anda memilih plugin-plugin yang ingin dipasang, dan setiap plugin menampilkan host yang dihubunginya sebelum dipasang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unirsi non installa nulla. Scegli tu quali plugin installare, e ognuno chiede gli host che contatta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加しても、何もインストールされません。インストールするプラグインは、ご自身で選べます。それぞれ、接続するホストの確認を求めます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodanie nie instaluje niczego. Sam wybierasz, które wtyczki zainstalować, a każda pyta o hosty, z którymi się łączy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar não instala nada. Você escolhe quais plugins instalar, e cada um pede os endereços que contata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение ничего не устанавливает. Вы сами выбираете, какие плагины установить, и каждый показывает серверы, с которыми связывается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att gå med installerar inget. Du väljer vilka tillägg som ska installeras, och varje tillägg frågar efter de värdar den kontaktar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katılmak hiçbir şey yüklemez. Hangi eklentiler yükleyeceğinizi siz seçersiniz ve her biri bağlanacağı sunucuları gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tham gia không cài đặt gì cả. Bạn chọn các plugin để cài, và mỗi thứ sẽ yêu cầu xác nhận các máy chủ mà nó kết nối tới."
          }
        }
      }
    },
