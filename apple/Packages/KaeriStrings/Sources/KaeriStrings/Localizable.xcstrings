          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Канал работает, только пока Kaeri открыт на этом устройстве (%1$@). Прогресс на этих ридерах остаётся на них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flödet körs bara medan Kaeri är öppet på den här %1$@. Förlopp på de e-läsarna stannar där."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akış yalnızca Kaeri bu %1$@ üzerinde açıkken çalışır. O e-okuyuculardaki ilerleme orada kalır."
