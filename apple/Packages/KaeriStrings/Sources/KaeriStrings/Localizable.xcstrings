    "servers-cert-body" : {
      "comment" : "Body of that step. The fingerprint is shown under it. Argument 1: host (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verwendet ein Zertifikat, dem dieses Gerät nicht vertraut. Das ist bei einem Server zu Hause normal. Erlaube es nur, wenn dieser Fingerabdruck mit dem übereinstimmt, den dein Server anzeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ uses a certificate this device doesn't trust. That's normal for a server at home. Allow it only if this fingerprint matches the one your server shows."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ usa un certificado en el que este dispositivo no confía. Es normal en un servidor casero. Permítelo solo si esta huella coincide con la que muestra tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utilise un certificat auquel cet appareil ne fait pas confiance. C’est normal pour un serveur à la maison. N’autorisez-le que si cette empreinte correspond à celle que montre votre serveur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ memakai sertifikat yang tidak dipercaya perangkat ini. Itu wajar untuk server di rumah. Izinkan hanya jika sidik jari ini sama dengan yang ditampilkan server Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ usa un certificato di cui questo dispositivo non si fida. È normale per un server di casa. Consentilo solo se questa impronta coincide con quella mostrata dal tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は、このデバイスが信頼していない証明書を使っています。自宅のサーバーでは普通のことです。サーバーに表示されるフィンガープリントと一致する場合だけ許可してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ używa certyfikatu, któremu to urządzenie nie ufa. To normalne w przypadku serwera w domu. Zezwól tylko wtedy, gdy ten odcisk zgadza się z tym, który pokazuje twój serwer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ usa um certificado em que este dispositivo não confia. Isso é normal para um servidor em casa. Permita só se esta impressão digital for igual à que o seu servidor mostra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
