    "settings-notify-explain-on" : {
      "comment" : "Under the notification preview while New episodes is on. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst eine Benachrichtigung, wenn eine Folge einer Serie aus deiner Liste „Wird geschaut“ erscheint, zu der Zeit, die %1$@ angibt. Die eigene Einstellung einer Serie hat Vorrang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You get one notification when an episode of a show in your Watching list comes out, at the time %1$@ lists. A show's own setting comes first."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibes una notificación cuando sale un episodio de una serie de tu lista Viendo, a la hora que indica %1$@. El ajuste propio de cada serie tiene prioridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous recevez une notification quand un épisode d’une série de votre liste En cours sort, à l’heure indiquée par %1$@. Le réglage propre à une série passe avant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda mendapat satu pemberitahuan saat episode dari tayangan dalam daftar Menonton Anda keluar, pada jam yang tercantum di %1$@. Pengaturan tayangan itu sendiri didahulukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica quando esce un episodio di una serie nella lista delle serie che guardi, all'orario indicato da %1$@. Prevale l'impostazione della singola serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視聴中」リストにある作品のエピソードが公開されると、%1$@に載っている時刻に1件通知が届きます。作品ごとの設定が優先されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostajesz jedno powiadomienie, gdy wyjdzie odcinek tytułu, który oglądasz, o godzinie podanej przez %1$@. Ustawienie danego tytułu ma pierwszeństwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você recebe uma notificação quando sai um episódio de uma série da sua lista Assistindo, no horário informado por %1$@. A configuração própria de cada série vem primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы получаете одно уведомление, когда выходит эпизод тайтла из списка «Смотрю», в то время, которое указывает %1$@. Настройка самого тайтла важнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en notis när ett avsnitt av en serie i listan Tittar på kommer ut, vid den tid %1$@ anger. Seriens egen inställning går före."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleniyor listenizdeki bir dizinin bölümü çıktığında, %1$@ üzerinde verilen saatte tek bildirim alırsınız. Dizinin kendi ayarı önce gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn nhận một thông báo khi một tập của tựa trong danh sách Đang xem ra mắt, vào giờ %1$@ ghi. Cài đặt riêng của tựa được ưu tiên."
          }
        }
      }
    },
