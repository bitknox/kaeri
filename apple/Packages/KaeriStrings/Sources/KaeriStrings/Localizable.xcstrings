    "settings-trailers-note-apple" : {
      "comment" : "Note under the Play trailers setting: what the trailers are and when they do not play.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trailer laufen stumm über YouTube, das deine IP-Adresse sieht. Sie spielen nicht im Modus für geringe Datenmenge, bei aktivierter Option „Bewegung reduzieren“ oder im Energiesparmodus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trailers play muted from YouTube, which sees your IP address. They don't play in Low Data Mode, with Reduce Motion on or in Low Power Mode."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tráilers se reproducen sin sonido desde YouTube, que ve tu dirección IP. No se reproducen en Modo de datos bajos, con Reducir movimiento activado ni en Modo de bajo consumo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bandes-annonces sont lues en sourdine depuis YouTube, qui voit votre adresse IP. Elles ne se lisent pas en mode Données réduites, avec Réduire les animations activé, ni en mode Faible consommation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trailer diputar tanpa suara dari YouTube, yang dapat melihat alamat IP Anda. Trailer tidak diputar dalam Mode Data Rendah, saat Kurangi Gerakan aktif, atau dalam Mode Daya Rendah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I trailer vengono riprodotti senza audio da YouTube, che vede il tuo indirizzo IP. Non partono con la Modalità dati ridotti, con Riduci movimento attivo o in Modalità risparmio energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予告編はYouTubeからミュートで再生され、YouTubeにIPアドレスが送られます。低データモード、「視差効果を減らす」の設定、低電力モードでは再生されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiastuny są odtwarzane bez dźwięku z YouTube, który widzi twój adres IP. Nie działają w trybie niskiej transmisji danych, przy włączonym ograniczeniu ruchu ani w trybie niskiego poboru energii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os trailers tocam sem som pelo YouTube, que vê seu endereço IP. Eles não tocam no Modo de Dados Baixos, com Reduzir movimento ativado ou no Modo de Baixo Consumo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трейлеры без звука идут с YouTube, который видит ваш IP-адрес. Не воспроизводятся в режиме низкого объёма данных, при включённом уменьшении движения и в режиме энергосбережения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trailers spelas upp utan ljud från YouTube, som ser din IP-adress. De spelas inte upp i läget Lite data, med Minska rörelse på eller i strömsparläge."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragmanlar YouTube'dan sessiz oynatılır. YouTube IP adresinizi görür. Düşük Veri Modu'nda, Hareketi Azalt açıkken veya Düşük Güç Modu'nda oynatılmazlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trailer phát không tiếng từ YouTube, nơi sẽ thấy địa chỉ IP của bạn. Trailer không phát trong Chế độ dữ liệu thấp, khi bật Giảm chuyển động hoặc ở Chế độ tiết kiệm pin."
          }
        }
      }
    },
