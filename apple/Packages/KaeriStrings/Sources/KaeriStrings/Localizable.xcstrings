    "store-admin-open-failed" : {
      "comment" : "Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Browser ließ sich nicht öffnen (%1$@). Auf dem Rechner des Plugin-Stores führe „kaeri store admin“ aus, um einen Link auszugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't open a browser (%1$@). On the plugin store's machine, run \"kaeri store admin\" to print a link."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir el navegador (%1$@). En el equipo de la tienda de complementos, ejecuta \"kaeri store admin\" para imprimir un enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir un navigateur (%1$@). Sur la machine de la boutique de plugins, lancez « kaeri store admin » pour afficher un lien."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa membuka peramban (%1$@). Di mesin toko plugin, jalankan \"kaeri store admin\" untuk mencetak tautan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire il browser (%1$@). Sul computer del negozio di plugin, esegui \"kaeri store admin\" per stampare un link."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザを開けませんでした（%1$@）。プラグインストアのマシンで「kaeri store admin」を実行すると、リンクが表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się otworzyć przeglądarki (%1$@). Na komputerze, na którym działa sklep z wtyczkami, uruchom „kaeri store admin”, aby wydrukować link."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir o navegador (%1$@). Na máquina da loja de plugins, rode \"kaeri store admin\" para imprimir um link."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть браузер (%1$@). Чтобы получить ссылку, выполните на компьютере, где работает магазин плагинов, команду «kaeri store admin»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att öppna en webbläsare (%1$@). På datorn där tilläggsbutik körs kör du \"kaeri store admin\" för att skriva ut en länk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcı açılamadı (%1$@). Bağlantı yazdırmak için eklenti mağazasının bulunduğu makinede \"kaeri store admin\" komutunu çalıştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không mở được trình duyệt (%1$@). Trên máy của cửa hàng plugin, hãy chạy \"kaeri store admin\" để in liên kết."
          }
        }
      }
