    "report-crash-off" : {
      "comment" : "Line that replaces the crash rows while saving crash reports is off.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absturzberichte sind aus, daher ist keiner enthalten. Du kannst sie unter Einstellungen, Über einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
