    "cause-no-connection" : {
      "comment" : "Reason: the play waited two minutes for a connection and the device stayed offline. Shown in a toast and on the failure screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Verbindung. Versuche es erneut, wenn du wieder online bist."
