            "value" : "Sie funktionieren sofort nicht mehr mit %1$@. Plugins, die bereits auf ihnen installiert sind, bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They stop working with %1$@ at once. Plugins already installed on them stay."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejan de funcionar con %1$@ de inmediato. Los complementos ya instalados en ellos se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils cessent de fonctionner avec %1$@ immédiatement. Les plugins déjà installés sur eux restent en place."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereka langsung berhenti berfungsi dengan %1$@. Plugin-plugin yang sudah terpasang di perangkat itu tidak ikut dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
