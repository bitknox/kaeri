        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré sur cet appareil seulement. AniSkip accepte les %1$@ jusqu’à %2$@ dans un épisode de cette durée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya disimpan di perangkat ini. AniSkip menerima %1$@ hingga %2$@ pada episode sepanjang ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato solo su questo dispositivo. AniSkip accetta %1$@ fino a %2$@ in un episodio così lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスにのみ保存しました。このエピソードの長さでは、AniSkipが受け付ける%1$@は最長%2$@です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano tylko na tym urządzeniu. W tak długim odcinku AniSkip przyjmuje do %2$@: %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo só neste dispositivo. O AniSkip aceita %1$@ de até %2$@ num episódio deste tamanho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено только на этом устройстве. AniSkip принимает %1$@ длиной до %2$@ для эпизода такой продолжительности."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparat bara på den här enheten. AniSkip tar emot %1$@ på upp till %2$@ i ett avsnitt så här långt."
          }
