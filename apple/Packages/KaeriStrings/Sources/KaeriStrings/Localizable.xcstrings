          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установлен %1$@, но он собран для старой версии Kaeri и требует обновления. Попросите автора о новой сборке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
