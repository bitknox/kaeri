    "report-privacy" : {
      "comment" : "Line at the foot of the Report a bug sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts verlässt dieses Gerät, bis du den Bericht auf GitHub öffnest. Titel, Adressen, Dateipfade und Namen werden entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing leaves this device until you open the report on GitHub. Titles, addresses, file paths and names are removed."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada sale de este dispositivo hasta que abras el reporte en GitHub. Se quitan los títulos, direcciones, rutas de archivos y nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne quitte cet appareil avant que vous n’ouvriez le rapport sur GitHub. Les titres, adresses, chemins de fichiers et noms sont supprimés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang keluar dari perangkat ini sampai Anda membuka laporan di GitHub. Judul, alamat, jalur berkas, dan nama dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla lascia questo dispositivo finché non apri la segnalazione su GitHub. Titoli, indirizzi, percorsi dei file e nomi vengono rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubでレポートを開くまで、このデバイスから何も送信されません。タイトル、アドレス、ファイルパス、名前は除去されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopóki nie otworzysz zgłoszenia na GitHubie, nic nie wychodzi poza to urządzenie. Tytuły, adresy, ścieżki plików i nazwy są usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada sai deste dispositivo até você abrir o relatório no GitHub. Títulos, endereços, caminhos de arquivos e nomes são removidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
