      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Schlüssel funktioniert nicht mehr, und deine Geräte wechseln beim nächsten Abgleich zum neuen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old key stops working, and your devices switch to the new one the next time they sync."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave anterior deja de funcionar, y tus dispositivos cambian a la nueva la próxima vez que se sincronicen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ancienne clé cesse de fonctionner, et vos appareils passent à la nouvelle à leur prochaine synchronisation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci lama berhenti berlaku, dan perangkat Anda beralih ke yang baru pada sinkronisasi selanjutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vecchia chiave smette di funzionare e i tuoi dispositivi passano alla nuova alla prossima sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いキーは使えなくなり、デバイスは次回の同期で新しいキーに切り替わります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stary klucz przestaje działać, a twoje urządzenia przełączą się na nowy przy następnej synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave antiga deixa de funcionar, e seus dispositivos passam para a nova na próxima vez que sincronizarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старый ключ перестанет работать, а ваши устройства перейдут на новый при следующей синхронизации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gamla nyckeln slutar fungera, och dina enheter byter till den nya vid sin kommande synk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski anahtar çalışmaz olur ve cihazlar bir sonraki eşitlemede yenisine geçer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa cũ sẽ ngừng hoạt động, và các các thiết bị của bạn chuyển sang khóa mới ở lần đồng bộ kế tiếp."
          }
        }
      }
    },
