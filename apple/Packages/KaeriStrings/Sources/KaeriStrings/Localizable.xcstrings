    "cloud-close-carries-on" : {
      "comment" : "Windows and Linux dialog line under Connecting or Setting up the folder: the dialog's Close button leaves the work running.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dies schließen. Kaeri arbeitet im Hintergrund und öffnet den nächsten Schritt von selbst, sobald er bereit ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can close this. Kaeri carries on, and opens the next step by itself when it's ready."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cerrar esto. Kaeri continúa por su cuenta y abre el paso que sigue cuando esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez fermer cette fenêtre. Kaeri poursuit et ouvre l'étape suivante tout seul quand elle est prête."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh menutup ini. Kaeri terus berjalan, dan membuka langkah selanjutnya sendiri saat siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi chiuderla. Kaeri prosegue da solo e apre il passaggio successivo quando è pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウィンドウは閉じて構いません。Kaeriは処理を続け、準備ができたら次のステップを自動で開きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz to zamknąć. Kaeri kończy pracę w tle i sam otworzy kolejny krok, gdy będzie gotowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode fechar isto. O Kaeri segue trabalhando e abre a próxima etapa sozinho quando estiver pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это окно можно закрыть. Kaeri продолжит работу и сам откроет следующий шаг, когда всё будет готово."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan stänga det här. Kaeri fortsätter och öppnar följande steg av sig själv när det är klart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu kapatabilirsiniz. Kaeri çalışmayı sürdürür ve hazır olunca sonraki adımı kendiliğinden açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể đóng cửa sổ này. Kaeri vẫn chạy tiếp và tự mở bước kế tiếp khi sẵn sàng."
          }
        }
      }
    },
    "cloud-connect" : {
      "comment" : "Button.",
      "extractionState" : "manual",
