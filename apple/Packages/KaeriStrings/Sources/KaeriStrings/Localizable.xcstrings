    "onboarding-lists-line-both" : {
      "comment" : "Line on the AniList page after Both. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri hält dein Lesen und Schauen mit %1$@ im Gleichschritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri keeps your reading and watching in step with %1$@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri mantiene lo que lees y ves al día con %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri synchronise ce que vous lisez et regardez avec %1$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri menyelaraskan bacaan dan tontonan Anda dengan %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri tiene allineato ciò che leggi e guardi con %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriは読書と視聴の記録を%1$@と揃えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri synchronizuje twoje czytanie i oglądanie z: %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri mantém o que você lê e assiste em sincronia com %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri синхронизирует ваши чтение и просмотр с %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri håller ditt läsande och tittande i synk med %1$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri, okuduklarınızı ve izlediklerinizi %1$@ ile eşit tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri giữ việc đọc và xem của bạn đồng bộ với %1$@."
          }
        }
      }
    },
