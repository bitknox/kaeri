          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles param de funcionar com %1$@ imediatamente. Os plugins já instalados neles continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они сразу перестают работать с %1$@. Плагины, уже установленные на них, остаются."
          }
