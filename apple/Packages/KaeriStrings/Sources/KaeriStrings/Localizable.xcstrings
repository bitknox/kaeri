    "onboarding-both-line" : {
      "comment" : "Line under the title of that page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri bringt keine Serien oder Bücher mit. Füge hinzu, was du schon hast, oder tritt mit einer Einladung des Eigentümers einem Plugin-Store bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri comes with no shows or books. Add what you already have, or join a plugin store with an invite from its owner."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri no incluye series ni libros. Agrega los que ya tienes o únete a una tienda de complementos con una invitación de su propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri est livré sans séries ni livres. Ajoutez ce que vous avez déjà, ou rejoignez une boutique de plugins avec une invitation de son propriétaire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri tidak menyertakan serial atau buku. Tambahkan yang sudah Anda punya, atau ikuti toko plugin dengan undangan dari pemiliknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri non include serie né libri. Aggiungi quelli che hai già, oppure unisciti a un negozio di plugin con un invito del suo proprietario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriには作品も本も付属していません。お持ちのものを追加するか、管理者から受け取った招待でプラグインストアに参加してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri nie zawiera żadnych seriali ani książek. Dodaj to, co już masz, albo skorzystaj z zaproszenia od właściciela, który prowadzi sklep z wtyczkami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kaeri não traz séries nem livros. Adicione o que você já tem ou entre em uma loja de plugins com um convite do dono."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri не содержит ни сериалов, ни книг. Добавьте то, что у вас уже есть, или вступите в магазин плагинов по приглашению его владельца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri levereras utan serier eller böcker. Lägg till det du redan har, eller gå med i en tilläggsbutik med en inbjudan från dess ägare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri dizisiz ve kitapsız gelir. Elinizdekileri ekleyin ya da sahibinin davetiyle bir eklenti mağazasına katılın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri không đi kèm phim hay sách nào. Hãy thêm những gì bạn đã có, hoặc tham gia một cửa hàng plugin bằng lời mời từ chủ sở hữu."
          }
        }
      }
    },
