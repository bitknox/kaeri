    "notice-anilist-client-missing" : {
      "comment" : "Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated. Argument 1: client (Text). Argument 2: secret (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList braucht eine Client-ID und ein Geheimnis. Setze %1$@ und %2$@ in der Konfigurationsdatei und melde dich dann erneut an. Um die Anmeldeadresse zu erhalten, führe kaeri --login-url aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList needs a client id and secret. Set %1$@ and %2$@ in the config file, then sign in again. To get the sign-in address, run kaeri --login-url."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList necesita un id de cliente y un secreto. Pon %1$@ y %2$@ en el archivo de configuración, y luego inicia sesión otra vez. Para obtener la dirección de inicio de sesión, ejecuta kaeri --login-url."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList a besoin d'un identifiant et d'un secret de client. Renseignez %1$@ et %2$@ dans le fichier de configuration, puis reconnectez-vous. Pour obtenir l'adresse de connexion, lancez kaeri --login-url."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList memerlukan ID dan rahasia klien. Atur %1$@ dan %2$@ dalam berkas konfigurasi, lalu masuk lagi. Untuk mendapatkan alamat masuk, jalankan kaeri --login-url."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList richiede un id client e un segreto. Imposta %1$@ e %2$@ nel file di configurazione, poi accedi di nuovo. Per ottenere l'indirizzo di accesso, esegui kaeri --login-url."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniListにはクライアントIDとシークレットが必要です。設定ファイルで%1$@と%2$@を設定してから、もう一度サインインしてください。サインイン用のアドレスは、kaeri --login-urlを実行すると表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList wymaga identyfikatora klienta i sekretu. Ustaw %1$@ i %2$@ w pliku konfiguracyjnym, a potem zaloguj się ponownie. Adres logowania podaje polecenie: kaeri --login-url."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AniList precisa de um ID de cliente e de um segredo. Defina %1$@ e %2$@ no arquivo de configuração e conecte de novo. Para obter o endereço de conexão, execute kaeri --login-url."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList требует идентификатор клиента и секрет. Задайте %1$@ и %2$@ в файле настроек, затем войдите снова. Чтобы получить адрес для входа, выполните kaeri --login-url."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList behöver ett klient-id och en hemlighet. Ange %1$@ och %2$@ i konfigurationsfilen och logga sedan in igen. För att få inloggningsadressen kör du kaeri --login-url."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList için istemci kimliği ve gizli anahtar gerekiyor. Yapılandırma dosyasında %1$@ ve %2$@ değerlerini ayarlayın, sonra yeniden oturum açın. Oturum açma adresini almak için kaeri --login-url komutunu çalıştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList cần client id và secret. Hãy đặt %1$@ và %2$@ trong tệp cấu hình, rồi đăng nhập lại. Để lấy địa chỉ đăng nhập, chạy kaeri --login-url."
          }
        }
      }
    },
    "notice-anilist-implicit-flow" : {
      "comment" : "Toast when AniList is set to a sign-in method only the Kaeri app can finish. The setting name is a key of the config file and is not translated. Argument 1: setting (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese AniList-Anmeldemethode funktioniert nur in der App Kaeri. Um hier anzumelden, setze %1$@ in der Konfigurationsdatei auf „loopback“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This AniList sign-in method works only in the Kaeri app. To sign in here, set %1$@ to \"loopback\" in the config file."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este método de inicio de sesión de AniList solo funciona en la app de Kaeri. Para iniciar sesión aquí, pon %1$@ en \"loopback\" en el archivo de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette méthode de connexion AniList ne fonctionne que dans l'application Kaeri. Pour vous connecter ici, mettez %1$@ à « loopback » dans le fichier de configuration."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metode masuk AniList ini hanya berfungsi di aplikasi Kaeri. Untuk masuk di sini, atur %1$@ ke \"loopback\" dalam berkas konfigurasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo metodo di accesso ad AniList funziona solo nell'app Kaeri. Per accedere qui, imposta %1$@ su \"loopback\" nel file di configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このAniListのサインイン方法は、Kaeriアプリでのみ使えます。ここでサインインするには、設定ファイルで%1$@を「loopback」にしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta metoda logowania AniList działa tylko w aplikacji Kaeri. Aby zalogować się tutaj, ustaw %1$@ na „loopback” w pliku konfiguracyjnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este método de conexão do AniList funciona só no app Kaeri. Para conectar aqui, defina %1$@ como \"loopback\" no arquivo de configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот способ входа в AniList работает только в приложении Kaeri. Чтобы войти здесь, задайте для %1$@ значение «loopback» в файле настроек."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här AniList-inloggningsmetoden fungerar bara i appen Kaeri. För att logga in här sätter du %1$@ till \"loopback\" i konfigurationsfilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu AniList oturum açma yöntemi yalnızca Kaeri uygulamasında çalışır. Burada oturum açmak için yapılandırma dosyasında %1$@ değerini \"loopback\" olarak ayarlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểu đăng nhập AniList này chỉ hoạt động trong ứng dụng Kaeri. Để đăng nhập ở đây, hãy đặt %1$@ thành \"loopback\" trong tệp cấu hình."
          }
        }
      }
    },
    "notice-anilist-limit" : {
