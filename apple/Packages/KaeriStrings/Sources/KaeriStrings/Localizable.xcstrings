    "party-leave-detail" : {
      "comment" : "Line under it. The room is a name. Argument 1: room (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Kaeri schließt, verlässt du %1$@. Alle anderen machen ohne dich weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing Kaeri leaves %1$@. Everyone else carries on without you."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar Kaeri te saca de %1$@. Los demás siguen sin ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer Kaeri quitte %1$@. Les autres continuent sans vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menutup Kaeri akan membuat Anda keluar dari %1$@. Yang lain tetap melanjutkan tanpa Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudendo Kaeri esci da %1$@. Gli altri continuano senza di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeriを閉じると、%1$@から退出します。ほかの参加者は、あなた抜きで続けます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie Kaeri opuszcza pokój %1$@. Pozostali uczestnicy oglądają dalej bez tej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar o Kaeri tira você de %1$@. Os outros continuam sem você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытие Kaeri покинет %1$@. Остальные продолжат без вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att stänga Kaeri lämnar %1$@. Alla andra fortsätter utan dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri kapatılınca %1$@ odasından ayrılırsınız. Diğerleri sizsiz devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng Kaeri sẽ rời %1$@. Những người khác vẫn tiếp tục mà không có bạn."
          }
        }
      }
    },
