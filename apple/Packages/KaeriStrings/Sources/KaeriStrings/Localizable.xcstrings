          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez ce que vous regardez et lisez, depuis vos propres sources."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat yang Anda tonton dan baca, dari sumber-sumber Anda sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni traccia di ciò che guardi e leggi, dalle tue fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のソースで、視聴も読書も記録できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź to, co oglądasz i czytasz. Dostarczają to twoje źródła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o que você assiste e lê, a partir das suas próprias fontes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следите за тем, что смотрите и читаете. Источники вы добавляете сами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll koll på vad du tittar på och läser, från dina egna källor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi kaynaklarınızdan izlediklerinizi ve okuduklarınızı takip edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi những gì bạn xem và đọc, từ các nguồn của riêng bạn."
          }
        }
      }
    },
    "onboarding-welcome-note" : {
      "comment" : "Note under the welcome line.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Listen und dein Fortschritt bleiben auf deinen Geräte. Tracker und Quellen fügst du selbst hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lists and progress stay on your devices. Trackers and sources are yours to add."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus listas y tu progreso se quedan en tus dispositivos. Agregar servicios de seguimiento y fuentes depende de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos listes et votre progression restent sur vos appareils. Les Services de suivi et les sources sont à vous d'ajouter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar dan kemajuan Anda tetap ada di perangkat Anda. Anda sendiri yang menambahkan Pelacak-pelacak dan sumber-sumber."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue liste e i tuoi progressi restano sui tuoi dispositivi. Tracker e fonti sono tue da aggiungere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストと進捗はあなたのデバイスに残ります。連携サービスとソースは、ご自分で追加します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje listy i postęp zostają przy tobie. Trackery i źródła dodajesz sam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas listas e seu progresso ficam nos seus dispositivos. Serviços de acompanhamento e fontes ficam por sua conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши списки и прогресс остаются при вас. Трекеры и источники вы добавляете сами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina listor och ditt förlopp stannar på dina enheter. Trackers och källor lägger du till själv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listeleriniz ve ilerlemeniz cihazlarınızda kalır. Takip hizmetleri ve kaynaklar eklemek size kalmış."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh sách và tiến độ của bạn nằm trên các thiết bị của bạn. Bạn tự thêm các dịch vụ theo dõi và các nguồn."
          }
        }
      }
    },
