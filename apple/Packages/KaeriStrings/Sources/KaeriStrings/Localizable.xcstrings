    "stores-qr-instructions" : {
      "comment" : "Line beside the QR code on the TV.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den QR-Code mit deinem Telefon. Füge dann auf der Seite, die sich öffnet, den Einladungslink für einen Plugin-Store ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
