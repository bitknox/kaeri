    "reading-failed-webview" : {
      "comment" : "Why a novel could not open: the system's web view is too old. The version is its major version number, such as 80. Argument 1: version (Plain).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
