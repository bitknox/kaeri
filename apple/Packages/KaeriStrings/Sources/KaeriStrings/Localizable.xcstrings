    "shell-start-failed-body" : {
      "comment" : "Plain line under the title of the page shown when the engine could not start. The reason follows it, in the engine's words, for a bug report.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas hat verhindert, dass Kaeri öffnet. Versuch es noch einmal. Wenn es immer wieder passiert, sende einen Bericht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something stopped Kaeri from opening. Try again, and if it keeps happening, send a report."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo impidió que Kaeri se abriera. Inténtalo otra vez y, si sigue pasando, envía un reporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose a empêché Kaeri de s’ouvrir. Réessayez et, si cela continue, envoyez un rapport."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada yang menghalangi Kaeri dibuka. Coba lagi, dan jika terus terjadi, kirim laporan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa ha impedito l'apertura di Kaeri. Riprova e, se succede ancora, invia una segnalazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何らかの理由でKaeriを開けませんでした。もう一度お試しください。それでも同じ場合は、不具合を報告してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś uniemożliwiło otwarcie Kaeri. Spróbuj ponownie, a jeśli to się powtarza, wyślij zgłoszenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo impediu a Kaeri de abrir. Tente de novo e, se continuar acontecendo, envie um relatório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то помешало открыть Kaeri. Попробуйте ещё раз. Если это повторяется, отправьте отчёт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något hindrade Kaeri från att öppnas. Försök igen, och skicka en rapport om det fortsätter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaeri açılmasını bir şey engelledi. Yeniden deneyin. Sorun sürerse bir rapor gönderin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có gì đó đã chặn Kaeri mở. Hãy thử lại. Nếu lỗi vẫn tiếp diễn, hãy gửi báo cáo."
          }
        }
      }
    },
