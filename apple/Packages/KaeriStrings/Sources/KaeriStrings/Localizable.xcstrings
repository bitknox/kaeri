        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, diğer cihazlar cihazlarınızdan gelen geçmişi tutuyor. Eşitleme açılırken kaydettiğiniz anahtar onu açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đang giữ lịch sử từ các các thiết bị khác của bạn. Khóa bạn đã lưu khi bật đồng bộ sẽ mở được nó."
          }
        }
      }
    },
    "rkey-enter-note" : {
      "comment" : "Field note.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 Buchstaben und Ziffern in Vierergruppen. Leerzeichen und Groß- und Kleinschreibung spielen keine Rolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 letters and digits, in groups of four. Spaces and case don’t matter."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 letras y dígitos, en grupos de cuatro. Los espacios y las mayúsculas no importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 lettres et chiffres, par groupes de quatre. Les espaces et la casse n’ont pas d’importance."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 huruf dan angka, dalam kelompok empat. Spasi dan huruf besar kecil tidak berpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 lettere e cifre, in gruppi di quattro. Spazi e maiuscole non contano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英数字24文字を、4文字ずつに区切ったものです。スペースと大文字小文字は区別しません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 litery i cyfry w grupach po cztery. Spacje i wielkość liter nie mają znaczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 letras e dígitos, em grupos de quatro. Espaços e maiúsculas não importam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 буквы и цифры группами по четыре. Пробелы и регистр не важны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 bokstäver och siffror, i grupper om fyra. Mellanslag och versaler spelar ingen roll."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 harf ve rakam, dörderli gruplar halinde. Boşluk ve büyük küçük harf fark etmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 chữ cái và chữ số, chia thành các nhóm bốn. Khoảng trắng và chữ hoa, chữ thường đều không quan trọng."
          }
        }
      }
    },
