    "store-open-join-on" : {
      "comment" : "Toast after a store owner lets anyone with the store's link join.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Person mit dem Link des Plugin-Stores kann jetzt beitreten. Kopiere ihn von der Mitgliederseite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the plugin store's link can join now. Copy it from the members screen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera con el enlace de la tienda de complementos puede unirse ahora. Cópialo desde la pantalla de miembros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du lien de la boutique de plugins peut désormais la rejoindre. Copiez-le depuis l’écran des membres."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun yang memiliki tautan toko plugin ini bisa bergabung sekarang. Salin dari layar anggota."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora chiunque abbia il link del negozio di plugin può unirsi. Copialo dalla schermata dei membri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインストアのリンクを知っている人は、今から参加できます。メンバーの画面からリンクをコピーできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz dołączyć może każdy, kto ma link. Skopiuj go z ekranu członków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem tiver o link da loja de plugins pode entrar agora. Copie o link na tela de membros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "магазин плагинов: подключиться по ссылке теперь может любой. Скопируйте её на экране участников."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vem som helst med länken till tilläggsbutik kan gå med nu. Kopiera den från medlemssidan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eklenti mağazasının bağlantısına sahip herkes artık katılabilir. Bağlantıyı üye ekranından kopyalayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bất kỳ ai có liên kết của cửa hàng plugin giờ đều có thể tham gia. Sao chép liên kết từ màn hình thành viên."
          }
        }
      }
    },
