    "sync-device-removed" : {
      "comment" : "The error line under Sync on a device that another of the person's devices removed from sync. Joining again, with a code or the recovery key, or setting sync up again adds it as a new device.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät wurde auf einem anderen Gerät aus der Synchronisierung entfernt. Tritt erneut bei, um es zu synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device was removed from sync on another device. Join again to sync it."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo se quitó de la sincronización desde otro dispositivo. Vuelve a unirte para sincronizarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a été retiré de la synchronisation sur un autre appareil. Rejoignez-la de nouveau pour le synchroniser."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini dihapus dari sinkronisasi di perangkat lain. Gabung lagi untuk menyinkronkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo è stato rimosso dalla sincronizzazione da un altro dispositivo. Unisciti di nuovo per sincronizzarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは、別のデバイスで同期から削除されました。同期するには、もう一度参加してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne urządzenie usunęło to urządzenie z synchronizacji. Dołącz ponownie, aby je synchronizować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo foi removido da sincronização em outro dispositivo. Entre de novo para sincronizá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другое устройство удалило это устройство из синхронизации. Подключите его снова, чтобы синхронизировать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten togs bort från synk på en annan enhet. Gå med igen för att synka den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz başka bir cihaz üzerinden eşitlemeden çıkarıldı. Eşitlemek için yeniden katılın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này đã bị xóa khỏi đồng bộ trên một thiết bị khác. Hãy tham gia lại để đồng bộ."
          }
        }
      }
