    "profiles-picker-line" : {
      "comment" : "Title of the iPad and Mac launch picker's explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Profil. Dann: Weiter. Diese Frage kannst du in den Einstellungen unter Profile ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a profile to continue. You can turn this question off in Settings, Profiles."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un perfil para continuar. Puedes desactivar esta pregunta en Ajustes, Perfiles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un profil pour continuer. Vous pouvez désactiver cette question dans Réglages, Profils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih profil untuk lanjutkan. Pertanyaan ini bisa dimatikan di Pengaturan, Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un profilo per continua. Puoi disattivare questa domanda in Impostazioni, Profili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続けるには、プロファイルを選んでください。この確認は、設定の「プロファイル」でオフにできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz profil, aby przejść dalej. To pytanie możesz wyłączyć w Ustawieniach, w Profilach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um perfil para continuar. Você pode desativar esta pergunta em Configurações, Perfis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите профиль, чтобы продолжить. Этот вопрос можно отключить в настройках, в разделе «Профили»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en profil och fortsätt. Du kan stänga av den här frågan i Inställningar, Profiler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "devam için bir profil seçin. Bu soruyu Ayarlar'da, Profiller bölümünden kapatabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chọn một hồ sơ để tiếp tục. Bạn có thể tắt câu hỏi này trong Cài đặt, Hồ sơ."
          }
        }
      }
    },
    "profiles-shared-foot" : {
      "comment" : "Profiles page footer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen, Downloads und die Einstellungen dieses Gerät gelten für jedes Profil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources, downloads and this device’s settings are shared by every profile."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Fuentes, las descargas y los ajustes de este dispositivo los comparten todos los perfiles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources, les téléchargements et les réglages de cet appareil sont partagés par tous les profils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber-sumber, unduhan, dan pengaturan perangkat ini dipakai bersama oleh setiap profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonti, download e impostazioni di questo dispositivo sono condivisi da tutti i profili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソース、ダウンロード、このデバイスの設定は、すべてのプロファイルで共有されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym urządzeniu wszystkie profile mają wspólne: źródła, pobrane pliki i ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Fontes, os downloads e as configurações deste dispositivo são compartilhados por todos os perfis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве у всех профилей общие: источники, загрузки и настройки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Källor, nedladdningar och den här enhetens inställningar delas av alla profiler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynaklar, indirmeler ve bu cihaz cihazın ayarları her profilde ortaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nguồn, tệp tải xuống và cài đặt của thiết bị này được dùng chung cho mọi hồ sơ."
          }
        }
      }
    },
