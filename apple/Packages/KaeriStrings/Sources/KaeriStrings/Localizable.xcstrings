          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect è disattivato su questo server. Accedi con una password o attivalo nella dashboard di Jellyfin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーではQuick Connectがオフです。パスワードでサインインするか、Jellyfinの管理ダッシュボードでオンにしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
