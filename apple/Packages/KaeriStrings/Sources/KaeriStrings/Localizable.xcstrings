    "stores-empty-detail" : {
      "comment" : "Line under the empty title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin-Stores enthalten signierte Plugins und geben jedem Gerät ein eigenes Token. Tritt einem mit dem Einladungslink bei, den dir die betreibende Person schickt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin stores hold signed plugins and give each device its own token. Join one with the invite link its owner sends you."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiendas de complementos guardan complementos firmados y dan a cada dispositivo su propio token. Únete a una con el enlace de invitación que te envíe su propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutiques de plugins contiennent des plugins signés et donnent à chaque appareil son propre jeton. Rejoignez-en une avec le lien d’invitation que son propriétaire vous envoie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toko-toko plugin menyimpan plugin-plugin bertanda tangan dan memberi setiap perangkat tokennya sendiri. Bergabunglah dengan tautan undangan dari pemiliknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Negozi di plugin contengono plugin firmati e danno a ogni dispositivo il proprio token. Unisciti a uno con il link di invito che ti manda il suo proprietario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインストアは署名付きのプラグインを保管し、デバイスごとに専用のトークンを発行します。運営者から届いた招待リンクで参加できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sklepy z wtyczkami przechowują podpisane wtyczki i dają każdemu urządzeniu własny token. Dołącz do jednego linkiem z zaproszenia od jego właściciela."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lojas de plugins guardam plugins assinados e dão a cada dispositivo o seu próprio token. Entre em uma com o link de convite que o dono dela enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Магазины плагинов хранят подписанные плагины и выдают каждому устройству отдельный токен. Присоединитесь к одному по ссылке-приглашению от его владельца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilläggsbutiker innehåller signerade tillägg och ger varje enhet sin egen token. Gå med i en med inbjudningslänken som ägaren skickar till dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklenti mağazaları imzalı eklentiler tutar ve her cihaz için ayrı bir belirteç verir. Sahibinin gönderdiği davet bağlantısıyla birine katılın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cửa hàng plugin giữ các các plugin đã ký và cấp cho mỗi thiết bị một token riêng. Hãy tham gia bằng liên kết mời mà chủ của nó gửi cho bạn."
          }
        }
      }
    },
