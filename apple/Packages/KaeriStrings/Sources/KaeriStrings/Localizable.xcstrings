    "player-share-body" : {
      "comment" : "Body of the sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip ist eine gemeinsame Liste von Vor- und Abspännen, betrieben von eigenen Freiwilligen. Die Player anderer Leute überspringen die Zeiten, die du markierst, und die gefundenen, die du bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip is a shared list of openings and endings, run by its own volunteers. Other people's players skip the times you mark and the found times you confirm."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip es una lista compartida de aperturas y finales, mantenida por sus propios voluntarios. Los reproductores de otras personas omiten los tiempos que marcas y los tiempos encontrados que confirmas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip est une liste partagée d’intros et de génériques, tenue par ses propres bénévoles. Les lecteurs des autres passent les repères que vous marquez et ceux trouvés que vous confirmez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip adalah daftar pembukaan dan penutup bersama yang dikelola relawannya sendiri. Pemutar orang lain melewati waktu yang Anda tandai dan waktu temuan yang Anda konfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip è un elenco condiviso di aperture e chiusure, gestito da volontari. I player degli altri saltano i tempi che segni e quelli trovati che confermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkipは、ボランティアが運営する、オープニングとエンディングの共有リストです。あなたがマークした位置と、確認した検出済みの位置は、ほかの人のプレーヤーでもスキップされます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip to wspólna lista czołówek i zakończeń, prowadzona przez własnych wolontariuszy. Odtwarzacze innych osób pomijają czasy, które zaznaczysz, oraz znalezione czasy, które potwierdzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AniSkip é uma lista compartilhada de aberturas e encerramentos, mantida por seus próprios voluntários. Os players de outras pessoas pulam os tempos que você marca e os tempos encontrados que você confirma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip: общий список опенингов и эндингов, который ведут его волонтёры. Плееры других людей пропускают отмеченные вами моменты и подтверждённые найденные."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip är en delad lista över intron och outron, driven av egna frivilliga. Andra personers spelare hoppar över tiderna du markerar och de hittade tider du bekräftar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip, kendi gönüllüleri tarafından işletilen ortak bir açılış ve kapanış listesidir. Başkalarının oynatıcıları, sizin işaretlediğiniz zamanları ve onayladığınız bulunmuş zamanları atlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniSkip là danh sách chung về đoạn mở đầu và đoạn kết, do các tình nguyện viên của nó vận hành. Trình phát của người khác sẽ bỏ qua các mốc bạn đánh dấu và các mốc tìm thấy mà bạn xác nhận."
          }
        }
      }
    },
