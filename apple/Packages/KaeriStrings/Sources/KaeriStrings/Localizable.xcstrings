    "rkey-line" : {
      "comment" : "Sheet line.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre ihn sicher auf. Er stellt deinen Verlauf wieder her, wenn du jedes Gerät verlierst, und lässt ein neues Gerät aus deinem Cloud-Ordner beitreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this somewhere safe. It restores your history if you lose every device, and lets a new device join from your cloud folder."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdala en un lugar seguro. Restaura tu historial si pierdes cada dispositivo, y permite que un nuevo dispositivo se una desde tu carpeta en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez-la en lieu sûr. Elle restaure votre historique si vous perdez chaque appareil, et permet à un nouvel appareil de rejoindre depuis votre dossier cloud."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan di tempat aman. Kunci ini memulihkan riwayat Anda jika Anda kehilangan semua perangkat, dan membuat perangkat baru bisa bergabung dari folder cloud Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservala in un posto sicuro. Ripristina la cronologia se perdi ogni dispositivo e permette a un nuovo dispositivo di unirsi dalla tua cartella cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全な場所に保管してください。すべてのデバイスをなくしても履歴を復元でき、新しいデバイスがクラウドフォルダから参加するときにも使います。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj go w bezpiecznym miejscu. Przywraca historię, jeśli stracisz wszystkie urządzenia, i pozwala nowemu urządzeniu dołączyć z twojego folderu w chmurze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde em um lugar seguro. Ela restaura seu histórico se você perder cada dispositivo e deixa um novo dispositivo entrar pela sua pasta na nuvem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните его в надёжном месте. Он восстановит историю, если вы потеряете все устройства, и позволит новому устройству присоединиться из вашей облачной папки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förvara den säkert. Den återställer din historik om du förlorar alla dina enheter, och låter en ny enhet gå med från din molnmapp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu güvenli bir yerde saklayın. Tüm cihazlar kaybolursa geçmişinizi geri getirir ve yeni bir cihaz cihazın bulut klasörünüzden katılmasını sağlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cất ở nơi an toàn. Khóa khôi phục lịch sử của bạn nếu bạn mất hết mọi thiết bị, và cho phép một thiết bị mới tham gia từ thư mục đám mây của bạn."
          }
        }
      }
    },
