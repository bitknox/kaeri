    "together-start-line" : {
      "comment" : "Line under Start a party.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eröffne einen Raum, lade Freunde per Link oder Code ein und tippe dann bei dem, was ihr schauen wollt, auf Abspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a room and invite friends with a link or a code, then press Play on what you want to watch."
