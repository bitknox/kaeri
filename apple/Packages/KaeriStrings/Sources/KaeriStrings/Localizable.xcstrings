    "settings-reset-detail" : {
      "comment" : "Line under it. The old settings file is moved aside, not deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Einstellung geht auf ihren Standard zurück, auch der Torrent-Proxy. Dein Verlauf bleibt, und die alte Einstellungsdatei wird aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every setting goes back to its default, the torrent proxy included. Your watch history stays, and the old settings file is kept."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los ajustes vuelven a sus valores predeterminados, incluido el proxy de torrents. Tu historial se conserva y el archivo de ajustes anterior se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les réglages reviennent à leur valeur par défaut, proxy des torrents compris. Votre historique reste, et l’ancien fichier de réglages est conservé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua pengaturan kembali ke bawaan, termasuk proxy torrent. Riwayat tontonan tetap ada, dan berkas pengaturan lama disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni impostazione torna al valore predefinito, proxy dei torrent compreso. La cronologia resta e il vecchio file delle impostazioni viene conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントのプロキシを含め、すべての設定が初期値に戻ります。視聴履歴は残り、古い設定ファイルも保管されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde ustawienie wraca do wartości domyślnej, razem z proxy torrentów. Historia oglądania zostaje, a stary plik ustawień jest zachowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as configurações voltam ao padrão, inclusive o proxy dos torrents. Seu histórico é mantido e o arquivo de configurações antigo é guardado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все настройки вернутся к значениям по умолчанию, включая прокси для торрентов. История просмотров сохранится, а старый файл настроек останется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla inställningar går tillbaka till standard, torrentproxyn inräknad. Din visningshistorik finns kvar, och den gamla inställningsfilen sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ayar varsayılanına döner, torrent proxy'si dahil. İzleme geçmişiniz kalır ve eski ayar dosyası saklanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi cài đặt trở về mặc định, kể cả proxy cho torrent. Lịch sử xem của bạn được giữ, và tệp cài đặt cũ cũng được giữ lại."
          }
        }
      }
    },
    "settings-reset-done" : {
      "comment" : "Notice once Kaeri has started again on the default settings. The file is the name the old settings file is kept under, beside the new one, such as config.damaged-2026-10-30. Argument 1: file (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen sind wieder auf Standard. Die alte Datei wird als %1$@ aufbewahrt."
          }
