    "notice-browser-not-opened" : {
      "comment" : "Toast when no browser could be opened for a sign-in. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Anmeldung konnte kein Browser geöffnet werden. Prüfe, ob einer installiert ist, und versuche es erneut. %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't open a browser for the sign-in. Check that one is installed and try again. %1$@"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir un navegador para iniciar sesión. Revisa que haya uno instalado e inténtalo de nuevo. %1$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'ouvrir un navigateur pour la connexion. Vérifiez qu'un navigateur est installé, puis réessayez. %1$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat membuka peramban untuk masuk. Pastikan ada peramban yang terpasang, lalu coba lagi. %1$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire un browser per l'accesso. Controlla che ce ne sia uno installato e riprova. %1$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン用のブラウザを開けませんでした。ブラウザがインストールされているか確認して、もう一度試してください。%1$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się otworzyć przeglądarki do logowania. Sprawdź, czy któraś jest zainstalowana, i spróbuj ponownie. %1$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir um navegador para a conexão. Verifique se há um instalado e tente de novo. %1$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть браузер для входа. Проверьте, что он установлен, и попробуйте ещё раз. %1$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att öppna en webbläsare för inloggningen. Kontrollera att en är installerad och försök igen. %1$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açma için tarayıcı açılamadı. Bir tarayıcının kurulu olup olmadığını denetleyin ve yeniden deneyin. %1$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không mở được trình duyệt để đăng nhập. Hãy kiểm tra xem đã cài trình duyệt chưa rồi thử lại. %1$@"
          }
        }
      }
    },
    "notice-cast-audio-codec" : {
      "comment" : "The TV can't play the stream's audio, and this device can't convert it. The name is the TV's own. The codec is a technical name such as DTS. Argument 1: name (Text). Argument 2: codec (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann dieses Audio nicht abspielen (%2$@), und dieses Gerät kann es nicht umwandeln. Probiere eine andere Quelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ can't play this audio (%2$@), and this device can't convert it. Try another source."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no puede reproducir este audio (%2$@), y este dispositivo no puede convertirlo. Prueba con otra fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas lire cet audio (%2$@), et cet appareil ne peut pas le convertir. Essayez une autre source."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tidak bisa memutar audio ini (%2$@), dan perangkat ini tidak bisa mengonversinya. Coba sumber lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non riesce a riprodurre questo audio (%2$@) e questo dispositivo non può convertirlo. Prova un'altra fonte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ではこの音声を再生できず(%2$@)、このデバイスでも変換できません。別のソースをお試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nie może odtworzyć tego dźwięku (%2$@), a to urządzenie nie potrafi go przekonwertować. Wypróbuj inne źródło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não consegue reproduzir este áudio (%2$@), e este dispositivo não consegue convertê-lo. Tente outra fonte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не может воспроизвести этот звук (%2$@), а это устройство не умеет его преобразовать. Попробуйте другой источник."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kan inte spela det här ljudet (%2$@), och den här enheten kan inte konvertera det. Prova en annan källa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bu sesi oynatamıyor (%2$@), bu cihaz ise sesi dönüştüremiyor. Başka bir kaynak deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ không phát được âm thanh này (%2$@), và thiết bị này không thể chuyển đổi. Hãy thử nguồn khác."
          }
        }
      }
    },
