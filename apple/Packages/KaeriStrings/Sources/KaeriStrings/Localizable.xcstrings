    "shell-engine-stopped-body" : {
      "comment" : "Plain line under the title of the page shown when the engine stopped while the app was open.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads und Sync sind ebenfalls angehalten. Starte Kaeri neu, um weiterzumachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads and sync stopped with it. Start Kaeri again to carry on."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas y la sincronización también se detuvieron. Vuelve a iniciar Kaeri para seguir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements et la synchronisation se sont arrêtés aussi. Relancez Kaeri pour continuer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduhan dan sinkronisasi ikut berhenti. Mulai Kaeri lagi untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche i download e la sincronizzazione si sono fermati. Avvia di nuovo Kaeri per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードと同期も止まりました。Kaeriを起動し直すと続けられます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieranie i synchronizacja też się zatrzymały. Uruchom Kaeri ponownie, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads e a sincronização pararam junto. Abra o Kaeri de novo para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки и синхронизация остановились вместе с ним. Запустите Kaeri снова, чтобы возобновить работу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedladdningar och synk stannade också. Starta Kaeri igen för att fortsätta."
