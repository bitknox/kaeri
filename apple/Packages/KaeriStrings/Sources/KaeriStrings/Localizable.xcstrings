    "devices-aside" : {
      "comment" : "Aside on the Devices page on the Mac and iPad. Argument 1: kind (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung überträgt, wo du aufgehört hast, deinen Verlauf und deine Einstellungen zwischen deinen eigenen Geräte, in der Nähe oder über einen Cloud-Ordner deiner Wahl. Sie wird versiegelt, bevor sie dieses %1$@ verlässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync carries where you stopped, your history and your settings between your own devices, nearby or through a cloud folder you choose. It is sealed before it leaves this %1$@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización lleva dónde te quedaste, tu historial y tus ajustes entre tus propios dispositivos, de forma cercana o a través de una carpeta en la nube que elijas. Se sella antes de salir de este dispositivo (%1$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation transporte où vous vous êtes arrêté, votre historique et vos réglages entre vos propres appareils, à proximité ou via un dossier cloud de votre choix. Elle est scellée avant de quitter cet %1$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi membawa posisi terakhir, riwayat, dan pengaturan Anda di antara perangkat Anda sendiri, di dekat atau lewat folder cloud pilihan Anda. Datanya disegel sebelum keluar dari %1$@ ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione porta dove ti sei fermato, la cronologia e le impostazioni tra i tuoi dispositivi, vicini o tramite una cartella cloud a tua scelta. È sigillata prima di lasciare questo %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期では、続きの位置、履歴、設定を、近くまたは選んだクラウドフォルダ経由で、自分のデバイスの間で受け渡します。内容はこの%1$@を出る前に封印されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja przenosi miejsce, w którym skończono oglądać, historię i ustawienia między twoimi urządzeniami, w pobliżu lub przez wybrany folder w chmurze. Jest szyfrowana, zanim opuści to urządzenie (%1$@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização leva onde você parou, seu histórico e suas configurações entre os seus próprios dispositivos, por perto ou por uma pasta na nuvem que você escolher. Ela é selada antes de sair deste dispositivo (%1$@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация переносит место, где вы остановились, историю и настройки между вашими устройствами, рядом или через выбранную облачную папку. Данные шифруются, прежде чем покинуть это устройство (%1$@)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synk för över var du slutade, din historik och dina inställningar mellan dina egna enheter, i närheten eller via en molnmapp du väljer. Den förseglas innan den lämnar den här %1$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşitleme; kaldığınız yeri, geçmişinizi ve ayarlarınızı kendi cihazlar arasında, yakından ya da seçtiğiniz bir bulut klasörü üzerinden taşır. Bu %1$@ dışına çıkmadan önce mühürlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ mang chỗ bạn đã xem dở, lịch sử và cài đặt giữa các các thiết bị của chính bạn, ở gần hoặc qua một thư mục đám mây bạn chọn. Dữ liệu được niêm phong trước khi rời %1$@ này."
          }
        }
      }
    },
