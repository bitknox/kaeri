    "reader-paper-mode-note" : {
      "comment" : "Paper mode's page.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiten wechseln sofort und nichts im Reader bewegt sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pages turn at once and nothing in the reader moves."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas cambian al instante y nada se mueve en el lector."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages tournent aussitôt et rien ne bouge dans le lecteur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halaman berganti seketika dan tidak ada yang bergerak di pembaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine girano subito e nulla nel lettore si muove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページは即座にめくれ、リーダー内の動きはなくなります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strony zmieniają się od razu i nic w czytniku się nie rusza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas viram de uma vez e nada se mexe no leitor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страницы листаются сразу, и в читалке ничего не движется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidor bläddras direkt och inget i läsaren rör sig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfalar anında döner ve okuyucuda hiçbir şey hareket etmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trang lật ngay và không gì trong trình đọc chuyển động."
          }
        }
      }
    },
    "reader-paper-quiet-note" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone dämpft Benachrichtigungen mit einem Fokus. Lege einen fest, der sich beim Öffnen von Kaeri einschaltet, und Kaeri wechselt in den Papiermodus, solange er aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone quiets notifications with a Focus. Set one to turn on when Kaeri opens, and Kaeri switches to Paper mode while it is on."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone silencia las notificaciones con un Focus. Configura uno para que se active al abrir Kaeri, y Kaeri pasa al modo Papel mientras esté activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'iPhone coupe les notifications avec un mode Concentration. Réglez-en un pour s'activer à l'ouverture de Kaeri, et Kaeri passe en mode papier tant qu'il est actif."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone menyenyapkan notifikasi lewat Fokus. Atur satu Fokus agar aktif saat Kaeri dibuka, dan Kaeri beralih ke Mode kertas selama Fokus itu aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone silenzia le notifiche con una Concentrazione. Impostane una che si attivi quando Kaeri si apre, e Kaeri passa alla modalità Carta finché è attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone では集中モードで通知を止められます。Kaeriを開いたときにオンになる集中モードを設定すると、その間はKaeriがペーパーモードに切り替わります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone wycisza powiadomienia za pomocą Skupienia. Ustaw jedno tak, by włączało się po otwarciu aplikacji Kaeri, a Kaeri przełączy się na tryb papieru, gdy będzie włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iPhone silencia as notificações com um Foco. Defina um para ligar quando o Kaeri abrir, e o Kaeri muda para o modo papel enquanto ele estiver ligado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone приглушает уведомления с помощью фокусирования. Настройте его на включение при открытии Kaeri, и Kaeri перейдёт в режим бумаги, пока оно включено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone dämpar aviseringar med ett fokus. Ställ in ett som slås på när Kaeri öppnas, så byter Kaeri till pappersläge medan det är på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone bildirimleri Odak ile susturur. Kaeri açılınca devreye girecek bir Odak ayarlayın; açık olduğu sürece Kaeri kâğıt moduna geçer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone tắt thông báo bằng Tập trung. Hãy đặt một chế độ bật khi Kaeri mở, và Kaeri sẽ chuyển sang chế độ giấy khi chế độ đó đang bật."
          }
        }
      }
    },
