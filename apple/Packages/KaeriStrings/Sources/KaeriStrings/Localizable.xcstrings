    "sync-note-kept-watched" : {
      "comment" : "Sync note. Argument 1: n (Plain). Argument 2: title (Text). Argument 3: other (Text). Argument 4: device (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folge %1$@ von %2$@ bleibt gesehen. %3$@ hat sie als ungesehen markiert, ohne zu wissen, dass %4$@ sie schon fertig hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode %1$@ of %2$@ stays watched. %3$@ marked it unwatched without knowing %4$@ had finished it."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El episodio %1$@ de %2$@ sigue como visto. %3$@ lo marcó como no visto sin saber que %4$@ lo había terminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’épisode %1$@ de %2$@ reste vu. %3$@ l’a marqué comme non vu sans savoir que %4$@ l’avait terminé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode %1$@ dari %2$@ tetap ditandai sudah ditonton. %3$@ menandainya belum ditonton tanpa tahu %4$@ sudah selesai menontonnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'episodio %1$@ di %2$@ resta visto. %3$@ lo ha segnato come non visto senza sapere che %4$@ lo aveva finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@のエピソード%1$@は視聴済みのままです。%3$@は、%4$@が視聴を終えたことを知らずに未視聴に戻しました。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odcinek %1$@ serialu %2$@ zostaje obejrzany. %3$@ oznaczył go jako nieobejrzany, nie wiedząc, że %4$@ już go skończył."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O episódio %1$@ de %2$@ continua como assistido. %3$@ o marcou como não assistido sem saber que %4$@ já o tinha terminado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эпизод %1$@ сериала %2$@ остаётся просмотренным. %3$@ отметил его непросмотренным, не зная, что %4$@ уже его досмотрел."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsnitt %1$@ av %2$@ förblir sett. %3$@ markerade det som osett utan att veta att %4$@ hade sett klart det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ için %1$@. bölüm izlendi olarak kalıyor. %3$@, %4$@ bitirdiğini bilmeden onu izlenmedi olarak işaretledi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập %1$@ của %2$@ vẫn được giữ là đã xem. %3$@ đã đánh dấu chưa xem mà không biết %4$@ đã xem xong tập này."
          }
        }
      }
    },
