    "sync-road-cloud-line" : {
      "comment" : "Road sheet row line. Names no service, since a build may hide some (decision 14).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Cloud-Laufwerk, das du schon nutzt, oder dein eigener Server. Es funktioniert auch, wenn deine Geräte getrennt sind, und legt eine Sicherung an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cloud drive you already use, or your own server. It works while your devices are apart and keeps a backup."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una unidad en la nube que ya usas, o tu propio servidor. Funciona aunque tus dispositivos estén lejos y guarda una copia de respaldo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un espace cloud que vous utilisez déjà, ou votre propre serveur. Il fonctionne même quand vos appareils sont éloignés, et garde une sauvegarde."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drive cloud yang sudah Anda pakai, atau server Anda sendiri. Ini tetap berfungsi saat perangkat Anda berjauhan, dan menyimpan cadangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cloud che usi già, o il tuo server. Funziona anche quando i tuoi dispositivi sono lontani e conserva un backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに使っているクラウドドライブか、自分のサーバーを使います。デバイスが離れていても動作し、バックアップも残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dysk w chmurze, z którego już korzystasz, albo własny serwer. Działa, gdy twoje urządzenia są daleko od siebie, i tworzy kopię zapasową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um drive na nuvem que você já usa, ou o seu próprio servidor. Funciona enquanto seus dispositivos estão longe um do outro e mantém um backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облачный диск, которым вы уже пользуетесь, или собственный сервер. Работает, пока ваши устройства далеко друг от друга, и хранит резервную копию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En molndisk du redan använder, eller din egen server. Den fungerar medan dina enheter är ifrån varandra och håller en säkerhetskopia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten kullandığınız bir bulut sürücüsü ya da kendi sunucunuz. cihazlarınız birbirinden uzaktayken de çalışır ve bir yedek tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ổ đám mây bạn đã dùng, hoặc máy chủ của riêng bạn. Nó hoạt động khi các các thiết bị của bạn ở xa nhau và giữ một bản sao lưu."
          }
        }
      }
    },
    "sync-road-later" : {
