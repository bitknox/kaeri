    "notice-mpv-old" : {
      "comment" : "Toast at launch when mpv is too old for Kaeri's own player. Terminal only: the engine never sends it to the apps. Argument 1: version (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ kann abspielen, aber der Player von Kaeri braucht für die Überspringen-Taste, die Karte „Als Nächstes“, Menüs und Vorschaubilder mpv 0.36 oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ can play, but Kaeri's player needs mpv 0.36 or newer for its skip button, Up next card, menus and thumbnails."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ puede reproducir, pero el reproductor de Kaeri necesita mpv 0.36 o más reciente para su botón de saltar, la tarjeta Siguiente, los menús y las miniaturas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ peut lire des vidéos, mais le lecteur de Kaeri demande mpv 0.36 ou plus récent pour son bouton Passer, la carte À suivre, les menus et les miniatures."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ bisa memutar, tetapi pemutar Kaeri memerlukan mpv 0.36 atau yang lebih baru untuk tombol lewati, kartu Berikutnya, menu, dan thumbnail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ può riprodurre, ma il player di Kaeri richiede mpv 0.36 o più recente per il pulsante di salto, la scheda Prossimo, i menu e le miniature."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@では再生できますが、Kaeriのプレーヤーは、スキップボタン、次のエピソードカード、メニュー、サムネイルのためにmpv 0.36以降が必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ potrafi odtwarzać, ale odtwarzacz Kaeri wymaga mpv 0.36 lub nowszego do przycisku pomijania, menu, miniatur i karty „Następny”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mpv %1$@ pode reproduzir, mas o player do Kaeri precisa do mpv 0.36 ou mais recente para o botão de pular, o cartão de Próximo, os menus e as miniaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ может воспроизводить, но плеер Kaeri для кнопки пропуска, карточки «Далее», меню и превью требует mpv версии 0.36 или новее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ kan spela, men Kaeris spelare kräver mpv 0.36 eller nyare för hoppknappen, kortet Nästa, menyerna och miniatyrerna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ oynatabiliyor, ama Kaeri oynatıcısının atlama düğmesi, Sıradaki kartı, menüleri ve küçük resimleri için mpv 0.36 ya da daha yenisi gerekli."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ có thể phát, nhưng trình phát của Kaeri cần mpv 0.36 trở lên cho nút bỏ qua, thẻ Tiếp theo, menu và ảnh xem trước."
          }
        }
      }
    },
