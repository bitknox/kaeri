    "player-mark-too-long" : {
      "comment" : "Line when the stretch is longer than AniSkip takes. $kind is in lower case and plural: openings, endings or recaps. $most is a length such as \"3 min\". Argument 1: kind (Text). Argument 2: most (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur auf diesem Gerät gespeichert. AniSkip nimmt bei einer so langen Folge %1$@ bis %2$@ an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved on this device only. AniSkip takes %1$@ up to %2$@ in an episode this long."
