    "downloads-seeding-note" : {
      "comment" : "Line under the seeding heading.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesehene Folgen werden geteilt, während Kaeri geöffnet ist. Das Teilen endet beim Verhältnis oder der Zeitgrenze, die du in den Einstellungen unter Quellen festlegst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watched episodes are shared back while Kaeri is open. Sharing stops at the ratio or time limit you set in Settings, under Sources."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios vistos se comparten mientras Kaeri está abierto. Se deja de compartir al llegar a la proporción o al límite de tiempo que defines en Configuración, en Fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes vus sont partagés pendant que Kaeri est ouvert. Le partage s’arrête au ratio ou à la durée limite que vous réglez dans les réglages, sous Sources."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode yang sudah ditonton dibagikan kembali saat Kaeri terbuka. Berbagi berhenti saat mencapai rasio atau batas waktu yang Anda atur di Pengaturan, di bawah Sumber-sumber."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi visti vengono condivisi mentre Kaeri è aperto. La condivisione si ferma al rapporto o al limite di tempo che imposti in Impostazioni, sotto Fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴済みのエピソードは、Kaeriを開いている間に共有されます。設定のソースで指定した比率か時間の上限に達すると、共有は止まります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obejrzane odcinki są udostępniane zwrotnie, gdy Kaeri jest otwarte. Udostępnianie kończy się po osiągnięciu współczynnika lub limitu czasu ustawionego w Ustawieniach, w sekcji: Źródła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os episódios assistidos são compartilhados de volta enquanto o Kaeri estiver aberto. O compartilhamento para no limite de proporção ou de tempo definido em Configurações, em Fontes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотренные эпизоды раздаются обратно, пока открыт Kaeri. Раздача останавливается при достижении коэффициента или лимита времени, заданных в настройках, в разделе «Источники»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedda avsnitt delas tillbaka medan Kaeri är öppen. Delningen slutar vid den kvot eller tidsgräns du anger i Inställningar, under Källor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlenen bölümler Kaeri açıkken geri paylaşılır. Paylaşım, Ayarlar'da Kaynaklar altında belirlediğiniz oran ya da süre sınırında durur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tập đã xem được chia sẻ lại khi Kaeri đang mở. Việc chia sẻ dừng khi đạt tỉ lệ hoặc thời gian bạn đặt trong Cài đặt, mục Các nguồn."
          }
        }
      }
    },
