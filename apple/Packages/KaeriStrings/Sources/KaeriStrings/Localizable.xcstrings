          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparuj je, a to urządzenie dostanie Twoje źródła, trackery i historię, a reszta konfiguracji będzie gotowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
