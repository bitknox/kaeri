        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni predefinite del lettore sono il punto di partenza di ogni serie. Una serie che cambi nel lettore tiene le sue scelte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダーの既定は、すべての作品の出発点です。リーダーで変更した作品は、その設定を保ちます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślne ustawienia czytnika to punkt wyjścia każdej serii. Seria zmieniona w czytniku zachowuje własne wybory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os padrões do leitor são o ponto de partida de toda série. Uma série que você muda no leitor guarda as próprias escolhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки читалки по умолчанию задают начало для каждой серии. Серия, которую вы изменили в читалке, сохраняет свой выбор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läsarens standardvärden är där varje serie börjar. En serie du ändrar i läsaren behåller sina egna val."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okuyucu varsayılanları her serinin başlangıç noktasıdır. Okuyucuda değiştirdiğiniz seri kendi seçimlerini korur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định của trình đọc là điểm bắt đầu của mọi bộ truyện. Bộ truyện nào bạn đổi trong trình đọc sẽ giữ lựa chọn riêng."
          }
        }
      }
    },
    "settings-aside-sources-apple" : {
      "comment" : "Side note in Sources while torrents are off.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen werden der Reihe nach von oben nach unten versucht. Eine Serie kann eine eigene Quelle behalten, die auf ihrer Titelseite gewählt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources are tried in order, top to bottom. A show can keep its own source, chosen from its title page."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuentes se prueban en orden, de arriba abajo. Una serie puede conservar su propia fuente, que se elige en la página de la serie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources sont essayées dans l’ordre, de haut en bas. Une série peut garder sa propre source, choisie depuis sa page de présentation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber-sumber dicoba berurutan, dari atas ke bawah. Sebuah tayangan dapat menyimpan sumber sendiri, yang dipilih dari halaman judulnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fonti vengono provate in ordine, dall'alto in basso. Un titolo può avere una fonte propria, scelta dalla sua pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースは上から順に試されます。作品ごとに、作品ページから専用のソースを選ぶこともできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródła są sprawdzane po kolei, od góry do dołu. Tytuł może mieć własne źródło, wybrane na jego stronie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fontes são testadas em ordem, de cima para baixo. Uma série pode usar a própria fonte, escolhida na página dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источники проверяются по порядку, сверху вниз. У сериала может быть свой источник, который выбирается на его странице."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Källor provas i ordning, uppifrån och ner. En titel kan ha en egen källa, som väljs på dess titelsida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynaklar yukarıdan aşağıya, sırayla denenir. Bir gösteri, başlık sayfasından seçilen kendi kaynak ile gelebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nguồn được thử theo thứ tự từ trên xuống dưới. Một tựa có thể giữ nguồn riêng, chọn từ trang thông tin của tựa đó."
          }
        }
      }
    },
