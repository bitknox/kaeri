        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar, Seasonal, Watch together and your shows leave Kaeri on this %1$@. Your list, progress and downloads stay, and come back if you turn watching on again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendario, De temporada, Ver juntos y tus series salen de Kaeri en este %1$@. Tu lista, tu progreso y tus descargas se quedan, y vuelven si activas de nuevo el ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendrier, Saisons, Regarder ensemble et vos séries quittent Kaeri sur %1$@. Votre liste, votre progression et vos téléchargements restent, et reviennent si vous réactivez le visionnage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender, Musiman, Nonton bareng, dan tontonan Anda hilang dari Kaeri di %1$@ ini. Daftar, kemajuan, dan unduhan Anda tetap ada, dan kembali jika Anda menyalakan fitur menonton lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendario, Stagione, Guarda insieme e le tue serie escono da Kaeri su questo %1$@. La tua lista, i progressi e i download restano, e tornano se riattivi il guardare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%1$@のKaeriから、カレンダー、シーズン、一緒に見る、作品が表示されなくなります。リスト、進捗、ダウンロードは残り、視聴をオンに戻すと復活します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendarz, Sezonowe, Oglądaj razem i twoje seriale znikają z aplikacji Kaeri na: %1$@. Lista, postęp i pobrane pliki zostają i wracają, jeśli ponownie włączysz oglądanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendário, Temporada, Assistir juntos e suas séries saem do Kaeri neste %1$@. Sua lista, seu progresso e seus downloads ficam e voltam se você ligar o assistir de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Календарь», «Сезон», Смотреть вместе и ваши сериалы исчезнут из Kaeri на %1$@. Список, прогресс и загрузки сохранятся и вернутся, если снова включить просмотр."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender, Säsong, Titta tillsammans och dina serier lämnar Kaeri på den här %1$@. Din lista, ditt förlopp och dina nedladdningar finns kvar och kommer tillbaka om du slår på tittande igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvim, Sezon, Birlikte izle ve dizileriniz bu %1$@ üzerinde Kaeri içinden kalkar. Listeniz, ilerlemeniz ve indirmeleriniz kalır; izlemeyi yeniden açarsanız geri gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch, Theo mùa, Cùng xem và phim của bạn sẽ biến mất khỏi Kaeri trên %1$@ này. Danh sách, tiến độ và các bản tải vẫn còn, và quay lại nếu bạn bật lại việc xem."
          }
        }
      }
    },
