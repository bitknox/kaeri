    "about-legal" : {
      "comment" : "Line under the legal line: what comes built in. The app shows legal-hosts-no-content before it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgesehen von einer Demo mit Creative-Commons-Werken bringt Kaeri keine Quellen mit. Plugins kommen aus Plugin-Stores, denen du beitrittst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apart from a demo of Creative Commons works, Kaeri comes with no sources. Plugins come from plugin stores you join."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparte de una demo con obras Creative Commons, Kaeri no incluye ninguna fuente. Complementos vienen de las tiendas de complementos a las que te unes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormis une démo d’œuvres Creative Commons, Kaeri n’inclut aucune source. Les plugins viennent des boutiques de plugins que vous rejoignez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selain demo karya Creative Commons, Kaeri tidak menyertakan sumber-sumber. Plugin-plugin berasal dari toko-toko plugin yang Anda ikuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parte una demo di opere Creative Commons, Kaeri non include fonti. Plugin provengono dai negozi di plugin a cui ti unisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creative Commonsの作品のデモを除き、Kaeriにはソースが付属していません。プラグインは参加したプラグインストアから提供されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poza wersją demonstracyjną z utworami Creative Commons Kaeri nie zawiera żadnych źródeł. Wtyczki pochodzą ze sklepów, do których dołączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora uma demo com obras Creative Commons, o Kaeri não vem com fontes. Plugins vêm das lojas de plugins em que você entrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помимо демо с произведениями Creative Commons, Kaeri не включает источники. Плагины приходят из магазинов плагинов, к которым вы присоединились."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bortsett från en demo med Creative Commons-verk kommer Kaeri utan källor. Tillägg kommer från tilläggsbutiker du går med i."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creative Commons eserlerinden oluşan bir demo dışında Kaeri hiçbir kaynak içermez. Eklentiler, katıldığınız eklenti mağazaları üzerinden gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoài một bản demo gồm các tác phẩm Creative Commons, Kaeri không đi kèm các nguồn nào. Các plugin đến từ các cửa hàng plugin mà bạn tham gia."
          }
        }
      }
    },
