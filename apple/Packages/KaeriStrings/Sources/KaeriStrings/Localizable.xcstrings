    "settings-presence-note" : {
      "comment" : "Footnote of the Discord group. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rich Presence zeigt das Cover, einen Fortschrittsbalken und einen Link zur Serie bei %1$@. Das funktioniert nur, wenn der Titel angezeigt wird. Discord lädt das Cover selbst von %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rich presence shows the cover, a progress bar and a link to the show on %1$@. It works only while the title is shown. Discord loads the cover from %1$@ itself."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presencia enriquecida muestra la portada, una barra de progreso y un enlace a la serie en %1$@. Solo funciona mientras se muestra el título. Discord carga la portada directamente desde %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activité enrichie affiche la jaquette, une barre de progression et un lien vers la série sur %1$@. Elle ne fonctionne que si le titre est affiché. Discord charge la jaquette directement depuis %1$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehadiran kaya menampilkan sampul, bilah kemajuan, dan tautan ke tayangan di %1$@. Ini hanya berfungsi jika judul ditampilkan. Discord memuat sampul langsung dari %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presenza su Discord mostra la copertina, una barra di avanzamento e un link alla serie su %1$@. Funziona solo se il titolo è visibile. Discord carica la copertina direttamente da %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リッチプレゼンスには、カバー画像、進捗バー、%1$@の作品へのリンクが表示されます。タイトルを表示しているときだけ機能します。カバー画像はDiscordが%1$@から直接読み込みます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status aktywności w Discordzie pokazuje okładkę, pasek postępu i link do tytułu w %1$@. Działa tylko wtedy, gdy tytuł jest pokazywany. Discord sam pobiera okładkę z %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rich Presence mostra a capa, uma barra de progresso e um link para a série em %1$@. Só funciona enquanto o título estiver visível. O Discord carrega a capa do próprio %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширенный статус показывает обложку, полосу прогресса и ссылку на тайтл на %1$@. Работает, только пока название показывается. Discord сам загружает обложку с %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utökad närvaro visar omslaget, en förloppsmätare och en länk till serien på %1$@. Det fungerar bara medan titeln visas. Discord hämtar omslaget direkt från %1$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zengin durum; kapağı, bir ilerleme çubuğunu ve %1$@ üzerindeki dizi bağlantısını gösterir. Yalnızca başlık gösterilirken çalışır. Discord kapağı %1$@ üzerinden kendisi yükler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoạt động chi tiết hiển thị ảnh bìa, thanh tiến độ và liên kết tới tựa trên %1$@. Tính năng này chỉ hoạt động khi tên tựa được hiển thị. Discord tự tải ảnh bìa từ %1$@."
          }
        }
      }
    },
