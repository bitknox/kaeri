    "home-demo-only-books" : {
      "comment" : "Home, under the spotlight, when the demo is the only thing to read.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Demo ist aktiv. Füge einen Ordner, einen Server oder einen Plugin-Store hinzu, um deine eigenen Bücher zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the demo is on. Add a folder, a server or a plugin store to read your own books."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la demo está activa. Agrega una carpeta, un servidor o una tienda de complementos para leer tus propios libros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
