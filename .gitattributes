
# Generated by tools/i18n from i18n/. Edit the catalogue and run `cargo run -p i18n-tool -- generate`.
crates/kaeri-i18n/ftl/** linguist-generated=true
crates/kaeri-i18n/src/locales.rs linguist-generated=true
crates/kaeri-i18n/src/t.rs linguist-generated=true
apple/Packages/KaeriStrings/Sources/** linguist-generated=true
android/i18n/src/main/res/** linguist-generated=true
android/i18n/src/main/kotlin/** linguist-generated=true
desktop/windows/Kaeri.App.Core/Strings.g.cs linguist-generated=true
desktop/windows/Kaeri.Windows/Strings/** linguist-generated=true

# The generator writes LF, so a Windows checkout must not turn these into CRLF.
i18n/** text eol=lf
tools/i18n/tests/** text eol=lf
crates/kaeri-i18n/ftl/** text eol=lf
crates/kaeri-i18n/src/locales.rs text eol=lf
crates/kaeri-i18n/src/t.rs text eol=lf
apple/Packages/KaeriStrings/Sources/** text eol=lf
android/i18n/src/main/** text eol=lf
desktop/windows/Kaeri.App.Core/Strings.g.cs text eol=lf
desktop/windows/Kaeri.Windows/Strings/** text eol=lf

# Flag images are binary: no line-ending conversion.
*.png binary

# Text the engine includes and splits on blank lines: LF on every checkout, Windows too.
assets/demo/*.txt text eol=lf
